<%- include('partials/header', { title: 'Admin' }) %>

<h1>Admin</h1>
<% if (error) { %><div class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div class="notice-box"><%= notice %></div><% } %>

<div class="card">
  <div class="section-title">Members</div>
  <ul class="plain">
    <% members.forEach(m => { %>
      <li>
        <strong><%= m.display_name %></strong> &middot; <%= m.email %><%= m.is_admin ? ' · admin' : '' %>
        <form method="post" action="/admin/members/reset-password" style="display:inline; margin-left:8px;">
          <%- include('partials/csrf_field') %>
          <input type="hidden" name="email" value="<%= m.email %>">
          <button class="btn btn-outline btn-small" type="submit">Send password reset email</button>
        </form>
      </li>
    <% }) %>
  </ul>
</div>

<div class="card">
  <div class="section-title">Post an announcement</div>
  <form class="stack" method="post" action="/admin/announcements">
    <%- include('partials/csrf_field') %>
    <label for="a-title">Title</label>
    <input id="a-title" name="title" type="text" required>
    <label for="a-body">Body</label>
    <textarea id="a-body" name="body" required></textarea>
    <button class="btn" type="submit">Post</button>
  </form>
</div>

<div class="card">
  <div class="section-title">Add an event</div>
  <form class="stack" method="post" action="/admin/events">
    <%- include('partials/csrf_field') %>
    <label for="e-title">Title</label>
    <input id="e-title" name="title" type="text" required>
    <label for="e-desc">Description</label>
    <textarea id="e-desc" name="description"></textarea>
    <label for="e-loc">Location</label>
    <input id="e-loc" name="location" type="text">
    <label for="e-start">Starts at</label>
    <input id="e-start" name="startsAt" type="datetime-local" required>
    <label for="e-cap">Capacity (optional)</label>
    <input id="e-cap" name="capacity" type="number" min="1">
    <button class="btn" type="submit">Add event</button>
  </form>
  <h3 style="margin-top:20px;">Recent events</h3>
  <ul class="plain">
    <% events.forEach(e => { %>
      <li><%= e.title %> &middot; <span class="muted small"><%= new Date(e.starts_at).toLocaleString() %></span></li>
    <% }) %>
  </ul>
</div>

<div class="card">
  <div class="section-title">Add a volunteer shift</div>
  <p class="muted small">Use "Repeat weekly" to create the same shift for several weeks at once &mdash; handy for regular shop-floor slots.</p>
  <form class="stack" method="post" action="/admin/volunteer-shifts">
    <%- include('partials/csrf_field') %>
    <label for="v-role">Role</label>
    <input id="v-role" name="role" type="text" required placeholder="Shop Floor" list="v-role-suggestions">
    <datalist id="v-role-suggestions">
      <option value="Shop Floor">
      <option value="Sorting & Shelving">
      <option value="Events & Language Exchange">
      <option value="Bilingual Support">
      <option value="Éveil Helper">
    </datalist>
    <label for="v-start">Starts at</label>
    <input id="v-start" name="startsAt" type="datetime-local" required>
    <label for="v-end">Ends at</label>
    <input id="v-end" name="endsAt" type="datetime-local" required>
    <label for="v-cap">Capacity</label>
    <input id="v-cap" name="capacity" type="number" min="1" value="1" required>
    <label for="v-repeat">Repeat weekly, this many times (including the first)</label>
    <input id="v-repeat" name="repeatWeeks" type="number" min="1" max="52" value="1">
    <label for="v-notes">Notes (optional)</label>
    <textarea id="v-notes" name="notes"></textarea>
    <button class="btn" type="submit">Add shift</button>
  </form>
  <h3 style="margin-top:20px;">Upcoming shifts</h3>
  <ul class="plain">
    <% if (!shifts.length) { %><li class="muted small">None scheduled.</li><% } %>
    <% shifts.forEach(s => { %>
      <li>
        <%= s.role %>
        <span class="muted small"><%= new Date(s.starts_at).toLocaleString() %> &middot; <%= s.signup_count %>/<%= s.capacity %> filled</span>
        <form method="post" action="/admin/volunteer-shifts/<%= s.id %>/delete" style="display:inline;">
          <%- include('partials/csrf_field') %>
          <button class="btn btn-outline btn-small" type="submit">Delete</button>
        </form>
      </li>
    <% }) %>
  </ul>
</div>

<div class="card">
  <div class="section-title">Start a charity vote round</div>
  <p class="muted small">Starting a new round closes any round that's currently open.</p>
  <form class="stack" method="post" action="/admin/charity-rounds">
    <%- include('partials/csrf_field') %>
    <label for="c-title">Question</label>
    <input id="c-title" name="title" type="text" required placeholder="Which charity should we support next?">
    <label for="c-options">Options (comma-separated)</label>
    <input id="c-options" name="options" type="text" required placeholder="Restos du Coeur, SPA Albi, ...">
    <button class="btn" type="submit">Start round</button>
  </form>
  <h3 style="margin-top:20px;">Recent rounds</h3>
  <ul class="plain">
    <% rounds.forEach(r => { %>
      <li>
        <%= r.title %>
        <span class="muted small"><%= r.is_active ? '(active)' : '(closed)' %></span>
        <% if (r.is_active) { %>
          <form method="post" action="/admin/charity-rounds/<%= r.id %>/close" style="display:inline;">
            <%- include('partials/csrf_field') %>
            <button class="btn btn-outline btn-small" type="submit">Close</button>
          </form>
        <% } %>
      </li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer') %>

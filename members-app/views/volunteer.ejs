<%- include('partials/header', { title: 'Volunteer Shifts' }) %>

<h1>Volunteer Shifts</h1>
<p class="muted">Sign up for a shift below. Uma's is entirely volunteer-run &mdash; every hour on the shop floor, every sorted donation, every event, is someone giving their time.</p>

<% const mine = shifts.filter(s => mySignedUpIds.has(s.id)); %>
<% if (mine.length) { %>
  <div class="card">
    <div class="section-title">My upcoming shifts</div>
    <ul class="plain">
      <% mine.forEach(s => { %>
        <li>
          <strong><%= s.role %></strong>
          <div class="muted small"><%= new Date(s.starts_at).toLocaleString() %> &ndash; <%= new Date(s.ends_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %></div>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card">
  <div class="section-title">All upcoming shifts</div>
  <% if (!shifts.length) { %>
    <p class="muted">No shifts scheduled yet.</p>
  <% } %>
  <ul class="plain">
    <% shifts.forEach(s => { %>
      <% const full = s.signup_count >= s.capacity; %>
      <li>
        <strong><%= s.role %></strong>
        <div class="muted small">
          <%= new Date(s.starts_at).toLocaleString() %> &ndash; <%= new Date(s.ends_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %>
          &middot; <%= s.signup_count %>/<%= s.capacity %> filled
        </div>
        <% if (s.notes) { %><div class="muted small"><%= s.notes %></div><% } %>
        <% if (mySignedUpIds.has(s.id)) { %>
          <form method="post" action="/volunteer/<%= s.id %>/cancel" style="margin-top:6px;">
            <%- include('partials/csrf_field') %>
            <button class="btn btn-outline btn-small" type="submit">Cancel</button>
          </form>
        <% } else { %>
          <form method="post" action="/volunteer/<%= s.id %>/signup" style="margin-top:6px;">
            <%- include('partials/csrf_field') %>
            <button class="btn btn-small" type="submit"<%= full ? ' disabled' : '' %>><%= full ? 'Full' : 'Sign up' %></button>
          </form>
        <% } %>
      </li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer') %>

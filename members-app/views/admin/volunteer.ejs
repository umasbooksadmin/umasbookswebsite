<%- include('../partials/header', { title: 'Admin — Volunteer Shifts' }) %>
<%- include('../partials/admin_subnav', { active }) %>

<h1>Volunteer Shifts</h1>

<div class="card">
  <div class="section-title">Add a volunteer shift</div>
  <p class="muted small">Use "Repeat weekly" to create the same shift for several weeks at once &mdash; handy for regular shop-floor slots.</p>
  <form class="stack" method="post" action="/admin/volunteer-shifts">
    <%- include('../partials/csrf_field') %>
    <label for="v-role">Role</label>
    <input id="v-role" name="role" type="text" required placeholder="Shop Floor" list="v-role-suggestions">
    <datalist id="v-role-suggestions">
      <option value="Shop Floor">
      <option value="Sorting & Shelving">
      <option value="Events & Language Exchange">
      <option value="Bilingual Support">
      <option value="Éveil Helper">
    </datalist>
    <label for="v-start">Starts at</label>
    <input id="v-start" name="startsAt" type="datetime-local" required>
    <label for="v-end">Ends at</label>
    <input id="v-end" name="endsAt" type="datetime-local" required>
    <label for="v-cap">Capacity</label>
    <input id="v-cap" name="capacity" type="number" min="1" value="1" required>
    <label for="v-repeat">Repeat weekly, this many times (including the first)</label>
    <input id="v-repeat" name="repeatWeeks" type="number" min="1" max="52" value="1">
    <label for="v-notes">Notes (optional)</label>
    <textarea id="v-notes" name="notes"></textarea>
    <button class="btn" type="submit">Add shift</button>
  </form>
</div>

<div class="card">
  <div class="section-title">Upcoming shifts</div>
  <ul class="plain">
    <% if (!shifts.length) { %><li class="muted small">None scheduled.</li><% } %>
    <% shifts.forEach(s => { %>
      <li>
        <%= s.role %>
        <span class="muted small"><%= new Date(s.starts_at).toLocaleString() %> &middot; <%= s.signup_count %>/<%= s.capacity %> filled</span>
        <form method="post" action="/admin/volunteer-shifts/<%= s.id %>/delete" style="display:inline;">
          <%- include('../partials/csrf_field') %>
          <button class="btn btn-outline btn-small" type="submit">Delete</button>
        </form>
      </li>
    <% }) %>
  </ul>
</div>

<%- include('../partials/footer') %>

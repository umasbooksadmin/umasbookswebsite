<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Members</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=EB+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site">
  <div class="wrap">
    <div class="brand">Uma's Books &mdash; Members</div>
    <nav>
      <% if (locals.user) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/forum">Forum</a>
        <a href="/events">Events</a>
        <a href="/charity">Charity Vote</a>
        <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
      <% } %>
    </nav>
    <div class="who">
      <% if (locals.user) { %>
        <span>Hi, <%= user.displayName %></span>
        <form method="post" action="/logout" style="margin:0;">
          <button class="btn btn-outline btn-small" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="btn btn-small" href="/signup">Join</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap">

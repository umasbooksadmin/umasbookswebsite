<%- include('partials/header', { title: 'Dashboard' }) %>

<h1>Welcome, <%= user.displayName %></h1>

<div class="card">
  <div class="section-title">Announcements</div>
  <% if (!announcements.length) { %>
    <p class="muted">Nothing posted yet.</p>
  <% } else { %>
    <ul class="plain">
      <% announcements.forEach(a => { %>
        <li>
          <strong><%= a.title %></strong>
          <div class="muted small"><%= new Date(a.published_at).toLocaleDateString() %></div>
          <div><%= a.body %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card">
  <div class="section-title">Community Forum</div>
  <% if (!forumThreads.length) { %>
    <p class="muted">No threads yet &mdash; <a href="/forum/new">start one</a>.</p>
  <% } else { %>
    <ul class="plain">
      <% forumThreads.forEach(t => { %>
        <li>
          <a href="/forum/<%= t.id %>"><%= t.title %></a>
          <div class="thread-meta"><%= t.author_name || 'Member' %> &middot; <%= t.reply_count %> repl<%= t.reply_count == 1 ? 'y' : 'ies' %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <p><a href="/forum">See all &rarr;</a></p>
</div>

<div class="card">
  <div class="section-title">Upcoming Events</div>
  <% if (!events.length) { %>
    <p class="muted">Nothing scheduled yet.</p>
  <% } else { %>
    <ul class="plain">
      <% events.forEach(e => { %>
        <li>
          <strong><%= e.title %></strong>
          <div class="muted small"><%= new Date(e.starts_at).toLocaleString() %><%= e.location ? ' · ' + e.location : '' %></div>
          <% if (rsvpedEventIds.has(e.id)) { %>
            <span class="notice-box small" style="display:inline-block; margin-top:6px;">You're going</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <p><a href="/events">See all &amp; RSVP &rarr;</a></p>
</div>

<div class="card">
  <div class="section-title">Volunteer Shifts</div>
  <% if (!shifts.length) { %>
    <p class="muted">No shifts scheduled yet.</p>
  <% } else { %>
    <ul class="plain">
      <% shifts.forEach(s => { %>
        <li>
          <strong><%= s.role %></strong>
          <div class="muted small"><%= new Date(s.starts_at).toLocaleString() %> &middot; <%= s.signup_count %>/<%= s.capacity %> filled</div>
          <% if (mySignedUpShiftIds.has(s.id)) { %>
            <span class="notice-box small" style="display:inline-block; margin-top:6px;">You're signed up</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <p><a href="/volunteer">See all &amp; sign up &rarr;</a></p>
</div>

<% if (charity) { %>
<div class="card">
  <div class="section-title">Charity Vote</div>
  <p class="muted"><%= charity.round.title %></p>
  <p><a href="/charity">View &amp; vote &rarr;</a></p>
</div>
<% } %>

<%- include('partials/footer') %>

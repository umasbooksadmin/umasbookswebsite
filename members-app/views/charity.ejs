<%- include('partials/header', { title: 'Charity Vote' }) %>

<h1>Charity Vote</h1>

<% if (!charity) { %>
  <p class="muted">No vote is open right now.</p>
<% } else { %>
  <p class="muted"><%= charity.round.title %></p>
  <% const total = charity.options.reduce((sum, o) => sum + Number(o.vote_count), 0); %>
  <div class="card">
    <% charity.options.forEach(o => { %>
      <div class="vote-option">
        <div>
          <form method="post" action="/charity/vote" style="display:inline;">
            <input type="hidden" name="optionId" value="<%= o.id %>">
            <strong><%= o.name %></strong>
            <% if (o.description) { %><div class="muted small"><%= o.description %></div><% } %>
            <div class="vote-bar"><span style="width: <%= total ? Math.round((o.vote_count / total) * 100) : 0 %>%;"></span></div>
            <div class="muted small"><%= o.vote_count %> vote<%= o.vote_count == 1 ? '' : 's' %></div>
            <button class="btn btn-small" type="submit" style="margin-top:8px;">
              <%= charity.myOptionId === o.id ? 'Your vote' : 'Vote' %>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>

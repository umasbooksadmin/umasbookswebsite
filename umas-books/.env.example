# Copy to .env for local development. On Render, these are set as real
# env vars (DATABASE_URL and SESSION_SECRET are wired up by render.yaml).

DATABASE_URL=postgres://localhost:5432/umas_books
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# Optional, production only: the PEM contents of the production database's
# CA certificate (on Render: the database's dashboard page, under
# Connections > CA Certificate), pasted as a single env var value. When
# set, database connections verify the server's certificate against it
# instead of accepting any certificate. Not needed locally.
PGSSLROOTCERT=

# Email (password reset links) — sent via Gmail/Google Workspace SMTP.
# GMAIL_USER is the mailbox to send from (e.g. admin@umasbooks.org).
# GMAIL_APP_PASSWORD is a 16-character App Password generated in that
# Google account's Security settings (requires 2-Step Verification to be
# enabled first) — NOT the regular account password.
# If either is unset, the app logs emails to the console instead of
# sending them, so local dev works without this.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: override the base URL used in emailed reset links. On Render
# this defaults to the service's own RENDER_EXTERNAL_URL automatically.
APP_BASE_URL=

# Optional: powers the inventory "scan a photo" feature (reading a book's
# title/author/ISBN off a cover or barcode photo) via Claude's vision API.
# Get a key at https://console.anthropic.com. If unset, photo scanning is
# disabled and staff can still look up/add books by typing the ISBN.
ANTHROPIC_API_KEY=

# HelloAsso (online checkout — see src/lib/helloasso.js). Get
# HELLOASSO_CLIENT_ID/SECRET from the organization's HelloAsso account
# under Mon Compte > Intégrations et API; HELLOASSO_ORG_SLUG is the
# organization's slug from its HelloAsso page URL. If any of these are
# unset, /cart/checkout shows an "online payment isn't set up yet"
# message instead of erroring. Use the sandbox base URL while testing —
# HELLOASSO_API_BASE=https://api.helloasso-sandbox.com/v5 — against a
# separate sandbox HelloAsso account (production and sandbox credentials
# aren't interchangeable). Once live, also point the organization's
# webhook (same admin page) at <this app's URL>/webhooks/helloasso.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
HELLOASSO_API_BASE=

# Optional: where the website's Contact Us form (/contact) delivers
# messages. Defaults to admin@umasbooks.org. Sending uses the Gmail
# settings above; if those are unset the message is only logged.
CONTACT_TO=

# Copy to .env for local development. On Render the same names are real env
# vars (see render.yaml; DATABASE_URL is set BY HAND in the dashboard).
#
# This file lists EVERY variable the code reads; the full table (defaults,
# secret or not, where each is set in production) is in ARCHITECTURE.md,
# "Environment variables". A test (test/unit/envInventory.test.js) fails if a
# variable is read in src/ or scripts/ but missing here or there.
#
# REQUIRED lines are uncommented. OPTIONAL lines are commented out: remove the
# leading "# " to use one. Values here are placeholders, never real secrets.

# ---------------------------------------------------------------- REQUIRED
# Postgres connection string. Local example below.
DATABASE_URL=postgres://localhost:5432/umas_books
# Signs the session cookie. Any long random string locally.
SESSION_SECRET=change-me-to-a-long-random-string
# REQUIRED IN PRODUCTION (the boot fails without it); optional locally, where
# it falls back to a key derived from SESSION_SECRET. Encrypts admins' two-step
# secrets. Set once: changing it makes admins re-enrol.
# TOTP_ENCRYPTION_KEY=change-me-to-another-long-random-string

# ---------------------------------------------------------------- BASICS (optional)
# HTTP port (default 3000).
# PORT=3000
# development (default) or production.
# NODE_ENV=development
# "disable" for a local Postgres without TLS (any other value uses TLS, as on Render).
PGSSLMODE=disable
# Postgres pool size (default 20, allowed 2 to 50).
# DB_POOL_MAX=20
# "staging" marks the test site (render.staging.yaml). Never set locally unless testing that.
# APP_ENV=
# Staging only: the production database host the test site must never use, and
# the only mailbox the test site may send to.
# PRODUCTION_DATABASE_HOST=
# STAGING_MAIL_TO=
# true or 1 = "coming soon" preview mode (payments off, search engines kept out).
# PREVIEW_MODE=
# Number of reverse proxies in front of the app (1 to 5; default 2 in production, 1 elsewhere).
# TRUST_PROXY_HOPS=1

# In-stock books per sitemap file (default 10000, the maximum). Tests only.
# SITEMAP_BOOKS_PER_FILE=10000

# ---------------------------------------------------------------- ADDRESSES (optional)
# The public address, no trailing slash; the only base URL used on a live site
# (emailed links, payment return URLs). On Render RENDER_EXTERNAL_URL is the
# automatic fallback.
# APP_BASE_URL=https://umasbooks.org
# RENDER_EXTERNAL_URL=
# Where alert emails go (errors, emails that cannot be sent, failing background
# jobs): one address or several separated by commas. Default: CONTACT_TO, then
# admin@umasbooks.org.
# ALERT_TO=
# Where the Contact form and forum reports deliver (same format). Default admin@umasbooks.org.
# CONTACT_TO=

# ---------------------------------------------------------------- FIRST ADMIN (optional)
# Used only by `npm run seed`, to create the first admin if none exists.
# SEED_ADMIN_PASSWORD is required that first time; the email defaults to
# admin@umasbooks.org.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set SEED_SAMPLE_CONTENT to true to force sample content; SEED_STRICT to true makes a seed failure exit 1.
# SEED_SAMPLE_CONTENT=
# SEED_STRICT=

# ---------------------------------------------------------------- EMAIL (optional locally, needed in production)
# Password reset, signup verification, contact form, reservation mail, alerts,
# sent via Gmail / Google Workspace SMTP. GMAIL_USER is the mailbox to send
# from; GMAIL_APP_PASSWORD is a 16-character App Password from that Google
# account's Security settings (needs 2-Step Verification), NOT the account
# password. If either is unset, development logs emails to the console; in
# production every send FAILS so the outbox keeps and retries the message.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# One positive number overriding the shop-wide hourly cap on throttled mail kinds.
# MAIL_GLOBAL_PER_HOUR=

# ---------------------------------------------------------------- ADMIN SESSIONS / SAFETY (optional)
# Admin two-step is ignored when set to "false" in production. Local/tests only.
# ADMIN_2FA_REQUIRED=
# Admin and till accounts are signed out after this many idle hours (default 8, 0.25 to 72)
# and this many days since login (default 7, 1 to 30).
# ADMIN_SESSION_IDLE_HOURS=8
# ADMIN_SESSION_MAX_DAYS=7
# Guest sessions per IP per 10 minutes (default 60). Only for tests acting as many visitors.
# ANON_SESSION_LIMIT=
# Voids a non-admin till user may make per day (default 3).
# TILL_MAX_VOIDS_PER_DAY=3
# Seconds the admin dashboard's slow counts are cached (30 in production, 0 elsewhere).
# DASHBOARD_COUNTS_CACHE_SECONDS=
# Month the financial year starts (1 to 12, default 1); used by the accounting export.
# FISCAL_YEAR_START_MONTH=1

# ---------------------------------------------------------------- AI (optional; photo scan, descriptions, price check)
# Key from https://console.anthropic.com. Unset = photo scanning and AI text are off.
# ANTHROPIC_API_KEY=
# Sent as the anthropic-workspace-id header on those calls.
# ANTHROPIC_WORKSPACE_ID=
# Most Anthropic calls a day for ALL AI features together (default 600; 0 = AI off).
# AI_DAILY_MAX_CALLS=600
# AI online price check: 1 or true switches it on (needs ANTHROPIC_API_KEY).
# PRICING_AI=
# PRICING_AI_MODEL=
# PRICING_AI_DAILY_MAX=150

# ---------------------------------------------------------------- BOOK LOOKUP (optional)
# New York Times Books API key (best-seller / award badges).
# NYT_API_KEY=
# Raises Google Books' cap on keyless lookups.
# GOOGLE_BOOKS_API_KEY=
# ISBNdb (paid): last-resort lookup and the publisher's-price suggestion. Unset = not used.
# ISBNDB_API_KEY=
# Only https://...isbndb.com addresses are accepted.
# ISBNDB_API_BASE=
# ISBNDB_MIN_INTERVAL_MS=1000
# ISBNDB_PRICE_TIMEOUT_MS=6000
# ISBNDB_PRICE_TTL_MS=259200000
# Scan-screen speed settings (defaults in ARCHITECTURE.md).
# SCAN_LOOKUP_SOURCES=openlibrary,bnf,google,openlibrary-data,isbndb
# SCAN_LOOKUP_TIMEOUT_MS=4000
# SCAN_LOOKUP_HEDGE_MS=1500
# SCAN_LOOKUP_GRACE_MS=300
# SCAN_CACHE_TTL_MS=600000
# SCAN_NEGATIVE_TTL_MS=120000
# SCAN_COVER_WAIT_MS=1200
# SCAN_PRICE_WAIT_MS=3000
# SCAN_SLOW_LOG_MS=1500
# "off" stops all awards lookups; "off" below stops the background cover copy.
# AWARDS_LOOKUPS=
# COVER_BACKFILL=

# ---------------------------------------------------------------- HELLOASSO (optional; membership only)
# Online MEMBERSHIP payment (src/lib/helloasso.js). CLIENT_ID/SECRET come from
# the organization's HelloAsso account under Mon Compte > Integrations et API;
# ORG_SLUG is the slug in its HelloAsso page URL. Unset = the membership sync is off.
# While testing use the sandbox (separate sandbox account and credentials);
# the sandbox address is https://api.helloasso-sandbox.com/v5 (put it in HELLOASSO_API_BASE).
# Once live, point the organization's webhook at <this app's URL>/webhooks/helloasso.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
HELLOASSO_API_BASE=
# Only orders of this HelloAsso form grant membership (unset = any Membership-type form).
# HELLOASSO_MEMBERSHIP_FORM_SLUG=

# ---------------------------------------------------------------- DEVELOPER SCRIPTS (optional)
# Demo-data script (npm run demo:load), staging or localhost only.
# DEMO_ALLOW_LOCAL=1
# DEMO_CONFIRM=yes
# DEMO_PASSWORD=
# TZ is forced to Europe/Paris by the code; CI and GITHUB_OUTPUT are set by GitHub
# Actions; DEBUG_BLOBS, DUMP_FILE and DUMP_EN_FILE belong to one-off scripts in scripts/.

# GENERATED FILE: edit src/lib/configRegistry.js, then run `npm run docs:env`. A test fails if this file is stale.
#
# Copy to .env for local development. On Render the same names are real env vars (see render.yaml;
# DATABASE_URL is set BY HAND in the dashboard).
#
# This file lists EVERY variable the code reads; the full table (defaults, secret or not, where each is
# set in production) is in ARCHITECTURE.md, "Environment variables".
#
# REQUIRED lines are uncommented. OPTIONAL lines are commented out: remove the leading "# " to use one.
# Values here are placeholders, never real secrets.

# -------------------------------------------------------- REQUIRED
# Postgres connection string. Local example below.
DATABASE_URL=postgres://localhost:5432/umas_books
# Signs the session cookie. Any long random string locally.
SESSION_SECRET=change-me-to-a-long-random-string
# REQUIRED IN PRODUCTION (the boot fails without it); optional locally, where it falls back to a
# key derived from SESSION_SECRET. Encrypts admins' two-step secrets. Set once: changing it makes
# admins re-enrol.
# TOTP_ENCRYPTION_KEY=change-me-to-another-long-random-string

# ----------------------------------------------- BASICS (optional)
# production turns on startup env validation (src/lib/env.js: lists every missing required var,
# warns about disabled email/payments), secure cookies, mandatory admin 2FA, and
# src/lib/baseUrl.js requiring APP_BASE_URL/RENDER_EXTERNAL_URL. Default: development.
# NODE_ENV=development
# HTTP listen port. Default: 3000.
# PORT=3000
# "disable" for a local Postgres without TLS (any other value uses TLS, as on Render).
PGSSLMODE=disable
# Size of the Postgres connection pool (src/lib/dbConfig.js). Default: 20 (allowed 2 to 50).
# DB_POOL_MAX=20
# "staging" marks the test site (render.staging.yaml). Never set locally unless testing that.
# APP_ENV=
# The production database's host name.
# PRODUCTION_DATABASE_HOST=
# The only mailbox the test site may send to (src/lib/staging.js); required there.
# STAGING_MAIL_TO=
# true, 1, on, yes or enabled (any case) turns on preview mode: coming-soon banner, payments off,
# search engines kept out. Default: off.
# PREVIEW_MODE=
# In-stock books per /sitemap-books-N.xml file (2 URLs each, so 20,000 URLs, under the 50,000
# limit); capped at 10000. Default: 10000.
# SITEMAP_BOOKS_PER_FILE=10000
# Integer 1 to 5: reverse proxies in front of the app (Render's edge plus its internal proxy = 2;
# no Cloudflare). Default: 2 in production, 1 elsewhere.
# TRUST_PROXY_HOPS=1

# -------------------------------------------- ADDRESSES (optional)
# The public address, no trailing slash.
# APP_BASE_URL=https://umasbooks.org
# Fallback for APP_BASE_URL when that is unset.
# RENDER_EXTERNAL_URL=
# Where the Contact form and forum reports deliver; one address or several separated by commas.
# Default: admin@umasbooks.org.
# CONTACT_TO=
# Where every site alert goes (errors, failed/stuck email, failing jobs, launch warnings); comma
# separated list. Default: falls back to CONTACT_TO, then admin@umasbooks.org.
# ALERT_TO=

# ------------------------------------------ FIRST ADMIN (optional)
# Email of the first admin created by npm run seed. Default: admin@umasbooks.org.
SEED_ADMIN_EMAIL=
# Password of the first admin: required only the first time npm run seed runs (it creates the
# admin if none exists).
SEED_ADMIN_PASSWORD=
# true forces the seed to add sample content. Default: off.
# SEED_SAMPLE_CONTENT=
# true makes a seed failure exit 1 (CI). Default: off.
# SEED_STRICT=

# ------------------ EMAIL (optional locally, needed in production)
# Password reset, signup verification, contact form, reservation mail, alerts, sent via Gmail /
# Google Workspace SMTP. GMAIL_USER is the mailbox to send from; GMAIL_APP_PASSWORD is a
# 16-character App Password from that Google account's Security settings (needs 2-Step
# Verification), NOT the account password. If either is unset, development logs emails to the
# console; in production every send FAILS so the outbox keeps and retries the message.
GMAIL_USER=
# Outgoing mail (resets, verification, contact form, every alert).
GMAIL_APP_PASSWORD=
# Overrides the shop-wide hourly cap on throttled mail kinds (signup, verification, password
# reset, book requests) with one positive number. Default: per-kind caps in THROTTLE.globalPerHour
# (src/lib/outbox.js).
# MAIL_GLOBAL_PER_HOUR=

# ------------------------------ ADMIN SESSIONS / SAFETY (optional)
# false switches admin two-step off, ignored when NODE_ENV=production (src/middleware/auth.js).
# Default: required.
# ADMIN_2FA_REQUIRED=
# Admin and till accounts are signed out after this long idle (src/lib/adminSession.js; runbook
# section ab). Default: 8 (allowed 0.25 to 72).
# ADMIN_SESSION_IDLE_HOURS=8
# Admin and till accounts are signed out this long after login even if active. Default: 7 (allowed
# 1 to 30).
# ADMIN_SESSION_MAX_DAYS=7
# Stored guest sessions per IP (src/lib/anonSessionGuard.js). Default: 60 per IP per 10 minutes.
# ANON_SESSION_LIMIT=
# How long the admin dashboard's slow counts are cached; 0 turns the cache off. Default: 30 in
# production, 0 elsewhere.
# DASHBOARD_COUNTS_CACHE_SECONDS=
# Voids a non-admin till user may make per day (src/lib/till.js). Default: 3.
# TILL_MAX_VOIDS_PER_DAY=3
# Month the financial year starts, for the monthly accounting export. Default: 1.
# FISCAL_YEAR_START_MONTH=1

# ------------ AI (optional; photo scan, descriptions, price check)
# Powers photo-scan and AI book descriptions/translations/genres.
# ANTHROPIC_API_KEY=
# Optional workspace header on Anthropic calls.
# ANTHROPIC_WORKSPACE_ID=
# Most Anthropic calls a day for ALL AI features together, counted from the database
# (src/lib/aiLimits.js; runbook "AI limits"). Default: 600 (0 = AI off).
# AI_DAILY_MAX_CALLS=600
# Turns on the AI market check behind price suggestions (also needs ANTHROPIC_API_KEY). Default:
# off (on only for 1 or true).
# PRICING_AI=
# Model for the market check; must support the web search tool. Default: the description model.
# PRICING_AI_MODEL=
# Most AI market lookups a day; part of AI_DAILY_MAX_CALLS. Default: 150 (0 = off).
# PRICING_AI_DAILY_MAX=150

# ------------------------------------------ BOOK LOOKUP (optional)
# New York Times Books API key; enables verified best-seller rows.
# NYT_API_KEY=
# off (also 0, false) stops all awards lookups. Default: on.
# AWARDS_LOOKUPS=
# off stops the background job that copies covers to our own server. Default: on.
# COVER_BACKFILL=
# Higher Google Books quota for the ISBN lookup (covers from Google are not used, see the
# cover-source decision).
# GOOGLE_BOOKS_API_KEY=
# ISBNdb key (paid): last-resort book lookup and the price suggestion.
# ISBNDB_API_KEY=
# Must be an https://...isbndb.com address, else ignored with a warning (the key is never sent
# elsewhere). Default: ISBNdb's production API.
# ISBNDB_API_BASE=
# Minimum gap between ISBNdb calls (src/lib/bookSources.js). Default: 1000.
# ISBNDB_MIN_INTERVAL_MS=1000
# Timeout for one ISBNdb price call (src/lib/isbndbPrice.js). Default: 6000.
# ISBNDB_PRICE_TIMEOUT_MS=6000
# How long an ISBNdb price answer is cached. Default: 3 days.
# ISBNDB_PRICE_TTL_MS=259200000
# Most paid ISBNdb requests per Paris day (title fallback and price suggestion together), counted
# atomically in ai_daily_cap (scope isbndb, src/lib/bookSources.js). Default: 500 (0 = no paid
# calls).
# ISBNDB_DAILY_MAX_CALLS=500
# Comma list of lookup sources the scan screen uses, in order (src/lib/bookLookup.js). Default:
# openlibrary,bnf,google,openlibrary-data,isbndb.
# SCAN_LOOKUP_SOURCES=openlibrary,bnf,google,openlibrary-data,isbndb
# How long a scan lookup result is cached (src/lib/bookLookup.js). Default: 600000 (10 minutes; 0
# = off).
# SCAN_CACHE_TTL_MS=600000
# How long a "not found" is cached. Default: 120000 (2 minutes).
# SCAN_NEGATIVE_TTL_MS=120000
# The whole book lookup is given up after this long. Default: 4000.
# SCAN_LOOKUP_TIMEOUT_MS=4000
# Start the second source if the first has not answered by then. Default: 1500 (0 = off).
# SCAN_LOOKUP_HEDGE_MS=1500
# Wait for slower sources this long after the first titled result. Default: 300.
# SCAN_LOOKUP_GRACE_MS=300
# Budget for the cover copy on the Add a book screen (src/routes/admin/inventoryLookup.js).
# Default: 1200.
# SCAN_COVER_WAIT_MS=1200
# Budget for the price suggestion on the Add a book screen (src/routes/admin/inventoryLookup.js).
# Default: 3000.
# SCAN_PRICE_WAIT_MS=3000
# Log a scan lookup slower than this (src/lib/timing.js). Default: 1500 (off disables).
# SCAN_SLOW_LOG_MS=1500

# --------------------------- HELLOASSO (optional; membership only)
# Online MEMBERSHIP payment (src/lib/helloasso.js). CLIENT_ID/SECRET come from the organization's
# HelloAsso account under Mon Compte > Integrations et API; ORG_SLUG is the slug in its HelloAsso
# page URL. Unset = the membership sync is off. While testing use the sandbox (separate sandbox
# account and credentials): https://api.helloasso-sandbox.com/v5 goes in HELLOASSO_API_BASE. Once
# live, point the organization's webhook at <this app's URL>/webhooks/helloasso.
HELLOASSO_CLIENT_ID=
# HelloAsso API credentials, membership only.
HELLOASSO_CLIENT_SECRET=
# HelloAsso API credentials, membership only.
HELLOASSO_ORG_SLUG=
# HelloAsso's sandbox URL for testing. Default: production API.
HELLOASSO_API_BASE=
# Only orders of this HelloAsso form (formSlug) grant membership. Default: any Membership-type
# form.
# HELLOASSO_MEMBERSHIP_FORM_SLUG=

# ------------------------------------ DEVELOPER SCRIPTS (optional)
# Demo-data script (src/lib/demoData.js): 1 allows a run against a local database.
# DEMO_ALLOW_LOCAL=1
# Demo-data script: yes skips the --yes prompt.
# DEMO_CONFIRM=yes
# Demo-data script: the fixed password of the demo accounts (a throwaway).
# DEMO_PASSWORD=

# Not listed above on purpose: TZ, CI, GITHUB_OUTPUT, DEBUG_BLOBS, DUMP_FILE, DUMP_EN_FILE (see ARCHITECTURE.md for each).

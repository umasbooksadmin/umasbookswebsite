<%- include('partials/header', { noindex: true, title: tr('Cart', 'Panier') }) %>

<h1><%= tr('Your Cart', 'Votre panier') %></h1>

<% if (locals.notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>

<% if (locals.pendingOrders && pendingOrders.length) { %>
  <div class="card" id="pending-orders">
    <h2 class="section-title"><%= tr('Your unpaid orders', 'Vos commandes non payées') %></h2>
    <p class="muted small"><%= tr('These items are held for you for about an hour while payment is pending. Finish paying, or cancel to release them.', 'Ces articles sont mis de côté pour vous pendant environ une heure, dans l’attente du paiement. Réglez la commande, ou annulez-la pour les libérer.') %></p>
    <% pendingOrders.forEach(o => { %>
      <div class="pending-order" style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; padding:12px 0; border-top:1px solid var(--line, #e4e0d6);">
        <div>
          <div><strong><%= tr('Order', 'Commande') %> #<%= o.id %> &middot; <%= formatDateTime(o.created_at) %></strong></div>
          <ul class="plain nested">
            <% o.items.forEach(i => { %><li><%= i.label %> <span class="muted small">&middot; <%= eur(i.price) %></span></li><% }) %>
          </ul>
          <div class="muted small"><%= tr('Total:', 'Total :') %> <%= eur(o.total_amount) %></div>
          <% if (!o.can_resume) { %><div class="muted small"><%= tr('The payment page has expired: cancel this order, then add the items to your cart again.', 'La page de paiement a expiré : annulez cette commande, puis ajoutez de nouveau les articles à votre panier.') %></div><% } %>
        </div>
        <% if (o.can_resume) { %><a class="btn btn-small" href="/cart/orders/<%= o.id %>/resume"><%= tr('Resume payment', 'Reprendre le paiement') %></a><% } %>
        <form method="post" action="/cart/orders/<%= o.id %>/cancel">
          <%- include('partials/csrf_field') %>
          <button type="submit" class="btn-outline btn-small"><%= tr('Cancel this order', 'Annuler cette commande') %></button>
        </form>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>

<% if (!items.length) { %>
  <div class="card"><p class="muted"><%= tr('Your cart is empty.', 'Votre panier est vide.') %> <a href="/books.html"><%= tr('Browse books', 'Parcourez les livres') %></a> <%= tr('or', 'ou') %> <a href="/sessions"><%= tr('browse drop-in sessions', 'les séances drop-in') %></a> <%= tr('to add some.', 'pour en ajouter.') %></p></div>
<% } else { %>
  <%- include('partials/cover_note') %>
  <div class="cart-list">
    <% items.forEach(i => { %>
      <div class="cart-item">
        <% if (i.kind === 'book') { %>
          <% if (i.coverUrl) { %>
            <img src="<%= i.coverUrl %>" alt="" class="cart-item-cover" width="48" height="72" loading="lazy" decoding="async" data-cover>
          <% } else { %>
            <div class="cart-item-cover book-thumb-placeholder"><%= tr('No cover', 'Pas de couverture') %></div>
          <% } %>
          <div class="cart-item-body">
            <div class="cart-item-title"><%= i.title %></div>
            <div class="muted small"><%= i.authors || tr('Unknown author', 'Auteur inconnu') %></div>
            <div style="margin-top:4px;"><span class="condition-badge condition-<%= i.condition %>"><%= conditionLabel(i.condition) %></span></div>
          </div>
        <% } else { %>
          <div class="cart-item-cover book-thumb-placeholder"><%= tr('Session', 'Séance') %></div>
          <div class="cart-item-body">
            <div class="cart-item-title"><%= i.title %></div>
            <div class="muted small"><%= tr('Drop-in seat', 'Place drop-in') %> &middot; <%= formatDateTime(i.startsAt) %></div>
          </div>
        <% } %>
        <div class="cart-item-price"><%= eur(i.price) %></div>
        <form method="post" action="/cart/remove">
          <%- include('partials/csrf_field') %>
          <input type="hidden" name="lineId" value="<%= i.lineId %>">
          <button type="submit" class="btn-outline btn-small"><%= tr('Remove', 'Retirer') %></button>
        </form>
      </div>
    <% }) %>
  </div>

  <div class="cart-total"><%= tr('Total:', 'Total :') %> <strong><%= eur(total) %></strong></div>

  <% if (locals.preview) { %>
    <div role="status" class="notice-box"><%= tr('Online ordering opens when we launch. This is a preview, so you can fill a cart to see how it works, but nothing can be ordered yet.', 'La commande en ligne ouvrira au lancement. Ceci est un aperçu : vous pouvez remplir un panier pour voir comment cela fonctionne, mais rien ne peut encore être commandé.') %></div>
  <% } else if (locals.checkoutState === 'guest') { %>
    <div class="card" id="login-to-checkout">
      <h2 class="section-title"><%= tr('Log in or create an account to check out', 'Connectez-vous ou créez un compte pour commander') %></h2>
      <p class="muted"><%= tr('You need an account to place an order. Your cart is kept: you will come straight back here.', 'Un compte est nécessaire pour passer commande. Votre panier est conservé : vous reviendrez directement ici.') %></p>
      <p>
        <a class="btn" href="/login?returnTo=<%= encodeURIComponent('/cart') %>"><%= tr('Log in', 'Se connecter') %></a>
        <a class="btn btn-outline" href="/signup?returnTo=<%= encodeURIComponent('/cart') %>"><%= tr('Create an account', 'Créer un compte') %></a>
      </p>
    </div>
  <% } else if (locals.checkoutState === 'unconfirmed') { %>
    <div role="status" class="notice-box"><%= tr('Please confirm your email address before ordering: open the link we sent you when you signed up.', 'Veuillez confirmer votre adresse e-mail avant de commander : ouvrez le lien que nous vous avons envoyé lors de votre inscription.') %></div>
  <% } else if (!helloassoReady) { %>
    <div role="status" class="notice-box"><%= tr("Online payment isn't switched on yet — please check back soon, or come by the shop to buy in person.", "Le paiement en ligne n’est pas encore activé : revenez bientôt, ou passez à la boutique pour acheter sur place.") %></div>
  <% } else { %>
    <div class="card">
      <h2 class="section-title"><%= tr('Checkout', 'Paiement') %></h2>
      <form class="stack" method="post" action="/cart/checkout">
        <%- include('partials/csrf_field') %>
        <label for="name"><%= tr('Name', 'Nom') %></label>
        <input id="name" name="name" type="text" autocomplete="name" value="<%= locals.accountName || '' %>" required>
        <label for="accountEmail"><%= tr('Email', 'E-mail') %></label>
        <input id="accountEmail" type="email" value="<%= locals.accountEmail || '' %>" readonly aria-describedby="accountEmailHelp">
        <p class="muted small" id="accountEmailHelp"><%= tr('This is your account email: your confirmation is sent there.', 'Voici l’adresse e-mail de votre compte : votre confirmation y sera envoyée.') %></p>
        <label for="phone"><%= tr('Phone (optional)', 'Téléphone (facultatif)') %></label>
        <input id="phone" name="phone" type="tel">
        <p class="muted small"><%= tr("You'll pay securely via HelloAsso, then come by Uma's Books to pick up your order.", "Vous paierez en toute sécurité via HelloAsso, puis vous passerez à Uma's Books pour retirer votre commande.") %></p>
        <label class="ann-check"><input type="checkbox" name="acceptCgv" required> <span><%= tr('I have read and accept the', 'J’ai lu et j’accepte les') %> <a href="/terms-of-sale.html" target="_blank" rel="noopener"><%= tr('terms of sale', 'conditions de vente') %></a> <%= tr('(including the right of withdrawal).', '(y compris le droit de rétractation).') %></span></label>
        <%- include('partials/privacy_note', { en: 'We use your details only to process your order. See our', fr: 'Vos données servent uniquement à traiter votre commande. Consultez notre' }) %>
        <% if (items.some((i) => i.kind === 'dropin')) { %><%- include('partials/dropin_waiver') %><% } %>
        <button class="btn" type="submit"><%= tr('Pay & Buy', 'Commander et payer') %></button>
      </form>
    </div>
  <% } %>
<% } %>

<%- include('partials/footer') %>

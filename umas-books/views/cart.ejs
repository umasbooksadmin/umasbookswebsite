<%- include('partials/header', { title: 'Cart' }) %>

<h1>Your Cart</h1>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<% if (!items.length) { %>
  <div class="card"><p class="muted">Your cart is empty. <a href="/books.html">Browse books</a> or <a href="/sessions">browse drop-in sessions</a> to add some.</p></div>
<% } else { %>
  <div class="cart-list">
    <% items.forEach(i => { %>
      <div class="cart-item">
        <% if (i.kind === 'book') { %>
          <% if (i.coverUrl) { %>
            <img src="<%= i.coverUrl %>" alt="" class="cart-item-cover">
          <% } else { %>
            <div class="cart-item-cover book-thumb-placeholder">No cover</div>
          <% } %>
          <div class="cart-item-body">
            <div class="cart-item-title"><%= i.title %></div>
            <div class="muted small"><%= i.authors || 'Unknown author' %></div>
          </div>
        <% } else { %>
          <div class="cart-item-cover book-thumb-placeholder">Session</div>
          <div class="cart-item-body">
            <div class="cart-item-title"><%= i.title %></div>
            <div class="muted small">Drop-in seat &middot; <%= formatDateTime(i.startsAt) %></div>
          </div>
        <% } %>
        <div class="cart-item-price">&euro;<%= i.price.toFixed(2) %></div>
        <form method="post" action="/cart/remove">
          <%- include('partials/csrf_field') %>
          <input type="hidden" name="lineId" value="<%= i.lineId %>">
          <button type="submit" class="btn-outline btn-small">Remove</button>
        </form>
      </div>
    <% }) %>
  </div>

  <div class="cart-total">Total: <strong>&euro;<%= total.toFixed(2) %></strong></div>

  <% if (!helloassoReady) { %>
    <div class="notice-box">Online payment isn't switched on yet &mdash; please check back soon, or come by the shop to buy in person.</div>
  <% } else { %>
    <div class="card">
      <h2 class="section-title">Checkout</h2>
      <form class="stack" method="post" action="/cart/checkout">
        <%- include('partials/csrf_field') %>
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required>
        <label for="phone">Phone (optional)</label>
        <input id="phone" name="phone" type="tel">
        <p class="muted small">You'll pay securely via HelloAsso, then come by Uma's Books to pick up your order.</p>
        <button class="btn" type="submit">Pay &amp; Buy</button>
      </form>
    </div>
  <% } %>
<% } %>

<%- include('partials/footer') %>

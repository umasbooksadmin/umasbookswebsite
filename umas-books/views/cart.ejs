<%- include('partials/header', { noindex: true, title: tr('Cart', 'Panier') }) %>

<h1><%= tr('Your Cart', 'Votre panier') %></h1>

<% if (locals.notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>

<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>

<% if (!items.length) { %>
  <div class="card"><p class="muted"><%= tr('Your cart is empty.', 'Votre panier est vide.') %> <a href="/books.html"><%= tr('Browse books', 'Parcourez les livres') %></a> <%= tr('or', 'ou') %> <a href="/sessions"><%= tr('browse drop-in sessions', 'les séances drop-in') %></a> <%= tr('to add some.', 'pour en ajouter.') %></p></div>
<% } else { %>
  <%- include('partials/cover_note') %>
  <div class="cart-list">
    <% items.forEach(i => { %>
      <div class="cart-item">
        <% if (i.kind === 'book') { %>
          <% if (i.coverUrl) { %>
            <img src="<%= i.coverUrl %>"<% if (coverSrcset(i.coverUrl)) { %> srcset="<%= coverSrcset(i.coverUrl) %>" sizes="48px"<% } %> alt="" class="cart-item-cover" width="48" height="72" loading="lazy" decoding="async" data-cover>
          <% } else { %>
            <div class="cart-item-cover book-thumb-placeholder"><%= tr('No cover', 'Pas de couverture') %></div>
          <% } %>
          <div class="cart-item-body">
            <div class="cart-item-title"><%= i.title %></div>
            <div class="muted small"><%= i.authors || tr('Unknown author', 'Auteur inconnu') %></div>
            <div style="margin-top:4px;"><span class="condition-badge condition-<%= i.condition %>"><%= conditionLabel(i.condition) %></span></div>
          </div>
        <% } else { %>
          <div class="cart-item-cover book-thumb-placeholder"><%= tr('Session', 'Séance') %></div>
          <div class="cart-item-body">
            <% const _frTitle = lang === 'fr' && i.titleFr && String(i.titleFr).trim() ? String(i.titleFr).trim() : null; %>
            <div class="cart-item-title"<% if (lang === 'fr' && !_frTitle) { %> lang="en"<% } %>><%= _frTitle || i.title %></div>
            <div class="muted small"><%= tr('Drop-in seat', 'Place drop-in') %> &middot; <%= formatDateTime(i.startsAt) %></div>
          </div>
        <% } %>
        <div class="cart-item-price"><%= eur(i.price) %></div>
        <form method="post" action="/cart/remove">
          <%- include('partials/csrf_field') %>
          <input type="hidden" name="lineId" value="<%= i.lineId %>">
          <button type="submit" class="btn-outline btn-small"><%= tr('Remove', 'Retirer') %></button>
        </form>
      </div>
    <% }) %>
  </div>

  <div class="cart-total"><%= tr('Total:', 'Total :') %> <strong><%= eur(total) %></strong></div>
  <p class="muted small cart-vat"><%= legalText.priceLine %></p>

  <% if (locals.preview) { %>
    <div role="status" class="notice-box"><%= tr('Online reservations open when we launch. This is a preview, so you can fill a cart to see how it works, but nothing can be reserved yet.', 'Les réservations en ligne ouvriront au lancement. Ceci est un aperçu : vous pouvez remplir un panier pour voir comment cela fonctionne, mais rien ne peut encore être réservé.') %></div>
  <% } else if (locals.checkoutState === 'guest') { %>
    <div class="card" id="login-to-checkout">
      <h2 class="section-title"><%= tr('Log in or create an account to reserve', 'Connectez-vous ou créez un compte pour réserver') %></h2>
      <p class="muted"><%= tr('You need an account to reserve. Your cart is kept: you will come straight back here.', 'Un compte est nécessaire pour réserver. Votre panier est conservé : vous reviendrez directement ici.') %></p>
      <p>
        <a class="btn" href="/login?returnTo=<%= encodeURIComponent('/cart') %>"><%= tr('Log in', 'Se connecter') %></a>
        <a class="btn btn-outline" href="/signup?returnTo=<%= encodeURIComponent('/cart') %>"><%= tr('Create an account', 'Créer un compte') %></a>
      </p>
    </div>
  <% } else if (locals.checkoutState === 'unconfirmed') { %>
    <div role="status" class="notice-box"><%= tr('Please confirm your email address before reserving: open the link we sent you when you signed up.', 'Veuillez confirmer votre adresse e-mail avant de réserver : ouvrez le lien que nous vous avons envoyé lors de votre inscription.') %></div>
  <% } else { %>
    <% const hasBooks = items.some((i) => i.kind === 'book'); const hasSeats = items.some((i) => i.kind === 'dropin'); %>
    <div class="card">
      <h2 class="section-title"><%= tr('Reservation', 'Réservation') %></h2>
      <form class="stack" method="post" action="/cart/reserve">
        <%- include('partials/csrf_field') %>
        <% items.filter((i) => i.kind === 'book').forEach((i) => { %><input type="hidden" name="seenPrice_<%= i.copyId %>" value="<%= i.price.toFixed(2) %>"><% }) %>
        <label for="name"><%= tr('Name', 'Nom') %></label>
        <input id="name" name="name" type="text" autocomplete="name" value="<%= locals.accountName || '' %>" required>
        <label for="accountEmail"><%= tr('Email', 'E-mail') %></label>
        <input id="accountEmail" type="email" value="<%= locals.accountEmail || '' %>" readonly aria-describedby="accountEmailHelp">
        <p class="muted small" id="accountEmailHelp"><%= tr('This is your account email: your confirmation is sent there.', 'Voici l’adresse e-mail de votre compte : votre confirmation y sera envoyée.') %></p>
        <label for="phone"><%= tr('Phone (optional)', 'Téléphone (facultatif)') %></label>
        <input id="phone" name="phone" type="tel" value="<%= locals.typedPhone || '' %>">
        <p class="muted small reserve-note" id="nothing-paid-online"><%= legalText.nothingPaidOnline %></p>
        <% if (hasBooks) { %><p class="muted small"><%= legalText.pickupWhere %></p><% } %>
        <% if (hasSeats) { %><p class="muted small"><%= tr('Drop-in seats: you pay at the session. You can cancel a seat online until {hours} hours before it starts.', 'Places « drop-in » : vous réglez à la séance. Vous pouvez annuler une place en ligne jusqu’à {hours} heures avant le début.', { hours: limits.seatHours }) %></p><% } %>
        <label class="ann-check"><input type="checkbox" name="acceptCgv" required> <span><%= tr('I have read and accept the', 'J’ai lu et j’accepte les') %> <a href="/terms-of-sale.html" target="_blank" rel="noopener"><%= tr('terms of sale', 'conditions générales de vente (CGV)') %></a>.</span></label>
        <%- include('partials/privacy_note', { en: 'We use your details only to process your reservation. See our', fr: 'Vos données servent uniquement à traiter votre réservation. Consultez notre' }) %>
        <p class="muted small no-returns-note"><%= legalText.noReturns %> <a href="/terms-of-sale.html" target="_blank" rel="noopener"><%= tr('Terms of sale', 'Conditions de vente') %></a></p>
        <button class="btn" type="submit"><%= tr('Reserve (free, no commitment)', 'Réserver (gratuit, sans engagement)') %></button>
      </form>
    </div>
  <% } %>
<% } %>

<%- include('partials/footer') %>

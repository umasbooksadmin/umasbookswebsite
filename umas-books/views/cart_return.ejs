<%- include('partials/header', { noindex: true, title: tr('Order', 'Commande') }) %>

<% if (status === 'paid') { %>
  <div class="order-receipt">
  <h1><%= tr('Order #{n} paid', 'Commande n°{n} payée', { n: order.id }) %></h1>
  <p class="muted"><%= tr("Thank you! Your payment went through. Keep this page as proof of your order — you can print it or save it as a PDF.", 'Merci ! Votre paiement a bien été reçu. Conservez cette page comme preuve de commande : vous pouvez l’imprimer ou l’enregistrer en PDF.') %></p>
  <div class="card" id="order-summary">
    <p class="small"><strong><%= tr('Order #{n}', 'Commande n°{n}', { n: order.id }) %></strong>
      &middot; <%= tr('paid on', 'payée le') %> <%= formatDateTime(order.paid_at || order.created_at) %>
      &middot; <%= tr('Name:', 'Nom :') %> <%= order.buyer_name %></p>
    <ul class="plain">
      <% items.forEach(i => { %>
        <li><%= i.label %> <span class="muted small">&middot; <%= eur(i.price) %></span></li>
      <% }) %>
    </ul>
    <p><strong><%= tr('Total:', 'Total :') %> <%= eur(order.total_amount) %></strong></p>
    <p class="muted small"><%= tr("Uma's Books — association loi 1901, 5 rue Hippolyte Savary, 81000 Albi — admin@umasbooks.org. Pick up at the shop (Rue Peyrolière) during opening hours and show this order number.", "Uma's Books — association loi 1901, 5 rue Hippolyte Savary, 81000 Albi — admin@umasbooks.org. Retrait à la boutique (Rue Peyrolière) pendant les heures d’ouverture, en indiquant ce numéro de commande.") %></p>
  </div>
  <p class="muted small"><%= tr('A confirmation email is on its way to {email}. Come by Uma\'s Books during opening hours to pick up your order.', 'Un e-mail de confirmation vous est envoyé à l’adresse {email}. Passez à Uma\'s Books pendant les heures d’ouverture pour retirer votre commande.', { email: order.buyer_email }) %></p>
  <p class="no-print"><button type="button" class="btn" data-print><%= tr('Print this page', 'Imprimer cette page') %></button></p>
  </div>
  <script src="/print-button.js"></script>
<% } else if (status === 'pending') { %>
  <h1><%= tr('Confirming your payment…', 'Confirmation de votre paiement…') %></h1>
  <p class="muted"><%= tr("We haven't heard back from the payment provider yet. This is usually quick — refresh this page in a minute, or check your email for a confirmation.", 'Nous n’avons pas encore de réponse du prestataire de paiement. C’est généralement rapide : actualisez cette page dans une minute, ou consultez vos e-mails pour la confirmation.') %></p>
<% } else if (paymentReceivedUnfulfilled) { %>
  <h1><%= tr('We received your payment', 'Nous avons bien reçu votre paiement') %></h1>
  <p class="muted"><%= tr("Your payment came through, but we couldn't complete your order automatically. We'll contact you at {email} shortly to sort it out — there's no need to pay again.", 'Votre paiement nous est bien parvenu, mais nous n’avons pas pu finaliser votre commande automatiquement. Nous vous contacterons très bientôt à l’adresse {email} pour régler cela : inutile de payer à nouveau.', { email: order.buyer_email }) %></p>
  <p><a class="btn" href="/books.html"><%= tr('Back to Books', 'Retour aux livres') %></a></p>
<% } else { %>
  <h1><%= tr('Payment not completed', 'Paiement non abouti') %></h1>
  <p class="muted"><%= tr("Your payment didn't go through, so nothing was charged — any books are back in stock and any drop-in seats are open again for anyone else to buy.", 'Votre paiement n’a pas abouti : rien n’a donc été débité. Les livres sont de nouveau en stock et les places drop-in sont de nouveau disponibles pour tout le monde.') %></p>
  <p><a class="btn" href="/books.html"><%= tr('Back to Books', 'Retour aux livres') %></a></p>
<% } %>

<%- include('partials/footer') %>

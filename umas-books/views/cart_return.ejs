<%- include('partials/header', { title: 'Order' }) %>

<% if (status === 'paid') { %>
  <h1>Thank you!</h1>
  <p class="muted">Your payment went through &mdash; here's what you ordered:</p>
  <div class="card">
    <ul class="plain">
      <% items.forEach(i => { %>
        <li><%= i.book_title %> <span class="muted small">&middot; &euro;<%= Number(i.price).toFixed(2) %></span></li>
      <% }) %>
    </ul>
    <p><strong>Total: &euro;<%= Number(order.total_amount).toFixed(2) %></strong></p>
  </div>
  <p class="muted small">A confirmation email is on its way to <%= order.buyer_email %>. Come by Uma's Books during opening hours to pick up your order.</p>
<% } else if (status === 'pending') { %>
  <h1>Confirming your payment&hellip;</h1>
  <p class="muted">We haven't heard back from the payment provider yet. This is usually quick &mdash; refresh this page in a minute, or check your email for a confirmation.</p>
<% } else { %>
  <h1>Payment not completed</h1>
  <p class="muted">Your payment didn't go through, so nothing was charged and your books are back in stock for anyone to buy or reserve.</p>
  <p><a class="btn" href="/books">Back to Books</a></p>
<% } %>

<%- include('partials/footer') %>

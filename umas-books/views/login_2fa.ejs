<%- include('partials/header', { title: tr('Two-step verification', 'Vérification en deux étapes') }) %>

<h1><%= tr('Two-step verification', 'Vérification en deux étapes') %></h1>
<% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
<p><%= tr('Enter the 6-digit code from your authenticator app.', 'Saisissez le code à 6 chiffres de votre application d’authentification.') %></p>
<form class="stack" method="post" action="/login/2fa">
  <%- include('partials/csrf_field') %>
  <label for="code"><%= tr('Code', 'Code') %></label>
  <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" autofocus required>
  <button class="btn" type="submit"><%= tr('Verify', 'Valider') %></button>
</form>
<p class="muted small"><%= tr('Lost your phone? Enter one of your recovery codes instead (each works once).', 'Vous avez perdu votre téléphone ? Saisissez plutôt l’un de vos codes de récupération (chacun ne fonctionne qu’une fois).') %></p>
<p class="muted small"><a href="/login"><%= tr('Start over', 'Recommencer') %></a></p>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Contact Us' }) %>

<h1 class="contact-title" data-i18n="contact.t">Contact Us</h1>
<p class="muted" data-i18n="contact.intro">Questions about books, programs, events or donations? Send us a message and we'll get back to you by email.</p>

<% if (sent) { %>
  <div class="notice-box" data-i18n="contact.sent">Thank you! Your message has been sent — we'll reply by email soon.</div>
<% } %>
<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<div class="card">
  <form class="stack" method="post" action="/contact">
    <%- include('partials/csrf_field') %>
    <label for="c-name" data-i18n="contact.name">Your name</label>
    <input id="c-name" name="name" type="text" autocomplete="name" maxlength="120" required value="<%= values.name || '' %>">
    <label for="c-email" data-i18n="contact.email">Your email</label>
    <input id="c-email" name="email" type="email" autocomplete="email" maxlength="200" required value="<%= values.email || '' %>">
    <label for="c-topic" data-i18n="contact.topic">Topic</label>
    <select id="c-topic" name="topic">
      <% topics.forEach(function (t, i) { %>
        <option value="<%= t %>" data-i18n="contact.topic.<%= i %>"<%= values.topic === t ? ' selected' : '' %>><%= t %></option>
      <% }) %>
    </select>
    <label for="c-message" data-i18n="contact.message">Message</label>
    <textarea id="c-message" name="message" rows="7" maxlength="5000" required><%= values.message || '' %></textarea>
    <div class="hp" aria-hidden="true">
      <label for="c-website">Website</label>
      <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off">
    </div>
    <button class="btn" type="submit" data-i18n="contact.send">Send message</button>
  </form>
</div>

<p class="muted small"><span data-i18n="contact.or">Or email us directly at</span> <a href="mailto:admin@umasbooks.org">admin@umasbooks.org</a>.</p>

<script src="/contact-i18n.js"></script>
<%- include('partials/footer') %>

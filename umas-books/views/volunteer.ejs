<%- include('partials/header', { title: 'Volunteer Shifts' }) %>

<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>

<h1>Volunteer Shifts</h1>
<p class="muted">Sign up for a shift below. Uma's is entirely volunteer-run &mdash; every hour on the shop floor, every sorted donation, every event, is someone giving their time.</p>

<% if (myShifts.length) { %>
  <div class="card">
    <div class="section-title">My upcoming shifts</div>
    <ul class="plain">
      <% myShifts.forEach(s => { %>
        <li>
          <strong><%= s.role %></strong>
          <div class="muted small"><%= formatDateTime(s.starts_at) %> &ndash; <%= formatTime(s.ends_at) %></div>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card">
  <div class="calendar-nav">
    <div class="calendar-nav-main">
      <a class="btn btn-outline btn-small" href="/volunteer?<%= prevHref %>">&larr; Prev</a>
      <span class="month-label"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a class="btn btn-outline btn-small" href="/volunteer?<%= nextHref %>">Next &rarr;</a>
    </div>
    <div class="calendar-view-toggle">
      <a href="/volunteer" class="btn btn-outline btn-small<%= view === 'month' ? ' is-active' : '' %>">Month</a>
      <a href="/volunteer?view=week" class="btn btn-outline btn-small<%= view === 'week' ? ' is-active' : '' %>">Week</a>
    </div>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% day.items.forEach(s => { %>
              <% const full = s.signup_count >= s.capacity; const mine = mySignedUpIds.has(s.id); %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %><%= mine ? ' is-mine' : '' %>">
                <summary><%= s.role %> &middot; <%= formatTime(s.starts_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatTime(s.starts_at) %> &ndash; <%= formatTime(s.ends_at) %>
                    &middot; <%= s.signup_count %>/<%= s.capacity %> filled
                  </div>
                  <% if (s.notes) { %><div class="muted small"><%= s.notes %></div><% } %>
                  <% if (mine) { %>
                    <form method="post" action="/volunteer/<%= s.id %>/cancel?<%= qs %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-outline btn-small" type="submit">Cancel</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/volunteer/<%= s.id %>/signup?<%= qs %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-small" type="submit"<%= full ? ' disabled' : '' %>><%= full ? 'Full' : 'Sign up' %></button>
                    </form>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Sessions' }) %>

<h1>Sessions</h1>
<p class="muted">Browse upcoming sessions<% if (user) { %> and sign up below.<% } else { %> and <a href="/login">log in</a> to sign up.<% } %></p>

<div class="card">
  <div class="calendar-nav">
    <a class="btn btn-outline btn-small" href="/sessions?month=<%= prevMonth %>">&larr; Prev</a>
    <span class="month-label"><%= monthLabel %></span>
    <a class="btn btn-outline btn-small" href="/sessions?month=<%= nextMonth %>">Next &rarr;</a>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% day.items.forEach(c => { %>
              <% const full = c.capacity != null && c.signup_count >= c.capacity; %>
              <% const spotsLeft = c.capacity != null ? Math.max(0, c.capacity - c.signup_count) : null; %>
              <% const signedUp = mySignedUpClassIds.has(c.id); %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %>">
                <summary><%= c.title %> &middot; <%= formatTime(c.starts_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(c.starts_at) %><%= c.location ? ' · ' + c.location : '' %>
                    <%= spotsLeft != null ? ' · ' + spotsLeft + ' spot' + (spotsLeft === 1 ? '' : 's') + ' left' : ' · ' + c.signup_count + ' signed up' %>
                  </div>
                  <% if (c.description) { %><div class="muted small" style="margin-top:6px;"><%= c.description %></div><% } %>

                  <% if (signedUp) { %>
                    <span class="notice-box small" style="display:inline-block; margin-top:10px;">You're signed up</span>
                  <% } else if (!user) { %>
                    <div style="margin-top:10px;"><a class="btn btn-small" href="/login">Log in to sign up</a></div>
                  <% } else { %>
                    <form method="post" action="/sessions/<%= c.id %>/signup?month=<%= currentMonth %>" style="margin-top:10px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-small" type="submit"<%= full ? ' disabled' : '' %>><%= full ? 'Full' : 'Sign up' %></button>
                    </form>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: tr('Upcoming Sessions', 'Prochaines séances'), description: tr("Upcoming English immersion sessions at Uma's Books & Adventures in Albi: see the monthly or weekly calendar, including drop-in sessions booked one at a time.", 'Les prochaines séances d’immersion en anglais d’Uma’s Books & Adventures à Albi : calendrier par mois ou par semaine, dont les séances à l’unité.'), extraCss: ['/floral-calendar.css'], mainClass: view === 'week' ? 'wrap-wide' : 'wrap' }) %>

<% const typeQs = dropinOnly ? '&type=dropin' : ''; %>
<% const qs = (view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`) + typeQs; %>
<% const prevHref = (view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`) + typeQs; %>
<% const nextHref = (view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`) + typeQs; %>
<% const periodQs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const monWeeks = view === 'week' ? weeks : mondayFirstWeeks(weeks); %>

<section class="fcal-hero">
  <%- include('partials/picture', { src: '/assets/img/hero-left.png', alt: '', w: 322, h: 512, cls: 'art art-left', lazy: true }) %>
  <%- include('partials/picture', { src: '/assets/img/hero-right.png', alt: '', w: 286, h: 512, cls: 'art art-right', lazy: true }) %>
  <div class="fcal-hero-copy">
    <div class="fcal-kicker"><%= tr('English Immersion', 'Immersion en anglais') %><div class="rule"></div></div>
    <h1 class="fcal-title"><%= tr('Upcoming Sessions', 'Prochaines séances') %></h1>
    <div class="fcal-nav">
      <a href="/sessions?<%= prevHref %>" aria-label="<%= tr('Previous', 'Précédent') %>">‹</a>
      <span class="fcal-month"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a href="/sessions?<%= nextHref %>" aria-label="<%= tr('Next', 'Suivant') %>">›</a>
    </div>
    <div class="fcal-view-toggle">
      <a href="/sessions<%= dropinOnly ? '?type=dropin' : '' %>" class="<%= view === 'month' ? 'is-active' : '' %>"><%= tr('Month', 'Mois') %></a>
      <a href="/sessions?view=week<%= typeQs %>" class="<%= view === 'week' ? 'is-active' : '' %>"><%= tr('Week', 'Semaine') %></a>
    </div>
    <div class="fcal-view-toggle">
      <a href="/sessions?<%= periodQs %>" class="<%= !dropinOnly ? 'is-active' : '' %>"><%= tr('All Sessions', 'Toutes les séances') %></a>
      <a href="/sessions?<%= periodQs %>&type=dropin" class="<%= dropinOnly ? 'is-active' : '' %>"><%= tr('Drop-ins Only', 'Séances à l’unité uniquement') %></a>
    </div>
  </div>
</section>

<div class="fcal-wrap<%= view === 'week' ? ' is-week' : '' %>">
  <div class="fcal-legend">
    <span class="fcal-legend-item"><span class="fcal-legend-swatch tone-a"></span> <%= tr('Little Explorers', 'Petits Explorateurs') %></span>
    <span class="fcal-legend-item"><span class="fcal-legend-swatch tone-b"></span> Éveil</span>
    <span class="fcal-legend-item"><span class="fcal-legend-swatch tone-c"></span> <%= tr('Adventurers', 'Aventuriers') %></span>
    <span class="fcal-legend-item"><span class="fcal-legend-swatch tone-d"></span> <%= tr('Readers', 'Lecteurs') %></span>
    <span class="fcal-legend-item"><span class="fcal-legend-swatch tone-e"></span> <%= tr('Teens', 'Ados') %></span>
    <span class="fcal-legend-item"><span class="fcal-legend-swatch tone-f"></span> <%= tr('Café / Adults', 'Café / Adultes') %></span>
  </div>
  <%- include('partials/calendar_grid', { monWeeks, qs, itemPartial: 'calendar_item_session', emptyKind: 'sessions', nextUrl: '/sessions?' + nextHref }) %>
</div>

<%- include('partials/footer') %>

<%
/* Server-side form (routes/marketingForms.js): POST /volunteer-signup. res.locals.form = { values, errors, error, sent }. */
const F = locals.form || {};
const V = F.values || {};
const E = F.errors || {};
const IDS = { name: 'vol-name', email: 'vol-email', consent: 'vol-consent' };
const _esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const aria = (k, hintId) => {
  const ids = [hintId, E[k] ? IDS[k] + '-err' : null].filter(Boolean).join(' ');
  return (E[k] ? ' aria-invalid="true"' : '') + (ids ? ' aria-describedby="' + ids + '"' : '');
};
const errP = (k) => (E[k]
  ? '<p class="field-error" id="' + IDS[k] + '-err" data-i18n="form.err.' + E[k].key + '">' + _esc(formMsg('form.err.' + E[k].key)) + '</p>'
  : '');
%>
<%- include('partials/mkt_header', {
  title: "Volunteer — Uma's Books and Adventures",
  description: "Volunteer at Uma's Books in Albi: help on the shop floor, sort and shelve donations, run events or support English and French speakers. All language levels welcome.",
}) %>
  <div class="page-hero">
    <span class="kicker" data-i18n="volunteer.kicker">Get Involved</span>
    <h1 data-i18n="volunteer.title">Volunteer With Us</h1>
  </div>
  <div class="section">
    <div class="wrap-narrow">
      <div class="prose">
        <p data-i18n="volunteer.intro">Uma&#39;s is entirely volunteer-run &mdash; every hour on the shop floor, every sorted donation, every event, is someone giving their time. New volunteers, at any language level, are always welcome.</p>
      </div>
      <div class="cardlist" style="margin-top: 28px;">
        <div class="card">
          <span class="card-title" data-i18n="volunteer.shop.t">Shop Floor</span>
          <span class="card-desc" data-i18n="volunteer.shop.d">Welcome visitors and mind the till during opening hours.</span>
        </div>
        <div class="card">
          <span class="card-title" data-i18n="volunteer.sorting.t">Sorting &amp; Shelving</span>
          <span class="card-desc" data-i18n="volunteer.sorting.d">Sort donations and keep the collection organised.</span>
        </div>
        <div class="card">
          <span class="card-title" data-i18n="volunteer.events.t">Events &amp; Language Exchange</span>
          <span class="card-desc" data-i18n="volunteer.events.d">Help run book club, language exchange, or story swaps.</span>
        </div>
        <div class="card">
          <span class="card-title" data-i18n="volunteer.translation.t">Bilingual Support</span>
          <span class="card-desc" data-i18n="volunteer.translation.d">Help visitors and paperwork move smoothly between English and French.</span>
        </div>
      </div>
      <h3 class="form-title" data-i18n="volunteer.schedule.title">Shop Shifts</h3>
      <table class="scheduletable">
        <thead>
          <tr><th data-i18n="volunteer.schedule.day">Days</th><th data-i18n="volunteer.schedule.time">Time</th></tr>
        </thead>
        <tbody>
          <tr><td data-i18n="visit.hours.days">Tue &ndash; Sat</td><td data-i18n="visit.hours.time">10:00&ndash;19:00</td></tr>
        </tbody>
      </table>
      <p class="form-hint" data-i18n="volunteer.schedule.note">Shifts typically run 2&ndash;3 hours within opening hours &mdash; tell us what works for you below.</p>
      <h3 class="form-title" data-i18n="volunteer.form.title">Volunteer Sign-up</h3>
      <% if (F.sent) { %>
      <div class="form-success" id="form-sent" role="status" tabindex="-1" data-form-sent>
        <h2 data-i18n="volunteer.sent.h">Thank you, your sign-up has been sent</h2>
        <p data-i18n="volunteer.sent.p">We have received it and will get back to you soon by email.</p>
      </div>
      <% } else { %>
      <%- include('partials/form_summary', { form: F, ids: IDS, dict: pageI18nEn }) %>
      <form class="formcard" method="post" action="/volunteer-signup" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="hp-field" aria-hidden="true">
          <label for="vol-website" data-i18n="volunteer.hp">Website</label>
          <input id="vol-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="field">
          <label for="vol-name"><span data-i18n="form.name.l">Name</span> <span class="req" aria-hidden="true">*</span></label>
          <input id="vol-name" name="name" type="text" maxlength="120" autocomplete="name" required aria-required="true" value="<%= V.name || '' %>"<%- aria('name') %>>
          <%- errP('name') %>
        </div>
        <div class="field">
          <label for="vol-email"><span data-i18n="form.email.l">Email</span> <span class="req" aria-hidden="true">*</span></label>
          <input id="vol-email" name="email" type="email" maxlength="200" autocomplete="email" required aria-required="true" value="<%= V.email || '' %>"<%- aria('email') %>>
          <%- errP('email') %>
        </div>
        <div class="field">
          <label for="vol-avail" data-i18n="volunteer.form.avail.l">Availability</label>
          <input id="vol-avail" name="availability" type="text" maxlength="300" value="<%= V.availability || '' %>">
        </div>
        <div class="field">
          <label for="vol-note" data-i18n="form.note.l">Note (optional)</label>
          <p class="form-hint-inline" id="vol-note-hint"><strong data-i18n="volunteer.form.health">Do not enter health information here: tell us in person.</strong></p>
          <textarea id="vol-note" name="note" maxlength="1000" aria-describedby="vol-note-hint"><%= V.note || '' %></textarea>
        </div>
        <div class="field">
          <label class="check-row" for="vol-consent">
            <input id="vol-consent" type="checkbox" name="consent" value="1" required aria-required="true"<%= V.consent ? ' checked' : '' %><%- aria('consent') %>>
            <span><span data-i18n="volunteer.form.consent">I agree to be contacted about volunteering.</span> <span class="req" aria-hidden="true">*</span></span>
          </label>
          <%- errP('consent') %>
        </div>
        <p class="form-hint" data-i18n-html="volunteer.form.privacy">We use your details only to reply and organise volunteering. They reach us by email only (nothing is stored on the website) and are deleted from our mailbox after 12 months. See our <a href="privacy-policy.html">Privacy Policy</a>.</p>
        <button type="submit" class="btn-submit" data-i18n="volunteer.form.submit">Send Sign-up</button>
      </form>
      <% } %>
    </div>
  </div>
<%- include('partials/mkt_footer', { pageI18nEn, pageI18nFr, extraScripts: ['assets/form-errors.js'] }) %>

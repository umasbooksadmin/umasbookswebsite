<%- include('partials/mkt_header', {
  title: collectionTitle + " — Uma's Books and Adventures",
  description: collectionDescription,
  extraCss: ['assets/books.css', 'assets/collections.css'],
  activeNav: 'books',
  hideBackLink: true,
}) %>
  <div class="bk-wrap col-page">
    <p class="col-back"><a href="/books.html"><span aria-hidden="true">&larr;</span> <%= tr('Back to Browse books', 'Retour à Parcourir les livres') %></a></p>
    <section class="col-head" aria-labelledby="col-title">
      <% if (collection.icon_path) { %><%- include('../partials/picture', { src: collection.icon_path, alt: '', w: 204, h: 204, cls: 'col-head-art', lazy: false }) %><% } %>
      <h1 id="col-title"><%= collectionTitle %></h1>
      <p class="col-desc"><%= collectionDescription %></p>
    </section>

    <section class="col-books" aria-labelledby="col-books-title">
      <h2 class="col-sr" id="col-books-title"><%= tr('Books in this collection', 'Les livres de cette collection') %></h2>
      <% if (!books.length) { %>
        <div class="col-empty" role="status">
          <p><%= tr('Every book in this collection has found a new home. Come back soon, or browse the rest of our shelves.', 'Tous les livres de cette collection ont trouvé preneur. Revenez bientôt, ou parcourez le reste de nos étagères.') %></p>
          <p><a class="btn btn-outline" href="/books.html"><%= tr('Browse all books', 'Parcourir tous les livres') %></a></p>
        </div>
      <% } else { %>
        <div class="bk-grid">
          <% books.forEach(function (b) { const srcset = coverSrcset(b.cover_url); %>
          <div class="bk-book">
            <button type="button" class="favorite-toggle" data-book-id="<%= b.id %>" aria-pressed="false" aria-label="<%= tr('Add {t} to favorites', 'Ajouter {t} aux favoris', { t: b.title }) %>"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg></button>
            <a href="/books/<%= b.id %>">
              <% if (b.cover_url) { %><img class="cover" src="<%= b.cover_url %>"<% if (srcset) { %> srcset="<%= srcset %>" sizes="(max-width: 700px) 45vw, 200px"<% } %> alt="" width="200" height="300" loading="lazy" decoding="async" data-cover>
              <% } else { %><div class="cover cover-none"><%= tr('No cover', 'Pas de couverture') %></div><% } %>
              <div class="t"><%= b.title %></div>
              <% if (b.authors) { %><div class="a"><%= b.authors %></div><% } %>
              <% if (b.min_price != null) { %><div class="p"><%= eur(b.min_price) %></div><% } %>
            </a>
          </div>
          <% }) %>
        </div>
        <p class="bk-covernote"><%= tr('Cover images come from an online book library and may not show the actual condition of the copy in our shop.', 'Les couvertures proviennent d’une bibliothèque de livres en ligne et peuvent ne pas refléter l’état réel de l’exemplaire en boutique.') %></p>
      <% } %>
    </section>
  </div>
<%- include('partials/mkt_footer', { pageI18nEn: {}, pageI18nFr: {}, extraScripts: ['favorites.js'] }) %>

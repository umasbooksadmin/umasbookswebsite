<%# The words public/page-collection.js and public/ui.js draw in the browser (Show more, the status line, the cards of the next pages): the same
    words as the Browse page (views/marketing/books.ejs); test/integration/collectionResults.test.js keeps the two in step. %>
<% const collectionPageI18n = {
  en: {
    "bk.fav.add": "Add {t} to favorites",
    "bk.more": "Show more",
    "bk.status.more": "More books added to the results.",
    "bk.loading": "Loading books…",
    "bk.error": "Couldn't load books right now — try again in a moment.",
    "bk.ratelimited": "Too many searches — please wait a moment and try again.",
    "bk.nocover": "No cover",
  },
  fr: {
    "bk.fav.add": "Ajouter {t} aux favoris",
    "bk.more": "Voir plus",
    "bk.status.more": "Livres ajoutés aux résultats.",
    "bk.loading": "Chargement des livres…",
    "bk.error": "Impossible de charger les livres pour le moment — réessayez dans un instant.",
    "bk.ratelimited": "Trop de recherches : veuillez patienter un instant puis réessayer.",
    "bk.nocover": "Pas de couverture",
  },
}; %>
<%- include('partials/mkt_header', {
  title: collectionTitle + " — Uma's Books and Adventures",
  description: collectionDescription,
  extraCss: ['assets/books.css', 'assets/collections.css'],
  activeNav: 'books',
  hideBackLink: true,
}) %>
  <div class="bk-wrap col-page">
    <p class="col-back"><a href="/books.html"><span aria-hidden="true">&larr;</span> <%= tr('Back to Browse books', 'Retour à Parcourir les livres') %></a></p>
    <% if (collection.banner_path) { const bsrc = bannerSrcset(collection.banner_path); %>
    <%# Wide picture at the top: 3:1 on a computer, taller on a phone (assets/collections.css). Above the fold, so not lazy; width and height are set so nothing jumps. %>
    <div class="col-banner"><img src="<%= collection.banner_path %>"<% if (bsrc) { %> srcset="<%= bsrc %>" sizes="(max-width: 1240px) 100vw, 1176px"<% } %> alt="<%= bannerAlt %>" width="1600" height="800" decoding="async" fetchpriority="high"></div>
    <% } %>
    <%# The title and description show on every collection page (maintainer request 2026-10-27): under the banner when there is one
        (then the round button picture is left out: the banner is the picture), otherwise at the top with that picture. %>
    <section class="col-head<%= collection.banner_path ? ' col-head-under' : '' %>" aria-labelledby="col-title">
      <% if (collection.icon_path && !collection.banner_path) { %><%- include('../partials/collection_icon', { src: collection.icon_path, w: 120, h: 120, cls: 'col-head-art', lazy: false }) %><% } %>
      <h1 id="col-title"><%= collectionTitle %></h1>
      <% if (collectionDescription) { %><p class="col-desc"><%= collectionDescription %></p><% } %>
    </section>

    <%# A polite status for screen readers (text only, no counts), set by public/page-collection.js after Show more: same line as on Browse. %>
    <p class="bk-sr" id="bk-status" role="status" aria-live="polite"></p>
    <%# The list is the Browse genre results (assets/books.css .bk-results, .bk-grid, .bk-more-row, .bk-covernote; views/marketing/books.ejs has the
        same elements): the first 24 books are here, public/page-collection.js adds the next 24 with "Show more" from /api/collections/<slug>/books.
        The heading is for screen readers: the title (or the banner) above already names the collection. %>
    <section class="bk-results" id="bk-results" aria-labelledby="col-books-title" data-collection="<%= collection.slug %>"<% if (moreOffset != null) { %> data-next-offset="<%= moreOffset %>"<% } %>>
      <h2 class="col-sr" id="col-books-title"><%= tr('Books in this collection', 'Les livres de cette collection') %></h2>
      <% if (!books.length) { %>
        <div class="col-empty" role="status">
          <p><%= tr('Every book in this collection has found a new home. Come back soon, or browse the rest of our shelves.', 'Tous les livres de cette collection ont trouvé preneur. Revenez bientôt, ou parcourez le reste de nos étagères.') %></p>
          <p><a class="btn btn-outline" href="/books.html"><%= tr('Browse all books', 'Parcourir tous les livres') %></a></p>
        </div>
      <% } else { %>
        <%# Each book is the shared Browse card (partials/book_card.ejs, untouched) in a .col-item with, under it, its genre and the
            AI's reason (no label: just the sentence) (lib/collections.js bookExtras; no reason for a book added by hand, and on /fr/ only a French one).
            public/page-collection.js itemHtml draws the same markup for the books "Show more" adds. %>
        <div class="bk-grid" id="bk-results-grid"><% books.forEach(function (b) { const x = b.extras || {}; %><div class="col-item"><%- include('partials/book_card', { b }) %><% if (x.genre || x.why) { %><div class="col-more"><% if (x.genre) { %><p class="col-genre"><%= x.genre %></p><% } %><% if (x.why) { %><p class="col-why"><%= x.why %></p><% } %></div><% } %></div><% }) %></div>
        <div class="bk-more-row"><button type="button" class="btn btn-outline" id="bk-more" data-i18n="bk.more" hidden>Show more</button></div>
        <p class="bk-covernote"><%= tr('Cover images come from an online book library and may not show the actual condition of the copy in our shop.', 'Les couvertures proviennent d’une bibliothèque de livres en ligne et peuvent ne pas refléter l’état réel de l’exemplaire en boutique.') %></p>
      <% } %>
    </section>
  </div>
<%- include('partials/mkt_footer', { pageI18nEn: collectionPageI18n.en, pageI18nFr: collectionPageI18n.fr, extraScripts: ['favorites.js', '/ui.js', '/cart-add.js', '/page-collection.js'] }) %>

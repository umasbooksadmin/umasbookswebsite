<%- include('partials/mkt_header', {
  title: "English Immersion — Uma's Books and Adventures",
  description: "English Immersion at Uma's Books: stories, games, creativity and conversation, all in English, for children, teens and adults in Albi.",
  extraCss: ['assets/home.css', 'assets/immersion.css'],
  bodyClass: 'home',
  activeNav: 'programs',
}) %>
  <section class="h-hero" style="min-height:0;">
    <img class="art art-left" src="assets/img/hero-left.png" alt="">
    <img class="art art-right" src="assets/img/hero-right.png" alt="">
    <div class="imm-hero-copy">
      <h1 data-i18n="imm.hero.t">English Immersion at Uma&rsquo;s Books</h1>
      <p class="imm-script" data-i18n="imm.hero.script">Stories, games, creativity and conversation — all in English.</p>
      <p class="imm-sub" data-i18n="imm.hero.sub">For children, teens and adults in Albi.</p>
    </div>
  </section>

  <section class="imm-heading">
    <h2 data-i18n="imm.sessions.h">Find the Right Session for You</h2>
  </section>
  <section class="imm-sessions">
    <div class="imm-session-grid">
      <div class="imm-session-card tone-a">
        <h3 data-i18n="imm.s1.t">Little Explorers</h3>
        <div class="imm-rule"></div>
        <div class="age-label" data-i18n="imm.age">Age</div>
        <div class="age-range">2&ndash;3</div>
      </div>
      <div class="imm-session-card tone-b">
        <h3 data-i18n="imm.s2.t">Éveil English</h3>
        <div class="imm-rule"></div>
        <div class="age-label" data-i18n="imm.age">Age</div>
        <div class="age-range">3&ndash;5</div>
      </div>
      <div class="imm-session-card tone-c">
        <h3 data-i18n="imm.s3.t">Young Adventurers</h3>
        <div class="imm-rule"></div>
        <div class="age-label" data-i18n="imm.age">Age</div>
        <div class="age-range">5&ndash;9</div>
      </div>
      <div class="imm-session-card tone-d">
        <h3 data-i18n="imm.s4.t">Young Readers</h3>
        <div class="imm-rule"></div>
        <div class="age-label" data-i18n="imm.age">Age</div>
        <div class="age-range">9&ndash;14</div>
      </div>
      <div class="imm-session-card tone-e">
        <h3 data-i18n="imm.s5.t">Teen Literature</h3>
        <div class="imm-rule"></div>
        <div class="age-label" data-i18n="imm.age">Age</div>
        <div class="age-range">14&ndash;17</div>
      </div>
      <div class="imm-session-card tone-f">
        <h3 data-i18n="imm.s6.t">English Café</h3>
        <div class="imm-rule"></div>
        <div class="age-label" data-i18n="imm.age">Age</div>
        <div class="age-range" data-i18n="imm.adult">Adult</div>
      </div>
    </div>
  </section>

  <section class="imm-heading">
    <h2 data-i18n="imm.about.h">What is English Immersion?</h2>
  </section>
  <section class="imm-about">
    <p class="prose" data-i18n="imm.about.p">A playful, welcoming way to experience English outside the classroom. Through books, stories and creative activities, participants discover the language naturally, build confidence and develop a love of English.</p>
    <div class="imm-highlights">
      <div class="col">
        <div class="h-title" data-i18n="imm.h1.t">A Welcoming, Community-Led Program</div>
        <p class="h-text" data-i18n="imm.h1.p">A love of language, books and connection.</p>
      </div>
      <div class="col">
        <div class="h-title" data-i18n="imm.h2.t">Led by a Native English-Speaking Facilitator</div>
        <p class="h-text" data-i18n="imm.h2.p">A warm, engaging and supportive learning environment.</p>
      </div>
      <div class="col">
        <div class="h-title" data-i18n="imm.h3.t">Located in Albi</div>
        <p class="h-text" data-i18n="imm.h3.p">At Uma’s Books and Adventures, a unique space where books, community and learning meet.</p>
      </div>
    </div>
  </section>

  <section class="imm-calendar-link">
    <a class="imm-join-btn dark-green" href="/sessions"><span data-i18n="imm.cal.cta">See the full calendar: weekly &amp; drop-in</span> <span class="arrow" aria-hidden="true">&rsaquo;</span></a>
  </section>
  <section class="imm-heading">
    <h2 data-i18n="imm.join.h">Choose How You Join</h2>
  </section>
  <section class="imm-join">
    <div class="imm-join-grid">
      <div class="imm-join-card tone-green">
        <div class="kicker" data-i18n="imm.weekly.kicker">Weekly Immersion</div>
        <h3 data-i18n="imm.weekly.t">A regular place every week</h3>
        <p data-i18n="imm.weekly.p">Our weekly sessions offer a gentle, progressive way for children to learn English — a great complement to English courses or a wonderful way to start.</p>
        <div class="imm-join-meta">
          <div class="m">
            <div class="lbl" data-i18n="imm.duration.l">Duration</div>
            <div class="val" data-i18n="imm.duration.v">1 hour</div>
            <div class="note" data-i18n="imm.duration.n">per session</div>
          </div>
          <div class="m">
            <div class="lbl" data-i18n="imm.cost.l">Cost</div>
            <div class="val" data-i18n="imm.weekly.cost.v">15 €</div>
            <div class="note" data-i18n="imm.weekly.cost.n">per session, billed monthly</div>
          </div>
        </div>
        <a class="imm-join-btn dark-green" href="pre-registration.html"><span data-i18n="imm.weekly.cta">Preregister</span> <span class="arrow" aria-hidden="true">&rsaquo;</span></a>
      </div>
      <div class="imm-join-card tone-pink">
        <div class="kicker" data-i18n="imm.dropin.kicker">Drop-In Immersion</div>
        <h3 data-i18n="imm.dropin.t">Come whenever it suits you</h3>
        <p data-i18n="imm.dropin.p">Our drop-in sessions offer a relaxed and engaging way for children to experience English. Each one-hour session includes a mix of stories, games, activities and creative play — all in English.</p>
        <div class="imm-join-meta">
          <div class="m">
            <div class="lbl" data-i18n="imm.duration.l">Duration</div>
            <div class="val" data-i18n="imm.duration.v">1 hour</div>
            <div class="note" data-i18n="imm.duration.n">per session</div>
          </div>
          <div class="m">
            <div class="lbl" data-i18n="imm.cost.l">Cost</div>
            <div class="val" data-i18n="imm.dropin.cost.v">20 €</div>
            <div class="note" data-i18n="imm.dropin.cost.n">per session, prepaid</div>
          </div>
        </div>
        <a class="imm-join-btn dark-red" href="/sessions?type=dropin"><span data-i18n="imm.dropin.cta">Check upcoming sessions</span> <span class="arrow" aria-hidden="true">&rsaquo;</span></a>
      </div>
    </div>
  </section>

<%- include('partials/mkt_header', {
  title: "Books — Uma's Books and Adventures",
  description: "Browse pre-loved English books by genre or search by title, author or keyword, then pick them up at Uma's Books in Albi.",
  extraCss: ['assets/books.css', 'assets/collections.css'],
  activeNav: 'books',
}) %>
  <noscript><link rel="stylesheet" href="<%= assetUrl('/assets/books-nojs.css') %>"></noscript>
  <div class="bk-wrap">
    <section class="bk-top">
      <h1 data-i18n="bk.title">Browse books</h1>
    </section>

    <noscript>
      <section class="bk-noscript" aria-labelledby="bk-noscript-title">
        <p data-i18n-html="bk.noscript">Searching and browsing by genre need JavaScript. Here are our newest books, or <a href="/request-a-book">ask us to look out for a title</a>.</p>
        <h2 id="bk-noscript-title" data-i18n="bk.new.title">New In</h2>
        <ul class="bk-noscript-list">
          <% (typeof noscriptBooks !== 'undefined' ? noscriptBooks : []).forEach(b => { %>
          <li><a href="/books/<%= b.id %>"><%- bookText(b.title) %></a><% if (b.authors) { %> — <%- bookText(b.authors) %><% } %><% if (b.min_price != null) { %> · <%= eur(b.min_price) %><% } %></li>
          <% }) %>
        </ul>
      </section>
    </noscript>

    <div class="bk-search-row">
      <form class="bk-search" id="shop-search-form" role="search">
        <span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg></span>
        <input type="search" id="shop-search-input" data-i18n-attr="placeholder:bk.search.ph;aria-label:bk.search.label" placeholder="Search books…" aria-label="Search by title, author, keyword, or genre">
        <button type="submit" data-i18n="bk.search.submit">Search</button>
      </form>
    </div>


    <%- include('partials/collections_row', { collections: typeof collectionButtons !== 'undefined' ? collectionButtons : [], hidden: typeof collectionsHidden !== 'undefined' && collectionsHidden }) %>

    <section class="bk-new" aria-labelledby="bk-new-title"<%= (typeof newInHidden !== 'undefined' && newInHidden) ? ' hidden' : '' %>>
      <div class="bk-new-head">
        <h2 id="bk-new-title" data-i18n="bk.new.title">New In</h2>
        <span class="sub" data-i18n="bk.new.sub">Fresh arrivals, new adventures.</span>
        <button type="button" class="bk-link-btn" id="bk-new-all"><span data-i18n="bk.new.all">See All New In</span> &rarr;</button>
      </div>
      <%# Skip the New In row (up to hundreds of books) for the genres below. Visible only while it has keyboard focus (assets/books.css .bk-skip). %>
      <a class="bk-skip" href="#bk-genres-label" data-i18n="bk.skip.genres">Skip to Browse by Genre</a>
      <div class="bk-carousel">
        <button type="button" class="arrow" id="bk-new-prev" data-i18n-attr="aria-label:bk.prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4 7 12l8 8"/></svg></button>
        <button type="button" class="arrow arrow-next" id="bk-new-next" data-i18n-attr="aria-label:bk.next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 4 8 8-8 8"/></svg></button>
        <div class="bk-track" id="bk-new-track" role="region" tabindex="0" data-i18n-attr="aria-label:bk.new.region" aria-label="New In books: use the arrow keys to move along">
          <p class="muted" data-i18n="bk.loading">Loading books…</p>
        </div>
      </div>
    </section>

    <section class="bk-genres" aria-labelledby="bk-genres-label">
      <h2 class="bk-sec-title" id="bk-genres-label" data-i18n="bk.genres.label">Browse by Genre</h2>
      <div class="bk-carousel">
        <button type="button" class="arrow" id="bk-genre-prev" data-i18n-attr="aria-label:bk.genres.prev" aria-label="Previous genres"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4 7 12l8 8"/></svg></button>
        <button type="button" class="arrow arrow-next" id="bk-genre-next" data-i18n-attr="aria-label:bk.genres.next" aria-label="Next genres"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 4 8 8-8 8"/></svg></button>
        <%# The genre buttons (src/lib/browseGenres.js). public/page-books.js reads data-slug / data-topic back from here and wires the clicks. %>
        <div class="bk-track bk-tiles" id="bk-genre-list" role="group" aria-labelledby="bk-genres-label"><%
          browseGenres.forEach(function (g, i) { %><button type="button" class="bk-genre" data-index="<%= i %>" data-slug="<%= g.slug %>" data-topic="<%= g.topic %>"><span class="chip" style="background:<%= g.bg %>;color:<%= g.fg %>"><svg <%- iconAttrs %> aria-hidden="true"><%- g.svg %></svg></span><span data-i18n="<%= g.key %>"><%= pageI18nEn[g.key] %></span></button><% }) %></div>
      </div>
    </section>

    <%# A polite status for screen readers, separate from the results (an aria-live region around 24 cards re-announced them all). Text only, no counts: public/page-books.js sets it after a genre, a search or Show more. %>
    <p class="bk-sr" id="bk-status" role="status" aria-live="polite"></p>

    <section class="bk-results" id="bk-results" hidden>
      <div class="bk-results-head">
        <h2 id="bk-results-title"></h2>
      </div>
      <div class="bk-grid" id="bk-results-grid"></div>
      <div class="bk-more-row"><button type="button" class="btn btn-outline" id="bk-more" data-i18n="bk.more" hidden>Show more</button></div>
      <p class="bk-covernote" data-i18n="bk.covernote">Cover images come from an online book library and may not show the actual condition of the copy in our shop.</p>
    </section>
  </div>

  <section class="bk-band bk-band-ask">
    <div class="bk-band-row">
      <div class="bk-band-item">
        <span class="badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/><path d="M10.5 8v5M8 10.5h5"/></svg></span>
        <div>
          <h3 data-i18n="bk.band.ask.t">Can't find a book? Ask us</h3>
          <p data-i18n="bk.band.ask.d">Tell us what you are looking for and we'll email you if a copy arrives. No account needed.</p>
        </div>
        <a class="btn btn-outline" href="/request-a-book" data-i18n="bk.band.ask.cta">Ask us</a>
      </div>
    </div>
  </section>

  <section class="bk-band">
    <div class="bk-band-row">
      <div class="bk-band-item">
        <span class="badge light" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20C5 11 10 5 20 4c-.5 9-6.5 14-15 16z"/><path d="M5 20 14 11"/><path d="M9 16H6.5"/><path d="M12 13V9.5"/><path d="M12 13h3.5"/></svg></span>
        <div>
          <h3 data-i18n="bk.band.purpose.t">A Bookshop with a Bigger Purpose</h3>
          <p data-i18n="bk.band.purpose.d">All profits go back into the bookstore to fund more events, books and a local charity chosen quarterly.</p>
        </div>
      </div>
      <div class="bk-band-item">
        <span class="badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 6.5C10.2 5.2 7.6 4.5 4 4.5v14c3.6 0 6.2.7 8 2 1.8-1.3 4.4-2 8-2v-14c-3.6 0-6.2.7-8 2z"/><path d="M12 6.5v14"/></svg></span>
        <div>
          <h3 data-i18n="bk.band.donate.t">Donate Books</h3>
          <p data-i18n="bk.band.donate.d">Give your pre-loved books a new chapter. Help us grow our collection and support our community.</p>
        </div>
        <a class="btn btn-outline" href="about.html#donate" data-i18n="bk.band.donate.cta">Learn more</a>
      </div>
    </div>
  </section>
<%- include('partials/mkt_footer', {
  pageI18nEn, pageI18nFr,
  extraScripts: ['favorites.js', '/books-state.js', '/ui.js', '/carousel.js', '/page-books.js'],
}) %>

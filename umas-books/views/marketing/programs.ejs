<%- include('partials/mkt_header', {
  title: "English Programs — Uma's Books and Adventures",
  extraCss: ['assets/programs.css'],
  bodyClass: 'home',
}) %>
  <section class="pg">
    <article class="pg-col pg-weekly">
      <div class="pg-kicker" data-i18n="pg.w.kicker">Weekly program</div>
      <h1 class="pg-title" data-i18n="pg.w.t">English Immersion Program</h1>
      <div class="pg-script-row">
        <p class="pg-script" data-i18n="pg.w.script">A joyful start for curious minds.</p>
      </div>
      <p class="pg-text" data-i18n="pg.w.p1">One hour a week in a fun, friendly and supportive environment. Our English immersion program is a gentle, progressive way for children to learn English — a great complement to English courses or a wonderful way to start.</p>
      <p class="pg-text" data-i18n="pg.w.p2">Through stories, games, activities and creative play, children discover the language naturally while building confidence.</p>
      <div class="pg-info">
        <div class="pg-info-item"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.4"/></svg></span><div><div class="lbl" data-i18n="pg.loc.l">Location</div><div class="val" data-i18n="pg.loc.v">Uma’s Books and Adventures</div></div></div>
        <div class="pg-info-item"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2.2"/></svg></span><div><div class="lbl" data-i18n="pg.dur.l">Duration</div><div class="val" data-i18n="pg.dur.v">1 hour</div></div></div>
        <div class="pg-info-item"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><ellipse cx="15" cy="6" rx="5" ry="2"/><path d="M10 6v3c0 1.1 2.2 2 5 2s5-.9 5-2V6"/><path d="M10 9v3c0 1.1 2.2 2 5 2s5-.9 5-2V9"/><ellipse cx="9" cy="13" rx="5" ry="2"/><path d="M4 13v3c0 1.1 2.2 2 5 2s5-.9 5-2v-3"/><path d="M4 16v3c0 1.1 2.2 2 5 2s5-.9 5-2v-3"/></svg></span><div><div class="lbl" data-i18n="pg.cost.l">Cost</div><div class="val" data-i18n="pg.w.cost.v">15 € per session</div><div class="note" data-i18n="pg.w.cost.n">to be billed monthly</div></div></div>
      </div>
      <p class="pg-teacher"><span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="7.5" r="4"/><path d="M4 21v-1.5C4 15.4 7.6 13 12 13s8 2.4 8 6.5V21z"/></svg></span><span data-i18n="pg.teacher">Animated by a native English teacher who is also a volunteer.</span></p>
      <div class="pg-actions">
        <a class="pg-btn red" href="immersion.html"><span data-i18n="pg.w.cta1">Preregister</span> <span class="arrow" aria-hidden="true">&rsaquo;</span></a>
        <a class="pg-btn green" href="/immersion/calendar"><span data-i18n="pg.w.cta2">Check the calendar</span> <span class="arrow" aria-hidden="true">&rsaquo;</span></a>
      </div>
    </article>
    <article class="pg-col pg-dropin" id="drop-in">
      <div class="pg-kicker" data-i18n="pg.d.kicker">Flexible sessions</div>
      <h2 class="pg-title" data-i18n="pg.d.t">Drop-In Immersion Sessions</h2>
      <div class="pg-script-row">
        <p class="pg-script" data-i18n="pg.d.script">English, just for fun!</p>
      </div>
      <p class="pg-text" data-i18n="pg.d.p1">No commitment, just come and join! Our drop-in immersion classes offer a relaxed and engaging way for children to experience English.</p>
      <p class="pg-text" data-i18n="pg.d.p2">Each one-hour session includes a mix of stories, games, activities and creative play — all in English.</p>
      <div class="pg-info">
        <div class="pg-info-item"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.4"/></svg></span><div><div class="lbl" data-i18n="pg.loc.l">Location</div><div class="val" data-i18n="pg.loc.v">Uma’s Books and Adventures</div></div></div>
        <div class="pg-info-item"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2.2"/></svg></span><div><div class="lbl" data-i18n="pg.dur.l">Duration</div><div class="val" data-i18n="pg.dur.v">1 hour</div></div></div>
        <div class="pg-info-item"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><ellipse cx="15" cy="6" rx="5" ry="2"/><path d="M10 6v3c0 1.1 2.2 2 5 2s5-.9 5-2V6"/><path d="M10 9v3c0 1.1 2.2 2 5 2s5-.9 5-2V9"/><ellipse cx="9" cy="13" rx="5" ry="2"/><path d="M4 13v3c0 1.1 2.2 2 5 2s5-.9 5-2v-3"/><path d="M4 16v3c0 1.1 2.2 2 5 2s5-.9 5-2v-3"/></svg></span><div><div class="lbl" data-i18n="pg.cost.l">Cost</div><div class="val" data-i18n="pg.d.cost.v">20 € per session</div><div class="note" data-i18n="pg.d.cost.n">prepaid</div></div></div>
      </div>
      <p class="pg-teacher"><span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="7.5" r="4"/><path d="M4 21v-1.5C4 15.4 7.6 13 12 13s8 2.4 8 6.5V21z"/></svg></span><span data-i18n="pg.teacher">Animated by a native English teacher who is also a volunteer.</span></p>
      <div class="pg-actions">
        <a class="pg-btn gold wide" href="/immersion/calendar"><span data-i18n="pg.d.cta">Check upcoming sessions</span> <span class="arrow" aria-hidden="true">&rsaquo;</span></a>
      </div>
    </article>
  </section>

<%
/* Server-side form (routes/marketingForms.js, lib/marketingForms.js): POST /pre-registration.
   res.locals.form = { values, errors, error, sent }: see routes/marketingForms.js. The dictionaries are
   defined first because the error summary prints the English labels from them. */
const F = locals.form || {};
const V = { days: [], times: [], ...(F.values || {}) };
const isChild = V.who === 'child';
const E = F.errors || {};
const IDS = { who: 'preg-who', childFirst: 'preg-first', childLast: 'preg-last', birthYear: 'preg-birthyear', guardian: 'preg-guardian',
  session: 'preg-session', days: 'preg-days', times: 'preg-times', parent: 'preg-parent', email: 'preg-email', phone: 'preg-phone',
  consent: 'preg-consent' };
const _esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
// aria-invalid + aria-describedby (the error message, plus an optional hint) for one field.
const aria = (k, hintId) => {
  const ids = [hintId, E[k] ? IDS[k] + '-err' : null].filter(Boolean).join(' ');
  return (E[k] ? ' aria-invalid="true"' : '') + (ids ? ' aria-describedby="' + ids + '"' : '');
};
// A group of radios or checkboxes (a fieldset): described by its error; aria-invalid is not allowed on a group.
const ariaGroup = (k, hintId) => {
  const ids = [hintId, E[k] ? IDS[k] + '-err' : null].filter(Boolean).join(' ');
  return ids ? ' aria-describedby="' + ids + '"' : '';
};
const errP = (k) => (E[k]
  ? '<p class="field-error" id="' + IDS[k] + '-err" data-i18n="form.err.' + E[k].key + '">' + _esc(formMsg('form.err.' + E[k].key)) + '</p>'
  : '');
const SESSION_OPTIONS = [['little-explorers', 'imm.s1.t'], ['eveil-english', 'imm.s2.t'], ['young-adventurers', 'imm.s3.t'],
  ['young-readers', 'imm.s4.t'], ['teen-literature', 'imm.s5.t'], ['english-cafe', 'imm.s6.t']];
const DAY_OPTIONS = [['tue', 'preg.day.tue'], ['wed', 'preg.day.wed'], ['thu', 'preg.day.thu'], ['fri', 'preg.day.fri'], ['sat', 'preg.day.sat']];
const TIME_OPTIONS = [['morning', 'preg.time.morning'], ['earlyafternoon', 'preg.time.earlyafternoon'],
  ['lateafternoon', 'preg.time.lateafternoon'], ['evening', 'preg.time.evening']];
%>
<%- include('partials/mkt_header', {
  title: "Pre-Registration — Uma's Books and Adventures",
  description: "Pre-register for Weekly English Immersion sessions at Uma's Books in Albi: children, teens and adults.",
  extraCss: ['assets/home.css', 'assets/preregistration.css'],
  bodyClass: 'home',
  activeNav: 'programs',
}) %>
  <section class="h-hero" style="min-height:0;">
    <img class="art art-left" src="assets/img/hero-left.png" alt="">
    <img class="art art-right" src="assets/img/hero-right.png" alt="">
    <div class="preg-hero-copy">
      <h1 data-i18n="preg.hero.t">Weekly English Immersion</h1>
      <div class="preg-kicker" data-i18n="preg.hero.kicker">Pre-Registration</div>
      <hr class="preg-rule">
      <p class="preg-script" data-i18n="preg.hero.script">Stories, games, creativity and conversation — all in English.</p>
      <p class="preg-sub" data-i18n="preg.hero.sub">For children, teens and adults in Albi.</p>
    </div>
  </section>

  <div class="preg-layout">
    <div>
      <% if (F.sent) { %>
      <div class="form-success" id="form-sent" role="status" tabindex="-1" data-form-sent>
        <h2 data-i18n="preg.sent.h">Thank you, your pre-registration has been sent</h2>
        <p data-i18n="preg.sent.p">We have received it and will contact you soon with a few suggested time slots and next steps. Nothing else is needed from you for now.</p>
        <p><a class="h-btn" href="immersion.html" data-i18n="preg.sent.back">Back to English programs</a></p>
      </div>
      <% } else { %>
      <%- include('partials/form_summary', { form: F, ids: IDS, dict: pageI18nEn }) %>
      <form class="preg-form" method="post" action="/pre-registration" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="hp-field" aria-hidden="true">
          <label for="preg-website" data-i18n="preg.hp">Website</label>
          <input id="preg-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="preg-section-title"><span class="num">1.</span> <span data-i18n="preg.s0.h">Who is registering?</span></div>
        <%# Server-side validated and no-JS safe: both blocks below are always in the page; assets/preregistration.js only hides the child block for an adult. %>
        <fieldset class="preg-fieldset" id="preg-who" tabindex="-1"<%- ariaGroup('who') %>>
          <legend><span data-i18n="preg.f.who.l">Who is registering?</span> <span class="req" aria-hidden="true">*</span></legend>
          <label class="preg-check"><input type="radio" name="who" value="self"<%= V.who === 'self' ? ' checked' : '' %> aria-required="true"> <span data-i18n="preg.who.self">An adult, for themselves</span></label>
          <label class="preg-check"><input type="radio" name="who" value="child"<%= isChild ? ' checked' : '' %> aria-required="true"> <span data-i18n="preg.who.child">A parent or guardian, for a child</span></label>
          <%- errP('who') %>
        </fieldset>

        <div id="preg-child-block" class="preg-child-block" data-child-block<%= V.who === 'self' ? ' hidden' : '' %>>
        <div class="preg-section-title"><span class="num">2.</span> <span data-i18n="preg.s1.h">About the child (only if you are registering a child)</span></div>
        <div class="preg-note" data-i18n="preg.s1.note">Fill in this section only if you are registering a child. If you are registering for yourself, leave it empty.</div>
        <div class="preg-row">
          <div class="field">
            <label for="preg-first">
              <span data-i18n="preg.f.first.l">Child’s first name</span> <span class="req" aria-hidden="true">*</span>
            </label>
            <input id="preg-first" name="childFirst" type="text" maxlength="80" autocomplete="off" data-child-field<%= isChild ? ' aria-required="true"' : '' %> value="<%= V.childFirst || '' %>"<%- aria('childFirst') %>>
            <%- errP('childFirst') %>
          </div>
          <div class="field">
            <label for="preg-last">
              <span data-i18n="preg.f.last.l">Child’s last name</span> <span class="req" aria-hidden="true">*</span>
            </label>
            <input id="preg-last" name="childLast" type="text" maxlength="80" autocomplete="off" data-child-field<%= isChild ? ' aria-required="true"' : '' %> value="<%= V.childLast || '' %>"<%- aria('childLast') %>>
            <%- errP('childLast') %>
          </div>
        </div>
        <div class="field">
          <label for="preg-birthyear">
            <span data-i18n="preg.f.birthyear.l">Child’s year of birth</span> <span class="req" aria-hidden="true">*</span>
          </label>
          <p class="preg-field-hint" id="preg-birthyear-hint" data-i18n="preg.f.birthyear.hint">Four digits, for example 2017. We only ask for the year.</p>
          <input id="preg-birthyear" name="birthYear" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" data-child-field<%= isChild ? ' aria-required="true"' : '' %> value="<%= V.birthYear || '' %>"<%- aria('birthYear', 'preg-birthyear-hint') %>>
          <%- errP('birthYear') %>
        </div>
        <div class="preg-check-group">
          <label class="preg-check" for="preg-guardian">
            <input id="preg-guardian" type="checkbox" name="guardian" value="1" data-child-field<%= isChild ? ' aria-required="true"' : '' %><%= V.guardian ? ' checked' : '' %><%- aria('guardian') %>>
            <span><span data-i18n="preg.f.guardian">I am the parent or legal guardian of the child.</span> <span class="req" aria-hidden="true">*</span></span>
          </label>
          <%- errP('guardian') %>
        </div>
        </div>

        <div class="preg-section-title"><span class="num">3.</span> <span data-i18n="preg.s2.h">Session and Availability</span></div>
        <div class="field">
          <label for="preg-session">
            <span data-i18n="preg.f.session.l">Choose a session</span> <span class="req" aria-hidden="true">*</span>
          </label>
          <select id="preg-session" name="session" required aria-required="true"<%- aria('session') %>>
            <option value="" data-i18n="preg.f.session.ph">Select a session</option>
            <% SESSION_OPTIONS.forEach(function (o) { %><option value="<%= o[0] %>"<%= V.session === o[0] ? ' selected' : '' %> data-i18n="<%= o[1] %>"><%= pageI18nEn[o[1]] %></option>
            <% }) %>
          </select>
          <%- errP('session') %>
        </div>
        <div class="preg-note" data-i18n="preg.s2.note">Let us know which days and times work best for you. We will propose a couple of time slots based on your preferences and availability.</div>
        <%# Checkbox groups, not multi-select lists: no Ctrl/Cmd needed (WCAG 2.1.1, 3.3.2). %>
        <div class="preg-row">
          <fieldset class="preg-fieldset" id="preg-days" tabindex="-1"<%- ariaGroup('days', 'preg-days-hint') %>>
            <legend><span data-i18n="preg.f.days.l">Preferred day(s)</span> <span class="req" aria-hidden="true">*</span></legend>
            <p class="preg-field-hint" id="preg-days-hint" data-i18n="preg.days.hint">Tick every day that suits you.</p>
            <% DAY_OPTIONS.forEach(function (o) { %><label class="preg-check"><input type="checkbox" name="days" value="<%= o[0] %>"<%= V.days.includes(o[0]) ? ' checked' : '' %>> <span data-i18n="<%= o[1] %>"><%= pageI18nEn[o[1]] %></span></label>
            <% }) %>
            <%- errP('days') %>
          </fieldset>
          <fieldset class="preg-fieldset" id="preg-times" tabindex="-1"<%- ariaGroup('times', 'preg-times-hint') %>>
            <legend><span data-i18n="preg.f.times.l">Preferred time(s)</span> <span class="req" aria-hidden="true">*</span></legend>
            <p class="preg-field-hint" id="preg-times-hint" data-i18n="preg.times.hint">Tick every time that suits you.</p>
            <% TIME_OPTIONS.forEach(function (o) { %><label class="preg-check"><input type="checkbox" name="times" value="<%= o[0] %>"<%= V.times.includes(o[0]) ? ' checked' : '' %>> <span data-i18n="<%= o[1] %>"><%= pageI18nEn[o[1]] %></span></label>
            <% }) %>
            <%- errP('times') %>
          </fieldset>
        </div>

        <div class="preg-section-title"><span class="num">4.</span> <span data-i18n="preg.s3.h">Your Details</span></div>
        <div class="preg-note" data-i18n="preg.s3.note">The adult registering, or the parent or guardian of the child.</div>
        <div class="field">
          <label for="preg-parent">
            <span data-i18n="preg.f.parent.l">Your name</span> <span class="req" aria-hidden="true">*</span>
          </label>
          <input id="preg-parent" name="parent" type="text" maxlength="120" autocomplete="name" required aria-required="true" value="<%= V.parent || '' %>"<%- aria('parent') %>>
          <%- errP('parent') %>
        </div>
        <div class="field">
          <label for="preg-email">
            <span data-i18n="preg.f.email.l">Email address</span> <span class="req" aria-hidden="true">*</span>
          </label>
          <input id="preg-email" name="email" type="email" maxlength="200" autocomplete="email" required aria-required="true" value="<%= V.email || '' %>"<%- aria('email') %>>
          <%- errP('email') %>
        </div>
        <div class="field">
          <label for="preg-phone">
            <span data-i18n="preg.f.phone.l">Phone number</span> <span class="req" aria-hidden="true">*</span>
          </label>
          <input id="preg-phone" name="phone" type="tel" maxlength="30" autocomplete="tel" required aria-required="true" value="<%= V.phone || '' %>"<%- aria('phone') %>>
          <%- errP('phone') %>
        </div>

        <div class="preg-section-title"><span class="num">5.</span> <span data-i18n="preg.s4.h">Additional Information</span> <span class="opt" data-i18n="preg.s4.opt">(optional)</span></div>
        <div class="field">
          <label for="preg-level" data-i18n="preg.f.level.l">English experience or level</label>
          <input id="preg-level" name="level" type="text" maxlength="200" value="<%= V.level || '' %>">
        </div>
        <div class="field">
          <label for="preg-notes" data-i18n="preg.f.notes.l">Anything else you’d like to share with us? (interests, needs, etc.)</label>
          <p class="preg-health" id="preg-notes-hint"><strong data-i18n="preg.health">Do not enter health information here (allergies, medical conditions, disabilities): tell us in person.</strong></p>
          <textarea id="preg-notes" name="notes" maxlength="1000" aria-describedby="preg-notes-hint"><%= V.notes || '' %></textarea>
        </div>

        <label class="preg-check">
          <input type="checkbox" name="updates" value="1"<%= V.updates ? ' checked' : '' %>>
          <span data-i18n="preg.f.updates">I’d like to receive updates about the English Immersion program. (optional)</span>
        </label>
        <div class="preg-check-group">
          <label class="preg-check" for="preg-consent">
            <input id="preg-consent" type="checkbox" name="consent" value="1" required aria-required="true"<%= V.consent ? ' checked' : '' %><%- aria('consent') %>>
            <span><span data-i18n="preg.f.consent">I agree to be contacted about this program.</span> <span class="req" aria-hidden="true">*</span></span>
          </label>
          <%- errP('consent') %>
        </div>

        <p class="preg-form-hint preg-privacy" data-i18n-html="preg.privacy">If you are registering a child, the child’s details are provided by a parent or legal guardian and are used only to organise the activity. These forms send us an email. A copy stays in our outgoing-mail queue for up to 30 days (90 if sending failed) and in our backups (up to 2 years); then it is erased. The email is deleted from our mailbox after 12 months. See our <a href="privacy-policy.html">Privacy Policy</a>.</p>

        <button type="submit" class="preg-submit"><span data-i18n="preg.submit">Submit Pre-Registration</span> <span aria-hidden="true">&rarr;</span></button>
        <p class="preg-form-hint" data-i18n="preg.hint">We’ll be in touch by email or phone soon with a few suggested time slots and next steps.</p>
      </form>
      <% } %>
    </div>


<%
// Strings added for "becoming a member needs an account" (join form, payment
// step, "Check my membership"). Kept together here so the server-rendered
// text (mt) and the language toggle's dictionary come from one source.
const memNewEn = {
  "mem.join.h": "Become a member",
  "mem.join.p": "Tell us who you are and we create your account in one step. You then pay on the next screen, and confirm your email afterwards.",
  "mem.join.name": "Name",
  "mem.join.email": "Email",
  "mem.join.btn": "Continue to payment",
  "mem.join.terms": "By continuing you agree to our <a href=\"membership-terms.html\">membership terms</a> and <a href=\"privacy-policy.html\">privacy policy</a>.",
  "mem.join.haveAccount": "Already have an account?",
  "mem.join.login": "Log in",
  "mem.err.fields": "Please enter your name and a valid email address.",
  "mem.paid.h": "Next: pay for your membership",
  "mem.paid.emailed": "We have emailed you a link: click it after paying to confirm your address and choose your password. Your membership is attached to your account when you confirm.",
  "mem.paid.useEmail": "Use this same email on the payment form:",
  "mem.paid.haveAccount": "If you already have an account, <a href=\"/login?returnTo=%2Fmembership.html\">log in</a> first. You will come back to this page.",
  "mem.paid.other": "Use a different email",
  "mem.member.h": "You are a member",
  "mem.member.until": "You are a member until",
  "mem.member.noend": "You are a member, with no end date.",
  "mem.member.renew": "You can renew from this page during the last 30 days of your membership.",
  "mem.acct.a": "Use the same email as your account (",
  "mem.acct.b": ") so your membership is linked to it.",
  "mem.check.hint": "Already paid? Look for your payment now.",
  "mem.check.btn": "Check my membership",
  "mem.check.found": "Membership found: you are a member until",
  "mem.check.foundNoEnd": "Membership found: you are a member, with no end date.",
  "mem.check.notFoundA": "We have not found your payment yet. It can take a few minutes. Make sure you used the email",
  "mem.check.notFoundB": "on the payment form.",
  "mem.check.error": "We could not check right now. Please try again in a few minutes.",
  "mem.check.unconfirmed": "Please confirm your email address first: open the link we sent you when you signed up.",
};
const memNewFr = {
  "mem.join.h": "Devenir membre",
  "mem.join.p": "Dites-nous qui vous êtes : nous créons votre compte en une seule étape. Vous payez ensuite sur l’écran suivant, puis vous confirmez votre adresse e-mail.",
  "mem.join.name": "Nom",
  "mem.join.email": "E-mail",
  "mem.join.btn": "Continuer vers le paiement",
  "mem.join.terms": "En continuant, vous acceptez nos <a href=\"membership-terms.html\">conditions d’adhésion</a> et notre <a href=\"privacy-policy.html\">politique de confidentialité</a>.",
  "mem.join.haveAccount": "Vous avez déjà un compte ?",
  "mem.join.login": "Se connecter",
  "mem.err.fields": "Veuillez indiquer votre nom et une adresse e-mail valide.",
  "mem.paid.h": "Étape suivante : réglez votre adhésion",
  "mem.paid.emailed": "Nous vous avons envoyé un lien par e-mail : cliquez dessus après le paiement pour confirmer votre adresse et choisir votre mot de passe. Votre adhésion est rattachée à votre compte lorsque vous confirmez.",
  "mem.paid.useEmail": "Utilisez cette même adresse e-mail sur le formulaire de paiement :",
  "mem.paid.haveAccount": "Si vous avez déjà un compte, <a href=\"/login?returnTo=%2Fmembership.html\">connectez-vous</a> d’abord. Vous reviendrez sur cette page.",
  "mem.paid.other": "Utiliser une autre adresse e-mail",
  "mem.member.h": "Vous êtes membre",
  "mem.member.until": "Vous êtes membre jusqu’au",
  "mem.member.noend": "Vous êtes membre, sans date de fin.",
  "mem.member.renew": "Vous pourrez renouveler votre adhésion depuis cette page pendant les 30 derniers jours.",

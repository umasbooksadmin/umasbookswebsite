<%- include('partials/mkt_header', {
  title: "Membership — Uma's Books and Adventures",
  description: "Become a member of Uma's Books & Adventures: vote on our quarterly charity, join the discussion forum, and get access to special events.",
  extraCss: ['assets/home.css', 'assets/membership.css'],
  bodyClass: 'home',
}) %>
  <section class="h-hero" style="min-height:0;">
    <img class="art art-left" src="assets/img/hero-left.png" alt="">
    <img class="art art-right" src="assets/img/hero-right.png" alt="">
    <div class="mem-hero-copy">
      <div class="mem-kicker" data-i18n="mem.hero.kicker">Uma’s Books &amp; Adventures</div>
      <hr class="mem-rule">
      <h1 data-i18n="mem.hero.t">Membership</h1>
      <p class="mem-script" data-i18n="mem.hero.script">Become part of our community</p>
      <p class="mem-sub" data-i18n="mem.hero.sub">A simple way to support our nonprofit community, take part in what we build, and enjoy special opportunities at Uma’s Books &amp; Adventures.</p>
    </div>
  </section>

  <section class="mem-benefits-head">
    <h2 data-i18n="mem.benefits.h">Membership Benefits</h2>
  </section>
  <section class="mem-benefits">
    <div class="mem-benefit">
      <h3 data-i18n="mem.b1.t">Vote on our quarterly charity</h3>
      <p data-i18n="mem.b1.d">Help choose the organization our community supports each quarter.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b2.t">Discussion forums</h3>
      <p data-i18n="mem.b2.d">Connect with other members, share ideas, and talk about books.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b3.t">Special events</h3>
      <p data-i18n="mem.b3.d">Access member invitations and opportunities throughout the year.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b4.t">Special engagements</h3>
      <p data-i18n="mem.b4.d">Take part in selected talks, activities and community experiences.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b5.t">A free tote bag</h3>
      <p data-i18n="mem.b5.d">Collect your member tote bag from Uma’s Books &amp; Adventures. We’ll let you know when it’s ready for pickup.</p>
    </div>
  </section>

  <div class="mem-widget-wrap">
  <% if (locals.preview) { %>
    <%# Preview mode (src/lib/preview.js): no HelloAsso widget, so nobody can pay. %>
    <div class="mem-form-title" data-i18n="mem.preview.h"><%= tr('Membership opens at launch', 'L’adhésion ouvrira au lancement') %></div>
    <p class="mem-widget-note" data-i18n="mem.preview.p"><%= tr('This is a preview of Uma’s Books, so sign-up and payment are switched off for now. Come back when we open, or tell us what you think of the site.', 'Ceci est un aperçu d’Uma’s Books : l’inscription et le paiement sont désactivés pour le moment. Revenez à l’ouverture, ou dites-nous ce que vous pensez du site.') %></p>
    <p class="mem-widget-hint"><a href="/contact?topic=feedback" data-i18n="preview.link"><%= tr('Tell us what you think!', 'Dites-nous ce que vous en pensez !') %></a></p>
  <% } else { %>
    <div class="mem-form-title" data-i18n="mem.form.h">Join Uma’s Books &amp; Adventures</div>
    <p class="mem-widget-note" data-i18n-html="mem.widget.p">Sign-up and payment are handled securely by HelloAsso below. Membership lasts 12 months from your payment date and your account is activated automatically once it goes through — no need to contact us. By joining you agree to our <a href="membership-terms.html">membership terms</a> and <a href="privacy-policy.html">privacy policy</a>.</p>
    <iframe id="haWidget" title="HelloAsso membership form" allow="payment 'self' https://paymenthub.helloassopay.com https://helloasso.com" allowtransparency="true" scrolling="auto" src="https://www.helloasso.com/associations/umasbooks/adhesions/uma-s-books-memberships/widget" style="width: 100%; height: 750px; border: none;" onload="window.addEventListener('message', function(e) { const dataHeight = e.data.height; const haWidgetElement = document.getElementById('haWidget');
  if (dataHeight > parseFloat(haWidgetElement.height || 0)) { haWidgetElement.height = dataHeight + 'px';}})"></iframe>
    <p class="mem-widget-hint" data-i18n="mem.widget.hint">Already a member and just renewing? Use the same email address you use to log in here so your account updates automatically.</p>
    <p class="mem-widget-hint"><span data-i18n="mem.widget.directLabel">Having trouble with the form above?</span> <a href="https://www.helloasso.com/associations/umasbooks/adhesions/uma-s-books-memberships" target="_blank" rel="noopener" data-i18n="mem.widget.directLink">Open the membership page directly on HelloAsso</a>.</p>
  <% } %>
  </div>

const mt = (key) => (locals.lang === 'fr' ? memNewFr : memNewEn)[key];
%>
<%- include('partials/mkt_header', {
  title: "Membership — Uma's Books and Adventures",
  description: "Become a member of Uma's Books & Adventures: vote on our quarterly charity, join the discussion forum, and get access to special events.",
  extraCss: ['assets/home.css', 'assets/membership.css'],
  bodyClass: 'home',
}) %>
  <section class="h-hero" style="min-height:0;">
    <img class="art art-left" src="assets/img/hero-left.png" alt="">
    <img class="art art-right" src="assets/img/hero-right.png" alt="">
    <div class="mem-hero-copy">
      <div class="mem-kicker" data-i18n="mem.hero.kicker">Uma’s Books &amp; Adventures</div>
      <hr class="mem-rule">
      <h1 data-i18n="mem.hero.t">Membership</h1>
      <p class="mem-script" data-i18n="mem.hero.script">Become part of our community</p>
      <p class="mem-sub" data-i18n="mem.hero.sub">A simple way to support our nonprofit community, take part in what we build, and enjoy special opportunities at Uma’s Books &amp; Adventures.</p>
    </div>
  </section>

  <section class="mem-benefits-head">
    <h2 data-i18n="mem.benefits.h">Membership Benefits</h2>
  </section>
  <section class="mem-benefits">
    <div class="mem-benefit">
      <h3 data-i18n="mem.b1.t">Vote on our quarterly charity</h3>
      <p data-i18n="mem.b1.d">Help choose the organization our community supports each quarter.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b2.t">Discussion forums</h3>
      <p data-i18n="mem.b2.d">Connect with other members, share ideas, and talk about books.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b3.t">Special events</h3>
      <p data-i18n="mem.b3.d">Access member invitations and opportunities throughout the year.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b4.t">Special engagements</h3>
      <p data-i18n="mem.b4.d">Take part in selected talks, activities and community experiences.</p>
    </div>
    <div class="mem-benefit">
      <h3 data-i18n="mem.b5.t">A free tote bag</h3>
      <p data-i18n="mem.b5.d">Collect your member tote bag from Uma’s Books &amp; Adventures. We’ll let you know when it’s ready for pickup.</p>
    </div>
  </section>

  <div class="mem-widget-wrap">
  <% if (locals.preview) { %>
    <%# Preview mode (src/lib/preview.js): no HelloAsso widget and no join form, so nobody can pay or sign up here. %>
    <div class="mem-form-title" data-i18n="mem.preview.h"><%= tr('Membership opens at launch', 'L’adhésion ouvrira au lancement') %></div>
    <p class="mem-widget-note" data-i18n="mem.preview.p"><%= tr('This is a preview of Uma’s Books, so sign-up and payment are switched off for now. Come back when we open, or tell us what you think of the site.', 'Ceci est un aperçu d’Uma’s Books : l’inscription et le paiement sont désactivés pour le moment. Revenez à l’ouverture, ou dites-nous ce que vous pensez du site.') %></p>
    <p class="mem-widget-hint"><a href="/contact?topic=feedback" data-i18n="preview.link"><%= tr('Tell us what you think!', 'Dites-nous ce que vous en pensez !') %></a></p>
  <% } else { %>
    <%
      // memState (src/lib/membershipPage.js): guest = not logged in, no join
      // started; joined = a guest has just filled the join form (account created,
      // confirmation email sent) and now pays; form = logged-in account holder
      // who is not (or no longer) a current member; member = current member.
      const memState = locals.memState || 'guest';
      const flash = locals.memFlash || null;
    %>
    <% if (flash && flash.error) { %><div role="alert" class="error-box" data-i18n="mem.err.fields"><%= mt('mem.err.fields') %></div><% } %>
    <% if (flash && flash.check === 'found') { %>
      <div role="status" class="notice-box">
        <% if (locals.memExpires) { %><span data-i18n="mem.check.found"><%= mt('mem.check.found') %></span> <strong><%= locals.memExpires %></strong>.<% } else { %><span data-i18n="mem.check.foundNoEnd"><%= mt('mem.check.foundNoEnd') %></span><% } %>
      </div>
    <% } else if (flash && flash.check === 'notfound') { %>
      <div role="status" class="notice-box"><span data-i18n="mem.check.notFoundA"><%= mt('mem.check.notFoundA') %></span> <strong><%= locals.memEmail %></strong> <span data-i18n="mem.check.notFoundB"><%= mt('mem.check.notFoundB') %></span></div>
    <% } else if (flash && flash.check === 'error') { %>
      <div role="alert" class="error-box" data-i18n="mem.check.error"><%= mt('mem.check.error') %></div>
    <% } else if (flash && flash.check === 'unconfirmed') { %>
      <div role="alert" class="error-box" data-i18n="mem.check.unconfirmed"><%= mt('mem.check.unconfirmed') %></div>
    <% } %>

    <% if (memState === 'member') { %>
      <div class="mem-form-title" data-i18n="mem.member.h"><%= mt('mem.member.h') %></div>
      <% if (locals.memExpires) { %>
        <p class="mem-widget-note"><span data-i18n="mem.member.until"><%= mt('mem.member.until') %></span> <strong><%= locals.memExpires %></strong>.</p>
      <% } else { %>
        <p class="mem-widget-note" data-i18n="mem.member.noend"><%= mt('mem.member.noend') %></p>
      <% } %>
      <p class="mem-widget-hint" data-i18n="mem.member.renew"><%= mt('mem.member.renew') %></p>
    <% } else if (memState === 'guest') { %>
      <%# Not logged in, no join started: the HelloAsso widget is NOT in the page. One short form creates the account (same logic as /signup) and leads to payment. %>
      <div class="mem-form-title" data-i18n="mem.join.h"><%= mt('mem.join.h') %></div>
      <p class="mem-widget-note" data-i18n="mem.join.p"><%= mt('mem.join.p') %></p>
      <form class="mem-form" method="post" action="/membership/join">
        <%- include('../partials/csrf_field') %>
        <div class="field">
          <label for="memName" data-i18n="mem.join.name"><%= mt('mem.join.name') %></label>
          <input id="memName" name="displayName" type="text" autocomplete="name" maxlength="100" value="<%= flash && flash.name ? flash.name : '' %>" required>
        </div>
        <div class="field">
          <label for="memEmail" data-i18n="mem.join.email"><%= mt('mem.join.email') %></label>
          <input id="memEmail" name="email" type="email" autocomplete="email" maxlength="200" value="<%= flash && flash.email ? flash.email : '' %>" required>
        </div>
        <button class="btn btn-maroon" type="submit" data-i18n="mem.join.btn"><%= mt('mem.join.btn') %></button>
        <p class="mem-widget-hint" data-i18n-html="mem.join.terms"><%- mt('mem.join.terms') %></p>
      </form>
      <p class="mem-widget-hint"><span data-i18n="mem.join.haveAccount"><%= mt('mem.join.haveAccount') %></span> <a href="/login?returnTo=<%= encodeURIComponent('/membership.html') %>" data-i18n="mem.join.login"><%= mt('mem.join.login') %></a></p>
    <% } else { %>
      <% if (memState === 'joined') { %>
        <div class="mem-form-title" data-i18n="mem.paid.h"><%= mt('mem.paid.h') %></div>
        <p class="mem-widget-note" data-i18n="mem.paid.emailed"><%= mt('mem.paid.emailed') %></p>
        <p class="mem-widget-note" id="memJoinedEmail"><span data-i18n="mem.paid.useEmail"><%= mt('mem.paid.useEmail') %></span> <strong><%= locals.memEmail %></strong></p>
        <p class="mem-widget-hint" data-i18n-html="mem.paid.haveAccount"><%- mt('mem.paid.haveAccount') %></p>
        <form method="post" action="/membership/join/reset">
          <%- include('../partials/csrf_field') %>
          <button class="btn btn-outline" type="submit" data-i18n="mem.paid.other"><%= mt('mem.paid.other') %></button>
        </form>
      <% } else { %>
        <div class="mem-form-title" data-i18n="mem.form.h">Join Uma’s Books &amp; Adventures</div>
        <%# Logged in: ONLY the payment form (never a signup form): they become a member on their existing account. %>
        <p class="mem-widget-note" id="memAccountEmail"><span data-i18n="mem.acct.a"><%= mt('mem.acct.a') %></span><strong><%= locals.memEmail %></strong><span data-i18n="mem.acct.b"><%= mt('mem.acct.b') %></span></p>
      <% } %>
      <p class="mem-widget-note" data-i18n-html="mem.widget.p">Sign-up and payment are handled securely by HelloAsso below. Membership lasts 12 months from your payment date and your account is activated automatically once it goes through — no need to contact us. By joining you agree to our <a href="membership-terms.html">membership terms</a> and <a href="privacy-policy.html">privacy policy</a>.</p>
      <iframe id="haWidget" title="HelloAsso membership form" allow="payment 'self' https://paymenthub.helloassopay.com https://helloasso.com" allowtransparency="true" scrolling="auto" src="https://www.helloasso.com/associations/umasbooks/adhesions/uma-s-books-memberships/widget" style="width: 100%; height: 750px; border: none;" onload="window.addEventListener('message', function(e) { const dataHeight = e.data.height; const haWidgetElement = document.getElementById('haWidget');
  if (dataHeight > parseFloat(haWidgetElement.height || 0)) { haWidgetElement.height = dataHeight + 'px';}})"></iframe>
      <% if (memState === 'form') { %>
        <form method="post" action="/membership/check" class="mem-check">
          <%- include('../partials/csrf_field') %>
          <p class="mem-widget-hint" data-i18n="mem.check.hint"><%= mt('mem.check.hint') %></p>
          <button class="btn btn-outline" type="submit" data-i18n="mem.check.btn"><%= mt('mem.check.btn') %></button>
        </form>
      <% } %>
      <p class="mem-widget-hint" data-i18n="mem.widget.hint">Already a member and just renewing? Use the same email address you use to log in here so your account updates automatically.</p>
      <p class="mem-widget-hint"><span data-i18n="mem.widget.directLabel">Having trouble with the form above?</span> <a href="https://www.helloasso.com/associations/umasbooks/adhesions/uma-s-books-memberships" target="_blank" rel="noopener" data-i18n="mem.widget.directLink">Open the membership page directly on HelloAsso</a>.</p>
    <% } %>
  <% } %>
  </div>

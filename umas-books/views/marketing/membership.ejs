  "mem.acct.b": ") pour que votre adhésion y soit rattachée.",
  "mem.check.hint": "Vous avez déjà payé ? Recherchez votre paiement maintenant.",
  "mem.check.btn": "Vérifier mon adhésion",
  "mem.check.found": "Adhésion trouvée : vous êtes membre jusqu’au",
  "mem.check.foundNoEnd": "Adhésion trouvée : vous êtes membre, sans date de fin.",

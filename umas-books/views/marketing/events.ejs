<%- include('partials/mkt_header', {
  title: "Events — Uma's Books and Adventures",
  description: "Book clubs, author talks, storytime and cultural events at Uma's Books in Albi. See what is coming up and sign up.",
  extraCss: ['assets/home.css', 'assets/events.css'],
  bodyClass: 'home home-fit fit-screen',
  activeNav: 'events',
}) %>
  <section class="h-hero">
    <%- include('../partials/picture', { src: '/assets/img/hero-left.png', alt: '', w: 322, h: 512, cls: 'art art-left' }) %>
    <%- include('../partials/picture', { src: '/assets/img/hero-right.png', alt: '', w: 286, h: 512, cls: 'art art-right' }) %>
    <div class="h-hero-copy">
      <h1 class="ev-hero-h1" data-i18n-html="ev.hero.h1"><span class="line">Adventures</span> <span class="line"><span class="amp">&amp;</span> Events</span></h1>
      <div class="rule"></div>
      <p class="tagline" data-i18n-html="ev.hero.tagline">Book clubs, author talks <br>&amp; storytime in Albi</p>
    </div>
  </section>

  <section class="h-cards">
    <article class="h-card">
      <img class="medallion" src="assets/img/medallion-browse.png" alt="">
      <h2 data-i18n="ev.clubs.t">Book Clubs</h2>
      <div class="divider"></div>
      <p data-i18n="ev.clubs.d">Read along with fellow book lovers and talk it all over — in English, over tea.</p>
    </article>

    <article class="h-card gold">
      <img class="medallion" src="assets/img/medallion-donate.png" alt="">
      <h2 data-i18n="ev.talks.t">Author Talks</h2>
      <div class="divider"></div>
      <p data-i18n="ev.talks.d">Meet writers, translators and storytellers, and hear how their books came to life.</p>
    </article>

    <article class="h-card green">
      <img class="medallion" src="assets/img/medallion-eveil.png" alt="">
      <h2 data-i18n="ev.story.t">Storytime</h2>
      <span class="subtitle" data-i18n="ev.story.sub">For little readers</span>
      <div class="divider"></div>
      <p data-i18n="ev.story.d">Picture books, songs and rhymes read aloud in English for children and families.</p>
    </article>

    <article class="h-card">
      <img class="medallion" src="assets/img/medallion-events.png" alt="">
      <h2 data-i18n="ev.culture.t">Cultural Events</h2>
      <div class="divider"></div>
      <p data-i18n="ev.culture.d">Language exchanges, seasonal celebrations and gatherings for the whole community.</p>
    </article>
  </section>

  <section class="ev-schedule" id="schedule" aria-labelledby="ev-schedule-title">
    <div class="ev-head">
      <h2 id="ev-schedule-title" data-i18n="ev.schedule.t">Upcoming</h2>
      <div class="divider"></div>
      <p data-i18n="ev.schedule.d">Everyone is welcome. Sign up so we know how many chairs to put out.</p>
    </div>
    <div class="ev-list" id="events-schedule">
      <p class="ev-empty" data-i18n="events.loading">Loading the schedule…</p>
    </div>
    <div class="ev-more">
      <a class="h-btn h-btn-outline" href="/events"><span data-i18n="ev.calendar">View the full calendar</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <section class="member-band member-row">
    <div class="about-card">
      <h2 data-i18n="ev.about.t">Share an adventure</h2>
      <div class="divider"></div>
      <p data-i18n="ev.about.d">Uma’s is a community space. If you’d like to run a book club, give a talk or host a workshop, we’d love to hear your idea.</p>
      <a class="h-btn" href="mailto:admin@umasbooks.org?subject=Event%20idea"><span data-i18n="ev.about.cta">Suggest an event</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <img class="sprig" src="assets/img/sprig.png" alt="">
    </div>
    <%- include('partials/mkt_member_band') %>
  </section>

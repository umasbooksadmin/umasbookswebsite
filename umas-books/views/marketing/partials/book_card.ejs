<%# The Browse book card, drawn on the server. Params: b = { id, title, authors, cover_url, min_price }. It must stay the same HTML as
    UmasUI.bookCardHtml(book, true) in public/ui.js, which draws the Browse results and "Show more" pages in the browser: test/unit/uiHelpers.test.js
    renders this file and compares it with the browser card. Kept on single lines so no whitespace is added between the tags. -%>
<% const srcset = coverSrcset(b.cover_url); -%><div class="bk-book"><%- include('../../partials/favorite_button', { id: b.id, title: b.title }).trim() %><a href="/books/<%= b.id %>"><% if (b.cover_url) { %><img class="cover" src="<%= b.cover_url %>"<% if (srcset) { %> srcset="<%= srcset %>" sizes="(max-width: 700px) 45vw, 200px"<% } %> alt="" width="200" height="300" loading="lazy" decoding="async" data-cover><% } else { %><div class="cover cover-none" aria-hidden="true"><%= tr('No cover', 'Pas de couverture') %></div><% } %><div class="t"><%- bookText(b.title) %></div><% if (b.authors) { %><div class="a"><%- bookText(b.authors) %></div><% } %><% if (b.min_price != null) { %><div class="p"><%= eur(b.min_price) %></div><% } %></a></div>
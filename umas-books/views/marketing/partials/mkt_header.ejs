<%
/* Shared <head>/<header> for every marketing page (views/marketing/*.ejs).
   Params: title (required), description (optional meta), extraCss
   (array of extra stylesheet hrefs, e.g. ['assets/home.css']), bodyClass
   (optional, e.g. 'home home-fit fit-screen'), activeNav (one of
   'home'|'books'|'programs'|'events', or omitted for none), hideBackLink
   (every page shows a "← Back" link above <main> except the homepage),
   jsonLd (optional object, emitted as an application/ld+json block).
   Locals set by the marketing routes in src/index.js (res.locals):
   siteUrl (absolute base URL, '' when it can't be determined) and
   canonicalPath (this page's path, e.g. '/about.html'). */
const _siteUrl = (typeof siteUrl !== 'undefined' && siteUrl) ? String(siteUrl).replace(/\/+$/, '') : '';
const _path = (typeof canonicalPath !== 'undefined' && canonicalPath) ? canonicalPath : '/';
const _desc = (typeof description !== 'undefined' && description)
  ? description
  : "Uma's Books & Adventures — a community English bookshop in Albi, France.";
const _pageUrl = _siteUrl ? _siteUrl + _path : '';
const _ogImage = _siteUrl ? _siteUrl + '/assets/img/logo-stamp-1280x720.png' : '';
const nav = [
  { key: 'home', href: '/', i18n: 'nav.home', label: 'Home' },
  { key: 'books', href: 'books.html', i18n: 'nav.books', label: 'Browse Books' },
  { key: 'programs', href: 'immersion.html', i18n: 'nav.programs', label: 'English Programs' },
  // Straight to the live calendar from inside the app (partials/header.ejs);
  // from here, a logged-out visitor sees the marketing teaser page first.
  { key: 'events', href: 'events.html', i18n: 'nav.events', label: 'Events' },
];
%>
<!doctype html>
<html lang="<%= typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : 'en' %>" data-theme="light">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="<%= _desc %>">
<% if (_pageUrl) { %><link rel="canonical" href="<%= _pageUrl %>">
<% } %><meta property="og:site_name" content="Uma's Books &amp; Adventures">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_GB">
<meta property="og:locale:alternate" content="fr_FR">
<% if (_pageUrl) { %><meta property="og:url" content="<%= _pageUrl %>">
<% } %><% if (_ogImage) { %><meta property="og:image" content="<%= _ogImage %>">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="720">
<meta property="og:image:alt" content="Uma's Books &amp; Adventures">
<% } %><meta name="twitter:card" content="<%= _ogImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= _desc %>">
<% if (_ogImage) { %><meta name="twitter:image" content="<%= _ogImage %>">
<% } %><link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
<% } %><link rel="stylesheet" href="assets/site.css">
<link rel="stylesheet" href="site-header.css">
<% (typeof extraCss !== 'undefined' ? extraCss : []).forEach(href => { %><link rel="stylesheet" href="<%= href %>"><% }) %>
</head>
<body<%- typeof bodyClass !== 'undefined' && bodyClass ? ' class="' + bodyClass + '"' : '' %>>
<a class="skip-link" href="#main-content">Skip to main content</a>

<%- include('../../partials/mkt_chrome_header', { nav, activeNav: typeof activeNav !== 'undefined' ? activeNav : undefined }) %>
<% if (typeof hideBackLink === 'undefined' || !hideBackLink) { %>
<div class="site-back-bar"><a href="#" class="site-back-link">&larr; Back</a></div>
<% } %>
<main id="main-content" tabindex="-1">

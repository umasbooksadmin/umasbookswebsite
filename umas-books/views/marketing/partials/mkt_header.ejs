<%
/* Shared <head>/<header> for every marketing page (views/marketing/*.ejs).
   Params: title (required), description (optional meta), extraCss
   (array of extra stylesheet hrefs, e.g. ['assets/home.css']), bodyClass
   (optional, e.g. 'home home-fit fit-screen'), activeNav (one of
   'home'|'books'|'programs'|'events', or omitted for none), hideBackLink
   (every page shows a "← Back" link above <main> except the homepage),
   jsonLd (optional object, emitted as an application/ld+json block),
   ogType ('website' by default; 'article' for a blog post), ogImage (absolute URL of the share picture, default the
   logo stamp), ogLocale (default from the page's language; a post shown in English on a French page says en_GB),
   metaProps (optional [{property, content}] extra <meta property> tags, e.g. article:published_time),
   robots (optional meta robots value, e.g. 'noindex, nofollow' for an admin's preview of a draft).
   Locals set by the marketing routes in src/index.js (res.locals):
   siteUrl (absolute base URL, '' when it can't be determined) and
   canonicalPath (this page's path, e.g. '/about.html'). */
// The server renders the chosen language (lib/pageDictionary.js fills the data-i18n
// hooks below from the page's FR dictionary: meta.title, meta.description).
const _isFr = typeof lang !== 'undefined' && lang === 'fr';
const _siteUrl = (typeof siteUrl !== 'undefined' && siteUrl) ? String(siteUrl).replace(/\/+$/, '') : '';
const _path = (typeof canonicalPath !== 'undefined' && canonicalPath) ? canonicalPath : '/';
const _desc = (typeof description !== 'undefined' && description)
  ? description
  : "Uma's Books & Adventures — a community English bookshop in Albi, France.";
// Canonical URL in THIS page's language + hreflang alternates (lib/frUrls.js, via the seoUrls local).
const _seo = typeof locals.seoUrls === 'function' ? locals.seoUrls() : null;
const _pageUrl = _seo ? _seo.canonical : (_siteUrl ? _siteUrl + _path : '');
const _alternates = _seo ? _seo.alternates : (_pageUrl ? [{ hreflang: 'x-default', href: _pageUrl }] : []);
const _customOg = typeof ogImage !== 'undefined' && ogImage ? ogImage : '';
const _ogImage = _customOg || (_siteUrl ? _siteUrl + '/assets/img/logo-stamp-1280x720.png' : '');
const _ogLocale = typeof ogLocale !== 'undefined' && ogLocale ? ogLocale : (_isFr ? 'fr_FR' : 'en_GB');
// Absolute paths: the header also renders on nested pages (/collections/<slug>), where a relative 'books.html'
// would resolve to /collections/books.html (404). French pages gain /fr via prefixLinks (lib/frUrls.js).
const nav = [
  { key: 'home', href: '/', i18n: 'nav.home', label: 'Home' },
  { key: 'books', href: '/books.html', i18n: 'nav.books', label: 'Browse Books' },
  { key: 'programs', href: '/immersion.html', i18n: 'nav.programs', label: 'English Programs' },
  // Straight to the live calendar from inside the app (partials/header.ejs);
  // from here, a guest sees the marketing teaser page first.
  { key: 'events', href: '/events.html', i18n: 'nav.events', label: 'Events' },
];
%>
<!doctype html>
<html lang="<%= typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : 'en' %>" data-theme="light">
<head>
<meta charset="utf-8">
<title data-i18n="meta.title"><%= title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light">
<meta name="description" content="<%= _desc %>" data-i18n-attr="content:meta.description">
<% if (locals.preview || locals.staging) { %><meta name="robots" content="noindex, nofollow">
<% } else if (typeof robots !== 'undefined' && robots) { %><meta name="robots" content="<%= robots %>">
<% } %>
<% if (_pageUrl) { %><link rel="canonical" href="<%= _pageUrl %>">
<% _alternates.forEach(a => { %><link rel="alternate" hreflang="<%= a.hreflang %>" href="<%= a.href %>">
<% }) %><% } %><meta property="og:site_name" content="Uma's Books &amp; Adventures">
<meta property="og:title" content="<%= title %>" data-i18n-attr="content:meta.title">
<meta property="og:description" content="<%= _desc %>" data-i18n-attr="content:meta.description">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
<meta property="og:locale" content="<%= _ogLocale %>">
<meta property="og:locale:alternate" content="<%= _ogLocale === 'fr_FR' ? 'en_GB' : 'fr_FR' %>">
<% (typeof metaProps !== 'undefined' && metaProps ? metaProps : []).forEach(m => { %><meta property="<%= m.property %>" content="<%= m.content %>">
<% }) %>
<% if (_pageUrl) { %><meta property="og:url" content="<%= _pageUrl %>">
<% } %><% if (_ogImage) { %><meta property="og:image" content="<%= _ogImage %>">
<% if (!_customOg) { %><meta property="og:image:width" content="1280">
<meta property="og:image:height" content="720">
<% } %><meta property="og:image:alt" content="<%= _customOg ? title : (_isFr ? 'Uma’s Books & Adventures — une librairie associative anglophone à Albi' : 'Uma\'s Books & Adventures — a community English bookshop in Albi, France') %>">
<% } %><meta name="twitter:card" content="<%= _ogImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= title %>" data-i18n-attr="content:meta.title">
<meta name="twitter:description" content="<%= _desc %>" data-i18n-attr="content:meta.description">
<% if (_ogImage) { %><meta name="twitter:image" content="<%= _ogImage %>">
<% } %><link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
<% } %><link rel="preload" href="/assets/fonts/cormorant-garamond-normal-latin-500-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/nunito-sans-normal-latin-400-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= assetUrl('/assets/site.css') %>">
<link rel="stylesheet" href="<%= assetUrl('/site-header.css') %>">
<link rel="stylesheet" href="<%= assetUrl('/print.css') %>" media="print">
<% (typeof extraCss !== 'undefined' ? extraCss : []).forEach(href => { %><link rel="stylesheet" href="<%= assetUrl(href.charAt(0) === '/' ? href : '/' + href) %>"><% }) %>
</head>
<body<%- typeof bodyClass !== 'undefined' && bodyClass ? ' class="' + bodyClass + '"' : '' %>>
<a class="skip-link" href="#main-content" data-i18n="a11y.skip"><%= _isFr ? 'Aller au contenu principal' : 'Skip to main content' %></a>

<%- include('../../partials/mkt_chrome_header', { nav, activeNav: typeof activeNav !== 'undefined' ? activeNav : undefined }) %>
<% if (typeof hideBackLink === 'undefined' || !hideBackLink) { %>
<%# A landmark of its own (axe "region", RGAA 9.2): the bar sits above <main>, so it is a labelled <nav>, not loose content. %>
<nav class="site-back-bar" aria-label="<%= _isFr ? 'Lien de retour' : 'Back link' %>"><a href="<%= typeof backHref !== 'undefined' && backHref ? backHref : '/' %>" class="site-back-link" data-i18n="nav.back"><%= _isFr ? '← Retour' : '← Back' %></a></nav>
<% } %>
<main id="main-content" tabindex="-1">

<!-- The "Become a Member" pitch, repeated as-is on index.html and
     events.html (each pairs it with its own different sibling card) —
     shared here instead of copy-pasted, using site.js's COMMON i18n
     keys since the copy itself never varies by page. -->
<div class="member-inner">
  <div class="kicker" data-i18n="member.kicker">Join our community</div>
  <h2 data-i18n-html="member.t">Become a Member <br>of Our Association</h2>
  <p data-i18n-html="member.d">Members vote on the next charity to donate to, <br>volunteer opportunities, special events and more.</p>
  <a class="h-btn" href="membership.html"><span data-i18n="member.cta">Find out how to sign up here</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
</div>

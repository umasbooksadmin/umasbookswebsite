<%- include('partials/header', { title: 'Charity Vote' }) %>

<h1>Charity Vote</h1>

<% if (!charity) { %>
  <p class="muted">No vote is open right now.</p>
<% } else { %>
  <p class="muted">
    <%= charity.round.title %>
    <% if (charity.round.closes_at) { %> &middot; Voting ends <%= formatDateTime(charity.round.closes_at) %><% } %>
  </p>
  <% if (charity.round.allow_multiple) { %><p class="muted small">You can select multiple charities.</p><% } %>

  <% const total = charity.options.reduce((sum, o) => sum + Number(o.vote_count), 0); %>

  <% if (isMember) { %>
    <form method="post" action="/charity/vote">
      <%- include('partials/csrf_field') %>
      <div class="card">
        <% charity.options.forEach(o => { %>
          <% const mine = charity.myOptionIds.includes(o.id); %>
          <div class="vote-option">
            <div style="flex:1;">
              <label style="display:flex; align-items:flex-start; gap:10px; cursor:pointer;">
                <input type="<%= charity.round.allow_multiple ? 'checkbox' : 'radio' %>" name="optionIds" value="<%= o.id %>" <%= mine ? 'checked' : '' %> style="margin-top:5px;">
                <span>
                  <strong><%= o.name %></strong>
                  <% if (o.category) { %> <span class="status-pill category"><%= o.category %></span><% } %>
                  <% if (o.description) { %><div class="muted small"><%= o.description %></div><% } %>
                  <% if (o.website_url && /^https?:\/\//i.test(o.website_url)) { %><div class="small"><a href="<%= o.website_url %>" target="_blank" rel="noopener"><%= o.website_url %></a></div><% } %>
                  <% if (charity.showResults) { %>
                    <div class="vote-bar" style="margin-top:6px;"><span style="width: <%= total ? Math.round(o.vote_count / total * 100) : 0 %>%;"></span></div>
                    <div class="muted small"><%= o.vote_count %> vote<%= o.vote_count == 1 ? '' : 's' %></div>
                  <% } %>
                </span>
              </label>
            </div>
          </div>
        <% }) %>
        <button class="btn" type="submit" style="margin-top:14px;">Submit My Votes</button>
      </div>
    </form>
  <% } else { %>
    <div class="card">
      <% charity.options.forEach(o => { %>
        <div class="vote-option">
          <div style="flex:1;">
            <strong><%= o.name %></strong>
            <% if (o.category) { %> <span class="status-pill category"><%= o.category %></span><% } %>
            <% if (o.description) { %><div class="muted small"><%= o.description %></div><% } %>
            <% if (charity.showResults) { %>
              <div class="vote-bar" style="margin-top:6px;"><span style="width: <%= total ? Math.round(o.vote_count / total * 100) : 0 %>%;"></span></div>
              <div class="muted small"><%= o.vote_count %> vote<%= o.vote_count == 1 ? '' : 's' %></div>
            <% } %>
          </div>
        </div>
      <% }) %>
      <p class="muted small" style="margin-top:10px;"><a href="/login">Log in as a member</a> to vote.</p>
    </div>
  <% } %>
<% } %>

<% if (isMember) { %>
  <div class="card" style="margin-top:20px;">
    <div class="section-title">Suggest a Charity</div>
    <p class="muted small">Know a local cause we should consider for a future vote? Suggest it below — an admin reviews every submission.</p>
    <form class="stack" method="post" action="/charity/ideas">
      <%- include('partials/csrf_field') %>
      <label for="idea-name">Charity name</label>
      <input id="idea-name" name="name" type="text" required>
      <label for="idea-category">Category (optional)</label>
      <select id="idea-category" name="category">
        <option value="">Select…</option>
        <% categories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
      </select>
      <label for="idea-description">Why this charity? (optional)</label>
      <textarea id="idea-description" name="description"></textarea>
      <label for="idea-website">Website (optional)</label>
      <input id="idea-website" name="websiteUrl" type="text" placeholder="https://">
      <button class="btn" type="submit">Submit Idea</button>
    </form>

    <% if (myIdeas.length) { %>
      <div class="section-title" style="margin-top:20px; font-size:18px;">Your submitted ideas</div>
      <ul class="plain">
        <% myIdeas.forEach(i => { %>
          <li>
            <strong><%= i.name %></strong>
            <span class="status-pill <%= i.status === 'approved' ? 'published' : i.status === 'rejected' ? 'trash' : 'scheduled' %>">
              <%= i.status === 'approved' ? 'Approved' : i.status === 'rejected' ? 'Not selected' : 'Pending review' %>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>

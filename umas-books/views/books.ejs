<%- include('partials/header', { title: 'Books' }) %>

<h1>Books</h1>
<p class="muted">Search what's in stock right now &mdash; reserve a copy and pick it up in the shop, no account or online payment needed.</p>

<div class="card">
  <form class="stack" method="get" action="/books" style="flex-direction: row; gap: 12px; max-width: none; align-items: end; flex-wrap: wrap;">
    <div style="flex: 2; min-width: 200px;">
      <label for="q">Title or author</label>
      <input id="q" name="q" type="text" value="<%= q %>" placeholder="Search title or author...">
    </div>
    <button class="btn" type="submit">Search</button>
  </form>
</div>

<% if (genres.length) { %>
  <nav class="genre-subnav">
    <a href="/books<%= q ? '?q=' + encodeURIComponent(q) : '' %>" class="<%= !genre ? 'is-active' : '' %>">All Genres</a>
    <% genres.forEach(g => { %>
      <a href="/books?genre=<%= encodeURIComponent(g) %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="<%= genre === g ? 'is-active' : '' %>"><%= g %></a>
    <% }) %>
  </nav>
<% } %>

<% if (!books.length) { %>
  <div class="card"><p class="muted"><%= (q || genre) ? 'No in-stock books match that search.' : 'Search above to browse what\'s currently in stock.' %></p></div>
<% } %>

<div class="book-grid">
  <% books.forEach(b => { %>
    <a class="book-card" href="/books/<%= b.id %><%= genre ? '?genre=' + encodeURIComponent(genre) : '' %>">
      <% if (b.cover_url) { %>
        <img src="<%= b.cover_url %>" alt="" class="book-card-cover">
      <% } else { %>
        <div class="book-card-cover book-thumb-placeholder">No cover</div>
      <% } %>
      <div class="book-card-body">
        <div class="book-card-title"><%= b.title %></div>
        <div class="muted small"><%= b.authors || 'Unknown author' %></div>
        <div class="book-card-meta">
          <% if (b.min_price != null) { %><span class="book-card-price">&euro;<%= Number(b.min_price).toFixed(2) %></span><% } %>
          <span class="availability-badge is-in-stock"><span class="dot"></span><%= b.in_stock_count %> in stock</span>
        </div>
        <span class="btn btn-outline btn-small" style="margin-top:10px;">Reserve and Pickup</span>
      </div>
    </a>
  <% }) %>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: thread.title, hideBackLink: true }) %>

<p><a href="/forum">&larr; Back to forum</a></p>
<h1><%= thread.title %></h1>
<div class="thread-meta"><%= thread.author_name || 'Member' %> &middot; <%= formatDateTime(thread.created_at) %></div>
<div class="card"><%= thread.body %></div>

<h3>Replies</h3>
<% if (!replies.length) { %>
  <p class="muted">No replies yet.</p>
<% } %>
<% replies.forEach(r => { %>
  <div class="reply">
    <div class="thread-meta"><%= r.author_name || 'Member' %> &middot; <%= formatDateTime(r.created_at) %></div>
    <div><%= r.body %></div>
  </div>
<% }) %>

<h3 id="reply-heading">Add a reply</h3>
<form class="stack" method="post" action="/forum/<%= thread.id %>/replies">
  <%- include('partials/csrf_field') %>
  <textarea name="body" aria-labelledby="reply-heading" required></textarea>
  <button class="btn" type="submit">Reply</button>
</form>

<%- include('partials/footer') %>

<%- include('partials/header', { title: tr('New Thread', 'Nouvelle discussion') }) %>

<h1><%= tr('Start a thread', 'Lancer une discussion') %></h1>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<form class="stack" method="post" action="/forum/new">
  <%- include('partials/csrf_field') %>
  <label for="title"><%= tr('Title', 'Titre') %></label>
  <input id="title" name="title" type="text" value="<%= (locals.values && locals.values.title) || '' %>" required>
  <label for="body"><%= tr('Message', 'Message') %></label>
  <textarea id="body" name="body" required><%= (locals.values && locals.values.body) || '' %></textarea>
  <%- include('partials/privacy_note', { en: 'Your post is visible to other members and shows your name. See our', fr: 'Votre message est visible des autres membres et affiche votre nom. Consultez notre' }) %>
  <button class="btn" type="submit"><%= tr('Post', 'Publier') %></button>
</form>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Set New Password' }) %>

<h1>Set a new password</h1>
<% if (error) { %><div class="error-box"><%= error %></div><% } %>
<% if (token) { %>
  <form class="stack" method="post" action="/reset-password/<%= token %>">
    <%- include('partials/csrf_field') %>
    <label for="newPassword">New password</label>
    <div class="password-field">
      <input id="newPassword" name="newPassword" type="password" minlength="8" required
        pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}"
        title="At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a symbol.">
      <button type="button" class="password-toggle" data-toggle-password="newPassword" aria-label="Show password">Show</button>
    </div>
    <p class="muted small">At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a symbol.</p>
    <button class="btn" type="submit">Set password</button>
  </form>
<% } else { %>
  <p><a href="/forgot-password">Request a new reset link</a></p>
<% } %>

<%- include('partials/footer') %>

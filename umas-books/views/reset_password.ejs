<%- include('partials/header', { noindex: true, title: locals.confirmed ? tr('Email Confirmed', 'Adresse confirmée') : tr('Set New Password', 'Nouveau mot de passe') }) %>

<% if (locals.confirmed && token) { %>
<h1><%= tr('Email confirmed: now choose your password', 'Adresse confirmée : choisissez maintenant votre mot de passe') %></h1>
<p class="muted"><%= tr('Thank you! To keep your account safe, please pick your password now. It replaces the one entered when the account was created.', 'Merci ! Pour la sécurité de votre compte, choisissez dès maintenant votre mot de passe. Il remplace celui saisi lors de la création du compte.') %></p>
<% } else { %>
<h1><%= tr('Set a new password', 'Choisir un nouveau mot de passe') %></h1>
<% } %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (token) { %>
  <form class="stack" method="post" action="/reset-password/<%= token %><%= locals.confirmed ? '?confirmed=1' : '' %>">
    <%- include('partials/csrf_field') %>
    <label for="newPassword"><%= tr('New password', 'Nouveau mot de passe') %></label>
    <div class="password-field">
      <input id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" required
        pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}"
        title="<%= tr('At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a symbol.', '8 caractères minimum, avec une majuscule, une minuscule, un chiffre et un symbole.') %>">
      <button type="button" class="password-toggle" data-toggle-password="newPassword" aria-label="<%= tr('Show password', 'Afficher le mot de passe') %>" aria-pressed="false"><%= tr('Show', 'Afficher') %></button>
    </div>
    <p class="muted small"><%= tr('At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a symbol.', '8 caractères minimum, avec une majuscule, une minuscule, un chiffre et un symbole.') %></p>
    <button class="btn" type="submit"><%= tr('Set password', 'Enregistrer le mot de passe') %></button>
  </form>
<% } else { %>
  <p><a href="/forgot-password"><%= tr('Request a new reset link', 'Demander un nouveau lien') %></a></p>
<% } %>

<%- include('partials/footer') %>

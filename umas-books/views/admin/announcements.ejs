<%- include('../partials/admin_header', { title: 'Announcements', active: active, pageTitle: 'Announcements' }) %>


<div class="card">
  <div class="section-title">Post an announcement</div>
  <form class="stack" method="post" action="/admin/announcements">
    <%- include('../partials/csrf_field') %>
    <label for="a-title">Title</label>
    <input id="a-title" name="title" type="text" required>
    <label for="a-body">Body</label>
    <textarea id="a-body" name="body" required></textarea>
    <button class="btn" type="submit">Post</button>
  </form>
</div>

<div class="card">
  <div class="section-title">Recent announcements</div>
  <% if (!announcements.length) { %><p class="muted">None posted yet.</p><% } %>
  <ul class="plain">
    <% announcements.forEach(a => { %>
      <li>
        <strong><%= a.title %></strong>
        <div class="muted small"><%= formatDateTime(a.published_at) %></div>
        <div><%= a.body %></div>
      </li>
    <% }) %>
  </ul>
</div>

<%- include('../partials/admin_footer') %>

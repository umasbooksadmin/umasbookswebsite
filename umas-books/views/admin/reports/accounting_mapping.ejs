<%- include('../../partials/admin_header', { title: 'Accounting mapping', active: 'reports', pageTitle: 'Accounting mapping', pageSub: 'Which accounts each kind of sale goes to in the accounting export', mainWide: true }) %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<div class="card">
  <p class="muted small">Each row of the <a href="/admin/reports/accounting">Accounting export</a> takes its debit account, credit account and journal from this table. The values shown are a starting point: <strong>ask the treasurer to confirm them</strong> (in particular 511 or 512 for cards, cheques and HelloAsso, and 471 for payments with no recorded method). Every change is written to the admin activity log.</p>
  <form method="post" action="/admin/reports/accounting/mapping">
    <%- include('../../partials/csrf_field') %>
    <div class="table-scroll"><table class="report-table">
      <thead><tr><th>Category</th><th>Payment method</th><th>Debit account</th><th>Credit account</th><th>Journal</th></tr></thead>
      <tbody>
        <% rows.forEach((r, i) => { %>
          <tr>
            <td><%= r.category %></td><td><%= r.method %></td>
            <td><input name="debit_<%= i %>" value="<%= r.debit %>" maxlength="20" required aria-label="Debit account for <%= r.category %>, <%= r.method %>" style="width:90px"></td>
            <td><input name="credit_<%= i %>" value="<%= r.credit %>" maxlength="20" required aria-label="Credit account for <%= r.category %>, <%= r.method %>" style="width:90px"></td>
            <td><input name="journal_<%= i %>" value="<%= r.journal %>" maxlength="10" required aria-label="Journal for <%= r.category %>, <%= r.method %>" style="width:70px"></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <p><button class="btn" type="submit">Save the mapping</button> <a class="btn btn-outline" href="/admin/reports/accounting">Back to the export</a></p>
  </form>
</div>
<%- include('../../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: report.title, active: active, pageTitle: report.title, pageSub: report.summary }) %>

<p><a href="/admin/reports">&larr; All reports</a></p>

<% if (report.usesRange) { %>
<div class="card">
  <form class="stack" method="get" action="/admin/reports/<%= report.slug %>" style="flex-direction: row; gap: 8px; max-width: 720px; align-items: end; flex-wrap: wrap;">
    <div>
      <label for="from">From</label>
      <input id="from" name="from" type="date" value="<%= query.from %>">
    </div>
    <div>
      <label for="to">To</label>
      <input id="to" name="to" type="date" value="<%= query.to %>">
    </div>
    <% if (report.usesGroup) { %>
    <div>
      <label for="group">Group by</label>
      <select id="group" name="group">
        <% groups.forEach(g => { %><option value="<%= g %>" <%= g === query.group ? 'selected' : '' %>><%= g.charAt(0).toUpperCase() + g.slice(1) %></option><% }) %>
      </select>
    </div>
    <% } %>
    <button class="btn" type="submit">Show</button>
  </form>
  <p class="muted small">Paris days. Without dates, the last 12 months are shown.</p>
</div>
<% } %>

<% if (report.usesPeriod) { %>
<div class="card">
  <form class="stack" method="get" action="/admin/reports/<%= report.slug %>" style="flex-direction: row; gap: 8px; max-width: 720px; align-items: end; flex-wrap: wrap;">
    <div>
      <label for="period">Period</label>
      <select id="period" name="period">
        <% periods.forEach(p => { %><option value="<%= p.key %>" <%= p.key === query.period ? 'selected' : '' %>><%= p.label %></option><% }) %>
      </select>
    </div>
    <button class="btn" type="submit">Show</button>
  </form>
  <p class="muted small">Paris days. Without a choice, the last 30 days are shown.</p>
</div>
<% } %>

<% if (accountFilters) { %>
<div class="card">
  <form class="stack" method="get" action="/admin/reports/<%= report.slug %>" style="flex-direction: row; gap: 8px; max-width: 900px; align-items: end; flex-wrap: wrap;">
    <div>
      <label for="type">Type</label>
      <select id="type" name="type">
        <% Object.keys(typeLabels).forEach(v => { %><option value="<%= v %>" <%= v === accountFilters.type ? 'selected' : '' %>><%= typeLabels[v] %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="q">Name or email</label>
      <input id="q" name="q" type="text" value="<%= accountFilters.q %>">
    </div>
    <div>
      <label for="from">Created from</label>
      <input id="from" name="from" type="date" value="<%= accountFilters.from %>">
    </div>
    <div>
      <label for="to">Created to</label>
      <input id="to" name="to" type="date" value="<%= accountFilters.to %>">
    </div>
    <button class="btn" type="submit">Show</button>
    <a class="btn btn-outline" href="/admin/reports/<%= report.slug %>">Clear</a>
  </form>
  <p class="muted small">Filters apply to the list below, not to the summary. Dates are Paris days.</p>
</div>
<% } %>

<% result.notes.forEach(n => { %><p class="muted small"><%= n %></p><% }) %>

<% result.sections.forEach((section, idx) => { %>
<div class="card">
  <div class="section-title"><%= section.title %></div>
  <% if (section.note) { %><p class="muted small"><%= section.note %></p><% } %>
  <% if (!section.rows.length) { %>
    <p class="muted">Nothing to show for this period.</p>
  <% } else { %>
    <div style="overflow-x:auto;">
      <div class="table-scroll"><table class="ann-table">
        <thead>
          <tr>
            <% section.columns.forEach(c => { %><th<%- ['int', 'eur', 'pct', 'dec1'].includes(c.type) ? ' style="text-align:right;"' : '' %>><%= c.label %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% section.rows.forEach(row => { %>
            <tr>
              <% section.columns.forEach(c => { %><td<%- ['int', 'eur', 'pct', 'dec1'].includes(c.type) ? ' style="text-align:right;"' : '' %>><%= formatCell(row[c.key], c.type) || '–' %></td><% }) %>
            </tr>
          <% }) %>
          <% if (section.totals) { %>
            <tr>
              <% section.columns.forEach(c => { %><td<%- ['int', 'eur', 'pct', 'dec1'].includes(c.type) ? ' style="text-align:right;"' : '' %>><strong><%= formatCell(section.totals[c.key], c.type) || '–' %></strong></td><% }) %>
            </tr>
          <% } %>
        </tbody>
      </table></div>
    </div>
  <% } %>
  <% const acctQs = (extra) => ['type=' + encodeURIComponent(accountFilters.type), 'q=' + encodeURIComponent(accountFilters.q), 'from=' + accountFilters.from, 'to=' + accountFilters.to].concat(extra || []).join('&amp;'); %>
  <% if (section.pagination && section.pagination.pages > 1) { %>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px;">
      <span class="muted small">Page <%= section.pagination.page %> of <%= section.pagination.pages %> &middot; <%= section.pagination.total %> accounts</span>
      <div style="display:flex; gap:6px; flex-wrap:wrap;">
        <% for (let p = 1; p <= section.pagination.pages; p++) { %>
          <a class="btn btn-outline btn-small<%= p === section.pagination.page ? ' is-active' : '' %>" href="/admin/reports/<%= report.slug %>?<%- acctQs(['page=' + p]) %>"><%= p %></a>
        <% } %>
      </div>
    </div>
  <% } %>
  <p style="margin-top:12px;">
    <% if (accountFilters) { %>
    <a class="btn btn-outline btn-small" href="/admin/reports/<%= report.slug %>?format=csv&amp;table=<%= section.key %>&amp;<%- acctQs() %>">Download CSV</a>
    <a class="btn btn-outline btn-small" title="Semicolon separators and decimal commas, for Excel in French" href="/admin/reports/<%= report.slug %>?format=csv&amp;locale=fr&amp;table=<%= section.key %>&amp;<%- acctQs() %>">Download for French Excel</a>
    <% } else { %>
    <a class="btn btn-outline btn-small" href="/admin/reports/<%= report.slug %>?format=csv&amp;table=<%= section.key %>&amp;from=<%= query.from %>&amp;to=<%= query.to %>&amp;group=<%= query.group %><%- report.usesPeriod ? '&amp;period=' + query.period : '' %>">Download CSV</a>
    <a class="btn btn-outline btn-small" title="Semicolon separators and decimal commas, for Excel in French" href="/admin/reports/<%= report.slug %>?format=csv&amp;locale=fr&amp;table=<%= section.key %>&amp;from=<%= query.from %>&amp;to=<%= query.to %>&amp;group=<%= query.group %><%- report.usesPeriod ? '&amp;period=' + query.period : '' %>">Download for French Excel</a>
    <% } %>
    <% if (report.slug === 'accounting') { %><a class="btn btn-outline btn-small" href="/admin/reports/accounting/mapping">Accounts mapping</a><% } %>
  </p>
</div>
<% }) %>

<%- include('../../partials/admin_footer') %>

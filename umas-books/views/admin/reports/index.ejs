<%- include('../../partials/admin_header', { title: 'Reports', active: active, pageTitle: 'Reports', pageSub: 'Figures about the stock, sales and members. Each report can be downloaded as a spreadsheet (CSV). No email addresses or buyer names are shown, except in the Accounts report.' }) %>

<div class="card">
  <ul class="plain">
    <% reports.forEach(r => { %>
      <li>
        <a href="/admin/reports/<%= r.slug %>"><strong><%= r.title %></strong></a>
        <div class="muted small"><%= r.summary %></div>
      </li>
    <% }) %>
    <li>
      <a href="/admin/reports/covers-to-check"><strong>Covers to check</strong></a>
      <div class="muted small">Books whose cover may be another edition's picture (saved before covers were tied to the exact ISBN). Check one at a time, or mark it fine.</div>
    </li>
  </ul>
</div>

<%- include('../../partials/admin_footer') %>

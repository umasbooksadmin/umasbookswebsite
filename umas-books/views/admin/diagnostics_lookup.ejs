<%- include('../partials/admin_header', { title: 'Book lookup sources', active: active, pageTitle: 'Book lookup sources', pageSub: 'Where the Add a book page finds a title from an ISBN. Read-only.' }) %>

<div class="card">
  <table class="ann-table">
    <thead><tr><th scope="col">Source</th><th scope="col">Status</th></tr></thead>
    <tbody>
      <tr><th scope="row">Open Library</th><td>On (always the first choice)</td></tr>
      <tr><th scope="row">Bibliothèque nationale de France</th><td>On, asked for French-language ISBNs only</td></tr>
      <tr><th scope="row">Google Books</th><td>On<%= googleKey ? ' (with a key)' : ' (no key: Google caps keyless use, it may answer "quota" and is then left alone for 10 minutes)' %></td></tr>
      <tr>
        <th scope="row">ISBNdb (paid)</th>
        <td>
          <% if (!isbndb.configured) { %>
            Off: no <code>ISBNDB_API_KEY</code> is set.
          <% } else if (isbndb.status === 'invalid') { %>
            <strong>Key refused.</strong> <%= isbndb.lastError %> Check <code>ISBNDB_API_KEY</code> in Render and the ISBNdb subscription.
          <% } else if (isbndb.status === 'rate_limited') { %>
            <strong>Quota reached.</strong> <%= isbndb.lastError %>
          <% } else if (isbndb.status === 'error') { %>
            <strong>Not answering well.</strong> <%= isbndb.lastError %>
          <% } else if (isbndb.status === 'ok') { %>
            Working. Last good answer: <%= isbndb.lastOkAt ? new Date(isbndb.lastOkAt).toLocaleString('en-GB', { timeZone: 'Europe/Paris', dateStyle: 'medium', timeStyle: 'medium' }) : '' %>.
          <% } else { %>
            Key set; not used yet since the site started (it is only asked when the free sources find no title, or lack the author, publisher or year).
          <% } %>
          <% if (isbndb.configured) { %> Calls since the site started: <%= isbndb.calls %>.<% } %>
          <% if (isbndb.pausedUntil) { %> Paused until <%= new Date(isbndb.pausedUntil).toLocaleTimeString('en-GB', { timeZone: 'Europe/Paris' }) %>.<% } %>
        </td>
      </tr>
    </tbody>
  </table>
  <p>Switch list (<code>SCAN_LOOKUP_SOURCES</code>): <code><%= sources %></code>. This page shows what this running copy of the site has seen since it started. What to do: <code>docs/runbook.md</code>, &ldquo;Scan speed&rdquo;. How often each source was used over time: <a href="/admin/reports/lookup-sources">report &ldquo;Book lookup sources used&rdquo;</a>.</p>
</div>

<%- include('../partials/admin_footer') %>

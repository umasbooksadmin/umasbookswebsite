<%- include('../partials/header', { title: 'Admin — Volunteer Shifts' }) %>
<%- include('../partials/admin_subnav', { active }) %>

<h1>Volunteer Shifts</h1>

<div class="card">
  <div class="section-title">Add a volunteer shift</div>
  <p class="muted small">Use "Repeat weekly" to create the same shift for several weeks at once &mdash; handy for regular shop-floor slots. Each shift takes one volunteer.</p>
  <form class="stack" method="post" action="/admin/volunteer-shifts">
    <%- include('../partials/csrf_field') %>
    <input type="hidden" name="month" value="<%= currentMonth %>">
    <label for="v-role">Role</label>
    <input id="v-role" name="role" type="text" required placeholder="Shop Floor" list="v-role-suggestions">
    <datalist id="v-role-suggestions">
      <option value="Shop Floor">
      <option value="Sorting & Shelving">
      <option value="Events & Language Exchange">
      <option value="Bilingual Support">
      <option value="Éveil Helper">
    </datalist>
    <label for="v-start">Starts at</label>
    <input id="v-start" name="startsAt" type="datetime-local" required>
    <label for="v-end">Ends at</label>
    <input id="v-end" name="endsAt" type="datetime-local" required>
    <label for="v-repeat">Repeat weekly, this many times (including the first)</label>
    <input id="v-repeat" name="repeatWeeks" type="number" min="1" max="52" value="1">
    <label for="v-notes">Notes (optional)</label>
    <textarea id="v-notes" name="notes"></textarea>
    <button class="btn" type="submit">Add shift</button>
  </form>
</div>

<div class="card">
  <div class="calendar-nav">
    <a class="btn btn-outline btn-small" href="/admin/volunteer-shifts?month=<%= prevMonth %>">&larr; Prev</a>
    <span class="month-label"><%= monthLabel %></span>
    <a class="btn btn-outline btn-small" href="/admin/volunteer-shifts?month=<%= nextMonth %>">Next &rarr;</a>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% day.items.forEach(s => { %>
              <% const full = s.signup_count >= s.capacity; %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %>">
                <summary><%= s.role %> &middot; <%= new Date(s.starts_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= new Date(s.starts_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %> &ndash; <%= new Date(s.ends_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %>
                    &middot; <%= s.signup_count %>/<%= s.capacity %> filled
                  </div>
                  <% if (s.notes) { %><div class="muted small"><%= s.notes %></div><% } %>
                  <form method="post" action="/admin/volunteer-shifts/<%= s.id %>/delete?month=<%= currentMonth %>" style="margin-top:8px;">
                    <%- include('../partials/csrf_field') %>
                    <button class="btn btn-outline btn-small" type="submit">Delete</button>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>

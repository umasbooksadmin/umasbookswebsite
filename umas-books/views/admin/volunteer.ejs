<%- include('../partials/admin_header', { title: 'Volunteer Shifts', active: active, pageTitle: 'Volunteer Shifts' }) %>

<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>

<p class="muted small">Click a day to add a shift there. Each shift takes one volunteer; use "Repeat weekly" to create the same shift for several weeks at once.</p>

<div class="card">
  <datalist id="v-role-suggestions">
    <option value="Shop Floor">
    <option value="Sorting & Shelving">
    <option value="Events & Language Exchange">
    <option value="Bilingual Support">
    <option value="Éveil Helper">
  </datalist>
  <div class="calendar-nav">
    <div class="calendar-nav-main">
      <a class="btn btn-outline btn-small" href="/admin/volunteer-shifts?<%= prevHref %>">&larr; Prev</a>
      <span class="month-label"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a class="btn btn-outline btn-small" href="/admin/volunteer-shifts?<%= nextHref %>">Next &rarr;</a>
    </div>
    <div class="calendar-view-toggle">
      <a href="/admin/volunteer-shifts" class="btn btn-outline btn-small<%= view === 'month' ? ' is-active' : '' %>">Month</a>
      <a href="/admin/volunteer-shifts?view=week" class="btn btn-outline btn-small<%= view === 'week' ? ' is-active' : '' %>">Week</a>
    </div>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <details class="calendar-pill calendar-add-pill">
              <summary>+ Add shift</summary>
              <div class="calendar-pill-body">
                <form class="stack" method="post" action="/admin/volunteer-shifts">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="view" value="<%= view %>">
                  <input type="hidden" name="month" value="<%= view === 'month' ? currentMonth : '' %>">
                  <input type="hidden" name="week" value="<%= view === 'week' ? currentWeek : '' %>">
                  <input type="hidden" name="date" value="<%= day.dateKey %>">
                  <label for="role-new-<%= day.dateKey %>">Role</label>
                  <input id="role-new-<%= day.dateKey %>" name="role" type="text" required placeholder="Shop Floor" list="v-role-suggestions">
                  <label for="start-new-<%= day.dateKey %>">Start time</label>
                  <input id="start-new-<%= day.dateKey %>" name="startTime" type="time" required>
                  <label for="end-new-<%= day.dateKey %>">End time</label>
                  <input id="end-new-<%= day.dateKey %>" name="endTime" type="time" required>
                  <label for="repeat-new-<%= day.dateKey %>">Repeat weekly, this many times (including this one)</label>
                  <input id="repeat-new-<%= day.dateKey %>" name="repeatWeeks" type="number" min="1" max="52" value="1">
                  <label for="notes-new-<%= day.dateKey %>">Notes (optional)</label>
                  <textarea id="notes-new-<%= day.dateKey %>" name="notes"></textarea>
                  <div><button class="btn btn-small" type="submit">Add shift</button></div>
                </form>
              </div>
            </details>
            <% day.items.forEach(s => { %>
              <% const full = s.signup_count >= s.capacity; %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %>">
                <summary><%= s.role %> &middot; <%= formatTime(s.starts_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatTime(s.starts_at) %> &ndash; <%= formatTime(s.ends_at) %>
                    &middot; <%= s.signup_count %>/<%= s.capacity %> filled
                  </div>
                  <% if (s.notes) { %><div class="muted small"><%= s.notes %></div><% } %>
                  <form method="post" action="/admin/volunteer-shifts/<%= s.id %>/delete?<%= qs %>" style="margin-top:8px;">
                    <%- include('../partials/csrf_field') %>
                    <button class="btn btn-outline btn-small" type="submit">Delete</button>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('../partials/admin_footer') %>

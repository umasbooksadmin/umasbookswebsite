<%- include('../../partials/admin_header', { title: 'Scan a Book', active: active, pageTitle: 'Scan a Book', compactTop: true, extraCss: ['/scan-intake.css'] }) %>

<% if (typeof saved !== "undefined" && saved) { %><div role="status" class="notice-box">Book saved &mdash; ready for the next one.</div><% } %>
<% if (typeof requestsMatched !== "undefined" && requestsMatched > 0) { %><div role="status" class="notice-box"><%= requestsMatched %> customer<%= requestsMatched === 1 ? '' : 's' %> asked for this book. <a href="/admin/requests?status=matched">See the requests</a></div><% } %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>

<p><a class="btn btn-outline btn-small" href="/admin/inventory/move">Move books</a></p>

<div class="card">
  <div class="section-title">Enter an ISBN</div>
  <p class="muted small">The faster way to add many books is the <a href="/admin/inventory/new">Add book page</a>: it looks the ISBN up as soon as you scan it. This page is for a photo of the cover. New books start at the location Store and the source Donation: change them on the book form.</p>
  <form class="stack" method="post" action="/admin/inventory/lookup" enctype="multipart/form-data">
    <%- include('../../partials/csrf_field') %>
    <label for="isbn">ISBN</label>
    <input id="isbn" name="isbn" type="text" inputmode="numeric" placeholder="9780143127550" autofocus data-auto-submit-isbn>
    <button class="btn" type="submit">Look up</button>
  </form>
</div>

<div class="card" id="no-isbn">
  <div class="section-title">No ISBN?</div>
  <p class="muted small">Old books, local editions and some second-hand books have no barcode. They are handled like any other book: <a class="btn btn-outline btn-small" href="/admin/inventory/new">Enter the details by hand</a> (title, author, condition and price). Each copy then gets its own label (UB-…) that the till scans.</p>
</div>

<div class="card">
  <div class="section-title">Or take a photo</div>
  <% if (visionEnabled) { %>
    <p class="muted small">Photograph the front cover, or the barcode/ISBN on the back &mdash; we'll read whatever's visible and look it up automatically.</p>
    <form class="stack" method="post" action="/admin/inventory/lookup" enctype="multipart/form-data">
      <%- include('../../partials/csrf_field') %>
      <button type="button" class="btn btn-outline" data-trigger-file="photo">Take or Choose Photo</button>
      <input id="photo" name="photo" type="file" aria-label="Book photo" accept="image/*" capture="environment" required class="file-input-hidden" data-file-name-target="photo-name" data-auto-submit-file>
      <span id="photo-name" class="muted small file-input-name">No photo selected</span>
    </form>
  <% } else { %>
    <p class="muted small">Photo scanning isn't set up yet (needs an <code>ANTHROPIC_API_KEY</code>) &mdash; use the ISBN box above, or <a href="/admin/inventory/new">add the book manually</a>.</p>
  <% } %>
</div>

<%- include('../../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: 'Price stickers', active: active, pageTitle: 'Price stickers', mainWide: true }) %>

<div class="card no-print">
  <p class="muted small">In-stock copies and the color of the sticker each one needs. Print this page, or download it as a CSV.</p>
  <form class="sticker-filters" method="get" action="/admin/inventory/stickers">
    <div>
      <label for="since">Added since</label>
      <input id="since" name="since" type="date" value="<%= filters.since %>">
    </div>
    <div>
      <label for="location">Location</label>
      <input id="location" name="location" type="text" list="location-options" value="<%= filters.location || '' %>" placeholder="Any location" autocomplete="off">
    </div>
    <div>
      <label for="color">Color</label>
      <select id="color" name="color">
        <option value="">All colors</option>
        <% priceColors.LEVELS.forEach(lv => { %><option value="<%= lv.key %>" <%= filters.color === lv.key ? 'selected' : '' %>><%= lv.label %> (<%= priceColors.meaning(lv) %>)</option><% }) %>
      </select>
    </div>
    <button class="btn" type="submit">Show</button>
    <a class="btn btn-outline" href="/admin/inventory/stickers?since=<%= encodeURIComponent(filters.since) %>&amp;location=<%= encodeURIComponent(filters.location || '') %>&amp;color=<%= encodeURIComponent(filters.color || '') %>&amp;format=csv">Download CSV</a>
    <button class="btn btn-outline" type="button" data-print>Print</button>
    <a class="btn btn-outline" href="/admin/inventory/labels?since=<%= encodeURIComponent(filters.since) %>&amp;location=<%= encodeURIComponent(filters.location || '') %>&amp;color=<%= encodeURIComponent(filters.color || '') %>">Print labels (barcodes)</a>
  </form>
  <%- include('../../partials/location_options') %>
  <p><a href="/admin/inventory">&larr; Back to inventory</a></p>
</div>

<div class="card">
  <div class="section-title">Sticker colors</div>
  <%- include('../../partials/sticker_legend') %>
</div>

<div class="card">
  <div class="section-title"><%= rows.length %> cop<%= rows.length === 1 ? 'y' : 'ies' %> added since <%= filters.since %><%= filters.location ? ' at ' + filters.location : '' %></div>
  <% if (truncated) { %><p class="notice-box" role="status">Only the first <%= rowLimit %> copies are shown: choose a later date or a location.</p><% } %>
  <% if (!rows.length) { %>
    <p class="muted">No in-stock copies match.</p>
  <% } else { %>
    <div class="table-scroll"><table class="sticker-sheet">
      <thead>
        <tr><th>Sticker</th><th>Price</th><th>Title</th><th>Author</th><th>ISBN</th><th>Condition</th><th>Binding</th><th>Location</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td><%- include('../../partials/sticker_chip', { level: r.level, text: r.level.label }) %></td>
            <td><%= r.price == null ? '' : '€' + priceText(r.price) %></td>
            <td><a href="/admin/inventory/<%= r.book_id %>"><%= r.title %></a></td>
            <td><%= r.authors || '' %></td>
            <td><%= r.isbn || '' %></td>
            <td><%= conditionLabel(r.condition) %></td>
            <td><%= bindingLabel(r.binding) || '' %></td>
            <td><%= r.location || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>

<script src="/print-button.js"></script>
<%- include('../../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: 'Inventory', active: active, pageTitle: 'Inventory' }) %>
<% if (typeof notice !== "undefined" && notice) { %><div class="notice-box" role="status"><%= notice %></div><% } %>


<div class="card">
  <form class="stack inv-ask" method="post" action="/admin/inventory/ask" aria-label="Search inventory by describing it">
    <%- include('../../partials/csrf_field') %>
    <label for="nl-ask">Describe what you are looking for</label>
    <div class="inv-ask-row">
      <textarea id="nl-ask" name="ask" rows="2" maxlength="<%= nl.maxLength %>" placeholder="e.g. books with a customer price different from the publisher's price" aria-describedby="nl-ask-help"><%= nl.sentence %></textarea>
      <button class="btn" type="submit">Find</button>
    </div>
    <p class="muted small" id="nl-ask-help" style="margin:0;">In your own words, in English. The AI turns it into a search, which is shown as "Understood as" above the results: check it. Read-only: it never changes anything.<%= nl.enabled ? '' : ' (Off on this site: the AI service is not set up. The search and filters below work.)' %></p>
    <% if (nl.error) { %><div class="error-box" role="alert" style="margin:0;"><%= nl.error %></div><% } %>
  </form>
</div>

<div class="card">
  <form class="stack inv-search" method="get" action="/admin/inventory" role="search" aria-label="Search inventory">
    <div class="inv-search-main">
      <div>
        <label for="q">Search by title, author, or ISBN</label>
        <input id="q" name="q" type="text" value="<%= q %>" placeholder="Search inventory...">
      </div>
      <button class="btn" type="submit">Search</button>
    </div>
    <div class="inv-filters">
      <div>
        <label for="f-location">Location</label>
        <select id="f-location" name="location">
          <option value="">Any</option>
          <option value="<%= NO_LOCATION %>" <%= filters.location === NO_LOCATION ? 'selected' : '' %>>No location set</option>
          <% locations.forEach(l => { %><option value="<%= l %>" <%= filters.location && filters.location !== NO_LOCATION && filters.location.toLowerCase() === l.toLowerCase() ? 'selected' : '' %>><%= l %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="f-condition">Condition</label>
        <select id="f-condition" name="condition">
          <option value="">Any</option>
          <% CONDITIONS.forEach(c => { %><option value="<%= c.value %>" <%= filters.condition === c.value ? 'selected' : '' %>><%= c.label %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="f-binding">Binding</label>
        <select id="f-binding" name="binding">
          <option value="">Any</option>
          <option value="<%= NO_BINDING %>" <%= filters.binding === NO_BINDING ? 'selected' : '' %>>Not set</option>
          <% BINDINGS.forEach(b => { %><option value="<%= b.value %>" <%= filters.binding === b.value ? 'selected' : '' %>><%= b.label %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="f-genre">Genre</label>
        <select id="f-genre" name="genre">
          <option value="">Any</option>
          <option value="<%= NO_GENRE %>" <%= filters.genre === NO_GENRE ? 'selected' : '' %>>No genre set</option>
          <% const genreSel = (g) => (filters.genre && filters.genre !== NO_GENRE && filters.genre.toLowerCase() === g.toLowerCase() ? 'selected' : ''); %>
          <% genres.forEach(g => { %><option value="<%= g %>" <%= genreSel(g) %>><%= g %></option><% }) %>
          <% if (otherGenres.length) { %><optgroup label="Other (not managed)"><% otherGenres.forEach(g => { %><option value="<%= g %>" <%= genreSel(g) %>><%= g %></option><% }) %></optgroup><% } %>
        </select>
      </div>
      <div>
        <label for="f-pmin">Min price (&euro;)</label>
        <input id="f-pmin" name="priceMin" type="text" inputmode="decimal" autocomplete="off" value="<%= filters.priceMinText %>" placeholder="e.g. 5">
      </div>
      <div>
        <label for="f-pmax">Max price (&euro;)</label>
        <input id="f-pmax" name="priceMax" type="text" inputmode="decimal" autocomplete="off" value="<%= filters.priceMaxText %>" placeholder="e.g. 5,50">
      </div>
      <div>
        <label for="f-rfrom">Received from</label>
        <input id="f-rfrom" name="receivedFrom" type="date" value="<%= filters.receivedFromText %>">
      </div>
      <div>
        <label for="f-rto">Received to</label>
        <input id="f-rto" name="receivedTo" type="date" value="<%= filters.receivedToText %>">
      </div>
      <div class="inv-filter-check">
        <label for="f-rnone"><input id="f-rnone" name="receivedNone" type="checkbox" value="1" <%= filters.receivedNone ? 'checked' : '' %>> No date received set</label>
      </div>
    </div>
    <p class="muted small" style="margin:0;">Location, condition, price and date received look at copies in the store: a book is listed when one copy matches all of them. The date received is the copy's Acquisition Date; both dates are included.</p>
    <% if (filterErrors.length) { %><div class="error-box" role="alert" style="margin:0;"><% filterErrors.forEach(e => { %><div><%= e %></div><% }) %></div><% } %>
    <% if (filterActive) { %><p style="margin:0;"><a href="/admin/inventory<%= q ? '?q=' + encodeURIComponent(q) : '' %>">Clear filters</a><%= q ? ' (keeps the search text)' : '' %> &middot; <a href="/admin/inventory">Clear everything</a></p><% } %>
  </form>
  <p class="inv-actions" style="margin-top:16px;">
    <a class="btn" href="/admin/inventory/new">Scan a book</a>
    <a class="btn btn-outline" href="/admin/inventory/new">Add manually</a>
    <a class="btn btn-outline" href="/admin/inventory/scan">Scan a cover photo</a>
    <a class="btn btn-outline" href="/admin/inventory/move">Move books</a>
    <a class="btn btn-outline" href="/admin/till/items">Other stock (not books)</a>
  </p>
  <div class="inv-downloads">
    <a class="btn btn-outline" href="/admin/inventory/export.csv">Download all inventory (CSV)</a>
    <a class="btn btn-outline" href="/admin/inventory/results.csv<%= resultsQuery ? '?' + resultsQuery : '' %>">Download these results (CSV)</a>
  </div>
  <p class="muted small" style="margin-top:8px;">
    <strong>All inventory</strong> is everything in the system, whatever you searched. <strong>These results</strong> is exactly what the search and filters above show (or the sentence search, when one is shown) (all of it, not just the first <%= listLimit %>)<%= filterActive || q ? '' : ': with nothing searched, that is everything too' %>; with a location, condition, price or date received filter on, only the copies that match are listed.
    Both: one row per copy, for French Excel (semicolons, decimal commas), no customer data.
    Per book instead of per copy: <a href="/admin/inventory/export.csv?books=1">all inventory</a>, <a href="/admin/inventory/results.csv?<%= resultsQuery ? resultsQuery + '&' : '' %>books=1">these results</a>.
    The full file is also emailed every evening at 21:00.
  </p>
</div>

<div class="card">
  <% if (nl.active) { %>
    <div class="notice-box inv-understood" role="status"><strong>Understood as:</strong> <%= nl.understood %><% if (nl.sentence) { %><div class="muted small">You asked: &ldquo;<%= nl.sentence %>&rdquo;</div><% } %><div class="small"><a href="/admin/inventory">Clear this search</a></div></div>
  <% } %>
  <% if (!books.length) { %>
    <p class="muted"><%= (q || filterActive || nl.active) ? 'No books match this search.' : 'No books yet — scan or add one above.' %></p>
  <% } else { %>
    <p class="muted small" role="status" id="inv-count"><%= totalMatches %> <%= totalMatches === 1 ? 'book' : 'books' %><%= (q || filterActive || nl.active) ? ' match' : '' %><%= totalMatches > books.length ? ' (showing the first ' + books.length + ': narrow the search to see the rest)' : '' %></p>
    <ul class="plain">
      <% books.forEach(b => { %>
        <li style="display:flex; gap:14px; align-items:center;">
          <% if (b.cover_url) { %>
            <img src="<%= b.cover_url %>" alt="" class="book-thumb" width="44" height="64" loading="lazy" decoding="async" data-cover>
          <% } else { %>
            <div class="book-thumb book-thumb-placeholder">No cover</div>
          <% } %>
          <div style="flex:1;">
            <a href="/admin/inventory/<%= b.id %>"><strong><%= b.title %></strong></a>
            <div class="muted small">
              <%= b.authors || 'Unknown author' %><%= b.isbn ? ' · ISBN ' + b.isbn : '' %>
              &middot; <%= b.in_stock_count %>/<%= b.copy_count %> in stock
              <% if (b.locations) { %>&middot; Location: <%= b.locations %><% } %>
            </div>
            <% if (b.matched_copies.length) { %>
              <div class="small inv-matched">Matching <%= b.matched_copies.length === 1 ? 'copy' : 'copies' %>:
                <% b.matched_copies.forEach((m, i) => { %><%= i ? '; ' : '' %><strong><%= m.location || 'No location' %></strong> &middot; <%= conditionLabel(m.condition) %> &middot; <%= m.price == null ? 'no price' : '€' + m.price.toFixed(2) %><% if (showReceived) { %> &middot; <%= m.received ? 'received ' + m.received : 'no date received' %><% } %><% (m.extra || []).forEach(x => { %> &middot; <%= x %><% }) %><% }) %>
              </div>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('../../partials/admin_footer') %>

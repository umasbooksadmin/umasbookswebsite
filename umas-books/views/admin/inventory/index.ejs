<%- include('../../partials/admin_header', { title: 'Inventory', active: active, pageTitle: 'Inventory' }) %>
<% if (typeof notice !== "undefined" && notice) { %><div class="notice-box" role="status"><%= notice %></div><% } %>


<div class="card">
  <form class="stack" method="get" action="/admin/inventory" style="flex-direction: row; gap: 8px; max-width: 720px; align-items: end;">
    <div style="flex: 1;">
      <label for="q">Search by title, author, or ISBN</label>
      <input id="q" name="q" type="text" value="<%= q %>" placeholder="Search inventory...">
    </div>
    <div style="flex: 1;">
      <label for="location">Location</label>
      <input id="location" name="location" type="text" list="location-options" value="<%= location %>" placeholder="Any location">
    </div>
    <button class="btn" type="submit">Search</button>
  </form>
  <%- include('../../partials/location_options') %>
  <p style="margin-top:16px;">
    <a class="btn" href="/admin/inventory/scan">Scan a book</a>
    <a class="btn btn-outline" href="/admin/inventory/new">Add manually</a>
    <a class="btn btn-outline" href="/admin/inventory/move">Move books</a>
    <a class="btn btn-outline" href="/admin/inventory/sell">Sell in shop</a>
    <a class="btn btn-outline" href="/admin/inventory/stickers">Price stickers</a>
  </p>
</div>

<div class="card">
  <% if (!books.length) { %>
    <p class="muted">No books yet — scan or add one above.</p>
  <% } else { %>
    <ul class="plain">
      <% books.forEach(b => { %>
        <li style="display:flex; gap:14px; align-items:center;">
          <% if (b.cover_url) { %>
            <img src="<%= b.cover_url %>" alt="" class="book-thumb">
          <% } else { %>
            <div class="book-thumb book-thumb-placeholder">No cover</div>
          <% } %>
          <div style="flex:1;">
            <a href="/admin/inventory/<%= b.id %>"><strong><%= b.title %></strong></a>
            <div class="muted small">
              <%= b.authors || 'Unknown author' %><%= b.isbn ? ' · ISBN ' + b.isbn : '' %>
              &middot; <%= b.in_stock_count %>/<%= b.copy_count %> in stock
              <% if (b.locations) { %>&middot; Location: <%= b.locations %><% } %>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('../../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: 'Sell in shop', active: active, pageTitle: 'Sell in shop' }) %>

<p><a href="/admin/inventory">&larr; Back to inventory</a> &middot; <a href="/admin/inventory/move">Move books</a></p>

<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>

<div class="card">
  <p class="muted small">Scan the book's barcode (or type the ISBN) and press Enter. Check the price, say how it was paid, and press &ldquo;Record sale&rdquo;. The book is then marked as sold. Online orders are not recorded here: they are marked sold automatically when they are paid.</p>
  <form class="stack" method="post" action="/admin/inventory/sell" autocomplete="off">
    <%- include('../../partials/csrf_field') %>
    <label for="isbn">ISBN</label>
    <input id="isbn" name="isbn" type="text" inputmode="numeric" placeholder="9780143127550" value="<%= isbn %>" <%= copies ? '' : 'autofocus' %>>
    <button class="btn <%= copies ? 'btn-outline' : '' %>" type="submit">Find the book</button>
  </form>
</div>

<% if (copies && copies.length) { %>
<div class="card">
  <div class="section-title"><%= copies[0].title %></div>
  <p class="muted small"><%= copies[0].authors || 'Unknown author' %></p>
  <form class="stack" method="post" action="/admin/inventory/sell" autocomplete="off">
    <%- include('../../partials/csrf_field') %>
    <input type="hidden" name="prefillFor" value="<%= prefillFor %>">
    <input type="hidden" name="prefillPrice" value="<%= price %>">
    <% if (copies.length === 1) { %>
      <input type="hidden" name="copyId" value="<%= copies[0].id %>">
      <% const c = copies[0]; const cl = (conditions.find(x => x.value === c.condition) || {}).label || c.condition; %>
      <p><%= cl %><%= c.location ? ' · Location ' + c.location : '' %><%= c.status === 'reserved' ? ' · reserved for a customer' : '' %></p>
    <% } else { %>
      <p class="muted small"><%= copies.length %> copies are available. The oldest one is selected; pick another if that is the one in your hand.</p>
      <% copies.forEach((c, i) => { %>
        <% const cl = (conditions.find(x => x.value === c.condition) || {}).label || c.condition; %>
        <label class="ann-check" for="copy-<%= c.id %>">
          <input id="copy-<%= c.id %>" type="radio" name="copyId" value="<%= c.id %>" <%= i === 0 ? 'checked' : '' %>>
          <%= cl %><%= c.suggested != null ? ' · €' + c.suggested.toFixed(2) : '' %><%= c.location ? ' · Location ' + c.location : '' %><%= c.status === 'reserved' ? ' · reserved for a customer' : '' %>
        </label>
      <% }) %>
    <% } %>

    <label for="price">Price (&euro;)</label>
    <input id="price" name="price" type="number" step="0.01" min="0" value="<%= price %>" required>
    <% if (copies.some(c => c.condition === 'new')) { %>
      <p class="muted small">A new book must be sold at the publisher's price, with at most 5% off (French fixed book price law).</p>
    <% } %>

    <label for="payment">Paid by</label>
    <select id="payment" name="payment">
      <option value="">Not recorded</option>
      <% paymentMethods.forEach(m => { %><option value="<%= m.value %>"><%= m.label %></option><% }) %>
    </select>

    <button class="btn" type="submit" autofocus>Record sale</button>
  </form>
</div>
<% } %>

<div class="card">
  <div class="section-title">Last <%= recent.length %> sales in the shop</div>
  <% if (!recent.length) { %>
    <p class="muted">No sales recorded yet.</p>
  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="ann-table">
        <thead><tr><th>When</th><th>Book</th><th>Price</th><th>Paid by</th></tr></thead>
        <tbody>
          <% recent.forEach(s => { %>
            <tr>
              <td><%= formatDateTime(s.sold_at) %></td>
              <td><%= s.title %></td>
              <td>&euro;<%= Number(s.price).toFixed(2) %></td>
              <td><%= s.payment_method || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../../partials/admin_footer') %>

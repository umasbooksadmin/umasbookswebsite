<%- include('../../partials/admin_header', { title: 'Copy labels', active: active, pageTitle: 'Copy labels', mainWide: true }) %>

<div class="card">
  <p class="muted small">Every copy gets a label with a barcode (<strong>UB-</strong> and the copy number) that the till scans. Pick copies, then print. Use <strong>Price stickers</strong> for the colored price stickers.</p>
  <form class="sticker-filters" method="get" action="/admin/inventory/labels">
    <div><label for="since">Added since</label><input id="since" name="since" type="date" value="<%= filters.since %>"></div>
    <div><label for="location">Location</label><input id="location" name="location" type="text" list="location-options" value="<%= filters.location || '' %>" placeholder="Any location" autocomplete="off"></div>
    <div>
      <label for="color">Color</label>
      <select id="color" name="color">
        <option value="">All colors</option>
        <% priceColors.LEVELS.forEach(lv => { %><option value="<%= lv.key %>" <%= filters.color === lv.key ? 'selected' : '' %>><%= lv.label %></option><% }) %>
      </select>
    </div>
    <div><label for="w">Label width (mm)</label><input id="w" name="w" type="number" min="20" max="210" step="0.5" value="<%= size.w %>" style="width:90px"></div>
    <div><label for="h">Height (mm)</label><input id="h" name="h" type="number" min="10" max="150" step="0.5" value="<%= size.h %>" style="width:90px"></div>
    <div>
      <label for="layout">Printing on</label>
      <select id="layout" name="layout">
        <option value="roll" <%= size.layout === 'roll' ? 'selected' : '' %>>A label roll (one label per page)</option>
        <option value="sheet" <%= size.layout === 'sheet' ? 'selected' : '' %>>A sheet of labels (A4 grid)</option>
      </select>
    </div>
    <button class="btn" type="submit">Show</button>
  </form>
  <%- include('../../partials/location_options') %>
  <p><a href="/admin/inventory/stickers?since=<%= encodeURIComponent(filters.since) %>">Price stickers</a> &middot; <a href="/admin/inventory">&larr; Back to inventory</a></p>
</div>

<form class="card" method="get" action="/admin/inventory/labels">
  <input type="hidden" name="w" value="<%= size.w %>"><input type="hidden" name="h" value="<%= size.h %>"><input type="hidden" name="layout" value="<%= size.layout %>">
  <input type="hidden" name="since" value="<%= filters.since %>"><input type="hidden" name="location" value="<%= filters.location || '' %>"><input type="hidden" name="color" value="<%= filters.color || '' %>">
  <div class="section-title"><%= rows.length %> cop<%= rows.length === 1 ? 'y' : 'ies' %> in stock, added since <%= filters.since %></div>
  <% if (truncated) { %><p class="notice-box" role="status">Only the first <%= rowLimit %> copies are shown: choose a later date or a location.</p><% } %>
  <% if (!rows.length) { %>
    <p class="muted">No in-stock copies match.</p>
  <% } else { %>
    <p>
      <button class="btn" type="submit">Print labels for the ticked copies</button>
      <button class="btn btn-outline" type="submit" name="all" value="1">Print all <%= rows.length %> shown</button>
    </p>
    <table class="sticker-sheet">
      <thead><tr><th><input type="checkbox" aria-label="Tick all" data-tick-all></th><th>Code</th><th>Sticker</th><th>Price</th><th>Title</th><th>Author</th><th>ISBN</th><th>Location</th></tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td><input type="checkbox" name="id" value="<%= r.id %>" aria-label="Label for <%= r.title %>"></td>
            <td><strong><%= copyCode(r.id) %></strong></td>
            <td><%- include('../../partials/sticker_chip', { level: r.level, text: r.level.label }) %></td>
            <td><%= r.price == null ? '' : '€' + Number(r.price).toFixed(2) %></td>
            <td><a href="/admin/inventory/<%= r.book_id %>"><%= r.title %></a></td>
            <td><%= r.authors || '' %></td>
            <td><%= r.isbn || 'No ISBN' %></td>
            <td><%= r.location || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</form>
<script src="/labels.js"></script>
<%- include('../../partials/admin_footer') %>

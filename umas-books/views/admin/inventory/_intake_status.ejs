<%# The line that says a book was just saved on the one-screen add page. role="status" so a screen reader announces it;
    it holds no focusable thing except the label link, and nothing here takes focus. scan-intake.js fills the same
    region after a save done without leaving the page. %>
<div class="scan-saved" id="scan-saved" role="status" aria-live="polite" data-scan-saved<%= typeof savedCopy !== 'undefined' && savedCopy ? '' : ' hidden' %>>
  <% if (typeof savedCopy !== 'undefined' && savedCopy) { %>
    <span class="scan-saved-text">Saved: <strong><%= savedCopy.title %></strong>.</span>
    <% if (typeof savedRequests !== 'undefined' && savedRequests > 0) { %><span class="scan-saved-requests"><%= savedRequests %> customer<%= savedRequests === 1 ? '' : 's' %> asked for this book. <a href="/admin/requests?status=matched">See the requests</a></span><% } %>
  <% } %>
</div>

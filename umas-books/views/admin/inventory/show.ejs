<%- include('../../partials/admin_header', { title: book.title, active: active, pageTitle: book.title, extraCss: ['/cover-edit.css'] }) %>
<% if (typeof notice !== "undefined" && notice) { %><div class="notice-box" role="status"><%= notice %></div><% } %>

<% if (typeof requestCount !== "undefined" && requestCount > 0) { %><div class="notice-box" role="status"><%= requestCount %> customer<%= requestCount === 1 ? '' : 's' %> asked for this book. <a href="/admin/requests?status=matched&amp;book=<%= book.id %>">See the request<%= requestCount === 1 ? '' : 's' %></a></div><% } %>

<p><a href="/admin/inventory">&larr; Back to inventory</a></p>
<% if (typeof error !== 'undefined' && error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
<p class="muted"><%= book.authors || 'Unknown author' %><%= book.isbn ? ' · ISBN ' + book.isbn : '' %><%= book.categories ? ' · ' + book.categories : '' %></p>

<div class="card" style="display:flex; gap:20px;">
  <% if (book.cover_url) { %>
    <img src="<%= book.cover_url %>" alt="" class="book-cover-preview" style="flex-shrink:0;">
  <% } %>
  <div style="flex:1;">
    <% if (book.publisher) { %><div class="muted small">Publisher: <%= book.publisher %></div><% } %>
    <% const bindingLabel = (bindings.find(x => x.value === book.binding) || {}).label; %>
    <% if (bindingLabel) { %><div class="muted small">Binding: <%= bindingLabel %></div><% } %>
    <% if (book.published_year) { %><div class="muted small">Published: <%= book.published_year %></div><% } %>
    <% if (book.description) { %><p style="margin-top:10px;"><%= book.description %></p><% } %>

    <details style="margin-top:14px;">
      <summary style="cursor:pointer; color: var(--maroon);">Edit details</summary>
      <form class="stack" method="post" action="/admin/inventory/<%= book.id %>" enctype="multipart/form-data" style="margin-top:12px;">
        <%- include('../../partials/csrf_field') %>
        <label for="title">Title</label>
        <input id="title" name="title" type="text" required value="<%= book.title %>">
        <label for="author">Author</label>
        <input id="author" name="author" type="text" value="<%= book.authors || '' %>">
        <label for="isbn">ISBN</label>
        <input id="isbn" name="isbn" type="text" value="<%= book.isbn || '' %>">
        <label for="publisher">Publisher</label>
        <input id="publisher" name="publisher" type="text" value="<%= book.publisher || '' %>">
        <label for="publishedYear">Published year</label>
        <input id="publishedYear" name="publishedYear" type="number" value="<%= book.published_year || '' %>">
        <label for="binding">Binding</label>
        <select id="binding" name="binding">
          <option value="">Not specified</option>
          <% bindings.forEach(b => { %><option value="<%= b.value %>" <%= b.value === book.binding ? 'selected' : '' %>><%= b.label %></option><% }) %>
        </select>
        <label for="genre">Genres</label>
        <input id="genre" name="genre" type="text" value="<%= book.categories || '' %>" placeholder="e.g. Fantasy, Fiction — separate multiple with commas">
        <label for="coverUrl">Cover image URL</label>
        <input id="coverUrl" name="coverUrl" type="text" value="<%= book.cover_url || '' %>">
        <% if (!book.cover_url) { %>
          <button type="button" class="btn btn-outline" style="align-self: flex-start;" data-trigger-file="coverPhoto">No cover found — Take or Upload a Photo</button>
          <input id="coverPhoto" name="coverPhoto" type="file" aria-label="Cover photo" accept="image/*" capture="environment" class="file-input-hidden" data-file-name-target="coverPhoto-name">
          <span id="coverPhoto-name" class="muted small file-input-name">No photo selected</span>
          <p class="muted small">A photo overrides the URL above.</p>
        <% } %>
        <label for="description">Description</label>
        <textarea id="description" name="description"><%= book.description || '' %></textarea>
        <div><button type="button" class="btn btn-outline btn-small" data-generate-description="description">Generate description</button></div>
        <div><button class="btn btn-small" type="submit">Save changes</button></div>
      </form>
      <form data-confirm="Delete this book and all of its copies? This can't be undone." method="post" action="/admin/inventory/<%= book.id %>/delete" style="margin-top:10px;">
        <%- include('../../partials/csrf_field') %>
        <button class="btn btn-outline btn-small" type="submit">Delete this book</button>
      </form>
    </details>
  </div>
</div>

<div class="card" id="cover" data-cover-edit>
  <div class="section-title">Cover</div>
  <% if (typeof coverMessage !== "undefined" && coverMessage) { %>
    <div class="<%= coverMessage.error ? 'error-box' : 'notice-box' %> cvr-message" tabindex="-1" data-cover-message <%- coverMessage.error ? 'role="alert"' : 'role="status"' %>><%= coverMessage.text %></div>
  <% } %>
  <p class="visually-hidden" role="status" aria-live="polite" data-cover-live></p>
  <div class="cvr-body">
    <div class="cvr-preview">
      <% if (cover.preview) { %>
        <img class="cvr-img" src="<%= cover.preview %>" alt="Current cover of <%= book.title %>" data-cover-img>
      <% } else { %>
        <div class="cvr-empty"><%= cover.external ? 'Cover not saved on our server' : 'No cover' %></div>
      <% } %>
    </div>
    <div class="cvr-side">
      <% if (cover.external) { %>
        <p class="muted small cvr-note">This cover is an old web address that is not saved on our server, so it can't be rotated or cropped. Replace it with a photo, or remove it.</p>
      <% } else if (!cover.url) { %>
        <p class="muted small cvr-note">This book has no cover. Press Find a cover to pick one from Open Library, or take a photo of the front, or choose one from your files.</p>
      <% } else { %>
        <p class="muted small cvr-note">Changes are saved at once. The picture you replace is cleaned up automatically later.</p>
      <% } %>
      <div class="cvr-actions">
        <a class="btn btn-outline btn-small" href="/admin/inventory/<%= book.id %>/find-cover?go=1">Find a cover</a>
        <form method="post" action="/admin/inventory/<%= book.id %>/cover/replace" enctype="multipart/form-data">
          <%- include('../../partials/csrf_field') %>
          <button type="button" class="btn btn-outline btn-small" data-trigger-file="cover-photo"><%= cover.url ? 'Replace cover photo' : 'Add cover photo' %></button>
          <input id="cover-photo" name="coverPhoto" type="file" aria-label="<%= cover.url ? 'Replace cover photo' : 'Add cover photo' %>" accept="image/*" capture="environment" class="file-input-hidden" data-file-name-target="cover-photo-name" data-max-bytes="8388608" data-max-label="8 MB" data-auto-submit-file>
          <span id="cover-photo-name" class="visually-hidden"></span>
          <noscript><label for="cover-photo-plain">Photo</label> <input id="cover-photo-plain" name="coverPhoto" type="file" accept="image/*"> <button class="btn btn-small" type="submit">Upload</button></noscript>
        </form>
        <% if (cover.stored) { %>
          <form method="post" action="/admin/inventory/<%= book.id %>/cover/rotate">
            <%- include('../../partials/csrf_field') %>
            <button class="btn btn-outline btn-small" type="submit" name="direction" value="left"><span aria-hidden="true">&#8634;</span> Rotate left</button>
            <button class="btn btn-outline btn-small" type="submit" name="direction" value="right"><span aria-hidden="true">&#8635;</span> Rotate right</button>
          </form>
          <button type="button" class="btn btn-outline btn-small" data-cover-crop-open hidden aria-expanded="false" aria-controls="cover-crop">Crop</button>
        <% } %>
        <% if (cover.url) { %>
          <form method="post" action="/admin/inventory/<%= book.id %>/cover/remove" data-confirm="Remove this book's cover? The book will show &quot;No cover&quot; until you add one.">
            <%- include('../../partials/csrf_field') %>
            <button class="btn btn-outline btn-small" type="submit">Remove cover</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
  <% if (cover.stored) { %>
    <div class="cvr-crop" id="cover-crop" data-cover-crop hidden>
      <p class="muted small" id="cover-crop-help">Drag the box, or its corners, to choose the part to keep. You can also drag on the picture to draw a new box. With a keyboard, focus the box: arrow keys move it, Shift plus arrow keys change its size, Escape cancels.</p>
      <div class="cvr-stage" data-cover-stage>
        <img class="cvr-stage-img" src="<%= cover.preview %>" alt="" data-cover-stage-img>
        <div class="cvr-overlay" data-cover-overlay>
          <div class="cvr-box" tabindex="0" role="group" aria-label="Crop area" aria-describedby="cover-crop-help" data-cover-box>
            <span class="cvr-handle" data-handle="nw"></span><span class="cvr-handle" data-handle="ne"></span><span class="cvr-handle" data-handle="sw"></span><span class="cvr-handle" data-handle="se"></span>
          </div>
        </div>
      </div>
      <p class="small cvr-readout" data-cover-readout></p>
      <form class="cvr-crop-form" method="post" action="/admin/inventory/<%= book.id %>/cover/crop" data-cover-crop-form>
        <%- include('../../partials/csrf_field') %>
        <input type="hidden" name="x" value="0"><input type="hidden" name="y" value="0"><input type="hidden" name="w" value="1"><input type="hidden" name="h" value="1">
        <button class="btn btn-small" type="submit">Apply crop</button>
        <button class="btn btn-outline btn-small" type="button" data-cover-reset>Reset</button>
        <button class="btn btn-outline btn-small" type="button" data-cover-cancel>Cancel</button>
      </form>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="section-title">Awards &amp; lists</div>
  <p class="muted small">Found automatically from Wikidata and the New York Times, or typed in by you. All of these show on the book page.</p>
  <% if (!awards.length) { %>
    <p class="muted">None yet.<%= book.awards_checked_at ? ' Last checked ' + formatDate(book.awards_checked_at) + '.' : ' Not checked yet.' %></p>
  <% } else { %>
    <ul class="plain">
      <% awards.forEach(a => { %>
        <li style="margin-bottom:10px;">
          <strong><%= a.label %></strong><%= a.year ? ' (' + a.year + ')' : '' %>
          <span class="muted small">&middot; <%= a.kind %> &middot; <%= a.source %>
            <% if (a.source_url) { %>&middot; <a href="<%= a.source_url %>" target="_blank" rel="noopener noreferrer">source</a><% } %></span>
          <% if (a.source === 'manual') { %>
            <form data-confirm="Remove this award from the book?" method="post" action="/admin/awards/<%= a.id %>/remove" style="display:inline;">
              <%- include('../../partials/csrf_field') %>
              <button class="btn btn-outline btn-small" type="submit">Remove</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
    <% if (book.awards_checked_at) { %><p class="muted small">Last checked <%= formatDate(book.awards_checked_at) %><%= book.awards_check_state === 'error' ? ' (a lookup failed; it will be tried again)' : '' %>.</p><% } %>
  <% } %>
  <form class="stack" method="post" action="/admin/inventory/<%= book.id %>/awards/add" style="margin-top:12px;">
    <%- include('../../partials/csrf_field') %>
    <label for="awards-add">Add awards (comma separated)</label>
    <input id="awards-add" name="awards" type="text" maxlength="1000" placeholder="e.g. Booker Prize (2019), Prix Goncourt (1999)" autocomplete="off">
    <p class="muted small">Add the year in brackets if you know it. These show to customers straight away.</p>
    <div><button class="btn btn-small" type="submit">Add</button></div>
  </form>
  <form method="post" action="/admin/inventory/<%= book.id %>/awards/check" style="margin-top:10px;">
    <%- include('../../partials/csrf_field') %>
    <button class="btn btn-outline btn-small" type="submit">Re-check now</button>
  </form>
</div>

<div class="card">
  <div class="section-title">Copies (<%= copies.length %>)</div>
  <% if (!copies.length) { %>
    <p class="muted">No copies recorded yet.</p>
  <% } else { %>
    <ul class="plain">
      <% copies.forEach(c => { %>
        <% const conditionLabel = (conditions.find(x => x.value === c.condition) || {}).label || c.condition; %>
        <% const statusLabel = (statuses.find(x => x.value === c.status) || {}).label || c.status; %>
        <li>
          <details<%= (typeof suggestFor !== 'undefined' && suggestFor.copyId === c.id) || (typeof openCopyId !== 'undefined' && openCopyId === c.id) ? ' open' : '' %>>
            <summary style="cursor:pointer;">
              <%= conditionLabel %> &middot; <%= statusLabel %><%= c.price != null && c.price !== '' && Number.isFinite(Number(c.price)) ? ' · €' + Number(c.price).toFixed(2) : '' %><%= c.location ? ' · Location ' + c.location : '' %>
            </summary>
            <% const tillCode = 'UB-' + c.id; %>
            <div class="till-code" style="margin-top:10px;">
              Till code: <code class="till-code-value" style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:1.05em;"><%= tillCode %></code>
              <button type="button" class="btn btn-outline btn-small" data-copy-text="<%= tillCode %>">Copy</button>
              <span class="muted small" data-copy-status role="status"></span>
              <div class="muted small">Type this code in the Till scan box.</div>
            </div>
            <% if (c.status === 'reserved' && c.reserved_by_name) { %>
              <div role="status" class="notice-box small" style="margin-top:10px;">
                Reserved by <%= c.reserved_by_name %> &middot; <%= c.reserved_by_email %><%= c.reserved_by_phone ? ' · ' + c.reserved_by_phone : '' %>
                <% if (c.cart_order_id) { %>
                  <div class="muted small">Reserved online, reservation <a href="/admin/orders/<%= c.cart_order_id %>">#<%= c.cart_order_id %></a>: collect it or cancel it from the reservation page.</div>
                <% } else if (c.reserved_at) { %>
                  <div class="muted small">
                    <%= formatDateTime(c.reserved_at) %>
                    &middot; auto-releases <%= formatDate(new Date(new Date(c.reserved_at).getTime() + 14 * 24 * 60 * 60 * 1000)) %>
                  </div>
                <% } %>
                <% if (!c.cart_order_id) { %>
                <form data-confirm="Cancel this reservation and put the copy back in stock?" method="post" action="/admin/inventory/<%= book.id %>/copies/<%= c.id %>/cancel-reservation" style="margin-top:6px;">
                  <%- include('../../partials/csrf_field') %>
                  <button class="btn btn-outline btn-small" type="submit">Cancel reservation &amp; return to stock</button>
                </form>
                <% } %>
              </div>
            <% } %>
            <form class="stack" method="post" action="/admin/inventory/<%= book.id %>/copies/<%= c.id %>" style="margin-top:12px;">
              <%- include('../../partials/csrf_field') %>
              <label for="condition-<%= c.id %>">Condition</label>
              <select id="condition-<%= c.id %>" name="condition">
                <% conditions.forEach(opt => { %><option value="<%= opt.value %>" <%= opt.value === c.condition ? 'selected' : '' %>><%= opt.label %></option><% }) %>
              </select>
              <%# The status this form was rendered with: the save only changes the status when the copy still has it (see the copy route). %>
              <input type="hidden" name="renderedStatus" value="<%= c.rendered_status || c.status %>">
              <label for="status-<%= c.id %>">Status</label>
              <select id="status-<%= c.id %>" name="status">
                <% statuses.forEach(opt => { %><option value="<%= opt.value %>" <%= opt.value === c.status ? 'selected' : '' %>><%= opt.label %></option><% }) %>
              </select>
              <% if (c.status !== 'sold') { %><p class="muted small" id="status-note-<%= c.id %>">Choosing &ldquo;Sold&rdquo; here only changes the status and records the date. It does not record a sale, so the copy will not appear in the Sales report or the Accounting export. To record a sale, sell it at the till.</p><% } %>
              <label for="location-<%= c.id %>">Location</label>
              <input id="location-<%= c.id %>" name="location" type="text" list="location-options" maxlength="40" value="<%= c.location || '' %>" placeholder="Not placed yet" autocomplete="off">
              <label for="source-<%= c.id %>">Source</label>
              <select id="source-<%= c.id %>" name="source">
                <option value="" <%= !c.source ? 'selected' : '' %>>Unknown</option>
                <% sources.forEach(opt => { %><option value="<%= opt.value %>" <%= opt.value === c.source ? 'selected' : '' %>><%= opt.label %></option><% }) %>
              </select>
              <% const suggestedHere = typeof suggestFor !== 'undefined' && suggestFor.copyId === c.id ? suggestFor.suggestion : null; %>
              <%- include('_price_control', {
                idSuffix: '-' + c.id, mode: 'edit', copyId: c.id, condition: c.condition, isClearance: c.is_clearance, chipPublisherPrice: c.publisher_price, suggestion: suggestedHere, priceValue: c.price,
                suggestAction: '/admin/inventory/' + book.id + '/copies/' + c.id + '/suggest',
                selected: c.price != null ? priceUi.keyFor(c.price, c.is_clearance) : '',
              }) %>
              <label for="publisherPrice-<%= c.id %>">Publisher's price (prix &eacute;diteur) (&euro;)<span data-pp-required hidden> *</span></label>
              <input id="publisherPrice-<%= c.id %>" name="publisherPrice" type="number" step="0.01" min="0" value="<%= c.publisher_price != null ? c.publisher_price : '' %>">
              <%- include('_publisher_price_help', { idSuffix: '-' + c.id, condition: c.condition, year: book.published_year, yearFromInput: false, withUseNote: false }) %>
              <label for="acquisitionCost-<%= c.id %>">Acquisition cost (&euro;)</label>
              <input id="acquisitionCost-<%= c.id %>" name="acquisitionCost" type="number" step="0.01" min="0" value="<%= c.acquisition_cost != null ? c.acquisition_cost : '' %>">
              <label for="acquiredAt-<%= c.id %>">Acquisition Date</label>
              <input id="acquiredAt-<%= c.id %>" name="acquiredAt" type="date" value="<%= c.acquired_at ? new Date(c.acquired_at).toLocaleDateString('en-CA') : '' %>">
              <label for="notes-<%= c.id %>">Notes</label>
              <textarea id="notes-<%= c.id %>" name="notes"><%= c.notes || '' %></textarea>
              <div class="muted small">Added <%= formatDate(c.created_at) %></div>
              <div style="display:flex; gap:8px;">
                <button class="btn btn-small" type="submit">Save copy</button>
                <button class="btn btn-outline btn-small" type="submit" form="delete-copy-<%= c.id %>">Delete 1 copy</button>
              </div>
            </form>
            <form id="use-price-<%= c.id %>" method="post" action="/admin/inventory/<%= book.id %>/copies/<%= c.id %>/use-price">
              <%- include('../../partials/csrf_field') %>
            </form>
            <form id="delete-copy-<%= c.id %>" data-confirm="Delete this copy? This can't be undone." method="post" action="/admin/inventory/<%= book.id %>/copies/<%= c.id %>/delete">
              <%- include('../../partials/csrf_field') %>
            </form>
          </details>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('../../partials/location_options') %>
<script src="<%= assetUrl('/price-suggestion.js') %>"></script>
<script src="<%= assetUrl('/cover-edit.js') %>"></script>
<script src="<%= assetUrl('/publisher-price-rule.js') %>"></script>
<script src="<%= assetUrl('/copy-text.js') %>"></script>
<%- include('../../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: 'Add Book', active: active, pageTitle: 'Add Book' }) %>

<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>

<div class="card">
  <% if (book.coverUrl) { %>
    <img src="<%= book.coverUrl %>" alt="" class="book-cover-preview">
  <% } %>
  <form class="stack" method="post" action="/admin/inventory" enctype="multipart/form-data">
    <%- include('../../partials/csrf_field') %>
    <input type="hidden" name="fromScan" value="<%= fromScan ? '1' : '' %>">

    <label for="title">Title</label>
    <input id="title" name="title" type="text" required value="<%= book.title || '' %>">

    <label for="author">Author</label>
    <input id="author" name="author" type="text" value="<%= book.author || '' %>">

    <label for="isbn">ISBN</label>
    <input id="isbn" name="isbn" type="text" value="<%= book.isbn || '' %>">

    <label for="publisher">Publisher</label>
    <input id="publisher" name="publisher" type="text" value="<%= book.publisher || '' %>">

    <label for="publishedYear">Published year</label>
    <input id="publishedYear" name="publishedYear" type="number" value="<%= book.publishedYear || '' %>">

    <label for="genre">Genres</label>
    <input id="genre" name="genre" type="text" value="<%= book.genre || '' %>" placeholder="e.g. Fantasy, Fiction — separate multiple with commas">

    <label for="genreFr">Genres (French)</label>
    <input id="genreFr" name="genreFr" type="text" value="<%= book.genreFr || '' %>" placeholder="Filled in automatically from Genres above if left blank">

    <label for="coverUrl">Cover image URL</label>
    <input id="coverUrl" name="coverUrl" type="text" value="<%= book.coverUrl || '' %>">

    <% if (!book.coverUrl) { %>
      <button type="button" class="btn btn-outline" style="align-self: flex-start;" data-trigger-file="coverPhoto">No cover found — Take or Upload a Photo</button>
      <input id="coverPhoto" name="coverPhoto" type="file" accept="image/*" capture="environment" class="file-input-hidden" data-file-name-target="coverPhoto-name">
      <span id="coverPhoto-name" class="muted small file-input-name">No photo selected</span>
      <p class="muted small">A photo overrides the URL above. Leave both blank to have a cover looked up automatically when you save.</p>
    <% } %>

    <label for="description">Description</label>
    <textarea id="description" name="description"><%= book.description || '' %></textarea>
    <div><button type="button" class="btn btn-outline btn-small" data-generate-description="description" data-generate-description-fr="descriptionFr">Generate description</button></div>
    <p class="muted small">Preview an AI description above, or leave blank to have one generated automatically when you save.</p>

    <label for="descriptionFr">Description (French)</label>
    <textarea id="descriptionFr" name="descriptionFr"><%= book.descriptionFr || '' %></textarea>
    <p class="muted small">Filled in automatically by translating the description above if left blank.</p>

    <div class="section-title" style="margin-top:10px;">This copy</div>
    <p class="muted small">Details for the physical copy you have in hand right now.</p>

    <label for="condition">Condition</label>
    <select id="condition" name="condition">
      <% conditions.forEach(c => { %><option value="<%= c.value %>" <%= c.value === (typeof selectedCondition !== 'undefined' ? selectedCondition : 'good') ? 'selected' : '' %>><%= c.label %></option><% }) %>
    </select>

    <label for="location">Location</label>
    <input id="location" name="location" type="text" list="location-options" maxlength="40" value="<%= location %>" placeholder="e.g. FICTION-A1" data-location-input autocomplete="off">
    <%- include('../../partials/location_options') %>

    <label for="status">Status</label>
    <select id="status" name="status">
      <% statuses.forEach(s => { %><option value="<%= s.value %>" <%= s.value === 'in_stock' ? 'selected' : '' %>><%= s.label %></option><% }) %>
    </select>

    <label for="acquisitionCost">Acquisition cost (&euro;)</label>
    <input id="acquisitionCost" name="acquisitionCost" type="number" step="0.01" min="0" value="<%= defaultPricing.acquisitionCost %>">

    <label for="price">Price (&euro;)</label>
    <input id="price" name="price" type="number" step="0.01" min="0" value="<%= defaultPricing.price %>">

    <label for="publisherPrice">Publisher's price (prix &eacute;diteur) (&euro;)</label>
    <input id="publisherPrice" name="publisherPrice" type="number" step="0.01" min="0" value="<%= typeof publisherPriceValue !== 'undefined' ? publisherPriceValue : '' %>">
    <p class="muted small">Required only when the condition is New. New books must be sold at the publisher's printed price; a discount of up to 5% is allowed (French fixed book price law). Leave Price empty to use the publisher's price.</p>

    <label for="acquiredAt">Acquisition Date</label>
    <input id="acquiredAt" name="acquiredAt" type="date" value="<%= new Date().toLocaleDateString('en-CA') %>">

    <label for="copyNotes">Copy notes (optional)</label>
    <textarea id="copyNotes" name="copyNotes"></textarea>

    <button class="btn" type="submit">Save book</button>
  </form>
</div>

<script src="/inventory-location.js"></script>
<%- include('../../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: 'Add Book', active: active, pageTitle: 'Add Book', compactTop: true, extraCss: ['/scan-intake.css'] }) %>

<%- include('_intake_status') %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>

<%  const q = typeof queried !== 'undefined' ? queried : { binding: true, source: true, condition: true }; // a refused save keeps what was typed %>
<div class="card scan-intake"<% if (!fromScan) { %> data-scan-intake<%= error ? " data-had-error" : "" %> data-binding-set="<%= q.binding ? '1' : '' %>" data-source-set="<%= q.source ? '1' : '' %>" data-condition-set="<%= q.condition ? '1' : '' %>"<% } %>>
  <form class="stack" method="post" action="/admin/inventory" enctype="multipart/form-data" id="intake-form">
    <%- include('../../partials/csrf_field') %>
    <input type="hidden" name="fromScan" value="<%= fromScan ? '1' : '' %>">

    <label for="isbn">ISBN (scan or type)</label>
    <div class="scan-isbn-row">
      <input id="isbn" name="isbn" type="text" inputmode="numeric" pattern="[0-9Xx -]*" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" placeholder="9780143127550" value="<%= book.isbn || '' %>"<%= fromScan ? '' : ' autofocus' %> data-scan-isbn>
      <button class="btn btn-outline" type="submit" formaction="/admin/inventory/lookup" formnovalidate data-scan-lookup-button>Look up</button>
    </div>
    <p class="scan-status" id="scan-status" role="status" aria-live="polite" data-scan-status></p>
    <%# Touch screens only (scan-intake.css). The iOS number pad has no X, and the check digit of an ISBN-10 can be an X: this switches the box to the letter keyboard (or tap 123/ABC on the pad). %>
    <button type="button" class="scan-x-toggle" data-isbn-x aria-pressed="false" aria-describedby="isbn-x-help">My ISBN has an X (letter keyboard)</button>
    <span id="isbn-x-help" hidden>Switches the keyboard to letters so you can type the X. You can also tap 123 or ABC on the number pad.</span>
    <% if (!fromScan) { %>
    <p class="muted small scan-hint"><span class="kbd-hint">Press <kbd>Enter</kbd> after the barcode to look it up. <kbd>Ctrl</kbd>/<kbd>Cmd</kbd>+<kbd>Enter</kbd> saves and starts the next book.</span> <a href="/admin/inventory/scan">Scan with a photo instead</a></p>
    <% } %>

    <details class="scan-kbd-help muted small">
      <summary>On-screen keyboard not showing?</summary>
      <p>A Bluetooth scanner counts as a hardware keyboard and hides the on-screen keyboard. Turn the scanner off, or switch it to its non-keyboard mode, or use the keyboard button in the AssistiveTouch menu (Settings &gt; Accessibility &gt; Touch &gt; AssistiveTouch; menu &gt; Device &gt; More &gt; Keyboard).</p>
    </details>

    <img id="cover-preview" class="book-cover-preview" alt=""<% if (book.coverUrl) { %> src="<%= book.coverUrl %>"<% } else { %> hidden<% } %>>

    <div class="intake-grid">
    <div class="field field-wide">
    <label for="title">Title</label>
    <input id="title" name="title" type="text" required autocomplete="off" autocapitalize="sentences" value="<%= book.title || '' %>"<%= (fromScan && book.isbn && !book.title) ? ' autofocus' : '' %>>
    </div>

    <div class="field">
    <label for="author">Author</label>
    <input id="author" name="author" type="text" autocomplete="off" autocapitalize="words" value="<%= book.author || '' %>">
    </div>

    <div class="field">
    <label for="binding">Binding</label>
    <select id="binding" name="binding">
      <option value="">Not specified</option>
      <% bindings.forEach(b => { %><option value="<%= b.value %>" <%= b.value === book.binding ? 'selected' : '' %>><%= b.label %></option><% }) %>
    </select>
    <p class="muted small scan-binding-hint" id="binding-hint" data-binding-hint aria-live="polite"></p>
    </div>

    <div class="field">
    <label for="condition">Condition</label>
    <select id="condition" name="condition">
      <% conditions.forEach(c => { %><option value="<%= c.value %>" <%= c.value === (typeof selectedCondition !== 'undefined' ? selectedCondition : 'very_good') ? 'selected' : '' %>><%= c.label %></option><% }) %>
    </select>
    </div>

    <div class="field">
    <label for="location">Location</label>
    <input id="location" name="location" type="text" list="location-options" maxlength="40" value="<%= location %>" placeholder="e.g. Store or Fiction A1" data-location-input<%= typeof locationQueried !== 'undefined' && locationQueried ? '' : ' data-location-default' %> autocomplete="off" autocapitalize="off" enterkeyhint="next">
    </div>
    <%- include('../../partials/location_options') %>

    <div class="field">
    <label for="source">Source</label>
    <select id="source" name="source">
      <option value="" <%= !source ? 'selected' : '' %>>Unknown</option>
      <% sources.forEach(s => { %><option value="<%= s.value %>" <%= s.value === source ? 'selected' : '' %>><%= s.label %></option><% }) %>
    </select>
    </div>

    </div>

    <%- include('_price_control', {
      idSuffix: '', mode: 'intake', condition: typeof selectedCondition !== 'undefined' ? selectedCondition : 'very_good', chipPublisherPrice: typeof publisherPriceValue !== 'undefined' ? publisherPriceValue : '', suggestAction: '/admin/inventory/suggest',
      suggestion: (typeof priceSuggestion !== 'undefined' && (book.isbn || book.title)) ? priceSuggestion : null, // no "Manual review" alert on a blank form
      priceValue: defaultPricing.price,
      selected: typeof priceLevelSelected !== 'undefined' && priceLevelSelected !== undefined ? priceLevelSelected
        : (typeof priceSuggestion !== 'undefined' && priceSuggestion && priceSuggestion.price != null ? priceUi.keyFor(priceSuggestion.price, priceSuggestion.level === 'clearance') : ''),
    }) %>

    <% if (typeof clearanceOthers !== 'undefined' && clearanceOthers.length) { %>
      <div class="notice-box" role="status">
        This book is going on clearance, and the shop is set to put <strong>all</strong> its copies on clearance.
        These <%= clearanceOthers.length %> other cop<%= clearanceOthers.length === 1 ? 'y' : 'ies' %> would also be repriced:
        <%= clearanceOthers.map(o => (o.price != null ? '€' + Number(o.price).toFixed(2) : 'no price')).join(', ') %>.
        <label class="ann-check"><input type="checkbox" name="repriceOthers" value="1"> Also reprice the other <%= clearanceOthers.length %> cop<%= clearanceOthers.length === 1 ? 'y' : 'ies' %></label>
      </div>
    <% } %>

    <details class="scan-more"<%= !fromScan || error ? ' open' : '' %> data-scan-more>
    <summary>More details (publisher, year, genres, description, cost, notes)</summary>
    <div class="stack-inner">
    <p class="muted small" id="no-isbn">No ISBN? That is fine: <strong>enter the details by hand</strong>. The title is the only required field. Every copy gets a label (UB-…) that the till scans, with or without an ISBN.</p>

    <label for="publisher">Publisher</label>
    <input id="publisher" name="publisher" type="text" value="<%= book.publisher || '' %>">

    <label for="publishedYear">Published year</label>
    <input id="publishedYear" name="publishedYear" type="number" value="<%= book.publishedYear || '' %>">

    <label for="genre">Genres</label>
    <input id="genre" name="genre" type="text" value="<%= book.genre || '' %>" placeholder="e.g. Fantasy, Fiction — separate multiple with commas">

    <label for="genreFr">Genres (French)</label>
    <input id="genreFr" name="genreFr" type="text" value="<%= book.genreFr || '' %>" placeholder="Filled in automatically from Genres above if left blank">

    <label for="coverUrl">Cover image URL</label>
    <input id="coverUrl" name="coverUrl" type="text" value="<%= book.coverUrl || '' %>">

    <% if (!book.coverUrl) { %>
      <button type="button" class="btn btn-outline" style="align-self: flex-start;" data-trigger-file="coverPhoto">No cover found — Take or Upload a Photo</button>
      <input id="coverPhoto" name="coverPhoto" type="file" aria-label="Cover photo" accept="image/*" capture="environment" class="file-input-hidden" data-file-name-target="coverPhoto-name">
      <span id="coverPhoto-name" class="muted small file-input-name">No photo selected</span>
      <p class="muted small">A photo overrides the URL above. Leave both blank to have a cover looked up automatically when you save.</p>
    <% } %>

    <label for="description">Description</label>
    <textarea id="description" name="description"><%= book.description || '' %></textarea>
    <div><button type="button" class="btn btn-outline btn-small" data-generate-description="description" data-generate-description-fr="descriptionFr">Generate description</button></div>
    <p class="muted small">Preview an AI description above, or leave blank to have one generated automatically when you save.</p>

    <label for="descriptionFr">Description (French)</label>
    <textarea id="descriptionFr" name="descriptionFr"><%= book.descriptionFr || '' %></textarea>
    <p class="muted small">Filled in automatically by translating the description above if left blank.</p>

    <div class="section-title" style="margin-top:10px;">This copy</div>
    <p class="muted small">Condition guide: <% conditions.forEach(c => { %><strong><%= c.label %>:</strong> <%= c.description %> <% }) %></p>

    <label for="status">Status</label>
    <select id="status" name="status">
      <% statuses.forEach(s => { %><option value="<%= s.value %>" <%= s.value === 'in_stock' ? 'selected' : '' %>><%= s.label %></option><% }) %>
    </select>

    <label for="acquisitionCost">Acquisition cost (&euro;)</label>
    <input id="acquisitionCost" name="acquisitionCost" type="number" step="0.01" min="0" value="<%= defaultPricing.acquisitionCost %>">

    <label for="publisherPrice">Publisher's price (prix &eacute;diteur) (&euro;)</label>
    <input id="publisherPrice" name="publisherPrice" type="number" step="0.01" min="0" value="<%= typeof publisherPriceValue !== 'undefined' ? publisherPriceValue : '' %>">
    <p class="muted small">Required only when the condition is New. New books must be sold at the publisher's printed price; a discount of up to 5% is allowed (French fixed book price law). Leave Price empty to use the publisher's price.</p>

    <label for="acquiredAt">Acquisition Date</label>
    <input id="acquiredAt" name="acquiredAt" type="date" value="<%= new Date().toLocaleDateString('en-CA') %>">

    <label for="copyNotes">Copy notes (optional)</label>
    <textarea id="copyNotes" name="copyNotes"><%= typeof copyNotesValue !== 'undefined' ? copyNotesValue : '' %></textarea>

    </div>
    </details>

    <div class="form-actions-sticky" data-scan-actions>
    <div class="scan-actions">
      <button class="btn scan-save-next" type="submit" name="fast" value="1" data-scan-save-next>Save and add another</button>
    </div>
    </div>
    <button class="btn btn-outline scan-save-view" type="submit" name="fast" value="0">Save book</button>
  </form>
</div>

<script src="/inventory-location.js"></script>
<script src="/price-suggestion.js"></script>
<script src="/scan-intake.js"></script>
<%- include('../../partials/admin_footer') %>

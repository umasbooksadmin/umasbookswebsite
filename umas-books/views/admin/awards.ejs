<%- include('../partials/admin_header', { title: 'Awards to review', active: active, pageTitle: 'Awards to review', pageSub: 'Awards and best-seller lists suggested by AI. Customers do not see them until you approve them.' }) %>
<% if (notice) { %><div class="notice-box" role="status"><%= notice %></div><% } %>

<div class="card">
  <div class="section-title">Status</div>
  <ul class="plain">
    <li>Books checked for awards: <strong><%= counts.checked %></strong>. Not checked yet: <strong><%= counts.unchecked %></strong>. Last check failed (will retry): <strong><%= counts.errors %></strong>.</li>
    <% if (!lookupsOn) { %>
      <li>Award lookups are switched off on this server (AWARDS_LOOKUPS).</li>
    <% } %>
    <% if (aiOn) { %>
      <li>AI web search today: <strong><%= usage.used %></strong> of <strong><%= usage.max %></strong> books.</li>
    <% } else { %>
      <li>AI web search is switched off. Awards come only from Wikidata and the New York Times list (if set up), and you can add awards by hand on each book.</li>
    <% } %>
  </ul>
</div>

<div class="card">
  <div class="section-title">Waiting for your decision (<%= pending.length %>)</div>
  <% if (!pending.length) { %>
    <p class="muted">Nothing to review right now.</p>
  <% } else { %>
    <p class="muted small">Open the source link and check it really says this about this book before you approve. When unsure, reject.</p>
    <form method="post" action="/admin/awards/approve-bulk" id="bulk-approve">
      <%- include('../partials/csrf_field') %>
    </form>
    <div style="overflow-x:auto;">
      <table class="ann-table">
        <thead>
          <tr>
            <th>Select</th>
            <th>Book</th>
            <th>Award or list</th>
            <th>Source</th>
            <th>Decision</th>
          </tr>
        </thead>
        <tbody>
          <% pending.forEach(function (a) { %>
            <tr>
              <td><input type="checkbox" name="ids" value="<%= a.id %>" form="bulk-approve" aria-label="Select <%= a.label %>"></td>
              <td><a href="/admin/inventory/<%= a.book_id %>"><%= a.title %></a><% if (a.authors) { %><div class="muted small"><%= a.authors %></div><% } %></td>
              <td><%= a.label %><%= a.year ? ' (' + a.year + ')' : '' %><div class="muted small"><%= a.kind %></div></td>
              <td><% if (a.source_url) { %><a href="<%= a.source_url %>" target="_blank" rel="noopener noreferrer">Open source</a><% } else { %><span class="muted">none</span><% } %></td>
              <td>
                <form method="post" action="/admin/awards/<%= a.id %>/approve" style="display:inline;">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="returnTo" value="review">
                  <button class="btn btn-small" type="submit">Approve</button>
                </form>
                <form method="post" action="/admin/awards/<%= a.id %>/reject" style="display:inline;">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="returnTo" value="review">
                  <button class="btn btn-outline btn-small" type="submit">Reject</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p style="margin-top:12px;"><button class="btn btn-small" type="submit" form="bulk-approve">Approve selected</button></p>
  <% } %>
</div>

<%- include('../partials/admin_footer') %>

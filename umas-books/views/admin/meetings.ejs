<%- include('../partials/admin_header', { title: 'Meetings', active: active, pageTitle: 'Meetings' }) %>

<p class="muted small">Click a day to schedule a meeting there.</p>

<div class="card">
  <div class="calendar-nav">
    <a class="btn btn-outline btn-small" href="/admin/meetings?month=<%= prevMonth %>">&larr; Prev</a>
    <span class="month-label"><%= monthLabel %></span>
    <a class="btn btn-outline btn-small" href="/admin/meetings?month=<%= nextMonth %>">Next &rarr;</a>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <details class="calendar-pill calendar-add-pill">
              <summary>+ Add meeting</summary>
              <div class="calendar-pill-body">
                <form class="stack" method="post" action="/admin/meetings">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="month" value="<%= currentMonth %>">
                  <input type="hidden" name="date" value="<%= day.dateKey %>">
                  <label for="title-new-<%= day.dateKey %>">Title</label>
                  <input id="title-new-<%= day.dateKey %>" name="title" type="text" required placeholder="Board Meeting">
                  <label for="time-new-<%= day.dateKey %>">Time</label>
                  <input id="time-new-<%= day.dateKey %>" name="time" type="time" required>
                  <label for="loc-new-<%= day.dateKey %>">Location (optional)</label>
                  <input id="loc-new-<%= day.dateKey %>" name="location" type="text" placeholder="Uma's Books, back room">
                  <label for="agenda-new-<%= day.dateKey %>">Agenda (optional)</label>
                  <textarea id="agenda-new-<%= day.dateKey %>" name="agenda"></textarea>
                  <div><button class="btn btn-small" type="submit">Schedule</button></div>
                </form>
              </div>
            </details>
            <% day.items.forEach(m => { %>
              <details class="calendar-pill">
                <summary><%= m.title %> &middot; <%= formatTime(m.scheduled_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(m.scheduled_at) %><%= m.location ? ' · ' + m.location : '' %>
                    &middot; <%= m.rsvp_count %> going
                  </div>
                  <% if (m.agenda) { %><div class="muted small"><em>Agenda:</em> <%= m.agenda %></div><% } %>

                  <form class="stack" method="post" action="/admin/meetings/<%= m.id %>/minutes?month=<%= currentMonth %>" style="margin-top:10px;">
                    <%- include('../partials/csrf_field') %>
                    <label for="minutes-<%= m.id %>">Minutes</label>
                    <textarea id="minutes-<%= m.id %>" name="minutes" placeholder="Add or edit minutes&hellip;"><%= m.minutes || '' %></textarea>
                    <div>
                      <button class="btn btn-small" type="submit">Save minutes</button>
                    </div>
                  </form>

                  <form method="post" action="/admin/meetings/<%= m.id %>/delete?month=<%= currentMonth %>" style="margin-top:8px;">
                    <%- include('../partials/csrf_field') %>
                    <button class="btn btn-outline btn-small" type="submit">Delete meeting</button>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('../partials/admin_footer') %>

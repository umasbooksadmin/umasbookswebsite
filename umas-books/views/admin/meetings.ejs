<%- include('../partials/admin_header', { title: 'Meetings', active: active, pageTitle: 'Meetings', mainWide: view === 'week' }) %>

<% if (typeof error !== "undefined" && error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<%# What was typed in a refused form is shown back in it (display only). %>
<% const ov = typeof formOverlay !== "undefined" && formOverlay ? formOverlay : null; %>
<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>

<p class="muted small">Click a day to schedule a meeting there.</p>

<div class="card">
  <div class="calendar-nav">
    <div class="calendar-nav-main">
      <a class="btn btn-outline btn-small" href="/admin/meetings?<%= prevHref %>">&larr; Prev</a>
      <span class="month-label"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a class="btn btn-outline btn-small" href="/admin/meetings?<%= nextHref %>">Next &rarr;</a>
    </div>
    <div class="calendar-view-toggle">
      <a href="/admin/meetings" class="btn btn-outline btn-small<%= view === 'month' ? ' is-active' : '' %>">Month</a>
      <a href="/admin/meetings?view=week" class="btn btn-outline btn-small<%= view === 'week' ? ' is-active' : '' %>">Week</a>
    </div>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% const nv = ov && ov.newDate === day.dateKey ? ov.values : null; %>
            <details class="calendar-pill calendar-add-pill"<%= nv ? ' open' : '' %>>
              <summary>+ Add meeting</summary>
              <div class="calendar-pill-body">
                <form class="stack" method="post" action="/admin/meetings" data-saving-text="Saving&hellip;">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="view" value="<%= view %>">
                  <input type="hidden" name="month" value="<%= view === 'month' ? currentMonth : '' %>">
                  <input type="hidden" name="week" value="<%= view === 'week' ? currentWeek : '' %>">
                  <input type="hidden" name="date" value="<%= day.dateKey %>">
                  <label for="title-new-<%= day.dateKey %>">Title</label>
                  <input id="title-new-<%= day.dateKey %>" name="title" type="text" required placeholder="Board Meeting" value="<%= nv ? nv.title : '' %>">
                  <label for="time-new-<%= day.dateKey %>">Time</label>
                  <input id="time-new-<%= day.dateKey %>" name="time" type="time" required value="<%= nv ? nv.time : '' %>">
                  <label for="loc-new-<%= day.dateKey %>">Location (optional)</label>
                  <input id="loc-new-<%= day.dateKey %>" name="location" type="text" placeholder="Uma's Books, back room" value="<%= nv ? nv.location : '' %>">
                  <label for="agenda-new-<%= day.dateKey %>">Agenda (optional)</label>
                  <textarea id="agenda-new-<%= day.dateKey %>" name="agenda"><%= nv ? nv.agenda : '' %></textarea>
                  <div><button class="btn btn-small" type="submit">Schedule</button></div>
                </form>
              </div>
            </details>
            <% day.items.forEach(m => { %>
              <details class="calendar-pill">
                <summary><%= m.title %> &middot; <%= formatTime(m.scheduled_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(m.scheduled_at) %><%= m.location ? ' · ' + m.location : '' %>
                    &middot; <%= m.rsvp_count %> going
                  </div>
                  <% if (m.agenda) { %><div class="muted small"><em>Agenda:</em> <%= m.agenda %></div><% } %>

                  <form class="stack" method="post" action="/admin/meetings/<%= m.id %>/minutes?<%= qs %>" style="margin-top:10px;">
                    <%- include('../partials/csrf_field') %>
                    <label for="minutes-<%= m.id %>">Minutes</label>
                    <textarea id="minutes-<%= m.id %>" name="minutes" placeholder="Add or edit minutes&hellip;"><%= m.minutes || '' %></textarea>
                    <div>
                      <button class="btn btn-small" type="submit">Save minutes</button>
                    </div>
                  </form>

                  <form data-confirm="Delete this meeting and its RSVPs and minutes? This can't be undone." method="post" action="/admin/meetings/<%= m.id %>/delete?<%= qs %>" style="margin-top:8px;">
                    <%- include('../partials/csrf_field') %>
                    <button class="btn btn-outline btn-small" type="submit">Delete meeting</button>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('../partials/admin_footer') %>

<%- include('../../partials/admin_header', { title: 'Pricing rules', active: active, pageTitle: 'Pricing rules', pageSub: 'How the price suggested for a book is worked out. A suggestion is only a suggestion: you can always change it.' }) %>

<% if (saved) { %><div class="notice-box" role="status">Pricing rules saved.</div><% } %>
<% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>

<%
  const num = (col, o = {}) => `<input name="${col}" type="number" step="${o.step || '0.01'}" min="${o.min || '0'}" ${o.max ? 'max="' + o.max + '"' : ''} required value="${String(form[col]).replace(/"/g, '&quot;')}" style="width:6.5em">`;
%>

<form method="post" action="/admin/pricing">
  <%- include('../../partials/csrf_field') %>

  <div class="card">
    <div class="section-title">The rules, in order (the first one that fits is used)</div>
    <p class="muted small">All prices are in euros. The &ldquo;online value&rdquo; of a book is what used copies of it typically sell for online. The condition of the copy never changes the price.</p>
    <ol>
      <li><strong>New book:</strong> the publisher's price (French fixed book price law). No other rule applies.</li>
      <li><strong>No ISBN:</strong> no price is suggested. A person looks the book up and chooses the price.</li>
      <li><strong>Very valuable books</strong> (not mass market) with an online value of <%- num('c_max') %> EUR or more: no price is suggested. A person checks the listings and chooses the price.</li>
      <li><strong>Clearance:</strong> if the shop already holds <%- num('clearance_after_copies', { step: '1', min: '1', max: '20' }) %> or more copies of the same book (in stock or reserved), and it is a Rule A or mass market book, the next copy goes to the clearance bin at <%- num('clearance_price') %> EUR.</li>
      <li><strong>Mass market paperbacks:</strong> <%- num('mass_market_price') %> EUR, whatever they are worth online.</li>
      <li><strong>Everything else, by online value:</strong>
        <ul>
          <li><strong>Rule A</strong> (popular, plenty of supply): under <%- num('a_max') %> EUR online &rarr; <%- num('a_price') %> EUR.</li>
          <li><strong>Rule B</strong> (mid-range stock): from Rule A's limit up to <%- num('b_max') %> EUR &rarr; <%- num('b_price') %> EUR.</li>
          <li><strong>Rule C</strong> (high value, collectible): from Rule B's limit up to Rule 3's limit &rarr; <%- num('c_factor') %> &times; the online value, rounded to the nearest <%- num('rounding_step') %> EUR.</li>
        </ul>
      </li>
      <li><strong>Hardcover minimum:</strong> a hardcover is never suggested below <%- num('hardcover_min_price') %> EUR (so hardcovers in Rules A and B become this price).</li>
    </ol>
  </div>

  <div class="card">
    <div class="section-title">Clearance options</div>
    <div class="stack">
      <label for="clearance_scope">When a book goes on clearance</label>
      <select id="clearance_scope" name="clearance_scope">
        <option value="extra" <%= form.clearance_scope === 'extra' ? 'selected' : '' %>>Only the new copy</option>
        <option value="all" <%= form.clearance_scope === 'all' ? 'selected' : '' %>>All its copies (when adding the copy, offer to reprice the others too)</option>
      </select>
      <label for="clearance_applies_to">Which books</label>
      <select id="clearance_applies_to" name="clearance_applies_to">
        <option value="set_a" <%= form.clearance_applies_to === 'set_a' ? 'selected' : '' %>>Rule A and mass market books only</option>
        <option value="all_sets" <%= form.clearance_applies_to === 'all_sets' ? 'selected' : '' %>>All books (except new books and books needing review)</option>
      </select>
      <label class="ann-check"><input type="checkbox" name="hardcover_min_applies_to_clearance" value="1" <%= form.hardcover_min_applies_to_clearance ? 'checked' : '' %>> The hardcover minimum also applies on clearance</label>
      <p class="muted small">New books are never put on clearance: French law fixes their price.</p>
    </div>
  </div>

  <div class="card">
    <div class="section-title">Other numbers</div>
    <div class="stack">
      <label for="levels">Standard prices you can pick by hand</label>
      <input id="levels" name="levels" type="text" required value="<%= form.levels %>">
      <p class="muted small">From lowest to highest, separated by commas. Clearance and Custom are always offered as well.</p>
      <label for="used_fraction">When only the publisher's price is known: a used copy is worth about this share of it</label>
      <%- num('used_fraction') %>
      <label>When nothing at all is known, the book's online value is taken to be (EUR)</label>
      <div class="muted small">
        Hardcover <%- num('fallback_hardcover') %>
        Trade <%- num('fallback_trade') %>
        Mass market <%- num('fallback_mass_market') %>
        Unknown or other binding <%- num('fallback_unknown') %>
      </div>
      <label>Exchange rates, for listings in other currencies</label>
      <div class="muted small">
        1 US dollar = <%- num('usd_eur', { step: '0.0001' }) %> EUR
        1 British pound = <%- num('gbp_eur', { step: '0.0001' }) %> EUR
      </div>
    </div>
  </div>

  <p><button class="btn" type="submit">Save pricing rules</button></p>
</form>

<div class="card">
  <div class="section-title">Try it</div>
  <p class="muted small">Shows what the saved rules would suggest. Nothing here changes any price.</p>
  <form method="get" action="/admin/pricing" class="stack" style="max-width:none; flex-direction:row; flex-wrap:wrap; align-items:flex-end; gap:12px;">
    <div><label for="calcMarket">Online value (EUR)</label><br><input id="calcMarket" name="calcMarket" type="number" step="0.01" min="0" value="<%= calc.market %>" style="width:7em"></div>
    <div><label for="calcBinding">Binding</label><br>
      <select id="calcBinding" name="calcBinding">
        <% bindingColumns.forEach(b => { %><option value="<%= b.value %>" <%= calc.binding === b.value ? 'selected' : '' %>><%= b.label %></option><% }) %>
      </select></div>
    <div><label for="calcCopies">Copies already in stock</label><br><input id="calcCopies" name="calcCopies" type="number" min="0" max="1000" value="<%= calc.copies %>" style="width:5em"></div>
    <div><label for="calcIsbn">ISBN</label><br>
      <select id="calcIsbn" name="calcIsbn">
        <option value="yes" <%= calc.isbn ? 'selected' : '' %>>Has an ISBN</option>
        <option value="no" <%= calc.isbn ? '' : 'selected' %>>No ISBN</option>
      </select></div>
    <div><button class="btn btn-small" type="submit">Calculate</button></div>
  </form>
  <% if (calc.result) { %>
    <p style="margin-top:12px;" role="status"><strong><%= calc.result.price == null ? calc.result.message : 'EUR ' + money(calc.result.price) %></strong> &middot; <%= calc.result.rule %></p>
  <% } %>

  <div style="overflow-x:auto; margin-top:16px;">
    <div class="table-scroll"><table class="ann-table">
      <thead>
        <tr><th>Online value (EUR)</th><% bindingColumns.forEach(b => { %><th><%= b.label %></th><% }) %></tr>
      </thead>
      <tbody>
        <% calc.table.forEach(r => { %>
          <tr><td><%= money(r.value) %></td><% r.cells.forEach(c => { %><td><%= c %></td><% }) %></tr>
        <% }) %>
        <tr><td>Any value, no ISBN</td><td colspan="<%= bindingColumns.length %>"><%= calc.noIsbn %></td></tr>
      </tbody>
    </table></div>
  </div>
  <p class="muted small">With no copies in stock yet. A new book always takes the publisher's price.</p>
</div>

<div class="card color-chart" id="price-colors">
  <div class="section-title">Price sticker colours</div>
  <p class="muted small no-print">The colour of the sticker on a book shows its price. The prices follow the saved rules above.</p>
  <div class="table-scroll"><table class="ann-table report-table" aria-label="Price sticker colours">
    <thead><tr><th>Sticker colour</th><th>Price</th><th>When to use</th></tr></thead>
    <tbody>
      <% colorChart.forEach(c => { %>
        <tr data-color="<%= c.key %>">
          <td><span class="color-swatch" aria-hidden="true" style="background:<%= c.hex %>;<%= c.border ? ' border-color:' + c.border + ';' : '' %>"></span> <strong><%= c.name %></strong></td>
          <td><%= c.price %></td>
          <td><%= c.when %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <p class="no-print"><button class="btn btn-small" type="button" onclick="window.print()">Print this chart</button></p>
</div>

<p><a href="/admin/pricing/review">Price check: books priced differently from the suggestion &rarr;</a></p>

<%- include('../../partials/admin_footer') %>

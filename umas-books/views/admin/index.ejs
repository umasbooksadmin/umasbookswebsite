<%- include('../partials/admin_header', { title: 'Dashboard', active: 'overview', pageTitle: 'Welcome back, ' + (locals.user ? user.displayName : ''), pageSub: "Here's what's happening at Uma's Books & Adventures" }) %>

<%
  function pct(now, prev) {
    if (!prev) return null;
    return Math.round(((now - prev) / prev) * 100);
  }
  function trend(now, prev) {
    var p = pct(now, prev);
    if (p === null) return '';
    var cls = p >= 0 ? 'trend-up' : 'trend-down';
    var arrow = p >= 0 ? '↑' : '↓';
    return '<span class="' + cls + '">' + arrow + ' ' + Math.abs(p) + '%</span>';
  }
%>

<div class="admin-stats">
  <div class="admin-stat tone-rose">
    <div class="label">Orders Today</div>
    <div class="value"><%= stats.ordersToday %></div>
    <div class="trend-row"><span>This Month <%= stats.ordersThisMonth %></span> <%- trend(stats.ordersThisMonth, stats.ordersLastMonth) %></div>
  </div>
  <div class="admin-stat tone-green">
    <div class="label">Total Sales</div>
    <div class="value">&euro;<%= Number(stats.salesToday).toFixed(0) %></div>
    <div class="trend-row"><span>This Month &euro;<%= Number(stats.salesThisMonth).toFixed(0) %></span> <%- trend(stats.salesThisMonth, stats.salesLastMonth) %></div>
  </div>
  <div class="admin-stat tone-blue">
    <div class="label">In-Stock Books</div>
    <div class="value"><%= stats.inStockCount %></div>
    <div class="trend-row"><span>Added This Month <%= stats.booksAddedThisMonth %></span> <%- trend(stats.booksAddedThisMonth, stats.booksAddedLastMonth) %></div>
  </div>
  <div class="admin-stat tone-tan">
    <div class="label">Total Accounts</div>
    <div class="value"><%= stats.totalAccounts %></div>
    <div class="trend-row"><span>New This Month <%= stats.newAccountsThisMonth %></span> <%- trend(stats.newAccountsThisMonth, stats.newAccountsLastMonth) %></div>
  </div>
  <div class="admin-stat tone-rose">
    <div class="label">Members</div>
    <div class="value"><%= stats.memberCount %></div>
    <div class="trend-row"><span>Paying members</span></div>
  </div>
</div>


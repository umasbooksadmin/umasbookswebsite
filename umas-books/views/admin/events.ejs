<%- include('../partials/admin_header', { title: 'Events', active: active, pageTitle: 'Events' }) %>

<p class="muted small">Events are public — anyone can view the calendar at <a href="/events">/events</a> and sign up with just a name and email, no account needed. Click a day to add an event there; click an event to see who's signed up.</p>

<div class="card">
  <div class="calendar-nav">
    <a class="btn btn-outline btn-small" href="/admin/events?month=<%= prevMonth %>">&larr; Prev</a>
    <span class="month-label"><%= monthLabel %></span>
    <a class="btn btn-outline btn-small" href="/admin/events?month=<%= nextMonth %>">Next &rarr;</a>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <details class="calendar-pill calendar-add-pill">
              <summary>+ Add event</summary>
              <div class="calendar-pill-body">
                <form class="stack" method="post" action="/admin/events">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="month" value="<%= currentMonth %>">
                  <input type="hidden" name="date" value="<%= day.dateKey %>">
                  <label for="title-new-<%= day.dateKey %>">Title</label>
                  <input id="title-new-<%= day.dateKey %>" name="title" type="text" required>
                  <label for="start-new-<%= day.dateKey %>">Start time</label>
                  <input id="start-new-<%= day.dateKey %>" name="startTime" type="time" required>
                  <label for="end-new-<%= day.dateKey %>">End time (optional)</label>
                  <input id="end-new-<%= day.dateKey %>" name="endTime" type="time">
                  <label for="loc-new-<%= day.dateKey %>">Location (optional)</label>
                  <input id="loc-new-<%= day.dateKey %>" name="location" type="text">
                  <label for="cap-new-<%= day.dateKey %>">Capacity (optional)</label>
                  <input id="cap-new-<%= day.dateKey %>" name="capacity" type="number" min="1">
                  <label for="price-new-<%= day.dateKey %>">Price (&euro;, optional)</label>
                  <input id="price-new-<%= day.dateKey %>" name="price" type="number" min="0" step="0.01" placeholder="Leave blank if free">
                  <div><button class="btn btn-small" type="submit">Add event</button></div>
                </form>
              </div>
            </details>
            <% day.items.forEach(e => { %>
              <% const full = e.capacity != null && e.signup_count >= e.capacity; const signups = signupsByEvent[e.id] || []; %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %>">
                <summary><%= e.title %> &middot; <%= formatTime(e.starts_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(e.starts_at) %><%= e.location ? ' · ' + e.location : '' %>
                    <%= e.capacity != null ? ' · ' + e.signup_count + '/' + e.capacity + ' signed up' : ' · ' + e.signup_count + ' signed up' %>
                    <%= e.price != null ? ' · €' + Number(e.price).toFixed(2) : ' · free' %>
                  </div>
                  <% if (e.description) { %><div class="muted small" style="margin-top:6px;"><%= e.description %></div><% } %>

                  <% if (signups.length) { %>
                    <div class="muted small" style="margin-top:10px; font-variant: small-caps; letter-spacing: 0.06em; color: var(--gold);">Signed up</div>
                    <ul class="plain" style="margin-top:4px;">
                      <% signups.forEach(s => { %>
                        <li style="padding:6px 0;">
                          <%= s.name %> &middot; <span class="muted small"><%= s.email %></span>
                          <form method="post" action="/admin/events/<%= e.id %>/signups/<%= s.id %>/delete?month=<%= currentMonth %>" style="display:inline; margin-left:8px;">
                            <%- include('../partials/csrf_field') %>
                            <button class="btn btn-outline btn-small" type="submit">Remove</button>
                          </form>
                        </li>
                      <% }) %>
                    </ul>
                  <% } %>

                  <details style="margin-top:10px;">
                    <summary style="cursor:pointer; color: var(--maroon);">Edit</summary>
                    <form class="stack" method="post" action="/admin/events/<%= e.id %>?month=<%= currentMonth %>" style="margin-top:10px;">
                      <%- include('../partials/csrf_field') %>
                      <label for="title-<%= e.id %>">Title</label>
                      <input id="title-<%= e.id %>" name="title" type="text" required value="<%= e.title %>">
                      <label for="desc-<%= e.id %>">Description</label>
                      <textarea id="desc-<%= e.id %>" name="description"><%= e.description || '' %></textarea>
                      <label for="loc-<%= e.id %>">Location</label>
                      <input id="loc-<%= e.id %>" name="location" type="text" value="<%= e.location || '' %>">
                      <label for="start-<%= e.id %>">Starts at</label>
                      <input id="start-<%= e.id %>" name="startsAt" type="datetime-local" required value="<%= new Date(e.starts_at.getTime() - e.starts_at.getTimezoneOffset()*60000).toISOString().slice(0,16) %>">
                      <label for="end-<%= e.id %>">Ends at</label>
                      <input id="end-<%= e.id %>" name="endsAt" type="datetime-local" value="<%= e.ends_at ? new Date(e.ends_at.getTime() - e.ends_at.getTimezoneOffset()*60000).toISOString().slice(0,16) : '' %>">
                      <label for="cap-<%= e.id %>">Capacity</label>
                      <input id="cap-<%= e.id %>" name="capacity" type="number" min="1" value="<%= e.capacity != null ? e.capacity : '' %>">
                      <label for="price-<%= e.id %>">Price (&euro;, optional)</label>
                      <input id="price-<%= e.id %>" name="price" type="number" min="0" step="0.01" value="<%= e.price != null ? e.price : '' %>" placeholder="Leave blank if free">
                      <div><button class="btn btn-small" type="submit">Save changes</button></div>
                    </form>
                  </details>

                  <form method="post" action="/admin/events/<%= e.id %>/delete?month=<%= currentMonth %>" style="margin-top:8px;">
                    <%- include('../partials/csrf_field') %>
                    <button class="btn btn-outline btn-small" type="submit">Delete event</button>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('../partials/admin_footer') %>

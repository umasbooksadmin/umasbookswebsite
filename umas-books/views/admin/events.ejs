<%- include('../partials/admin_header', { title: 'Events', active: active, pageTitle: 'Events', mainWide: view === 'week' }) %>

<% if (typeof error !== "undefined" && error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<%- include('../partials/admin_bad_ranges', { rows: badRanges, noun: 'event', path: '/admin/events', editable: true }) %>
<%# What was typed in a refused form is shown back in it (display only). %>
<% const ov = typeof formOverlay !== "undefined" && formOverlay ? formOverlay : null; %>
<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>

<p class="muted small">Events are public — anyone can view the calendar at <a href="/events">/events</a> and sign up with just a name and email, no account needed. Click a day to add an event there; click an event to see who's signed up.</p>

<div class="card">
  <div class="calendar-nav">
    <div class="calendar-nav-main">
      <a class="btn btn-outline btn-small" href="/admin/events?<%= prevHref %>">&larr; Prev</a>
      <span class="month-label"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a class="btn btn-outline btn-small" href="/admin/events?<%= nextHref %>">Next &rarr;</a>
    </div>
    <div class="calendar-view-toggle">
      <a href="/admin/events" class="btn btn-outline btn-small<%= view === 'month' ? ' is-active' : '' %>">Month</a>
      <a href="/admin/events?view=week" class="btn btn-outline btn-small<%= view === 'week' ? ' is-active' : '' %>">Week</a>
    </div>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% const nv = ov && ov.newDate === day.dateKey ? ov.values : null; %>
            <details class="calendar-pill calendar-add-pill"<%= nv ? ' open' : '' %>>
              <summary>+ Add event</summary>
              <div class="calendar-pill-body">
                <form class="stack" method="post" action="/admin/events" data-saving-text="Saving&hellip;">
                  <%- include('../partials/csrf_field') %>
                  <input type="hidden" name="view" value="<%= view %>">
                  <input type="hidden" name="month" value="<%= view === 'month' ? currentMonth : '' %>">
                  <input type="hidden" name="week" value="<%= view === 'week' ? currentWeek : '' %>">
                  <input type="hidden" name="date" value="<%= day.dateKey %>">
                  <label for="title-new-<%= day.dateKey %>">Title</label>
                  <input id="title-new-<%= day.dateKey %>" name="title" type="text" required value="<%= nv ? nv.title : '' %>">
                  <label for="start-new-<%= day.dateKey %>">Start time</label>
                  <input id="start-new-<%= day.dateKey %>" name="startTime" type="time" required value="<%= nv ? nv.startTime : '' %>">
                  <label for="end-new-<%= day.dateKey %>">End time (optional)</label>
                  <input id="end-new-<%= day.dateKey %>" name="endTime" type="time" value="<%= nv ? nv.endTime : '' %>">
                  <label for="loc-new-<%= day.dateKey %>">Location (optional)</label>
                  <input id="loc-new-<%= day.dateKey %>" name="location" type="text" value="<%= nv ? nv.location : '' %>">
                  <label for="cap-new-<%= day.dateKey %>">Capacity (optional)</label>
                  <input id="cap-new-<%= day.dateKey %>" name="capacity" type="number" min="0" max="100000" step="1" value="<%= nv ? nv.capacity : '' %>">
                  <label for="price-new-<%= day.dateKey %>">Price (&euro;, optional)</label>
                  <input id="price-new-<%= day.dateKey %>" name="price" type="number" min="0" step="0.01" placeholder="Leave blank if free" value="<%= nv ? nv.price : '' %>">
                  <div><button class="btn btn-small" type="submit">Add event</button></div>
                </form>
              </div>
            </details>
            <% day.items.forEach(e => { %>
              <% const ev = ov && ov.eventId === e.id ? ov.values : null; const vals = Object.assign({}, e, ev || {}); %>
              <% const full = e.capacity != null && e.signup_count >= e.capacity; const signups = signupsByEvent[e.id] || []; %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %>"<%= ev ? ' open' : '' %>>
                <summary><%= e.title %> &middot; <%= formatTime(e.starts_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(e.starts_at) %><%= e.location ? ' · ' + e.location : '' %>
                    <%= e.capacity != null ? ' · ' + e.signup_count + '/' + e.capacity + ' signed up' : ' · ' + e.signup_count + ' signed up' %>
                    <%= e.price != null ? ' · €' + Number(e.price).toFixed(2) : ' · free' %>
                  </div>
                  <% if (e.description) { %><div class="muted small" style="margin-top:6px;"><%= e.description %></div><% } %>
                  <% const _frs = fr.frenchState('event', e); %>
                  <div class="muted small fr-flag">French: <span class="status-pill <%= fr.FRENCH_PILL[_frs] %>"><%= fr.FRENCH_LABELS[_frs] %></span></div>

                  <% if (signups.length) { %>
                    <div class="muted small" style="margin-top:10px; font-variant: small-caps; letter-spacing: 0.06em; color: var(--gold-dark);">Signed up</div>
                    <ul class="plain" style="margin-top:4px;">
                      <% signups.forEach(s => { %>
                        <li style="padding:6px 0;">
                          <%= s.name %> &middot; <span class="muted small"><%= s.email %></span>
                          <form data-confirm="Remove this sign-up? This can't be undone." method="post" action="/admin/events/<%= e.id %>/signups/<%= s.id %>/delete?<%= qs %>" style="display:inline; margin-left:8px;">
                            <%- include('../partials/csrf_field') %>
                            <button class="btn btn-outline btn-small" type="submit">Remove</button>
                          </form>
                        </li>
                      <% }) %>
                    </ul>
                  <% } %>

                  <details style="margin-top:10px;"<%= ev ? ' open' : '' %>>
                    <summary style="cursor:pointer; color: var(--maroon);">Edit</summary>
                    <form class="stack" method="post" action="/admin/events/<%= e.id %>?<%= qs %>" style="margin-top:10px;">
                      <%- include('../partials/csrf_field') %>
                      <label for="title-<%= e.id %>">Title</label>
                      <input id="title-<%= e.id %>" name="title" type="text" required value="<%= vals.title %>">
                      <label for="desc-<%= e.id %>">Description</label>
                      <textarea id="desc-<%= e.id %>" name="description"><%= vals.description || '' %></textarea>
                      <label for="loc-<%= e.id %>">Location</label>
                      <input id="loc-<%= e.id %>" name="location" type="text" value="<%= vals.location || '' %>">
                      <label for="start-<%= e.id %>">Starts at</label>
                      <input id="start-<%= e.id %>" name="startsAt" type="datetime-local" required value="<%= ev ? ev.startsAt : new Date(e.starts_at.getTime() - e.starts_at.getTimezoneOffset()*60000).toISOString().slice(0,16) %>">
                      <label for="end-<%= e.id %>">Ends at</label>
                      <input id="end-<%= e.id %>" name="endsAt" type="datetime-local" value="<%= ev ? ev.endsAt : (e.ends_at ? new Date(e.ends_at.getTime() - e.ends_at.getTimezoneOffset()*60000).toISOString().slice(0,16) : '') %>">
                      <label for="cap-<%= e.id %>">Capacity</label>
                      <input id="cap-<%= e.id %>" name="capacity" type="number" min="0" max="100000" step="1" value="<%= ev ? ev.capacity : (e.capacity != null ? e.capacity : '') %>">
                      <label for="price-<%= e.id %>">Price (&euro;, optional)</label>
                      <input id="price-<%= e.id %>" name="price" type="number" min="0" step="0.01" value="<%= ev ? ev.price : (e.price != null ? e.price : '') %>" placeholder="Leave blank if free">
                      <%- include('../partials/admin_french_fields', { kind: 'event', idp: 'ev-' + e.id, fr, noun: 'event', saveLabel: 'Save changes',
                           values: vals, englishRow: e,
                           fields: [{ name: 'title', label: 'Title', type: 'text' }, { name: 'description', label: 'Description', type: 'textarea' }, { name: 'location', label: 'Location', type: 'text' }] }) %>
                      <div><button class="btn btn-small" type="submit">Save changes</button></div>
                    </form>
                  </details>

                  <form data-confirm="Delete this event and all of its sign-ups? This can't be undone." method="post" action="/admin/events/<%= e.id %>/delete?<%= qs %>" style="margin-top:8px;">
                    <%- include('../partials/csrf_field') %>
                    <button class="btn btn-outline btn-small" type="submit">Delete event</button>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<script src="<%= assetUrl('/french-translate.js') %>"></script>
<%- include('../partials/admin_footer') %>

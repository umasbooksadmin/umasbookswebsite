<%- include('../partials/admin_header', { title: 'Accounts', active: active, pageTitle: 'Accounts' }) %>


<div class="card">
  <ul class="plain">
    <% members.forEach(m => { %>
      <li style="display:flex; align-items:center; gap:10px; padding:6px 0;">
        <span>
          <strong><%= m.display_name %></strong> &middot; <%= m.email %><%= m.is_admin ? ' · admin' : '' %>
          <% if (m.is_member) { %> &middot; <span class="status-pill paid">Member</span><% } %>
          <% if (m.member_expires_at) { %> <span class="muted small">(<%= new Date(m.member_expires_at) < new Date() ? 'expired' : 'renews' %> <%= formatDate(m.member_expires_at) %>)</span><% } %>
        </span>
        <span style="margin-left:auto; display:flex; gap:8px;">
          <form method="post" action="/admin/members/<%= m.id %>/toggle-member">
            <%- include('../partials/csrf_field') %>
            <button type="submit" class="btn btn-outline btn-small"><%= m.is_member ? 'Remove member status' : 'Mark as member' %></button>
          </form>
          <% if (m.id !== user.id) { %>
            <form method="post" action="/admin/members/<%= m.id %>/toggle-admin">
              <%- include('../partials/csrf_field') %>
              <button type="submit" class="btn btn-outline btn-small"><%= m.is_admin ? 'Remove admin' : 'Make admin' %></button>
            </form>
          <% } %>
        </span>
      </li>
    <% }) %>
  </ul>
</div>

<%- include('../partials/admin_footer') %>

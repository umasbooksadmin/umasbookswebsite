<%- include('../partials/admin_header', { title: 'Privacy requests', active: active, pageTitle: 'Privacy requests', pageSub: 'Everything held under one email address: look it up, download it, or erase it. Every step is logged (the address itself is not).' }) %>
<%
  const c = records ? records.counts : null;
  const rows = c ? [
    ['Accounts', c.accounts], ['Reservations and sales (kept anonymised if paid, 10 years)', c.orders], ['Book reservations', c.reservations],
    ['Event sign-ups', c.eventSignups], ['Class sign-ups', c.classSignups], ['Book requests', c.bookRequests],
    ['Membership payments (kept anonymised)', c.membershipPayments], ['of which unmatched to an account', c.unmatchedPayments],
    ['Stored emails (subject and date only)', c.emails], ['of which contact / volunteer / pre-registration form mail', c.contactForms],
    ['Book-request "find my requests" links', c.bookRequestLinks]
  ] : [];
%>
<% if (typeof done !== 'undefined' && done) { %><div class="notice-box" role="status">Done. Everything held under that address was erased or anonymised. Now also search the Gmail inbox (contact, volunteer and pre-registration mail) and note the request in docs/privacy/requests-log.md. See the runbook, "A data request".</div><% } %>
<% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>

<div class="card">
  <form method="post" action="/admin/privacy/search">
    <%- include('../partials/csrf_field') %>
    <label for="pr-email">Email address</label>
    <input id="pr-email" type="email" name="email" value="<%= email %>" maxlength="200" required autocomplete="off">
    <button class="btn btn-small" type="submit">Look up</button>
  </form>
  <p class="muted small">Check the person's identity first (a reply from that address, or proof). Gmail mail (contact form, volunteer sign-up, pre-registration) is not in this list: search the inbox by hand.</p>
</div>

<% if (records) { %>
<div class="card">
  <h2>Held under this address</h2>
  <p><strong><%= email %></strong></p>
  <table class="ann-table"><tbody>
    <% rows.forEach(function (r) { %><tr><th scope="row"><%= r[0] %></th><td><%= r[1] %></td></tr><% }) %>
  </tbody></table>
  <% if (mode === 'confirm') { %>
    <form method="post" action="/admin/privacy/erase">
      <%- include('../partials/csrf_field') %>
      <input type="hidden" name="email" value="<%= email %>">
      <p>This cannot be undone. Accounts, sign-ups, reservations, book requests and stored emails are deleted; sales and payment records stay without any name, email or phone (10-year accounting rule). Type the address again to confirm.</p>
      <label for="pr-confirm">Type the address</label>
      <input id="pr-confirm" type="text" name="confirmEmail" maxlength="200" required autocomplete="off">
      <button class="btn btn-small" type="submit">Erase everything for this address</button>
    </form>
  <% } else { %>
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
      <form method="post" action="/admin/privacy/export">
        <%- include('../partials/csrf_field') %>
        <input type="hidden" name="email" value="<%= email %>">
        <button class="btn btn-outline btn-small" type="submit">Download everything (JSON)</button>
      </form>
      <form method="post" action="/admin/privacy/erase-confirm">
        <%- include('../partials/csrf_field') %>
        <input type="hidden" name="email" value="<%= email %>">
        <button class="btn btn-outline btn-small" type="submit">Erase everything for this address</button>
      </form>
    </div>
  <% } %>
</div>
<% } %>

<%- include('../partials/admin_footer') %>

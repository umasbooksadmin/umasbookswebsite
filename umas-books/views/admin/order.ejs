<%- include('../partials/admin_header', { title: 'Reservation #' + order.id, active: 'orders', pageTitle: 'Reservation #' + order.id, pageSub: 'All times are Paris time.' }) %>

<p><a href="/admin/orders">&larr; All reservations</a></p>

<% if (notice) { %><div class="notice-box" role="status"><%= notice %></div><% } %>
<% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>

<%
  const hasBooks = items.some(i => i.book_copy_id != null);
  const days = order.paid_at ? Math.floor((Date.now() - new Date(order.paid_at).getTime()) / 86400000) : null;
  const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
  const statusText = order.status === 'reserved' ? 'Reserved: awaiting pickup' : cap(order.status);
  const activeItems = items.filter(i => i.active);
  const methodLabel = (v) => (paymentMethods.find(m => m.value === v) || {}).label || v;
  const fv = formValues || {};
%>

<% if (order.status === 'paid' && !order.collected_at && hasBooks && days !== null && days >= overdueDays) { %>
  <div class="notice-box" role="status">Paid online <%= days %> days ago and not collected (a reservation from before payment moved to the shop).</div>
<% } %>
<% if (order.status === 'reserved' && order.reserved_until && new Date(order.reserved_until) < new Date()) { %>
  <div class="error-box" role="alert">This reservation is past its deadline and will be released automatically. If the customer is here now, you can still collect it.</div>
<% } %>

<div class="card">
  <div class="order-row">
    <span class="status-pill <%= order.status %>"><%= statusText %></span>
    <% if (order.status === 'paid' && order.collected_at) { %><span class="status-pill completed">Collected</span><% } %>
    <strong>&euro;<%= Number(order.total_amount).toFixed(2) %></strong>
    <% if (order.reserved_total != null) { %><span class="muted small">(reserved for &euro;<%= Number(order.reserved_total).toFixed(2) %>)</span><% } %>
  </div>
  <% if (order.status === 'reserved') { %>
    <p class="small" id="reservation-deadline">
      <% if (hasBooks && lastDay) { %>Books held until the end of <strong><%= formatDate(lastDay) %></strong>.<% } else { %>Seat held until its session is over.<% } %>
      <%= order.reservation_extended_at ? 'Extended once on ' + formatDate(order.reservation_extended_at) + '.' : '' %>
    </p>
  <% } %>
  <%- include('../partials/admin_resend_confirmation', { o: order }) %>
  <h2 class="section-title">Items</h2>
  <ul class="plain">
    <% items.forEach(i => { %>
      <li>
        <%= i.item_title %> <span class="muted small">&middot; &euro;<%= Number(i.price).toFixed(2) %></span>
        <% if (i.book_copy_id != null) { %>
          <span class="muted small">&middot; copy #<%= i.book_copy_id %> is now <%= i.copy_status || 'missing' %><%= i.copy_location ? ', shelf ' + i.copy_location : '' %><% if (i.book_id) { %> (<a href="/admin/inventory/<%= i.book_id %>">open book</a>)<% } %></span>
        <% } else { %>
          <span class="muted small">&middot; drop-in seat is now <%= i.seat_status || 'missing' %></span>
        <% } %>
        <% if (order.status === 'reserved' && !i.active) { %><span class="muted small">&middot; no longer held for this reservation (it will be dropped when you collect)</span><% } %>
      </li>
    <% }) %>
  </ul>
  <% if (related && related.length) { %>
    <p class="muted small">Related reservation<%= related.length === 1 ? '' : 's' %> (after a partial pickup):
      <% related.forEach((r, n) => { %><%= n ? ', ' : '' %><a href="/admin/orders/<%= r.id %>">#<%= r.id %> (<%= r.status %>)</a><% }) %></p>
  <% } %>
</div>

<div class="card">
  <h2 class="section-title">Customer</h2>
  <p>
    <%= order.buyer_name %> &middot; <%= order.buyer_email %><%= order.buyer_phone ? ' · ' + order.buyer_phone : '' %><br>
    <% if (order.user_id) { %>
      <span class="muted small">Account: <a href="/admin/members?view=<%= order.user_id %>"><%= order.account_name || order.account_email || ('#' + order.user_id) %></a></span>
    <% } else { %>
      <span class="muted small">No linked account (reservation made before accounts were required, or the account was erased).</span>
    <% } %>
  </p>
</div>

<div class="card">
  <h2 class="section-title">Payment</h2>
  <% if (order.payment_method) { %>
    <p class="small">Paid in the shop on <%= formatDateTime(order.paid_at) %> by <strong><%= methodLabel(order.payment_method) %></strong>: &euro;<%= Number(order.amount_received).toFixed(2) %> received<%= (order.reserved_total != null && Number(order.reserved_total) > Number(order.amount_received)) ? ' (discount: €' + (Number(order.reserved_total) - Number(order.amount_received)).toFixed(2) + ' off the list total of €' + Number(order.reserved_total).toFixed(2) + ')' : '' %>.<%= order.payment_note ? ' Note: ' + order.payment_note : '' %></p>
  <% } else if (order.status === 'reserved') { %>
    <p class="small">Nothing was paid online. The customer pays in the shop (or at the session) when collecting.</p>
  <% } else if (order.checkout_intent_id || order.helloasso_order_id) { %>
    <p class="small">A reservation from the old online payment flow: paid online, payment reference <code><%= order.helloasso_order_id || order.checkout_intent_id %></code>.</p>
  <% } else { %>
    <p class="small">No payment was taken.</p>
  <% } %>
</div>

<div class="card">
  <h2 class="section-title">Terms and history</h2>
  <p class="small">
    Terms of sale accepted: <%= order.cgv_accepted_at ? formatDateTime(order.cgv_accepted_at) + ' (version ' + order.cgv_version + ')' : 'not recorded (reservation made before this was kept)' %><br>
    Language: <%= order.lang === 'fr' ? 'French' : 'English' %>
  </p>
  <ul class="plain" id="order-history">
    <li><%= formatDateTime(order.created_at) %> &mdash; <%= order.status === 'pending' ? 'reservation created (unpaid, old online payment flow)' : 'reserved' %></li>
    <% if (order.paid_at) { %><li><%= formatDateTime(order.paid_at) %> &mdash; paid</li><% } %>
    <% if (order.collected_at) { %><li><%= formatDateTime(order.collected_at) %> &mdash; collected<%= order.collected_by_email ? ' (marked by ' + order.collected_by_email + ')' : '' %></li><% } %>
    <% if (order.refunded_at) { %><li><%= formatDateTime(order.refunded_at) %> &mdash; marked refunded<%= order.refund_method ? ' (' + ({ cash: 'cash from the till drawer', card: 'card refund on the terminal', transfer: 'bank transfer', other: 'other' }[order.refund_method] || order.refund_method) + ')' : '' %>. Note: <%= order.refund_note %></li><% } %>
    <% if (order.released_at) { %><li><%= formatDateTime(order.released_at) %> &mdash; ended as <%= order.status %> (<%= (order.release_reason || '').replace('_', '-') %>) without payment</li><% } else if (order.status === 'expired' || order.status === 'cancelled') { %><li>Ended as <%= order.status %> without payment</li><% } %>
    <% history.forEach(h => { %><li class="muted small"><%= formatDateTime(h.at) %> &mdash; admin log: <%= h.action %><%= h.actor_label ? ' by ' + h.actor_label : '' %><%= h.detail ? ' (' + h.detail + ')' : '' %></li><% }) %>
  </ul>
</div>

<div class="card">
  <h2 class="section-title">Actions</h2>
  <% if (order.status === 'reserved') { %>
    <% if (activeItems.length) { %>
      <form class="stack" method="post" action="/admin/orders/<%= order.id %>/collect" id="collect-form" style="margin-bottom:18px;">
        <%- include('../partials/csrf_field') %>
        <strong>Mark collected and paid</strong>
        <span class="muted small">Press this when the customer has taken everything that is still held and paid in the shop.</span>
        <label for="method">How did they pay?</label>
        <select id="method" name="method" required>
          <option value="">Choose&hellip;</option>
          <% paymentMethods.forEach(m => { %><option value="<%= m.value %>" <%= fv.method === m.value ? 'selected' : '' %> <%= (m.value === 'cash' && tillClosed) ? 'disabled' : '' %>><%= m.label %><%= (m.value === 'cash' && tillClosed) ? ' (today\'s till day is closed)' : '' %></option><% }) %>
        </select>
        <p class="muted small" id="collect-till-note" style="margin:0;">Usually collect a reservation at the till (scan ORDER-<%= order.id %>). If you use this button for cash, the cash is added to today&rsquo;s expected drawer cash on the End of day page (&ldquo;Cash taken via admin&rdquo;).<% if (tillClosed) { %> <strong id="collect-till-closed">Today&rsquo;s till day is already closed, so Cash is not offered: reopen the day on the End of day page first, or choose Other and say in the note where the money went.</strong><% } %></p>
        <% const listCents = activeItems.reduce((n, i) => n + Math.round(Number(i.price) * 100), 0); %>
        <% const minCents = activeItems.reduce((n, i) => n + i.floorCents, 0); %>
        <p class="small" style="margin:0;">List total: <strong>&euro;<%= (listCents / 100).toFixed(2) %></strong></p>
        <% if (minCents > 0) { %><p class="muted small" id="collect-minimum" style="margin:0;">Lowest amount allowed: <strong>&euro;<%= (minCents / 100).toFixed(2) %></strong> (new books: at most 5% below the publisher's price, French fixed book price law).</p><% } %>
        <label for="amountReceived">Amount received (&euro;)</label>
        <input id="amountReceived" name="amountReceived" type="number" step="0.01" min="<%= (minCents / 100).toFixed(2) %>" max="<%= (listCents / 100).toFixed(2) %>" value="<%= fv.amountReceived || (listCents / 100).toFixed(2) %>" required data-discount-total="<%= listCents %>" data-discount-note="note" data-discount-out="discount-live">
        <p id="discount-live" class="small" style="margin:0;" role="status" aria-live="polite"></p>
        <p class="muted small" style="margin:0;">It can only be lowered (a discount given at the pickup); then a note is required. The accounting export shows the difference as a separate &ldquo;Discount&rdquo; line, so the treasurer sees exactly what was received.</p>
        <label for="note">Note (required if less than the list total)</label>
        <input id="note" name="note" type="text" maxlength="<%= 500 %>" value="<%= fv.note || '' %>">
        <button class="btn" type="submit">Mark collected and paid</button>
      </form>

      <% if (activeItems.length > 1) { %>
        <form class="stack" method="post" action="/admin/orders/<%= order.id %>/collect-selected" id="collect-selected-form" style="margin-bottom:18px;">
          <%- include('../partials/csrf_field') %>
          <strong>Collect selected items</strong>
          <span class="muted small">The customer takes only some of the items: tick them. They are sold and paid; the others stay reserved on a new reservation with the same deadline.</span>
          <% activeItems.forEach(i => { %>
            <label class="ann-check"><input type="checkbox" name="itemIds" value="<%= i.id %>"> <span><%= i.item_title %> &middot; &euro;<%= Number(i.price).toFixed(2) %></span></label>
          <% }) %>
          <label for="method-sel">How did they pay?</label>
          <select id="method-sel" name="method" required>
            <option value="">Choose&hellip;</option>
            <% paymentMethods.forEach(m => { %><option value="<%= m.value %>" <%= (m.value === 'cash' && tillClosed) ? 'disabled' : '' %>><%= m.label %><%= (m.value === 'cash' && tillClosed) ? ' (today\'s till day is closed)' : '' %></option><% }) %>
          </select>
          <button class="btn btn-outline" type="submit">Collect selected items</button>
        </form>
      <% } %>
    <% } else { %>
      <p class="muted">Nothing is held for this reservation any more (its items were sold or released). You can cancel it.</p>
    <% } %>

    <div style="display:flex; flex-wrap:wrap; gap:12px;">
      <% if (hasBooks && !order.reservation_extended_at) { %>
        <form method="post" action="/admin/orders/<%= order.id %>/extend">
          <%- include('../partials/csrf_field') %>
          <button class="btn btn-outline" type="submit">Extend by <%= extensionDays %> days</button>
          <span class="muted small">Once only.</span>
        </form>
      <% } %>
      <form method="post" action="/admin/orders/<%= order.id %>/cancel-reservation" data-confirm="Cancel this reservation? Its books go back on the shelf and its seats are freed.">
        <%- include('../partials/csrf_field') %>
        <button class="btn btn-outline" type="submit">Cancel reservation</button>
      </form>
      <form method="post" action="/admin/orders/<%= order.id %>/no-show" data-confirm="Mark this reservation as a no-show? Its books go back on the shelf and its seats are freed.">
        <%- include('../partials/csrf_field') %>
        <button class="btn btn-outline" type="submit">Mark no-show / expired</button>
      </form>
    </div>
  <% } else if (order.status === 'paid') { %>
    <% if (hasBooks && !order.collected_at) { %>
      <form method="post" action="/admin/orders/<%= order.id %>/collected" style="margin-bottom:12px;">
        <%- include('../partials/csrf_field') %>
        <button class="btn" type="submit">Mark collected</button>
        <span class="muted small">For a reservation paid online (old flow): press this when the customer has taken the books.</span>
      </form>
    <% } %>
    <p>
      <a class="btn btn-outline" href="/admin/orders/<%= order.id %>/refund">Mark refunded</a><br>
      <span class="muted small">Only AFTER you gave the money back to the customer (cash, cheque or card). You will be asked to confirm.</span>
    </p>
  <% } else if (order.status === 'pending') { %>
    <form method="post" action="/admin/orders/<%= order.id %>/cancel" data-confirm="Cancel this unpaid reservation? Its books and seats become available again.">
      <%- include('../partials/csrf_field') %>
      <button class="btn btn-outline" type="submit">Cancel unpaid reservation</button>
      <span class="muted small">An unpaid reservation from the old online payment flow; it can no longer be paid.</span>
    </form>
  <% } else if (order.status === 'refunded') { %>
    <p class="muted">Refunded: nothing more to do.</p>
  <% } else { %>
    <p class="muted">This reservation ended without payment: nothing to do.</p>
  <% } %>
</div>

<%- include('../partials/admin_footer') %>

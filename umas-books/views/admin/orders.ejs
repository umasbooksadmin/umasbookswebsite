<%- include('../partials/admin_header', { title: 'Reservations', active: 'orders', pageTitle: 'Reservations', pageSub: total + ' reservation' + (total === 1 ? '' : 's') + (f.show || f.from || f.to || f.q ? ' match your filters' : ' in total') + '. Customers reserve online and pay in the shop. Dates and times are Paris time.' }) %>

<% if (notice) { %><div class="notice-box" role="status"><%= notice %></div><% } %>

<div class="card">
  <form class="stack" method="get" action="/admin/orders" style="flex-direction: row; gap: 8px; max-width: none; align-items: end; flex-wrap: wrap;">
    <div>
      <label for="show">Show</label>
      <select id="show" name="show">
        <option value="reserved" <%= f.show === 'reserved' ? 'selected' : '' %>><%= cap('reserved') %> (<%= counts.reserved %>)</option>
        <option value="expiring_soon" <%= f.show === 'expiring_soon' ? 'selected' : '' %>><%= SPECIAL.expiring_soon.label %> (<%= counts.expiring_soon %>)</option>
        <option value="expired" <%= f.show === 'expired' ? 'selected' : '' %>><%= cap('expired') %> (<%= counts.expired %>)</option>
        <option value="all" <%= f.show === '' ? 'selected' : '' %>>All reservations (<%= counts.total %>)</option>
        <% ['past_deadline', 'uncollected', 'overdue', 'stale_pending'].forEach(k => { %><option value="<%= k %>" <%= f.show === k ? 'selected' : '' %>><%= SPECIAL[k].label %> (<%= counts[k] %>)</option><% }) %>
        <% ['paid', 'refunded', 'cancelled', 'pending'].forEach(st => { %><option value="<%= st %>" <%= f.show === st ? 'selected' : '' %>><%= cap(st) %> (<%= counts[st] %>)</option><% }) %>
      </select>
    </div>
    <div>
      <label for="from">Reserved from</label>
      <input id="from" name="from" type="date" value="<%= f.from %>">
    </div>
    <div>
      <label for="to">Reserved until</label>
      <input id="to" name="to" type="date" value="<%= f.to %>">
    </div>
    <div>
      <label for="q">Search</label>
      <input id="q" name="q" type="search" value="<%= f.q %>" placeholder="Reservation number, email or name" maxlength="100">
    </div>
    <button class="btn" type="submit">Filter</button>
    <% if (f.show !== 'reserved' || f.from || f.to || f.q) { %><a class="btn btn-outline" href="/admin/orders">Clear</a><% } %>
  </form>
  <p class="muted small" style="margin-bottom:0;">
    <a href="/admin/orders"><%= counts.reserved %> reserved, waiting for pickup</a>
    <% if (counts.expiring_soon > 0) { %> &middot; <a href="/admin/orders?show=expiring_soon"><strong><%= counts.expiring_soon %> expiring in 3 days</strong></a><% } %>
    <% if (counts.past_deadline > 0) { %> &middot; <a href="/admin/orders?show=past_deadline"><%= counts.past_deadline %> past the deadline</a><% } %>
    <% if (counts.uncollected > 0) { %> &middot; <a href="/admin/orders?show=uncollected"><%= counts.uncollected %> paid online and not collected (old reservations)</a><% } %>
    &middot; <a href="/admin/orders/pickup-list">Pickup list</a> (<a href="/admin/orders/pickup-list?print=1">print version</a>)
  </p>
</div>

<% const resendNotices = {
  'resent': 'Confirmation sent.',
  'resend-queued': 'Confirmation queued: it could not be sent right now, it will be retried automatically (see Email outbox).',
  'resend-not_reserved': 'Only a reservation that is still open has a confirmation to resend.',
  'resend-erased': 'This buyer was erased: there is no address to send to.',
  'resend-not_found': 'Reservation not found.',
  'resend-queue_failed': 'The confirmation could not be built. Check the logs.'
}; %>
<% if (locals.resendNotice && resendNotices[resendNotice]) { %><div class="notice-box" role="status"><%= resendNotices[resendNotice] %></div><% } %>
<p class="muted small"><a href="/admin/email-outbox">Email outbox</a></p>

<div class="card">
  <% if (!orders.length) { %>
    <p class="muted"><%= f.show === 'reserved' && !f.from && !f.to && !f.q ? 'No reservation is waiting for pickup.' : ((f.show || f.from || f.to || f.q) ? 'No reservation matches these filters.' : 'No reservations yet.') %></p>
  <% } else { %>
    <ul class="plain">
      <% orders.forEach(o => { %>
        <li style="margin-bottom: 18px;" id="order-<%= o.id %>">
          <div class="order-row">
            <a href="/admin/orders/<%= o.id %>"><strong>Reservation #<%= o.id %></strong></a>
            <span class="muted small">&middot; <%= formatDateTime(o.created_at) %></span>
            <span class="status-pill <%= o.status %>"><%= cap(o.status) %></span>
            <% if (o.status === 'reserved' && o.reserved_until && o.items && o.items.some(i => !i.seat)) { %><span class="muted small">held until the end of <%= formatDate(lastDay(o)) %></span><% } %>
            <% if (o.status === 'paid' && o.collected_at) { %><span class="status-pill completed">Collected</span><% } %>
            <% if (o.is_guest) { %><span class="status-pill category">Guest</span><% if (o.status === 'reserved' && !o.guest_confirmed_at) { %><span class="muted small">email link not opened yet</span><% } %><% } %>
          </div>
          <div class="muted small"><%= o.buyer_name %> &middot; <%= o.buyer_email %><%= o.buyer_phone ? ' · ' + o.buyer_phone : '' %></div>
          <ul class="plain nested">
            <% (o.items || []).forEach(i => { %>
              <li><%= i.title %> <span class="muted small">&middot; &euro;<%= Number(i.price).toFixed(2) %></span></li>
            <% }) %>
          </ul>
          <div class="muted small">Total: &euro;<%= Number(o.total_amount).toFixed(2) %></div>
          <%- include('../partials/admin_resend_confirmation', { o }) %>
        </li>
      <% }) %>
    </ul>
    <% if (pages > 1) { %>
      <nav aria-label="Pages" class="muted" style="display:flex; gap:12px; align-items:center;">
        <% if (page > 1) { %><a href="/admin/orders<%= qs({ page: page - 1 }) %>">&larr; Newer</a><% } %>
        <span>Page <%= page %> of <%= pages %></span>
        <% if (page < pages) { %><a href="/admin/orders<%= qs({ page: page + 1 }) %>">Older &rarr;</a><% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<%- include('../partials/admin_footer') %>

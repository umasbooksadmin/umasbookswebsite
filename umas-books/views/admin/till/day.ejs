<%- include('../../partials/admin_header', { title: 'End of day', active: 'till-day', pageTitle: 'End of day', mainWide: true, extraCss: ['/till.css'] }) %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<% const fmtMoney = (c) => eur(c); const diff = summary.dayRow && summary.dayRow.difference_cents; %>

<div class="card no-print">
  <form class="filter-row" method="get" action="/admin/till/day">
    <div><label for="day">Day</label><input id="day" name="day" type="date" max="<%= today %>" value="<%= day %>"></div>
    <button class="btn" type="submit">Show</button>
    <a class="btn btn-outline" href="/admin/till/day?day=<%= day %>&amp;format=csv">Download CSV</a>
    <a class="btn btn-outline" href="/admin/till/day?day=<%= day %>&amp;format=csv&amp;locale=fr" title="Semicolon separators and decimal commas, for Excel in French">Download for French Excel</a>
    <button class="btn btn-outline" type="button" data-print>Print summary</button>
    <a class="btn btn-outline" href="/admin/till">Till</a>
  </form>
  <% if (unclosed.length) { %><p class="notice-box" role="status">Never closed: <% unclosed.forEach((d, i) => { %><a href="/admin/till/day?day=<%= d %>"><%= d %></a><%= i < unclosed.length - 1 ? ', ' : '' %><% }) %>.</p><% } %>
</div>

<div class="card" id="day-summary">
  <div class="section-title">Till summary for <%= day %> (Paris time)<%= summary.closed ? ' — CLOSED' : '' %></div>
  <div class="table-scroll"><table class="report-table">
    <thead><tr><th>Payment method</th><th>Sales</th><th>Total</th></tr></thead>
    <tbody>
      <tr><td>Cash</td><td><%= summary.cash.n %></td><td><%= fmtMoney(summary.cash.total) %></td></tr>
      <tr><td>Card</td><td><%= summary.card.n %></td><td><%= fmtMoney(summary.card.total) %></td></tr>
      <tr><th>All sales</th><th><%= summary.count %></th><th><%= fmtMoney(summary.total) %></th></tr>
      <tr class="muted"><td>Voided (not counted)</td><td><%= summary.voided.n %></td><td><%= fmtMoney(summary.voided.total) %></td></tr>
    </tbody>
  </table></div>
  <% if (summary.categories.length) { %>
    <div class="table-scroll"><table class="report-table" style="margin-top:14px">
      <thead><tr><th>Category</th><th>Items</th><th>Total</th></tr></thead>
      <tbody><% summary.categories.forEach(c => { %><tr><td><%= catLabel(c.category) %></td><td><%= c.n %></td><td><%= fmtMoney(c.total) %></td></tr><% }) %></tbody>
    </table></div>
  <% } %>

  <div class="section-title" style="margin-top:18px">Cash drawer</div>
  <div class="table-scroll"><table class="report-table">
    <tbody>
      <tr><td>Opening float<%= summary.hasFloat ? '' : ' (not entered)' %></td><td><%= fmtMoney(summary.floatCents) %></td></tr>
      <tr><td>+ Cash sales</td><td><%= fmtMoney(summary.cash.total) %></td></tr>
      <tr><th>Expected cash in the drawer</th><th id="expected"><%= fmtMoney(summary.expectedCashCents) %></th></tr>
      <% if (summary.closed) { %>
        <tr><td>Counted</td><td><%= fmtMoney(summary.dayRow.counted_cash_cents) %></td></tr>
        <tr><th>Difference</th><th id="difference"><%= diff === 0 ? 'None (the drawer is right)' : (diff > 0 ? 'Over by ' + fmtMoney(diff) : 'Short by ' + fmtMoney(-diff)) %></th></tr>
        <tr><td>Closed at</td><td><%= formatDateTime(summary.dayRow.closed_at) %></td></tr>
        <% if (summary.dayRow.note) { %><tr><td>Note</td><td><%= summary.dayRow.note %></td></tr><% } %>
      <% } %>
    </tbody>
  </table></div>
  <% if (summary.salesAfterClose) { %><p class="error-box" role="alert"><%= summary.salesAfterClose %> sale(s) were entered after the day was closed: they are not in the counted cash.</p><% } %>
  <% if (summary.dayRow && summary.dayRow.reopened_at && !summary.closed) { %><p class="notice-box" role="status">This day was reopened (<%= summary.dayRow.reopen_reason %>). Count the drawer and close it again.</p><% } %>
</div>

<% if (summary.unrefunded.length) { %>
<div class="card" id="unrefunded">
  <div class="section-title">Voided card sales: refund the card</div>
  <p class="error-box" role="alert">A voided card sale is not refunded automatically. Refund each one on the SumUp reader or app yourself, then tick it here.</p>
  <ul>
    <% summary.unrefunded.forEach(u => { %>
      <li>Sale <a href="/admin/till/sales/<%= u.id %>/receipt"><%= u.id %></a> (<%= fmtMoney(u.total_cents) %>)
        <% if (canManage) { %><form method="post" action="/admin/till/sales/<%= u.id %>/refunded" style="display:inline">
          <%- include('../../partials/csrf_field') %>
          <input type="hidden" name="back" value="/admin/till/day?day=<%= day %>">
          <button class="btn btn-small" type="submit">I refunded the card</button>
        </form><% } else { %><span class="muted small">an admin confirms the refund</span><% } %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<% if (summary.voidList.length) { %>
<div class="card" id="voids">
  <div class="section-title">Voided sales (<%= summary.voidList.length %>)</div>
  <div class="table-scroll"><table class="report-table">
    <thead><tr><th>Sale</th><th>Voided at</th><th>Voided by</th><th>Paid by</th><th>Amount</th><th>Reason</th></tr></thead>
    <tbody>
      <% summary.voidList.forEach(v => { %>
        <tr><td><a href="/admin/till/sales/<%= v.id %>/receipt"><%= v.id %></a></td><td><%= formatTime(v.voided_at) %></td><td><%= v.voided_by_name %><%= v.by_admin ? '' : ' (till account)' %></td><td><%= v.payment_method === 'cash' ? 'Cash' : 'Card' %></td><td><%= fmtMoney(v.total_cents) %></td><td><%= v.void_reason %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</div>
<% } %>

<% if (!summary.closed && canManage) { %>
<div class="card no-print">
  <form class="till-item-form" method="post" action="/admin/till/day/open">
    <%- include('../../partials/csrf_field') %>
    <input type="hidden" name="day" value="<%= day %>">
    <div><label for="openingFloat">Opening float (cash in the drawer at the start, euros)</label><input id="openingFloat" name="openingFloat" type="text" inputmode="decimal" value="<%= money(summary.floatCents) %>" style="width:120px"></div>
    <button class="btn btn-outline" type="submit">Save opening float</button>
  </form>
  <div class="section-title" style="margin-top:14px">Close the day</div>
  <p class="muted small">Count the cash in the drawer (all of it, including the float), type the total, and close. Closing locks voids for this day.</p>
  <form class="till-item-form" data-confirm="Closing locks voids for this day. Continue?" method="post" action="/admin/till/day/close" id="close-form">
    <%- include('../../partials/csrf_field') %>
    <input type="hidden" name="day" value="<%= day %>">
    <div><label for="counted">Counted cash (euros)</label><input id="counted" name="counted" type="text" inputmode="decimal" required style="width:140px" data-expected="<%= summary.expectedCashCents %>"></div>
    <div><label for="note">Note (optional)</label><input id="note" name="note" type="text" maxlength="300" style="width:320px"></div>
    <% if (!summary.hasFloat) { %>
      <label class="till-beep"><input type="checkbox" name="confirmNoFloat" value="1" id="confirm-no-float"> You did not enter an opening float: close with no opening float (it counts as &euro;0)</label>
    <% } %>
    <button class="btn" type="submit">Close the day</button>
  </form>
  <p id="diff-live" class="till-err" role="status"></p>
</div>
<% } %>

<% if (summary.closed && canManage) { %>
<div class="card no-print">
  <div class="section-title">Reopen this day</div>
  <p class="muted small">If a sale has to be added or a void made, reopen the day with a reason. The counted cash is cleared and you close the day again afterwards.</p>
  <form class="till-item-form" method="post" action="/admin/till/day/reopen" data-confirm="Reopen this day? The counted cash is cleared and the day must be closed again.">
    <%- include('../../partials/csrf_field') %>
    <input type="hidden" name="day" value="<%= day %>">
    <div><label for="reopen-reason">Reason (required)</label><input id="reopen-reason" name="reason" type="text" required maxlength="120" style="width:320px"></div>
    <button class="btn btn-outline" type="submit">Reopen the day</button>
  </form>
</div>
<% } %>
<% if (!canManage) { %><p class="muted small no-print">You can look at the end of day. Opening the float, closing and reopening the day are for an admin.</p><% } %>

<div class="card">
  <div class="section-title">Sales (<%= sales.length %>)</div>
  <% if (!sales.length) { %><p class="muted">No sales.</p><% } else { %>
    <div class="table-scroll"><table class="report-table">
      <thead><tr><th>#</th><th>Time</th><th>Items</th><th>Paid by</th><th>Total</th><th>Status</th></tr></thead>
      <tbody><% sales.forEach(s => { %>
        <tr class="<%= s.status === 'voided' ? 'till-voided' : '' %>"><td><a href="/admin/till/sales/<%= s.id %>/receipt"><%= s.id %></a></td><td><%= formatTime(s.created_at) %></td><td><%= s.summary %></td><td><%= s.payment_method %><%= s.card_reference ? ' (' + s.card_reference + ')' : '' %></td><td><%= fmtMoney(s.total_cents) %></td><td><%= s.status %><%= s.void_reason ? ': ' + s.void_reason : '' %><%= s.status === 'voided' && s.payment_method === 'card' ? (s.refund_confirmed ? ' (card refunded)' : ' (CARD REFUND NEEDED)') : '' %></td></tr>
      <% }) %></tbody>
    </table></div>
  <% } %>
</div>
<script src="/print-button.js"></script>
<script src="/till-day.js"></script>
<%- include('../../partials/admin_footer') %>

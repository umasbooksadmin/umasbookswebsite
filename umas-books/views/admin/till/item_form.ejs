<% const _title = item ? 'Edit item' : 'Add an item'; %>
<%- include('../../partials/admin_header', { title: _title + ' (other stock)', active: active, pageTitle: _title, pageSub: 'Other stock (not books): a picture, a name, a price, a category, how many are in stock and (optional) the barcode. It appears as a button on the till.', extraCss: ['/till.css', '/edu-item-form.css', '/cover-edit.css'] }) %>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>

<% if (item) { %>
<%- include('../../partials/picture_card', {
  anchor: 'picture', title: 'Picture', noun: 'picture', base: '/admin/till/items/' + item.id + '/image', field: 'image', message: pictureMessage,
  pic: pic, alt: 'Current picture of ' + item.name, emptyText: 'No picture', externalText: 'Picture not saved on our server',
  addLabel: 'Add picture', replaceLabel: 'Replace picture', removeLabel: 'Remove picture',
  removeConfirm: 'Remove this picture? The item will show "No picture" until you add one.',
  noteExternal: 'This picture is not saved on our server, so it can\'t be rotated or cropped. Replace it with a photo, or remove it.',
  noteEmpty: 'This item has no picture. Take a photo, or choose one from your library or files (JPEG, PNG or WebP, up to 8 MB). The picture is shown in this list and on the till button.',
  noteNormal: 'Picture changes are saved at once, without pressing Save below. The picture you replace is cleaned up automatically later.'
}) %>
<% } %>
<div class="card">
  <form class="stack" method="post" action="<%= item ? '/admin/till/items/' + item.id : '/admin/till/items' %>" enctype="multipart/form-data" id="other-stock-form">
    <%- include('../../partials/csrf_field') %>
    <div class="edu-barcode-box" data-edu-barcode data-lookup-url="/admin/till/items/lookup"<%- item ? ` data-item-id="${item.id}"` : '' %><%- autoLookup ? ' data-auto-lookup' : '' %>>
      <label for="edu-barcode">Scan or type barcode (optional)</label>
      <div class="edu-barcode-row">
        <input id="edu-barcode" name="barcode" type="text" autocomplete="off" maxlength="40" value="<%= values.barcode %>" aria-describedby="edu-barcode-help" style="max-width:240px">
        <button class="btn btn-outline btn-small" type="button" data-edu-lookup hidden>Look up</button>
      </div>
      <p class="muted small" id="edu-barcode-help">The manufacturer's code on the item (8 to 14 digits) or a code the shop prints itself (like TOTE-GREEN). With a scanner, scan it here: the name is looked up and filled in if the Name box is empty (not for a shop code). Nothing is saved until you press <%= item ? 'Save' : 'Add item' %>. Scanning the item at the till then adds one of it. No barcode on the item? Leave this empty and press <em>Generate a shop code</em>, then print the label.</p>
      <div class="edu-lookup-result" data-edu-lookup-result role="status" aria-live="polite" hidden></div>
    </div>
    <label for="stock-name">Name (at most 80 characters)</label>
    <input id="stock-name" name="name" type="text" maxlength="80" value="<%= values.name %>" required>
    <label for="stock-price">Price (euros)</label>
    <input id="stock-price" name="price" type="text" inputmode="decimal" value="<%= values.price %>" required style="max-width:140px">
    <label for="stock-cat">Category</label>
    <select id="stock-cat" name="category"><% categories.forEach(c => { %><option value="<%= c.value %>"<%= c.value === values.category ? ' selected' : '' %>><%= c.label %></option><% }) %></select>
    <label for="stock-stock">Stock (optional)</label>
    <input id="stock-stock" name="stock" type="text" inputmode="numeric" value="<%= values.stock %>" style="max-width:140px" aria-describedby="stock-stock-help">
    <p class="muted small" id="stock-stock-help">Leave empty if you do not want to count this item. When a number is set it goes down with each sale at the till, and the till refuses to sell at 0.</p>
    <% if (!item) { %>
    <label class="ann-check"><input type="checkbox" name="generate" value="1"<%= values.generate === '1' ? ' checked' : '' %>> <span>Generate a shop code (<%= shopCode %>n) if the barcode is blank</span></label>
    <label for="stock-image">Picture (optional)</label>
    <input id="stock-image" name="image" type="file" accept="image/*">
    <p class="muted small">JPEG, PNG or WebP, up to 8 MB. It is turned upright and made smaller, like a book cover photo. After you add the item, you can turn, crop or remove the picture on its edit page.</p>
    <% } else { %>
    <label class="ann-check"><input type="checkbox" name="active" value="1"<%= values.active === '1' ? ' checked' : '' %>> <span>On the till (untick to hide it from the till and free its barcode)</span></label>
    <% } %>
    <p><button class="btn" type="submit"><%= item ? 'Save' : 'Add item' %></button>
      <% if (item && !item.barcode) { %><button class="btn btn-outline" type="submit" formaction="/admin/till/items/<%= item.id %>/generate-code" formnovalidate formenctype="application/x-www-form-urlencoded">Generate a shop code</button><% } %>
      <a href="/admin/till/items">Cancel</a></p>
  </form>
</div>
<script src="<%= assetUrl('/edu-item-form.js') %>"></script>
<% if (item) { %><script src="<%= assetUrl('/cover-edit.js') %>"></script><% } %>
<%- include('../../partials/admin_footer') %>

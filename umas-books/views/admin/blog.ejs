<%- include('../partials/admin_header', { title: 'Blog', active: active, pageTitle: 'Blog Management', pageSub: 'Create, edit, and manage your blog posts.' }) %>

<%
  function blogQs(overrides) {
    const merged = Object.assign({}, filters, overrides);
    const parts = [];
    if (merged.status) parts.push('status=' + merged.status);
    if (merged.category) parts.push('category=' + encodeURIComponent(merged.category));
    if (merged.q) parts.push('q=' + encodeURIComponent(merged.q));
    if (merged.dateRange) parts.push('dateRange=' + merged.dateRange);
    if (overrides.page) parts.push('page=' + overrides.page);
    return parts.join('&');
  }
  const listQs = blogQs({});
  const statusLabels = { draft: 'Draft', scheduled: 'Scheduled', published: 'Published' };
  // The French status reuses the status pills: ready = green, draft = amber, missing = grey.
  const frenchPill = { ready: 'published', draft: 'scheduled', missing: 'draft' };
  const frenchHelp = {
    ready: 'The French pages show this French version.',
    draft: 'Not complete yet, so French visitors still see the English text (marked as English). A French version needs a title and content, and an excerpt when the English post has one.',
    missing: 'No French version yet, so French visitors see the English text (marked as English). The post can be published in English alone.',
  };
%>

<% if (flashNotice) { %><div class="notice-box" role="status" id="blog-notice"><%= flashNotice %></div><% } %>


<% if (locals.preview) { %>
<p class="muted small" role="note">Blog posts are not affected by preview mode: you can write, edit, publish and delete posts as usual, and a published post shows on the public blog straight away (behind the coming-soon banner). Only reservations and membership payments are switched off.</p>
<% } %>
<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:baseline;">
    <div class="section-title"><%= editing ? 'Edit Post' : 'Write a New Post' %></div>
    <% if (editing) { %><a href="/admin/blog?<%= listQs %>" class="small">Cancel edit</a><% } %>
  </div>
  <% if (flashError) { %><div class="error-box" role="alert" id="blog-error"><%= flashError %></div><% } %>
  <div class="error-box" role="alert" id="blog-client-error" hidden></div>
  <form class="stack" method="post" action="<%= editing ? '/admin/blog/' + editing.id : '/admin/blog' %>" enctype="multipart/form-data" id="blog-form" data-saving-text="Saving&hellip; please wait">
    <%- include('../partials/csrf_field') %>
    <input type="hidden" name="backQuery" value="<%= listQs %>">

    <label for="blog-title">Title</label>
    <input id="blog-title" name="title" type="text" required value="<%= formValues.title %>">

    <label for="blog-content">Content</label>
    <div class="richtext" data-richtext-required="Please write some content for the post." data-richtext-skip-when="status=draft">
      <div class="richtext-toolbar">
        <button type="button" data-cmd="bold"><strong>B</strong></button>
        <button type="button" data-cmd="italic"><em>I</em></button>
        <button type="button" data-cmd="underline"><u>U</u></button>
        <button type="button" data-cmd="insertUnorderedList">&bull; List</button>
        <button type="button" data-cmd="insertOrderedList">1. List</button>
        <button type="button" data-cmd="formatBlock" data-arg="blockquote">&ldquo;&rdquo;</button>
        <button type="button" data-cmd="createLink">Link</button>
      </div>
      <div class="richtext-editor" contenteditable="true"><%- formValues.body %></div>
    </div>
    <textarea name="body" class="richtext-hidden" aria-label="Post text"><%= formValues.body %></textarea>
    <div class="field-error" id="blog-body-error" role="alert" hidden>Please write some content before publishing or scheduling (a draft may stay empty).</div>

    <label for="blog-excerpt">Excerpt (optional)</label>
    <textarea id="blog-excerpt" name="excerpt" placeholder="A short summary shown on the blog list…"><%= formValues.excerpt %></textarea>

    <fieldset class="blog-fr" id="blog-french">
      <legend>French version <span class="status-pill <%= frenchPill[formFrenchState] %>" id="blog-french-status">French: <%= frenchLabels[formFrenchState] %></span></legend>
      <p class="muted small" id="blog-french-help"><%= frenchHelp[formFrenchState] %> Optional; saved with the post. A translation is only a draft for you to read: nothing is saved or shown until you press <%= editing ? 'Save Changes' : 'Publish Post' %>.</p>
      <div class="blog-fr-tools">
        <button type="button" class="btn btn-outline btn-small" id="blog-translate-btn" data-translate-url="/admin/blog/translate">Translate to French</button>
        <span class="muted small" id="blog-translate-status" role="status" aria-live="polite"></span>
      </div>

      <label for="blog-title-fr">Title (French)</label>
      <input id="blog-title-fr" name="title_fr" type="text" lang="fr" value="<%= formValues.title_fr %>">

      <label for="blog-content-fr">Content (French)</label>
      <div class="richtext">
        <div class="richtext-toolbar">
          <button type="button" data-cmd="bold"><strong>B</strong></button>
          <button type="button" data-cmd="italic"><em>I</em></button>
          <button type="button" data-cmd="underline"><u>U</u></button>
          <button type="button" data-cmd="insertUnorderedList">&bull; List</button>
          <button type="button" data-cmd="insertOrderedList">1. List</button>
          <button type="button" data-cmd="formatBlock" data-arg="blockquote">&ldquo;&rdquo;</button>
          <button type="button" data-cmd="createLink">Link</button>
        </div>
        <div class="richtext-editor" id="blog-content-fr" contenteditable="true" lang="fr" role="textbox" aria-multiline="true" aria-label="Content (French)"><%- formValues.body_fr %></div>
      </div>
      <textarea name="body_fr" class="richtext-hidden" aria-label="Post text (French)"><%= formValues.body_fr %></textarea>

      <label for="blog-excerpt-fr">Excerpt (French, optional)</label>
      <textarea id="blog-excerpt-fr" name="excerpt_fr" lang="fr" placeholder="A short summary shown on the French blog list…"><%= formValues.excerpt_fr %></textarea>
    </fieldset>

    <div class="mem-row field-pair">
      <div>
        <label for="blog-date">Publish Date</label>
        <input id="blog-date" name="publishDate" type="date" aria-describedby="blog-date-hint" value="<%= formValues.publishDate %>">
        <span id="blog-date-hint" class="muted small">A post is public only once this date has arrived.</span>
      </div>
      <div>
        <label for="blog-status">Status</label>
        <select id="blog-status" name="status">
          <option value="draft" <%= formValues.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="scheduled" <%= formValues.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
          <option value="published" <%= formValues.status === 'published' ? 'selected' : '' %>>Published</option>
        </select>
      </div>
    </div>

    <label>Featured Image</label>
    <% if (editing && editing.image_url) { %>
      <img src="<%= editing.image_url %>" alt="" style="max-width:200px; border-radius:4px; margin-bottom:6px;">
      <label class="ann-check"><input type="checkbox" name="removeImage"> <span>Remove current image</span></label>
    <% } %>
    <button type="button" class="btn btn-outline" data-trigger-file="blog-image" style="align-self:flex-start;">Upload an image</button>
    <input id="blog-image" name="image" type="file" aria-label="Featured image" accept="image/*" class="file-input-hidden" data-file-name-target="blog-image-name" data-max-bytes="15728640" data-max-label="15 MB">
    <span id="blog-image-name" class="muted small file-input-name">No image selected (JPG, PNG or WebP, max 15 MB)</span>

    <label for="blog-category">Category</label>
    <select id="blog-category" name="category">
      <option value="">Select a category…</option>
      <% categories.forEach(c => { %><option value="<%= c %>" <%= formValues.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
    </select>

    <label for="blog-tags">Tags (optional, comma-separated)</label>
    <input id="blog-tags" name="tags" type="text" placeholder="books, community, events" value="<%= formValues.tags %>">

    <div style="display:flex; gap:10px; margin-top:6px;">
      <button class="btn" type="submit"><%= editing ? 'Save Changes' : 'Publish Post' %></button>
      <button type="button" class="btn btn-outline" id="blog-preview-btn">Preview</button>
    </div>
  </form>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:12px;">
    <div class="section-title">Posts (<%= pagination.totalMatching %>)</div>
  </div>

  <form class="ann-filters" method="get" action="/admin/blog">
    <input type="text" name="q" aria-label="Search posts" value="<%= filters.q %>" placeholder="Search posts by title, content or tags…">
    <select name="status" aria-label="Filter by status">
      <option value="">All Statuses</option>
      <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
      <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
    </select>
    <select name="category" aria-label="Filter by category">
      <option value="">All Categories</option>
      <% categories.forEach(c => { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
    </select>
    <select name="dateRange" aria-label="Filter by date">
      <option value="">All Dates</option>
      <option value="7d" <%= filters.dateRange === '7d' ? 'selected' : '' %>>Last 7 days</option>
      <option value="30d" <%= filters.dateRange === '30d' ? 'selected' : '' %>>Last 30 days</option>
      <option value="year" <%= filters.dateRange === 'year' ? 'selected' : '' %>>This year</option>
    </select>
    <button class="btn btn-small" type="submit">Apply</button>
    <a class="btn btn-outline btn-small" href="/admin/blog">Clear Filters</a>
  </form>

  <form data-confirm="Delete the selected items permanently? This can't be undone." data-confirm-field="bulkAction" data-confirm-values="delete" method="post" action="/admin/blog/bulk">
    <%- include('../partials/csrf_field') %>
    <input type="hidden" name="backQuery" value="<%= listQs %>">
    <div class="ann-bulk-row">
      <select name="bulkAction" aria-label="Bulk action for the selected posts">
        <option value="">Bulk actions…</option>
        <option value="publish">Publish</option>
        <option value="draft">Move to Draft</option>
        <option value="delete">Delete</option>
      </select>
      <button class="btn btn-outline btn-small" type="submit">Apply</button>
    </div>
    <div style="overflow-x:auto;">
    <div class="table-scroll"><table class="ann-table table-sticky-first">
      <thead>
        <tr>
          <th><input type="checkbox" data-select-all="blog-rows" aria-label="Select all posts"></th>
          <th>Image</th>
          <th>Title</th>
          <th>Category</th>
          <th>Status</th>
          <th>French</th>
          <th>Published Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!posts.length) { %><tr><td colspan="8" class="muted" style="text-align:center; padding:24px;">No posts match these filters.</td></tr><% } %>
        <% posts.forEach(p => { %>
          <tr>
            <td><input type="checkbox" name="ids" value="<%= p.id %>" data-select-all-item="blog-rows" aria-label="Select <%= p.title %>"></td>
            <td><% if (p.image_url) { %><img src="<%= p.image_url %>" alt="" class="ann-thumb"><% } %></td>
            <td>
              <strong><%= p.title %></strong>
              <% if (p.excerpt) { %><div class="muted small"><%= p.excerpt.slice(0, 80) %></div><% } %>
            </td>
            <td><% if (p.category) { %><span class="status-pill category"><%= p.category %></span><% } %></td>
            <td><span class="status-pill <%= p.status %>"><%= statusLabels[p.status] %></span></td>
            <% const _fs = frenchState(p); %>
            <td><span class="status-pill <%= frenchPill[_fs] %>"><%= frenchLabels[_fs] %></span></td>
            <td class="muted small"><%= p.published_at ? formatDate(p.published_at) : '—' %></td>
            <td style="white-space:nowrap;">
              <a class="btn btn-outline btn-small" href="/admin/blog?edit=<%= p.id %>&<%= listQs %>">Edit</a>
              <% if (p.status === 'published' && p.published_at && new Date(p.published_at) <= new Date()) { %><a class="btn btn-outline btn-small" href="/blog/<%= p.slug %>" target="_blank" rel="noopener">View</a><% } else { %><a class="btn btn-outline btn-small" href="/blog/<%= p.slug %>?preview=1" target="_blank" rel="noopener" title="Only you can see this: it is not public yet">Preview on site</a><% } %>
              <button type="submit" form="blog-delete-<%= p.id %>" class="btn btn-outline btn-small ann-menu-danger">Delete</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    </div>
  </form>
  <% posts.forEach(p => { %>
    <form id="blog-delete-<%= p.id %>" method="post" action="/admin/blog/<%= p.id %>/delete" data-confirm="Delete this post permanently?" style="display:none;">
      <%- include('../partials/csrf_field') %>
      <input type="hidden" name="backQuery" value="<%= listQs %>">
    </form>
  <% }) %>

  <% if (pagination.totalPages > 1) { %>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px;">
      <span class="muted small">Showing <%= (pagination.page - 1) * pagination.pageSize + 1 %>&ndash;<%= Math.min(pagination.page * pagination.pageSize, pagination.totalMatching) %> of <%= pagination.totalMatching %> posts</span>
      <div style="display:flex; gap:6px;">
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <a class="btn btn-outline btn-small<%= p === pagination.page ? ' is-active' : '' %>" href="/admin/blog?<%= blogQs({ page: p }) %>"><%= p %></a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="<%= assetUrl('/blog-preview.js') %>"></script>
<script src="<%= assetUrl('/blog-translate.js') %>"></script>

<%- include('../partials/admin_footer') %>

<!doctype html>
<html lang="<%= typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : 'en' %>">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Admin</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/admin.css">
<% if (typeof extraCss !== "undefined") { extraCss.forEach(function (href) { %><link rel="stylesheet" href="<%= href %>"><% }) } %>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
</head>
<body>
<a class="skip-link" href="#admin-main-content">Skip to main content</a>
<% if (locals.staging) { %>
<div class="admin-preview-note" role="status">TEST SITE (staging): not the real Uma's Books. Email: <%= locals.stagingMailTo ? 'every message is redirected to ' + locals.stagingMailTo + ' (original recipient in the subject)' : 'NOT sent at all (STAGING_MAIL_TO is not set)' %>. HelloAsso: <%= locals.stagingHelloasso === 'sandbox' ? 'sandbox (payments are not real)' : 'not configured' %>.</div>
<% } %>
<% if (locals.preview) { %>
<div class="admin-preview-note" role="status">PREVIEW MODE is ON: online reservations and membership payments are disabled and the public site shows the coming-soon banner. Remove the PREVIEW_MODE setting in Render to launch.</div>
<% } %>
<% if (locals.helloassoSandbox) { %>
<div class="admin-sandbox-note" role="alert">HelloAsso sandbox: payments are not real. The site is live but HELLOASSO_API_BASE still points at the HelloAsso sandbox. Fix it in Render &gt; Environment.</div>
<% } %>
<% if (locals.launchAlerts && locals.launchAlerts.length) { %>
<div class="admin-sandbox-note admin-launch-note" role="alert">
  <% locals.launchAlerts.forEach(function (a) { %><div><strong>The live site is not set up correctly:</strong> <%= a.message %></div><% }) %>
</div>
<% } %>
<div class="admin-layout">
  <div class="admin-nav-backdrop" data-close-admin-nav></div>
  <aside class="admin-sidebar" id="admin-sidebar">
    <button type="button" class="admin-nav-close" data-close-admin-nav aria-label="Close menu">&times;</button>
    <a class="admin-logo" href="/dashboard"><img src="/assets/img/logo-wordmark-framed.png" alt="Uma’s Books &amp; Adventures"></a>
    <nav class="admin-nav" aria-label="Admin">
      <%
        const navLink = (href, label, keys, extra) => '<a href="' + href + '" class="' + ((extra || '') + (keys.includes(active) ? ' is-active' : '')).trim() + '"' + (keys.includes(active) ? ' aria-current="page"' : '') + '>' + label + '</a>';
      %>
      <a href="/">Home</a>
      <% if (!locals.tillOnly) { %><%- navLink('/admin', 'Dashboard', ['overview']) %><% } %>
      <%- navLink('/admin/till', '<strong>Till</strong>', ['till'], 'admin-nav-till') %>
      <% if (locals.tillOnly) { %><%- navLink('/admin/till/day', 'End of day', ['till-day']) %><% } else { %>
      <p class="admin-nav-heading" id="nav-sell">Sell</p>
      <div role="group" aria-labelledby="nav-sell" class="admin-nav-group">
        <%- navLink('/admin/inventory', 'Inventory', ['inventory']) %>
        <%- navLink('/admin/till/items', 'Other stock', ['till-items']) %>
      </div>
      <p class="admin-nav-heading" id="nav-people">Reservations &amp; members</p>
      <div role="group" aria-labelledby="nav-people" class="admin-nav-group">
        <%- navLink('/admin/orders', 'Reservations', ['orders']) %>
        <%- navLink('/admin/members', 'Accounts', ['members']) %>
        <%- navLink('/admin/members?role=member', 'Members', ['members-filter']) %>
        <%- navLink('/admin/requests', 'Book Requests', ['requests']) %>
      </div>
      <p class="admin-nav-heading" id="nav-programs">Programs</p>
      <div role="group" aria-labelledby="nav-programs" class="admin-nav-group">
        <%- navLink('/admin/sessions', 'English Programs', ['sessions']) %>
        <%- navLink('/admin/events', 'Events', ['events']) %>
        <%- navLink('/admin/volunteer-shifts', 'Volunteer Shifts', ['volunteer']) %>
        <%- navLink('/admin/meetings', 'Meetings', ['meetings']) %>
      </div>
      <p class="admin-nav-heading" id="nav-reports">Reports</p>
      <div role="group" aria-labelledby="nav-reports" class="admin-nav-group">
        <%- navLink('/admin/reports', 'Reports', ['reports']) %>
        <%- navLink('/admin/till/day', 'End of day', ['till-day']) %>
      </div>
      <p class="admin-nav-heading" id="nav-content">Site content</p>
      <div role="group" aria-labelledby="nav-content" class="admin-nav-group">
        <%- navLink('/admin/announcements', 'Announcements', ['announcements']) %>
        <%- navLink('/admin/blog', 'Blog', ['blog']) %>
        <%- navLink('/admin/charity', 'Charities', ['charity']) %>
      </div>
      <p class="admin-nav-heading" id="nav-settings">Settings</p>
      <div role="group" aria-labelledby="nav-settings" class="admin-nav-group">
        <%- navLink('/admin/pricing', 'Pricing rules', ['pricing']) %>
        <%- navLink('/admin/audit', 'Admin activity', ['audit']) %>
        <%- navLink('/admin/email-outbox', 'Email outbox', ['email-outbox']) %>
        <%- navLink('/admin/privacy', 'Privacy requests', ['privacy']) %>
      </div>
    <% } %>
    </nav>
    <a class="admin-view-site" href="/" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
      View Website
    </a>
  </aside>

  <main id="admin-main-content" tabindex="-1" class="admin-main<%= typeof mainWide !== "undefined" && mainWide ? " is-wide" : "" %>">
    <div class="admin-topbar">
      <%# Phones and tablets only (admin.css): the sidebar logo sits inside the closed menu drawer there, so this small logo is the way back to the main page. %>
      <a class="admin-topbar-brand" href="/"><picture><source srcset="/assets/img/logo-wordmark-framed.webp" type="image/webp"><img src="/assets/img/logo-wordmark-framed.png" alt="Uma's Books and Adventures" width="440" height="220"></picture></a>
      <div class="admin-topbar-tools">
        <button type="button" class="admin-nav-toggle" data-toggle-admin-nav aria-label="Open menu" aria-expanded="false" aria-controls="admin-sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <% if (!locals.tillOnly && (active === 'overview' || active === 'inventory')) { %>
        <form class="admin-search" method="get" action="/admin/inventory" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="text" name="q" placeholder="Search books…" aria-label="Search books">
        </form>
        <% } %>
        <a class="admin-avatar" href="/account" title="<%= locals.user ? user.displayName : '' %>"><%= locals.user ? user.displayName.split(/\s+/).map(function(w){ return w[0]; }).slice(0,2).join('').toUpperCase() : '?' %></a>
      </div>
      <%# A sibling of the tools (not inside them): inside, it was laid out after the search box and avatar, i.e. on the right of the bar. %>
      <div class="admin-topbar-title">
        <% if (active !== "overview") { %>
          <a href="#" class="admin-back-link">&larr; Back</a>
        <% } %>
        <h1><%= typeof pageTitle !== "undefined" ? pageTitle : "Dashboard" %></h1>
        <% if (typeof pageSub !== "undefined") { %><p class="sub"><%= pageSub %></p><% } %>
      </div>
    </div>

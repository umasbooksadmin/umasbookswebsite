<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Admin</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/admin.css">
<% if (typeof extraCss !== "undefined") { extraCss.forEach(function (href) { %><link rel="stylesheet" href="<%= href %>"><% }) } %>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
</head>
<body>
<a class="skip-link" href="#admin-main-content">Skip to main content</a>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <a class="admin-logo" href="/dashboard"><img src="/assets/img/logo-wordmark-framed.png" alt="Uma’s Books &amp; Adventures"></a>
    <nav class="admin-nav" aria-label="Admin">
      <a href="/admin" class="<%= active === 'overview' ? 'is-active' : '' %>">Dashboard</a>
      <a href="/admin/inventory" class="<%= (active === 'inventory' || active === 'orders') ? 'is-active' : '' %>">Books &amp; Orders</a>
      <a href="/admin/sessions" class="<%= active === 'sessions' ? 'is-active' : '' %>">English Programs</a>
      <a href="/admin/events" class="<%= active === 'events' ? 'is-active' : '' %>">Events</a>
      <a href="/admin/volunteer-shifts" class="<%= active === 'volunteer' ? 'is-active' : '' %>">Volunteer Shifts</a>
      <a href="/admin/meetings" class="<%= active === 'meetings' ? 'is-active' : '' %>">Meetings</a>
      <a href="/admin/announcements" class="<%= active === 'announcements' ? 'is-active' : '' %>">Announcements</a>
      <a href="/admin/members" class="<%= active === 'members' ? 'is-active' : '' %>">Accounts</a>
      <a href="/admin/charity" class="<%= active === 'charity' ? 'is-active' : '' %>">Charities</a>
      <a href="/admin/blog" class="<%= active === 'blog' ? 'is-active' : '' %>">Blog</a>
    </nav>
    <a class="admin-view-site" href="/" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
      View Website
    </a>
  </aside>

  <main id="admin-main-content" tabindex="-1" class="admin-main">
    <div class="admin-topbar">
      <div>
        <% if (active !== "overview") { %>
          <a href="#" class="admin-back-link" onclick="history.back(); return false;">&larr; Back</a>
        <% } %>
        <h1><%= typeof pageTitle !== "undefined" ? pageTitle : "Dashboard" %></h1>
        <% if (typeof pageSub !== "undefined") { %><p class="sub"><%= pageSub %></p><% } %>
      </div>
      <div class="admin-topbar-tools">
        <form class="admin-search" method="get" action="/admin/inventory">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="text" name="q" placeholder="Search books…" aria-label="Search books">
        </form>
        <a class="admin-avatar" href="/account" title="<%= locals.user ? user.displayName : '' %>"><%= locals.user ? user.displayName.split(/\s+/).map(function(w){ return w[0]; }).slice(0,2).join('').toUpperCase() : '?' %></a>
      </div>
    </div>

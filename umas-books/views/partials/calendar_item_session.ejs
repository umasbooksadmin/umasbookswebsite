<%
/* One day-cell's session card for views/sessions.ejs, rendered via
   partials/calendar_grid.ejs. `item` is a row from the classes table;
   `qs` is the current calendar query string, carried through so
   "Add to Cart" can send the shopper back to the same view. */
const c = item;
const spotsLeft = c.capacity != null ? Math.max(0, c.capacity - c.seats_taken) : null;
const sellsDropin = c.dropin_price != null;
const full = sellsDropin && spotsLeft != null && spotsLeft <= 0;
%>
<% if (sellsDropin) { %>
  <details class="fcal-session <%= toneForClassTitle(c.title) %>">
    <summary>
      <div class="fcal-session-title"><%= c.title %></div>
      <div class="fcal-session-time"><%= formatTime(c.starts_at) %></div>
      <div class="fcal-session-seats">
        <%= eur(c.dropin_price) %><%= spotsLeft != null ? ' · ' + (spotsLeft === 1 ? tr('1 place left', '1 place restante') : tr('{n} places left', '{n} places restantes', { n: spotsLeft })) : '' %>
      </div>
    </summary>
    <div class="fcal-session-details">
      <% if (full) { %>
        <div class="fcal-session-cta" style="opacity:0.6; cursor:default;"><%= tr('Full', 'Complet') %></div>
      <% } else { %>
        <form method="post" action="/cart/add-dropin">
          <%- include('csrf_field') %>
          <input type="hidden" name="classId" value="<%= c.id %>">
          <input type="hidden" name="backTo" value="/sessions?<%= qs %>">
          <button type="submit" class="fcal-session-cta"><%= tr('Add to Cart', 'Ajouter au panier') %></button>
        </form>
      <% } %>
    </div>
  </details>
<% } else { %>
  <div class="fcal-session <%= toneForClassTitle(c.title) %>">
    <div class="fcal-session-title"><%= c.title %></div>
    <div class="fcal-session-time"><%= formatTime(c.starts_at) %></div>
  </div>
<% } %>

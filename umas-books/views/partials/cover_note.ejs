<%# Only for covers that came from an online book library (lib/coverNote.js), never for the shop's own photos or a book
    with no cover (review 6B L4). coverNoteShow: true = shown, false = left out, 'client' = written hidden, for the page's
    script to show once it has drawn a book with such a cover. %>
<%# coverNoteLong: true = the longer text (book page); otherwise the shorter text used on lists. %>
<% const _coverNoteLong = locals.coverNoteLong === true; %>
<% const _coverNoteShow = locals.coverNoteShow === undefined ? true : locals.coverNoteShow; %>
<% if (_coverNoteShow) { %><p class="cover-note" data-cover-note<%= _coverNoteShow === 'client' ? ' hidden' : '' %>><%= _coverNoteLong ? tr("Cover images come from online book libraries and may not match the edition we hold: some are the cover of another edition, or of a pre-publication or reprint version. If the cover matters to you, ask us and we'll gladly check the copy on the shelf.", "Les couvertures proviennent de bibliothèques de livres en ligne et peuvent ne pas correspondre à l'édition que nous avons en rayon : il peut s'agir de la couverture d'une autre édition, d'une version avant publication ou d'une réimpression. Si la couverture est importante pour vous, demandez-nous, nous vérifierons volontiers l'exemplaire.") : tr("Covers are shown for illustration and may differ from our copy (another edition or printing). Ask us if it matters to you.", "Les couvertures sont données à titre indicatif et peuvent différer de notre exemplaire (autre édition ou tirage). Demandez-nous si cela compte pour vous.") %></p><% } %>

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Members</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600;700&family=Nunito+Sans:wght@400;600&family=Italianno&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/site-header.css">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Uma's Books">
</head>
<body>

<header class="mkt-header">
  <div class="h-header-row">
    <a class="h-logo" href="/"><img src="/assets/img/logo-stamp.png" alt="Uma’s Books &amp; Adventures — home" width="150" height="150"></a>
    <nav class="h-nav" aria-label="Main">
      <a href="/books" data-i18n="nav.books">Browse</a>
      <a href="/classes" data-i18n="nav.programs">Programs</a>
      <a href="/events" data-i18n="nav.events">Events</a>
    </nav>
    <div class="h-tools">
      <a class="h-tool fav" href="/favorites"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 20.5s-8-4.9-10-9.8C.6 7 2.9 4 6.2 4c2.2 0 4 1.3 5.8 3.5C13.8 5.3 15.6 4 17.8 4 21.1 4 23.4 7 22 10.7c-2 4.9-10 9.8-10 9.8z"/></svg><span class="label"><span data-i18n="tool.favorites">Favorites</span></span></a>
      <a class="h-tool" href="/wishlist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.8 2H4.2z"/><path d="M10 20.5a2 2 0 0 0 4 0"/><path d="M12 3v2"/></svg><span class="label"><span data-i18n="tool.alerts">Alerts</span></span></a>
      <% if (locals.user) { %>
        <form method="post" action="/logout">
          <%- include('csrf_field') %>
          <button type="submit" class="h-tool"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4.2"/><path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z" stroke-linejoin="round"/></svg><span class="label" data-i18n="tool.logout">Log Out</span></button>
        </form>
      <% } else { %>
      <a class="h-tool" href="/login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4.2"/><path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z" stroke-linejoin="round"/></svg><span class="label"><span data-i18n="tool.login">Log In</span></span></a>
      <% } %>
      <a class="h-tool" href="/dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="2.8"/><circle cx="5.5" cy="8.5" r="2.2"/><circle cx="18.5" cy="8.5" r="2.2"/><path d="M7 19c0-3.3 2.2-6 5-6s5 2.7 5 6z"/><path d="M1.5 18c0-2.7 1.8-4.8 4-4.8 1 0 1.8.4 2.5 1"/><path d="M22.5 18c0-2.7-1.8-4.8-4-4.8-1 0-1.8.4-2.5 1"/></svg><span class="label"><span data-i18n="tool.members">Member’s Access</span></span></a>
      <a class="h-tool" href="/cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5h3l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h9.3a1.5 1.5 0 0 0 1.5-1.2L21.5 7H6"/><path d="M8 11h12.5"/><circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17.5" cy="19.5" r="1.4"/></svg><span class="label"><span data-i18n="tool.cart">Cart</span> (<span data-cart-count>0</span>)</span></a>
      <div class="langtoggle" role="group" aria-label="Language / Langue">
        <button type="button" data-lang="en" class="is-active" aria-pressed="true">EN</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-lang="fr" aria-pressed="false">FR</button>
      </div>
    </div>
  </div>
</header>
<main class="wrap">

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Members</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600;700&family=Italianno&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/site-header.css">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#a65347">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Uma's Books">
</head>
<body>

<header class="site mkt-header">
  <div class="nav-row">
    <a class="brandmark" href="/">
      <img src="/logo.png" alt="Uma's Books and Adventures logo">
      <span class="brand-text">
        <span class="brand-name">Uma's Books</span>
        <span class="brand-tag" data-i18n="brand.tag">English Pre-Loved Books</span>
      </span>
    </a>
    <nav class="mainlinks">
      <a href="/books" data-i18n="nav.books">Browse Books</a>
      <a href="/classes" data-i18n="nav.classes">Éveil Programs</a>
      <a href="/events" data-i18n="nav.events">Events</a>
      <a href="/wishlist" data-i18n="nav.wishlist">Notify Me</a>
      <a href="/about.html" data-i18n="nav.about">About</a>
      <a href="/favorites" data-i18n="nav.favorites">Favorites</a>
    </nav>
    <div class="header-tools">
      <% if (locals.user) { %>
        <form method="post" action="/logout" style="margin:0;">
          <%- include('csrf_field') %>
          <button type="submit" class="btn btn-outline btn-small">Log Out</button>
        </form>
      <% } else { %>
        <a class="btn btn-outline btn-small" href="/login">Log In</a>
      <% } %>
      <div class="langtoggle" role="group" aria-label="Language / Langue">
        <button type="button" data-lang="en" class="is-active" aria-pressed="true">EN</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-lang="fr" aria-pressed="false">FR</button>
      </div>
    </div>
  </div>
</header>
<main class="wrap">

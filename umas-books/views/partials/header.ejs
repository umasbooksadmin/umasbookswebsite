<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Members</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=EB+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#a05946">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Uma's Books">
</head>
<body>
<header class="site">
  <div class="wrap">
    <div class="brand">Uma's Books &mdash; <%= (locals.user && user.isAdmin) ? "Admin" : "Members" %></div>
    <nav>
      <a href="/books">Books</a>
      <a href="/wishlist">Wishlist</a>
      <a href="/events">Events</a>
      <a href="/classes">Classes</a>
      <% if (locals.user) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/forum">Forum</a>
        <a href="/volunteer">Volunteer</a>
        <a href="/charity">Charity Vote</a>
        <a href="/meetings">Meetings</a>
        <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
      <% } %>
    </nav>
    <div class="who">
      <% if (locals.user) { %>
        <span>Hi, <%= user.displayName %></span>
        <a href="/account/password">Change password</a>
        <form method="post" action="/logout" style="margin:0;">
          <%- include('csrf_field') %>
          <button class="btn btn-outline btn-small" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="btn btn-small" href="/signup">Join</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap">

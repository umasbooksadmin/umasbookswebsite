<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %>Uma's Books Members</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600;700&family=Italianno&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/site-header.css">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Uma's Books">
</head>
<body>

<header class="mkt-header">
  <div class="h-header-row">
    <a class="h-wordmark" href="/" aria-label="Uma's Books &amp; Adventures — home">
      <span class="name">Uma&rsquo;s Books &amp; Adventures</span>
      <span class="place">Albi, France</span>
    </a>
    <nav class="h-nav" aria-label="Main">
      <a href="/books" data-i18n="nav.books">Books</a>
      <a href="/events" data-i18n="nav.events">Events</a>
      <a href="/classes" data-i18n="nav.ateliers">Ateliers</a>
      <a href="/about.html" data-i18n="nav.about">About</a>
      <a href="mailto:admin@umasbooks.org" data-i18n="nav.contact">Contact</a>
    </nav>
    <div class="h-tools">
      <a class="icon" href="/books" data-i18n-attr="aria-label:icon.search" aria-label="Search books">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
      </a>
      <a class="icon" href="<%= locals.user ? '/dashboard' : '/login' %>" data-i18n-attr="aria-label:icon.account" aria-label="My account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 21c0-4.1 3.4-7 7.5-7s7.5 2.9 7.5 7"/></svg>
      </a>
      <a class="icon" href="/cart" data-i18n-attr="aria-label:icon.cart" aria-label="Basket">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4.5 8h15l-1 13h-13l-1-13z"/><path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10"/></svg>
      </a>
      <% if (locals.user) { %>
        <form method="post" action="/logout">
          <%- include('csrf_field') %>
          <button type="submit" class="text-btn" data-i18n="nav.logout">Log Out</button>
        </form>
      <% } %>
      <div class="langtoggle" role="group" aria-label="Language / Langue">
        <button type="button" data-lang="en" class="is-active" aria-pressed="true">EN</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-lang="fr" aria-pressed="false">FR</button>
      </div>
    </div>
  </div>
</header>
<main class="wrap">

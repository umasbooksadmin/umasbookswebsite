<!doctype html>
<html lang="<%= typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : 'en' %>">
<head>
<meta charset="utf-8">
<% /* Params: title, description, ogImage (absolute or site-relative), ogType,
   jsonLd (object, emitted as application/ld+json), noindex, extraCss, hideBackLink.
   Locals from middleware (src/middleware/seoLocals.js): siteUrl, canonicalPath (the
   path WITHOUT the query string), membersArea (member-only page: keeps "Members"
   in the title). Shared with the marketing head's SEO block. */
const _t = typeof tr === 'function' ? tr : (en) => en;
const _isFr = locals.lang === 'fr';
const _members = !!locals.membersArea;
const _siteName = _members ? _t("Uma's Books Members", "Uma’s Books — Espace membres") : _t("Uma's Books", "Uma’s Books");
const _title = typeof title !== "undefined" ? title + " — " + _siteName : _siteName;
const _indexable = !(typeof noindex !== "undefined" && noindex) && !_members;
const _site = locals.siteUrl ? String(locals.siteUrl).replace(/\/+$/, '') : '';
// Canonical URL in THIS page's language + hreflang alternates (lib/frUrls.js, via the seoUrls local).
const _seo = typeof locals.seoUrls === 'function' ? locals.seoUrls() : null;
const _pageUrl = _seo ? _seo.canonical : ((_site && locals.canonicalPath) ? _site + locals.canonicalPath : '');
const _alternates = _seo ? _seo.alternates : (_pageUrl ? [{ hreflang: 'x-default', href: _pageUrl }] : []);
const _desc = (typeof description !== "undefined" && description) ? description
  : _t("Uma's Books & Adventures — a community English bookshop in Albi, France: pre-loved English books, English programs and events.", "Uma’s Books & Adventures — une librairie associative anglophone à Albi : livres anglais d’occasion, programmes d’anglais et événements.");
const _abs = (u) => !u ? '' : /^https?:\/\//i.test(u) ? u : (_site ? _site + (u.charAt(0) === '/' ? '' : '/') + u : '');
const _ogImage = (typeof ogImage !== "undefined" && ogImage) ? _abs(ogImage) : (_site ? _site + '/assets/img/logo-stamp-1280x720.png' : '');
const _defaultImg = !(typeof ogImage !== "undefined" && ogImage);
%><title><%= _title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if (locals.preview || locals.staging) { %><meta name="robots" content="noindex, nofollow">
<% } else if (!_indexable) { %><meta name="robots" content="noindex">
<% } %><% if (_indexable) { %><meta name="description" content="<%= _desc %>">
<% if (_pageUrl) { %><link rel="canonical" href="<%= _pageUrl %>">
<% _alternates.forEach(a => { %><link rel="alternate" hreflang="<%= a.hreflang %>" href="<%= a.href %>">
<% }) %><% } %><meta property="og:site_name" content="Uma's Books &amp; Adventures">
<meta property="og:title" content="<%= typeof title !== "undefined" ? title : _siteName %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:type" content="<%= typeof ogType !== "undefined" && ogType ? ogType : 'website' %>">
<meta property="og:locale" content="<%= _isFr ? 'fr_FR' : 'en_GB' %>">
<meta property="og:locale:alternate" content="<%= _isFr ? 'en_GB' : 'fr_FR' %>">
<% if (_pageUrl) { %><meta property="og:url" content="<%= _pageUrl %>">
<% } %><% if (_ogImage) { %><meta property="og:image" content="<%= _ogImage %>">
<% if (_defaultImg) { %><meta property="og:image:width" content="1280">
<meta property="og:image:height" content="720">
<% } %><meta name="twitter:image" content="<%= _ogImage %>">
<% } %><meta name="twitter:card" content="<%= _ogImage ? (_defaultImg ? 'summary_large_image' : 'summary') : 'summary' %>">
<meta name="twitter:title" content="<%= typeof title !== "undefined" ? title : _siteName %>">
<meta name="twitter:description" content="<%= _desc %>">
<% } %><% if (_indexable && typeof jsonLd !== 'undefined' && jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
<% } %><link rel="stylesheet" href="<%= assetUrl('/style.css') %>">
<link rel="stylesheet" href="<%= assetUrl('/site-header.css') %>">
<% if (typeof extraCss !== "undefined") { extraCss.forEach(function (href) { %><link rel="stylesheet" href="<%= assetUrl(href) %>"><% }) } %>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Uma's Books">
</head>
<body>
<a class="skip-link" href="#main-content"><%= typeof tr === 'function' ? tr('Skip to main content', 'Aller au contenu principal') : 'Skip to main content' %></a>

<%- include('mkt_chrome_header', { nav: [
  { key: 'home', href: '/', i18n: 'nav.home', label: 'Home' },
  { key: 'books', href: '/books.html', i18n: 'nav.books', label: 'Browse Books' },
  { key: 'programs', href: '/immersion.html', i18n: 'nav.programs', label: 'English Programs' },
  { key: 'events', href: '/events', i18n: 'nav.events', label: 'Events' },
] }) %>
<% if (typeof hideBackLink === "undefined" || !hideBackLink) { %>
<div class="site-back-bar"><a href="<%= typeof backHref !== 'undefined' && backHref ? backHref : '/' %>" class="site-back-link">&larr; <%= typeof tr === 'function' ? tr('Back', 'Retour') : 'Back' %></a></div>
<% } %>
<main id="main-content" tabindex="-1" class="<%= typeof mainClass !== 'undefined' ? mainClass : 'wrap' %>">

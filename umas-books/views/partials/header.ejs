<!doctype html>
<html lang="<%= typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : 'en' %>">
<head>
<meta charset="utf-8">
<title><%= typeof title !== "undefined" ? title + " — " : "" %><%= typeof tr === 'function' ? tr("Uma's Books Members", "Uma’s Books — Espace membres") : "Uma's Books Members" %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if (typeof noindex !== "undefined" && noindex) { %><meta name="robots" content="noindex">
<% } %><link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/site-header.css">
<% if (typeof extraCss !== "undefined") { extraCss.forEach(function (href) { %><link rel="stylesheet" href="<%= href %>"><% }) } %>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#fffefb">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Uma's Books">
</head>
<body>
<a class="skip-link" href="#main-content"><%= typeof tr === 'function' ? tr('Skip to main content', 'Aller au contenu principal') : 'Skip to main content' %></a>

<%- include('mkt_chrome_header', { nav: [
  { key: 'home', href: '/', i18n: 'nav.home', label: 'Home' },
  { key: 'books', href: '/books.html', i18n: 'nav.books', label: 'Browse Books' },
  { key: 'programs', href: '/immersion.html', i18n: 'nav.programs', label: 'English Programs' },
  { key: 'events', href: '/events', i18n: 'nav.events', label: 'Events' },
] }) %>
<% if (typeof hideBackLink === "undefined" || !hideBackLink) { %>
<div class="site-back-bar"><a href="#" class="site-back-link">&larr; <%= typeof tr === 'function' ? tr('Back', 'Retour') : 'Back' %></a></div>
<% } %>
<main id="main-content" tabindex="-1" class="<%= typeof mainClass !== 'undefined' ? mainClass : 'wrap' %>">

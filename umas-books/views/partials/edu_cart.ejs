<%# The cart icon on an educational item's price line: the same markup, classes and icons as a book card's (views/partials/card_cart.ejs),
    so public/cart-add.js and public/site-header.css serve both. Params: it ({ id, name }), inCart (bool), soldOut (bool), and the
    page's csrfToken / eduBackTo. States: add (a real POST form to /cart/add-edu, which works without JavaScript), "in your cart" (a link
    to the cart), sold out (a disabled button with a spoken name). Kept on one line so no whitespace is added between the tags. -%>
<% const _n = cartName('add', it.name, 'en'); const _ic = cartName('inCart', it.name, 'en'); const _so = cartName('soldOut', it.name, 'en'); const _svg = (d) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + d + '</svg>'; -%><span class="bk-cart" data-edu-id="<%= it.id %>"><% if (!soldOut) { %><form class="bk-cart-add" method="post" action="/cart/add-edu" data-edu-id="<%= it.id %>"<%= inCart ? ' hidden' : '' %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="eduItemId" value="<%= it.id %>"><input type="hidden" name="backTo" value="<%= eduBackTo %>"><button type="submit" class="bk-cart-btn"<%- _n.attr %>><%- _svg('<path d="M2.5 3.5h2.6l2.3 11.2a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.2l1.6-6.8H6"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/><path d="M13.3 9.6v4M11.3 11.6h4"/>') %><%- _n.span %></button></form><a class="bk-cart-btn bk-cart-in" href="/cart"<%- _ic.attr %><%= inCart ? '' : ' hidden' %>><%- _svg('<path d="M6 8h14.8l-1.6 6.8a1.6 1.6 0 0 1-1.6 1.2H9a1.6 1.6 0 0 1-1.6-1.3z" fill="currentColor"/><path d="M2.5 3.5h2.6L6 8"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/><path d="m10.9 11.9 1.8 1.8 3.4-3.6" stroke="#fff"/>') %><%- _ic.span %></a><% } %><button type="button" class="bk-cart-btn bk-cart-soldout" disabled<%- _so.attr %><%= soldOut ? '' : ' hidden' %>><%- _svg('<path d="M2.5 3.5h2.6l2.3 11.2a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.2l1.6-6.8H6"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/><path d="M4 21 20 4"/>') %><%- _so.span %></button></span>

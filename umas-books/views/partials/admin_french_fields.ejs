<%
/* The optional "French version" of an admin form, shared by the events, sessions, announcements and charity editors
   (the blog editor has its own, views/admin/blog.ejs). Admin screens stay in English.
   Params: kind (lib/frenchText.js SPECS key), idp (a unique id prefix: several forms share one page), fr (the module
   lib/frenchText.js), values (the French text now in the form: { title_fr, ... }), englishRow (what the status is judged
   against: { title, description, ..., title_fr, ... }), fields (the fields to show, in order: { name, label, type:
   'text' | 'textarea' | 'html', placeholder? }), noun ('event'), saveLabel ('Save changes').
   The "Translate to French" button is public/french-translate.js: it fills the form only. */
const _state = fr.frenchState(kind, englishRow);
const _html = fields.filter(f => f.type === 'html').map(f => f.name).join(',');
%>
<fieldset class="fr-version">
  <legend>French version <span class="status-pill <%= fr.FRENCH_PILL[_state] %>">French: <%= fr.FRENCH_LABELS[_state] %></span></legend>
  <p class="muted small"><%= fr.FRENCH_HELP[_state] %> Optional; saved with the <%= noun %>. A translation is only a draft for you to read: nothing is saved or shown until you press <%= saveLabel %>.</p>
  <div class="fr-tools">
    <button type="button" class="btn btn-outline btn-small fr-translate-btn" data-translate-url="/admin/translate-french/<%= kind %>" data-fr-fields="<%= fields.map(f => f.name).join(',') %>" data-fr-html="<%= _html %>">Translate to French</button>
    <span class="muted small fr-translate-status" role="status" aria-live="polite"></span>
  </div>
  <% fields.forEach(f => { const id = idp + '-' + f.name + '-fr'; const val = values[f.name + '_fr'] || ''; %>
    <label for="<%= id %>"><%= f.label %> (French)</label>
    <% if (f.type === 'html') { %>
      <div class="richtext">
        <div class="richtext-toolbar">
          <button type="button" data-cmd="bold"><strong>B</strong></button>
          <button type="button" data-cmd="italic"><em>I</em></button>
          <button type="button" data-cmd="underline"><u>U</u></button>
          <button type="button" data-cmd="insertUnorderedList">&bull; List</button>
          <button type="button" data-cmd="insertOrderedList">1. List</button>
          <button type="button" data-cmd="formatBlock" data-arg="blockquote">&ldquo;&rdquo;</button>
          <button type="button" data-cmd="createLink">Link</button>
        </div>
        <div class="richtext-editor" id="<%= id %>" data-fr-field="<%= f.name %>" contenteditable="true" lang="fr" role="textbox" aria-multiline="true" aria-label="<%= f.label %> (French)"><%- fr.hasText(val) ? fr.safeHtml(val) : '' %></div>
      </div>
      <textarea name="<%= f.name %>_fr" class="richtext-hidden" aria-label="<%= f.label %> text (French)"><%= val %></textarea>
    <% } else if (f.type === 'textarea') { %>
      <textarea id="<%= id %>" name="<%= f.name %>_fr" lang="fr"<% if (f.placeholder) { %> placeholder="<%= f.placeholder %>"<% } %><% if (f.maxlength) { %> maxlength="<%= f.maxlength %>"<% } %>><%= val %></textarea>
    <% } else { %>
      <input id="<%= id %>" name="<%= f.name %>_fr" type="text" lang="fr" value="<%= val %>"<% if (f.placeholder) { %> placeholder="<%= f.placeholder %>"<% } %>>
    <% } %>
  <% }) %>
</fieldset>

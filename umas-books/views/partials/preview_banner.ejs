<%
/* "Coming soon" banner shown on every customer-facing page while
   PREVIEW_MODE is on (src/lib/preview.js). Included at the top of
   partials/mkt_chrome_header.ejs, which both the marketing pages and the
   app pages render. Server-side French via tr(); on marketing pages
   assets/site.js re-applies the same strings (COMMON preview.*) when the
   visitor toggles the language. Styled in public/site-header.css. */
if (locals.preview) {
  const t = typeof tr === 'function' ? tr : (en) => en;
%>
<div class="preview-banner" role="region" aria-label="<%= t('Preview notice', 'Avis sur la version d’aperçu') %>">
  <span data-i18n="preview.text"><%= t("Preview — Uma’s Books is opening soon. You’re looking at a test version with sample books: nothing here is real yet and no payment is taken.", "Aperçu — Uma’s Books ouvre bientôt. Vous découvrez une version de test avec des livres d’exemple : rien n’est réel pour l’instant et aucun paiement n’est pris.") %></span>
  <a href="/contact?topic=feedback" data-i18n="preview.link"><%= t('Tell us what you think!', 'Dites-nous ce que vous en pensez !') %></a>
</div>
<% } %>

<%# Expects: kind ('thread' | 'reply'), id. No JavaScript: a <details> disclosure. %>
<details class="report-post">
  <summary class="muted small">Report</summary>
  <form class="stack" method="post" action="/forum/report">
    <%- include('csrf_field') %>
    <input type="hidden" name="kind" value="<%= kind %>">
    <input type="hidden" name="id" value="<%= id %>">
    <label for="report-reason-<%= kind %>-<%= id %>">Reason</label>
    <select id="report-reason-<%= kind %>-<%= id %>" name="reason" required>
      <option value="illegal">Illegal content</option>
      <option value="harassment">Harassment</option>
      <option value="spam">Spam</option>
      <option value="other">Other</option>
    </select>
    <label for="report-comment-<%= kind %>-<%= id %>">Comment (optional)</label>
    <textarea id="report-comment-<%= kind %>-<%= id %>" name="comment" maxlength="1000"></textarea>
    <button class="btn-outline btn-small" type="submit">Send report</button>
  </form>
</details>

<%# The cart icon on a book card's price line (src/lib/cardCart.js). Params: b = { id, title, buy }, and res.locals.cardCart
    ({ post, inCart, backTo }, set by setCardCartLocals). It must stay the same HTML as UmasUI.cartControlHtml in public/ui.js
    (test/unit/uiHelpers.test.js) for a page drawn for everyone: a GET form to the sign-in page (returnTo = this page). A page
    drawn for one session (cardCart.post) gets a real POST form to /cart/add with the CSRF token, and "in your cart" from the
    session. public/cart-add.js takes over either form when JavaScript runs. Nothing to buy online: nothing at all.
    Kept on one line so no whitespace is added between the tags. -%>
<% const _cc = (typeof cardCart !== 'undefined' && cardCart) || { post: false, inCart: new Set(), backTo: '/' }; const _buy = b.buy; if (_buy && (_buy.copyId > 0 || _buy.choose)) { const _in = _cc.inCart.has(Number(b.id)); const _ic = cartName('inCart', b.title, b.language); -%><span class="bk-cart" data-book-id="<%= b.id %>"><% if (_buy.copyId > 0) { const _n = cartName('add', b.title, b.language); %><form class="bk-cart-add" method="<%= _cc.post ? 'post' : 'get' %>" action="<%= _cc.post ? '/cart/add' : '/login' %>" data-copy-id="<%= _buy.copyId %>"<%= _in ? ' hidden' : '' %>><% if (_cc.post) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="copyId" value="<%= _buy.copyId %>"><input type="hidden" name="backTo" value="<%= _cc.backTo %>"><input type="hidden" name="via" value="card"><% } else { %><input type="hidden" name="returnTo" value="<%= _cc.backTo %>"><% } %><button type="submit" class="bk-cart-btn"<%- _n.attr %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 3.5h2.6l2.3 11.2a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.2l1.6-6.8H6"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/><path d="M13.3 9.6v4M11.3 11.6h4"/></svg><%- _n.span %></button></form><% } else { const _n = cartName('choose', b.title, b.language); %><a class="bk-cart-btn bk-cart-choose" href="/books/<%= b.id %>"<%- _n.attr %><%= _in ? ' hidden' : '' %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 3.5h2.6l2.3 11.2a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.2l1.6-6.8H6"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/><path d="M13.3 9.6v4M11.3 11.6h4"/></svg><%- _n.span %></a><% } %><a class="bk-cart-btn bk-cart-in" href="/cart"<%- _ic.attr %><%= _in ? '' : ' hidden' %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8h14.8l-1.6 6.8a1.6 1.6 0 0 1-1.6 1.2H9a1.6 1.6 0 0 1-1.6-1.3z" fill="currentColor"/><path d="M2.5 3.5h2.6L6 8"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/><path d="m10.9 11.9 1.8 1.8 3.4-3.6" stroke="#fff"/></svg><%- _ic.span %></a></span><% } -%>

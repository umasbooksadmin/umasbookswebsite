<!-- THE <footer> markup, shared by the Members Area app
     (partials/footer.ejs) and every marketing page
     (marketing/partials/mkt_footer.ejs) — see mkt_chrome_header.ejs's
     note for why this used to be two hand-synced copies. -->
<% const t = typeof tr === 'function' ? tr : (en) => en; %>
<footer class="mkt-footer">
  <div class="h-footer-row">
    <ul>
      <li><a href="/contact" data-i18n="foot.contact"><%= t('Contact Us', 'Nous contacter') %></a></li>
      <li><a href="/visit.html">Albi, France</a></li>
      <li><a href="/privacy-policy.html" data-i18n="foot.privacy"><%= t('Privacy Policy', 'Politique de confidentialité') %></a></li>
      <li><a href="/terms-of-sale.html" data-i18n="foot.terms"><%= t('Terms of Sale', 'Conditions générales de vente') %></a></li>
      <li><a href="/mentions-legales.html" data-i18n="foot.legal"><%= t('Legal Notice', 'Mentions légales') %></a></li>
    </ul>
    <% if (typeof socialLinks !== 'undefined' && (socialLinks.instagram || socialLinks.facebook)) { %>
    <div class="h-social">
      <%# Real social pages come from SOCIAL_LINKS in src/lib/legal.js; an empty one is not shown. %>
      <% if (socialLinks.instagram) { %><a href="<%= socialLinks.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a><% } %>
      <% if (socialLinks.facebook) { %><a href="<%= socialLinks.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.2v-7h-2.4v-2.8h2.4V9.1c0-2.4 1.5-3.7 3.6-3.7 1 0 1.9.1 2.2.1v2.5h-1.5c-1.2 0-1.4.6-1.4 1.4v1.8h2.8l-.4 2.8h-2.4v7H19a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/></svg></a><% } %>
    </div>
    <% } %>
  </div>
  <%# Map to the shop (coloured, own file: no third-party map tiles, so no request leaves our origin). %>
  <figure class="h-footer-map">
    <a href="/images/shop-map.jpg" data-i18n-attr="aria-label:foot.map.open" aria-label="<%= t('Open the map in full size', 'Ouvrir le plan en grand') %>">
      <img src="/images/shop-map-420.jpg" srcset="/images/shop-map-420.jpg 420w, /images/shop-map.jpg 800w" sizes="(max-width: 460px) 100vw, 420px" width="800" height="800" loading="lazy" decoding="async" data-i18n-attr="alt:foot.map.alt" alt="<%= t('Map showing the route to Uma\'s Books and Adventures from Rue de l\'Oulmet along Rue Peyrolière to the impasse, Albi', 'Plan de l’itinéraire vers Uma’s Books and Adventures depuis la rue de l’Oulmet, par la rue Peyrolière jusqu’à l’impasse, Albi') %>">
    </a>
    <figcaption data-i18n="foot.map.cap"><%= t('Albi, France: Rue Peyrolière', 'Albi, France : rue Peyrolière') %></figcaption>
  </figure>
</footer>

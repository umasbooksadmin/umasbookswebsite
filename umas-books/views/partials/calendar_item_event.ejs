<%
/* One day-cell's event card for views/events.ejs, rendered via
   partials/calendar_grid.ejs. `item` is a row from the events table;
   `qs` is the current calendar query string, carried through so the
   sign-up form can send the visitor back to the same view. */
const e = item;
const tones = ['tone-a', 'tone-b', 'tone-c', 'tone-d', 'tone-e', 'tone-f'];
const full = e.capacity != null && e.signup_count >= e.capacity;
%>
<details class="fcal-session <%= tones[e.id % tones.length] %>">
  <summary>
    <div class="fcal-session-title"><%= e.title %></div>
    <div class="fcal-session-time"><%= formatTime(e.starts_at) %></div>
    <div class="fcal-session-seats">
      <%= e.price != null ? '€' + Number(e.price).toFixed(2) : 'Free' %> &middot; <%= e.signup_count %> going
    </div>
  </summary>
  <div class="fcal-session-details">
    <div class="muted small"><%= formatDateTime(e.starts_at) %><%= e.location ? ' · ' + e.location : '' %> · <%= e.price != null ? '€' + Number(e.price).toFixed(2) : 'Free' %></div>
    <% if (e.description) { %><p class="muted small"><%= e.description %></p><% } %>

    <form method="post" action="/events/<%= e.id %>/signup?<%= qs %>" class="fcal-session-form">
      <%- include('csrf_field') %>
      <label for="name-<%= e.id %>">Name</label>
      <input id="name-<%= e.id %>" name="name" type="text" required<%= full ? ' disabled' : '' %>>
      <label for="email-<%= e.id %>">Email</label>
      <input id="email-<%= e.id %>" name="email" type="email" required<%= full ? ' disabled' : '' %>>
      <button type="submit" class="fcal-session-cta"<%= full ? ' disabled' : '' %>><%= full ? 'Full' : 'Sign Up' %></button>
    </form>

    <a class="fcal-session-cta fcal-session-cta-outline" href="/events/<%= e.id %>/ics" download>Add to My Calendar</a>
  </div>
</details>

<%
/* One day-cell's event card for views/events.ejs, rendered via
   partials/calendar_grid.ejs. `item` is a row from the events table;
   `qs` is the current calendar query string, carried through so the
   sign-up form can send the person back to the same view. */
const e = item;
const tones = ['tone-a', 'tone-b', 'tone-c', 'tone-d', 'tone-e', 'tone-f'];
const full = e.capacity != null && e.signup_count >= e.capacity;
const priceLabel = e.price != null
  ? eur(e.price)
  : tr('Free', 'Gratuit');
// Events are never paid on the site (the sign-up form takes a name and an email, nothing else).
const payOnTheDay = e.price != null ? tr('Payment on the day', 'Paiement sur place') : '';
%>
<details class="fcal-session <%= tones[e.id % tones.length] %>">
  <summary>
    <div class="fcal-session-title"<% if (e.fallback) { %> lang="en"<% } %>><%= e.title %><% if (e.fallback) { %> <span class="fcal-lang"><span aria-hidden="true">EN</span><span class="visually-hidden" lang="fr"> Événement présenté en anglais</span></span><% } %></div>
    <div class="fcal-session-time"><%= formatTime(e.starts_at) %></div>
    <div class="fcal-session-seats">
      <%= priceLabel %> &middot; <%= tr('{n} going', e.signup_count < 2 ? '{n} inscrit' : '{n} inscrits', { n: e.signup_count }) %>
    </div>
  </summary>
  <div class="fcal-session-details">
    <div class="muted small"><%= formatDateTime(e.starts_at) %><% if (e.location) { %> · <span<% if (e.fallback) { %> lang="en"<% } %>><%= e.location %></span><% } %> · <%= priceLabel %><%= payOnTheDay ? ' · ' + payOnTheDay : '' %></div>
    <% if (e.fallback) { %><p class="fcal-notice small" role="note"><%= tr('This event is only described in English.', 'Cet événement n’est décrit qu’en anglais.') %></p><% } %>
    <% if (e.description) { %><p class="muted small"<% if (e.fallback) { %> lang="en"<% } %>><%= e.description %></p><% } %>

    <form method="post" action="/events/<%= e.id %>/signup?<%= qs %>" class="fcal-session-form">
      <%- include('csrf_field') %>
      <label for="name-<%= e.id %>"><%= tr('Name', 'Nom') %></label>
      <input id="name-<%= e.id %>" name="name" type="text" required<%= full ? ' disabled' : '' %>>
      <label for="email-<%= e.id %>"><%= tr('Email', 'E-mail') %></label>
      <input id="email-<%= e.id %>" name="email" type="email" required<%= full ? ' disabled' : '' %>>
      <%- include('privacy_note', { en: 'We use your name and email only to manage attendance at this event. See our', fr: 'Votre nom et votre e-mail servent uniquement à gérer la participation à cet événement. Consultez notre' }) %>
      <button type="submit" class="fcal-session-cta"<%= full ? ' disabled' : '' %>><%= full ? tr('Full', 'Complet') : tr('Sign Up', 'S’inscrire') %></button>
    </form>

    <a class="fcal-session-cta fcal-session-cta-outline" href="/events/<%= e.id %>/ics" download><%= tr('Add to My Calendar', 'Ajouter à mon agenda') %></a>
  </div>
</details>

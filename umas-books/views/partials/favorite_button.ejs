<%# The heart on a book card. Params: id, title. English: a plain aria-label. French: an aria-label cannot carry a lang, so the spoken
    name is a visually-hidden span inside the button with the English title wrapped in lang="en" (lib/bookText.js favName). %>
<% if (lang === 'fr') { %><button type="button" class="favorite-toggle" data-book-id="<%= id %>" aria-pressed="false"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg><span class="fav-name"><%- favName(title) %></span></button><% } else { %><button type="button" class="favorite-toggle" data-book-id="<%= id %>" aria-pressed="false" aria-label="<%- favName(title) %>"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg></button><% } %>

<%- include('partials/header', { noindex: true, title: tr('Forgot Password', 'Mot de passe oublié') }) %>

<h1><%= tr('Reset your password', 'Réinitialiser votre mot de passe') %></h1>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<p class="muted"><%= tr('Enter the email you signed up with and we\'ll send you a link to set a new password.', 'Saisissez l’adresse e-mail utilisée lors de votre inscription : nous vous enverrons un lien pour choisir un nouveau mot de passe.') %></p>
<form class="stack" method="post" action="/forgot-password">
  <%- include('partials/csrf_field') %>
  <label for="email"><%= tr('Email', 'E-mail') %></label>
  <input id="email" name="email" type="email" autocomplete="email" required>
  <button class="btn" type="submit"><%= tr('Send reset link', 'Envoyer le lien') %></button>
</form>
<p class="muted small"><a href="/login"><%= tr('Back to log in', 'Retour à la connexion') %></a></p>

<%- include('partials/footer') %>

<%- include('partials/header', { noindex: true, title: 'Forgot Password' }) %>

<h1>Reset your password</h1>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<p class="muted">Enter the email you signed up with and we'll send you a link to set a new password.</p>
<form class="stack" method="post" action="/forgot-password">
  <%- include('partials/csrf_field') %>
  <label for="email">Email</label>
  <input id="email" name="email" type="email" autocomplete="email" required>
  <button class="btn" type="submit">Send reset link</button>
</form>
<p class="muted small"><a href="/login">Back to log in</a></p>

<%- include('partials/footer') %>

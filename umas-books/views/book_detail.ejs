<%- include('partials/header', { title: book.title, hideBackLink: true }) %>

<p><a class="tap-link" href="/books.html<%= backGenre ? '?genre=' + encodeURIComponent(backGenre) : '' %>">&larr; <%= backGenre ? tr('Back to {genre}', 'Retour à {genre}', { genre: genreLabel(backGenre) }) : tr('Back to Books', 'Retour aux livres') %></a></p>

<div class="book-detail-grid">
  <div>
    <div class="book-detail-cover-wrap">
      <%- include('partials/favorite_button', { id: book.id, title: book.title }) %>
      <% if (book.cover_url) { %>
        <%# width/height + aspect-ratio reserve the space (no layout shift); the cover is the page's main image, so it loads first. A failed load is swapped for a placeholder by public/app.js. %>
        <img src="<%= book.cover_url %>"<% if (coverSrcset(book.cover_url)) { %> srcset="<%= coverSrcset(book.cover_url) %>" sizes="(max-width: 700px) 150px, 240px"<% } %> alt="<%= tr('Cover of {title}', 'Couverture de {title}', { title: book.title }) %>" class="book-detail-cover" width="240" height="360" fetchpriority="high" decoding="async" data-cover>
      <% } else { %>
        <div class="book-detail-cover book-thumb-placeholder" aria-hidden="true"><%= tr('No cover', 'Pas de couverture') %></div>
      <% } %>
    </div>
    <%- include('partials/cover_note') %>
  </div>

  <div>
    <% if (book.categories) { %><div class="book-detail-kicker"><%= genresLabel(book.categories, book.categories_fr) %></div><% } %>
    <h1 style="margin-bottom:4px;"><%- bookText(book.title) %></h1>
    <p class="muted" style="margin-top:0;"><%= tr('by', 'de') %> <%- book.authors ? bookText(book.authors) : tr('Unknown author', 'Auteur inconnu') %></p>

    <% if (book.description) { %>
      <h2 class="book-about-title"><%= tr('About this book', 'À propos de ce livre') %></h2>
      <p class="book-about"><%= tr(book.description, book.description_fr) %></p>
    <% } %>

    <% if (typeof awards !== 'undefined' && awards.length) { %>
      <section class="book-awards" aria-labelledby="book-awards-title">
        <strong id="book-awards-title" class="book-awards-title"><%= tr('Awards & lists:', 'Prix et classements :') %></strong>
        <ul class="book-awards-list">
          <% awards.slice(0, 8).forEach((a) => { %><li><%= a %></li><% }) %>
        </ul>
        <% if (awards.length > 8) { %>
          <details class="book-awards-more">
            <summary><%= tr('Show all ({n})', 'Tout afficher ({n})', { n: awards.length }) %></summary>
            <ul class="book-awards-list">
              <% awards.slice(8).forEach((a) => { %><li><%= a %></li><% }) %>
            </ul>
          </details>
        <% } %>
      </section>
    <% } %>

    <% if (bindingLabel) { %>
      <dl class="book-facts"><div><dt><%= tr('Binding', 'Reliure') %> :</dt> <dd><%= bindingLabel %></dd></div></dl>
    <% } %>

    <% if (copies.length) { %>
      <%# A copy is only for sale online with a real price: NULL / 0 / negative means "ask in the shop" (see isPurchasablePrice in lib/inventory.js). %>
      <% const buyable = (c) => c.price != null && Number.isFinite(Number(c.price)) && Number(c.price) > 0; %>
      <% const minPrice = Math.min(...copies.filter(buyable).map(c => Number(c.price))); %>
      <div class="book-detail-price">
        <% if (isFinite(minPrice)) { %><%= eur(minPrice) %><% } %>
        <% if (copies.some(c => c.is_clearance)) { %><span class="clearance-badge"><%= tr('Clearance', 'Déstockage') %></span><% } %>
      </div>
      <% if (isFinite(minPrice)) { %><p class="muted small book-vat" style="margin:0 0 8px;"><%= legalText.priceLine %></p><% } %>

      <div class="availability-box">
        <div class="availability-badge is-in-stock"><span class="dot"></span><%= tr('Available in Shop', 'Disponible en boutique') %></div>
        <p class="muted small" style="margin:6px 0 12px;">
          <%= copies.length === 1 ? tr('1 copy on our shelves.', '1 exemplaire en rayon.') : tr('{n} copies on our shelves.', '{n} exemplaires en rayon.', { n: copies.length }) %>
        </p>

        <table class="copy-table" role="table">
          <caption class="visually-hidden"><%= tr('Condition and price of each copy', 'État et prix de chaque exemplaire') %></caption>
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader"><%= tr('Condition', 'État') %></th>
              <th scope="col" role="columnheader"><%= tr('Price', 'Prix') %></th>
              <th scope="col" role="columnheader"><span class="visually-hidden"><%= tr('Add to Cart', 'Ajouter au panier') %></span></th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            <% copies.forEach(c => { %>
              <tr role="row">
                <td role="cell"><span class="condition-badge condition-<%= c.condition %>"><%= conditionLabel(c.condition) %></span></td>
                <td role="cell"><%= buyable(c) ? eur(c.price) : '' %><% if (c.is_clearance) { %> <span class="clearance-badge"><%= tr('Clearance', 'Déstockage') %></span><% } %></td>
                <td role="cell">
                  <% if (buyable(c)) { %>
                  <form method="post" action="/cart/add">
                    <%- include('partials/csrf_field') %>
                    <input type="hidden" name="copyId" value="<%= c.id %>">
                    <input type="hidden" name="backTo" value="/cart">
                    <button class="btn btn-small" type="submit"><%= tr('Add to Cart', 'Ajouter au panier') %></button>
                  </form>
                  <% } else { %>
                  <span class="muted small copy-ask-in-shop"><%= tr('Ask in the shop', 'Se renseigner en boutique') %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <p class="muted small book-disclaimer"><%= legalText.bookFriendly %> <%= legalText.noReturns %> <a href="/terms-of-sale.html"><%= tr('Terms of sale', 'Conditions de vente') %></a></p>

        <details class="grade-legend">
          <summary><%= tr('What the grades mean', 'Que signifient les états ?') %></summary>
          <p class="muted small"><%= legalText.gradeNote %></p>
          <dl>
            <% conditions.forEach(g => { %>
              <dt><span class="condition-badge condition-<%= g.value %>"><%= conditionLabel(g.value) %></span></dt>
              <dd><%= tr(g.description, g.description_fr) %></dd>
            <% }) %>
          </dl>
        </details>
      </div>
    <% } else { %>
      <div class="availability-box">
        <div class="availability-badge is-out">&middot; <%= tr('Currently unavailable', 'Actuellement indisponible') %></div>
        <p class="muted small" style="margin:6px 0 0;"><%= tr('All copies of this title are spoken for right now — check back soon.', 'Tous les exemplaires de ce titre sont réservés pour le moment : revenez bientôt.') %></p>
      </div>
    <% } %>
  </div>
</div>

<% if (moreByAuthor.length) { %>
  <h2 style="margin-top:40px;"><%- tr('More by {author}', 'Du même auteur : {author}', { author: '\u0000' }).split('\u0000').map(escHtml).join(bookText(book.authors)) %></h2>
  <div class="book-grid">
    <% moreByAuthor.forEach(b => { %>
      <div class="book-card-wrap">
        <%- include('partials/favorite_button', { id: b.id, title: b.title }) %>
        <a class="book-card" href="/books/<%= b.id %>">
          <% if (b.cover_url) { %>
            <img src="<%= b.cover_url %>"<% if (coverSrcset(b.cover_url)) { %> srcset="<%= coverSrcset(b.cover_url) %>" sizes="(max-width: 700px) 45vw, 200px"<% } %> alt="" class="book-card-cover" width="200" height="300" loading="lazy" decoding="async" data-cover>
          <% } else { %>
            <div class="book-card-cover book-thumb-placeholder" aria-hidden="true"><%= tr('No cover', 'Pas de couverture') %></div>
          <% } %>
          <div class="book-card-body">
            <div class="book-card-title"><%- bookText(b.title) %></div>
            <% if (b.min_price != null) { %><div class="book-card-price"><%= eur(b.min_price) %></div><% } %>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
  <%- include('partials/cover_note') %>
<% } %>

<%- include('partials/footer') %>

<%- include('partials/header', { title: book.title, hideBackLink: true }) %>

<p><a href="/books<%= backGenre ? '?genre=' + encodeURIComponent(backGenre) : '' %>">&larr; Back to <%= backGenre || 'Books' %></a></p>

<div class="book-detail-grid">
  <div>
    <div class="book-detail-cover-wrap">
      <button type="button" class="favorite-toggle" data-book-id="<%= book.id %>" aria-pressed="false" aria-label="Favorite">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg>
      </button>
      <% if (book.cover_url) { %>
        <img src="<%= book.cover_url %>" alt="Cover of <%= book.title %>" class="book-detail-cover">
      <% } else { %>
        <div class="book-detail-cover book-thumb-placeholder">No cover</div>
      <% } %>
    </div>
    <%- include('partials/cover_note') %>
  </div>

  <div>
    <% if (book.categories) { %><div class="book-detail-kicker" data-fr-text="<%= book.categories_fr || '' %>"><%= book.categories %></div><% } %>
    <h1 style="margin-bottom:4px;"><%= book.title %></h1>
    <p class="muted" style="margin-top:0;">by <%= book.authors || 'Unknown author' %></p>

    <% if (copies.length) { %>
      <% const minPrice = Math.min(...copies.map(c => c.price != null ? Number(c.price) : Infinity)); %>
      <div class="book-detail-price">
        <% if (isFinite(minPrice)) { %>&euro;<%= minPrice.toFixed(2) %><% } %>
        <% if (copies.length === 1) { %><span class="muted small">&middot; <%= conditionLabel(copies[0].condition) %></span><% } %>
      </div>

      <div class="availability-box">
        <div class="availability-badge is-in-stock"><span class="dot"></span>Available in Shop</div>
        <p class="muted small" style="margin:6px 0 16px;">
          <%= copies.length %> cop<%= copies.length === 1 ? 'y' : 'ies' %> on our shelves.
        </p>

        <form method="post" action="/cart/add" style="margin-bottom:14px;">
          <%- include('partials/csrf_field') %>
          <% if (copies.length > 1) { %>
            <label for="cartCopyId">Which copy?</label>
            <select id="cartCopyId" name="copyId" style="margin-bottom:10px;">
              <% copies.forEach(c => { %>
                <option value="<%= c.id %>"><%= conditionLabel(c.condition) %><%= c.price != null ? ' · €' + Number(c.price).toFixed(2) : '' %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input type="hidden" name="copyId" value="<%= copies[0].id %>">
          <% } %>
          <input type="hidden" name="backTo" value="/cart">
          <button class="btn" type="submit">Add to Cart</button>
        </form>
      </div>
    <% } else { %>
      <div class="availability-box">
        <div class="availability-badge is-out">&middot; Currently unavailable</div>
        <p class="muted small" style="margin:6px 0 0;">All copies of this title are spoken for right now &mdash; check back soon.</p>
      </div>
    <% } %>

    <% if (book.description) { %>
      <h3 style="margin-top:28px;" data-fr-text="À propos de ce livre">About this book</h3>
      <p data-fr-text="<%= book.description_fr || '' %>"><%= book.description %></p>
    <% } %>
  </div>
</div>

<% if (moreByAuthor.length) { %>
  <h2 style="margin-top:40px;">More by <%= book.authors %></h2>
  <div class="book-grid">
    <% moreByAuthor.forEach(b => { %>
      <div class="book-card-wrap">
        <button type="button" class="favorite-toggle" data-book-id="<%= b.id %>" aria-pressed="false" aria-label="Favorite">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg>
        </button>
        <a class="book-card" href="/books/<%= b.id %>">
          <% if (b.cover_url) { %>
            <img src="<%= b.cover_url %>" alt="" class="book-card-cover">
          <% } else { %>
            <div class="book-card-cover book-thumb-placeholder">No cover</div>
          <% } %>
          <div class="book-card-body">
            <div class="book-card-title"><%= b.title %></div>
            <% if (b.min_price != null) { %><div class="book-card-price">&euro;<%= Number(b.min_price).toFixed(2) %></div><% } %>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
  <%- include('partials/cover_note') %>
<% } %>

<%- include('partials/footer') %>

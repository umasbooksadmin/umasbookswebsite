<%- include('partials/header', { title: book.title, hideBackLink: true }) %>

<p><a href="/books<%= backGenre ? '?genre=' + encodeURIComponent(backGenre) : '' %>">&larr; <%= backGenre ? tr('Back to {genre}', 'Retour à {genre}', { genre: backGenre }) : tr('Back to Books', 'Retour aux livres') %></a></p>

<div class="book-detail-grid">
  <div>
    <div class="book-detail-cover-wrap">
      <button type="button" class="favorite-toggle" data-book-id="<%= book.id %>" aria-pressed="false" aria-label="<%= tr('Favorite', 'Favori') %>">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg>
      </button>
      <% if (book.cover_url) { %>
        <img src="<%= book.cover_url %>" alt="<%= tr('Cover of {title}', 'Couverture de {title}', { title: book.title }) %>" class="book-detail-cover">
      <% } else { %>
        <div class="book-detail-cover book-thumb-placeholder"><%= tr('No cover', 'Pas de couverture') %></div>
      <% } %>
    </div>
    <%- include('partials/cover_note') %>
  </div>

  <div>
    <% if (book.categories) { %><div class="book-detail-kicker"><%= tr(book.categories, book.categories_fr) %></div><% } %>
    <h1 style="margin-bottom:4px;"><%= book.title %></h1>
    <p class="muted" style="margin-top:0;"><%= tr('by', 'de') %> <%= book.authors || tr('Unknown author', 'Auteur inconnu') %></p>

    <% if (copies.length) { %>
      <% const minPrice = Math.min(...copies.map(c => c.price != null ? Number(c.price) : Infinity)); %>
      <div class="book-detail-price">
        <% if (isFinite(minPrice)) { %>&euro;<%= minPrice.toFixed(2) %><% } %>
        <% if (copies.length === 1) { %><span class="muted small">&middot; <%= conditionLabel(copies[0].condition) %></span><% } %>
      </div>

      <div class="availability-box">
        <div class="availability-badge is-in-stock"><span class="dot"></span><%= tr('Available in Shop', 'Disponible en boutique') %></div>
        <p class="muted small" style="margin:6px 0 16px;">
          <%= copies.length === 1 ? tr('1 copy on our shelves.', '1 exemplaire en rayon.') : tr('{n} copies on our shelves.', '{n} exemplaires en rayon.', { n: copies.length }) %>
        </p>

        <form method="post" action="/cart/add" style="margin-bottom:14px;">
          <%- include('partials/csrf_field') %>
          <% if (copies.length > 1) { %>
            <label for="cartCopyId"><%= tr('Which copy?', 'Quel exemplaire ?') %></label>
            <select id="cartCopyId" name="copyId" style="margin-bottom:10px;">
              <% copies.forEach(c => { %>
                <option value="<%= c.id %>"><%= conditionLabel(c.condition) %><%= c.price != null ? ' · €' + Number(c.price).toFixed(2) : '' %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input type="hidden" name="copyId" value="<%= copies[0].id %>">
          <% } %>
          <input type="hidden" name="backTo" value="/cart">
          <button class="btn" type="submit"><%= tr('Add to Cart', 'Ajouter au panier') %></button>
        </form>
      </div>
    <% } else { %>
      <div class="availability-box">
        <div class="availability-badge is-out">&middot; <%= tr('Currently unavailable', 'Actuellement indisponible') %></div>
        <p class="muted small" style="margin:6px 0 0;"><%= tr('All copies of this title are spoken for right now — check back soon.', 'Tous les exemplaires de ce titre sont réservés pour le moment : revenez bientôt.') %></p>
      </div>
    <% } %>

    <% if (typeof awards !== 'undefined' && awards.length) { %>
      <div class="book-awards" style="margin-top:20px;">
        <strong><%= tr('Awards & lists:', 'Prix et classements :') %></strong>
        <% if (awards.length > 8) { %>
          <%= awards.slice(0, 8).join(', ') %>
          <details style="margin-top:6px;">
            <summary style="cursor:pointer; color: var(--maroon);"><%= tr('Show all ({n})', 'Tout afficher ({n})', { n: awards.length }) %></summary>
            <%= awards.join(', ') %>
          </details>
        <% } else { %>
          <%= awards.join(', ') %>
        <% } %>
      </div>
    <% } %>

    <% if (book.description) { %>
      <h3 style="margin-top:28px;"><%= tr('About this book', 'À propos de ce livre') %></h3>
      <p><%= tr(book.description, book.description_fr) %></p>
    <% } %>
  </div>
</div>

<% if (moreByAuthor.length) { %>
  <h2 style="margin-top:40px;"><%= tr('More by {author}', 'Du même auteur : {author}', { author: book.authors }) %></h2>
  <div class="book-grid">
    <% moreByAuthor.forEach(b => { %>
      <div class="book-card-wrap">
        <button type="button" class="favorite-toggle" data-book-id="<%= b.id %>" aria-pressed="false" aria-label="<%= tr('Favorite', 'Favori') %>">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 20s-7-4.4-9.5-8.8C.8 7.8 2.4 4.5 5.8 4c2-.3 3.7.7 4.8 2.4L12 8l1.4-1.6C14.5 4.7 16.2 3.7 18.2 4c3.4.5 5 3.8 3.3 7.2C19 15.6 12 20 12 20z"/></svg>
        </button>
        <a class="book-card" href="/books/<%= b.id %>">
          <% if (b.cover_url) { %>
            <img src="<%= b.cover_url %>" alt="" class="book-card-cover">
          <% } else { %>
            <div class="book-card-cover book-thumb-placeholder"><%= tr('No cover', 'Pas de couverture') %></div>
          <% } %>
          <div class="book-card-body">
            <div class="book-card-title"><%= b.title %></div>
            <% if (b.min_price != null) { %><div class="book-card-price">&euro;<%= Number(b.min_price).toFixed(2) %></div><% } %>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
  <%- include('partials/cover_note') %>
<% } %>

<%- include('partials/footer') %>

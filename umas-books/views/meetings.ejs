<%- include('partials/header', { title: tr('Meetings', 'Réunions'), mainClass: view === 'week' ? 'wrap-wide' : 'wrap' }) %>

<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>

<h1><%= tr('Meetings', 'Réunions') %></h1>

<div class="card">
  <div class="calendar-nav">
    <div class="calendar-nav-main">
      <a class="btn btn-outline btn-small" href="/meetings?<%= prevHref %>">&larr; <%= tr('Prev', 'Préc.') %></a>
      <span class="month-label"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a class="btn btn-outline btn-small" href="/meetings?<%= nextHref %>"><%= tr('Next', 'Suiv.') %> &rarr;</a>
    </div>
    <div class="calendar-view-toggle">
      <a href="/meetings" class="btn btn-outline btn-small<%= view === 'month' ? ' is-active' : '' %>"><%= tr('Month', 'Mois') %></a>
      <a href="/meetings?view=week" class="btn btn-outline btn-small<%= view === 'week' ? ' is-active' : '' %>"><%= tr('Week', 'Semaine') %></a>
    </div>
  </div>
  <div class="calendar-grid calendar-agenda">
    <% const weekdayNames = [tr('Sun', 'Dim'), tr('Mon', 'Lun'), tr('Tue', 'Mar'), tr('Wed', 'Mer'), tr('Thu', 'Jeu'), tr('Fri', 'Ven'), tr('Sat', 'Sam')]; %>
    <% weekdayNames.forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach((day, wi) => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><span class="calendar-day-weekday"><%= weekdayNames[wi] %></span><%= day.day %></div>
            <% day.items.forEach(m => { %>
              <% const going = rsvpedMeetingIds.has(m.id); %>
              <details class="calendar-pill<%= going ? ' is-mine' : '' %>">
                <summary><%= m.title %> &middot; <%= formatTime(m.scheduled_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(m.scheduled_at) %><%= m.location ? ' · ' + m.location : '' %>
                    &middot; <%= tr('{n} going', m.rsvp_count < 2 ? '{n} participant' : '{n} participants', { n: m.rsvp_count }) %>
                  </div>
                  <% if (m.agenda) { %><div class="muted small" style="margin-top:6px;"><em><%= tr('Agenda:', 'Ordre du jour :') %></em> <%= m.agenda %></div><% } %>
                  <% if (going) { %>
                    <form method="post" action="/meetings/<%= m.id %>/unrsvp?<%= qs %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-outline btn-small" type="submit"><%= tr('Cancel RSVP', 'Annuler ma participation') %></button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/meetings/<%= m.id %>/rsvp?<%= qs %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-small" type="submit"><%- tr("I'll be there", 'Je serai présent(e)') %></button>
                    </form>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<div class="card">
  <div class="section-title"><%= tr('Past meetings & minutes', 'Réunions passées et comptes rendus') %></div>
  <% if (!past.length) { %>
    <p class="muted"><%= tr('No past meetings yet.', 'Aucune réunion passée pour le moment.') %></p>
  <% } else { %>
    <ul class="plain">
      <% past.forEach(m => { %>
        <li>
          <strong><%= m.title %></strong>
          <div class="muted small"><%= formatDateTime(m.scheduled_at) %><%= m.location ? ' · ' + m.location : '' %></div>
          <% if (m.minutes) { %>
            <div style="margin-top:6px;"><em><%= tr('Minutes:', 'Compte rendu :') %></em> <%= m.minutes %></div>
          <% } else { %>
            <div class="muted small" style="margin-top:6px;"><%= tr('Minutes not posted yet.', 'Compte rendu pas encore publié.') %></div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Meetings' }) %>

<h1>Meetings</h1>

<div class="card">
  <div class="calendar-nav">
    <a class="btn btn-outline btn-small" href="/meetings?month=<%= prevMonth %>">&larr; Prev</a>
    <span class="month-label"><%= monthLabel %></span>
    <a class="btn btn-outline btn-small" href="/meetings?month=<%= nextMonth %>">Next &rarr;</a>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% day.items.forEach(m => { %>
              <% const going = rsvpedMeetingIds.has(m.id); %>
              <details class="calendar-pill<%= going ? ' is-mine' : '' %>">
                <summary><%= m.title %> &middot; <%= new Date(m.scheduled_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= new Date(m.scheduled_at).toLocaleString() %><%= m.location ? ' · ' + m.location : '' %>
                    &middot; <%= m.rsvp_count %> going
                  </div>
                  <% if (m.agenda) { %><div class="muted small" style="margin-top:6px;"><em>Agenda:</em> <%= m.agenda %></div><% } %>
                  <% if (going) { %>
                    <form method="post" action="/meetings/<%= m.id %>/unrsvp?month=<%= currentMonth %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-outline btn-small" type="submit">Cancel RSVP</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/meetings/<%= m.id %>/rsvp?month=<%= currentMonth %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-small" type="submit">I'll be there</button>
                    </form>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<div class="card">
  <div class="section-title">Past meetings &amp; minutes</div>
  <% if (!past.length) { %>
    <p class="muted">No past meetings yet.</p>
  <% } else { %>
    <ul class="plain">
      <% past.forEach(m => { %>
        <li>
          <strong><%= m.title %></strong>
          <div class="muted small"><%= new Date(m.scheduled_at).toLocaleString() %><%= m.location ? ' · ' + m.location : '' %></div>
          <% if (m.minutes) { %>
            <div style="margin-top:6px;"><em>Minutes:</em> <%= m.minutes %></div>
          <% } else { %>
            <div class="muted small" style="margin-top:6px;">Minutes not posted yet.</div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>

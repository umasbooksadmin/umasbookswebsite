<%- include('partials/header', { title: 'Meetings', mainClass: view === 'week' ? 'wrap-wide' : 'wrap' }) %>

<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>

<h1>Meetings</h1>

<div class="card">
  <div class="calendar-nav">
    <div class="calendar-nav-main">
      <a class="btn btn-outline btn-small" href="/meetings?<%= prevHref %>">&larr; Prev</a>
      <span class="month-label"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a class="btn btn-outline btn-small" href="/meetings?<%= nextHref %>">Next &rarr;</a>
    </div>
    <div class="calendar-view-toggle">
      <a href="/meetings" class="btn btn-outline btn-small<%= view === 'month' ? ' is-active' : '' %>">Month</a>
      <a href="/meetings?view=week" class="btn btn-outline btn-small<%= view === 'week' ? ' is-active' : '' %>">Week</a>
    </div>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% day.items.forEach(m => { %>
              <% const going = rsvpedMeetingIds.has(m.id); %>
              <details class="calendar-pill<%= going ? ' is-mine' : '' %>">
                <summary><%= m.title %> &middot; <%= formatTime(m.scheduled_at) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= formatDateTime(m.scheduled_at) %><%= m.location ? ' · ' + m.location : '' %>
                    &middot; <%= m.rsvp_count %> going
                  </div>
                  <% if (m.agenda) { %><div class="muted small" style="margin-top:6px;"><em>Agenda:</em> <%= m.agenda %></div><% } %>
                  <% if (going) { %>
                    <form method="post" action="/meetings/<%= m.id %>/unrsvp?<%= qs %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-outline btn-small" type="submit">Cancel RSVP</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/meetings/<%= m.id %>/rsvp?<%= qs %>" style="margin-top:8px;">
                      <%- include('partials/csrf_field') %>
                      <button class="btn btn-small" type="submit">I'll be there</button>
                    </form>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<div class="card">
  <div class="section-title">Past meetings &amp; minutes</div>
  <% if (!past.length) { %>
    <p class="muted">No past meetings yet.</p>
  <% } else { %>
    <ul class="plain">
      <% past.forEach(m => { %>
        <li>
          <strong><%= m.title %></strong>
          <div class="muted small"><%= formatDateTime(m.scheduled_at) %><%= m.location ? ' · ' + m.location : '' %></div>
          <% if (m.minutes) { %>
            <div style="margin-top:6px;"><em>Minutes:</em> <%= m.minutes %></div>
          <% } else { %>
            <div class="muted small" style="margin-top:6px;">Minutes not posted yet.</div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: tr('Announcements', 'Annonces'), extraCss: ['/dashboard.css'] }) %>

<h1><%= tr('Announcements', 'Annonces') %></h1>

<% if (!announcements.length) { %>
  <p class="muted"><%= tr('Nothing posted yet.', 'Rien n’a encore été publié.') %></p>
<% } else { %>
  <ul class="dash-ann-list">
    <% announcements.forEach(a => { %>
      <li class="dash-ann-item">
        <% if (a.image_url) { %><img src="<%= a.image_url %>" alt=""><% } %>
        <div>
          <div class="dash-ann-date"><%= a.is_pinned ? '\u{1F4CC} ' : '' %><%= formatDate(a.published_at) %></div>
          <h2<% if (a.fallback) { %> lang="en"<% } %>><%= a.title %><% if (a.fallback) { %> <span class="dash-lang"><span aria-hidden="true">EN</span><span class="visually-hidden" lang="fr"> Annonce disponible uniquement en anglais</span></span><% } %></h2>
          <% if (a.excerpt) { %><p<% if (a.fallback) { %> lang="en"<% } %>><%= a.excerpt %></p><% } %>
          <div class="rich-content"<% if (a.fallback) { %> lang="en"<% } %>><%- a.body %></div>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>

<%- include('partials/header', { noindex: true, title: tr('My Account', 'Mon compte') }) %>

<%
  const statusLabels = { reserved: tr('Reserved', 'Réservée'), pending: tr('Pending', 'En attente'), paid: tr('Paid', 'Payée'), cancelled: tr('Cancelled', 'Annulée'), expired: tr('Expired', 'Expirée'), refunded: tr('Refunded', 'Remboursée') };
  const statusLabel = (st) => statusLabels[st] || (st.charAt(0).toUpperCase() + st.slice(1));
  const money = eur;
%>
<h1><%= tr('My Account', 'Mon compte') %></h1>
<p class="small"><a href="/account/2fa"><%= tr('Two-step verification', 'Vérification en deux étapes') %></a></p>
<p class="small"><a href="/account/privacy"><%= tr('Privacy: download or delete my data', 'Confidentialité : télécharger ou supprimer mes données') %></a></p>
<% if (locals.notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<p class="muted small"><%= tr('Reservations and session sign-ups matched to {email}.', 'Réservations et inscriptions aux séances associées à {email}.', { email: email }) %></p>

<div class="card">
  <div class="section-title" id="reservations"><%= tr('My reservations', 'Mes réservations') %></div>
  <% if (!emailVerified) { %>
    <div role="status" class="notice-box"><%= tr('Confirm your email address to see your reservations here — we sent a confirmation link to {email} when you signed up. Check your inbox (and spam folder). Your reservations are never lost; they’ll appear as soon as the address is confirmed.', 'Confirmez votre adresse e-mail pour voir vos réservations ici : nous avons envoyé un lien de confirmation à {email} lors de votre inscription. Vérifiez votre boîte de réception (et vos courriers indésirables). Vos réservations ne sont jamais perdues : elles apparaîtront dès que l’adresse sera confirmée.', { email: email }) %></div>
  <% } else if (!orders.length) { %>
    <p class="muted"><%= tr('No reservations yet —', 'Aucune réservation pour le moment :') %> <a href="/books.html"><%= tr('browse books', 'parcourir les livres') %></a> <%= tr('or', 'ou') %> <a href="/sessions"><%= tr('reserve a drop-in seat', 'réserver une place « drop-in »') %></a>.</p>
  <% } else { %>
    <ul class="plain">
      <% orders.forEach(o => { %>
        <li>
          <div class="order-row">
            <strong><%= formatDate(o.created_at) %></strong>
            <span class="status-pill <%= o.status %>"><%= statusLabel(o.status) %></span>
          </div>
          <ul class="plain nested">
            <% (o.items || []).forEach(i => { %>
              <li><%= i.title %> <span class="muted small">&middot; <%= money(i.price) %></span></li>
            <% }) %>
          </ul>
          <div class="muted small"><%= tr('Total:', 'Total :') %> <%= money(o.total_amount) %></div>
          <% if (o.status === 'reserved') { %>
            <div class="muted small"><%= tr('Nothing is paid online: you pay at the shop when you collect.', 'Rien n’est payé en ligne : vous réglez à la boutique au retrait.') %><% if (o.reserved_until && (o.items || []).some((i) => !i.isSeat)) { %> <%= tr('Held until the end of {date}.', 'Gardée jusqu’à la fin de la journée du {date}.', { date: formatDateLong(lastDay(o)) }) %><% } %></div>
            <form method="post" action="/cart/reservations/<%= o.id %>/cancel" data-confirm="<%= tr('Cancel this reservation? Its items become available to others.', 'Annuler cette réservation ? Ses articles redeviendront disponibles pour les autres.') %>">
              <%- include('partials/csrf_field') %>
              <a class="btn btn-outline btn-small" href="/cart/return?order=<%= o.access_token %>"><%= tr('Open', 'Ouvrir') %></a>
              <button class="btn btn-outline btn-small" type="submit"><%= tr('Cancel reservation', 'Annuler la réservation') %></button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card">
  <div class="section-title"><%= tr('My book requests', 'Mes demandes de livres') %></div>
  <% if (!bookRequests.length) { %>
    <p class="muted"><%= tr('No book requests.', 'Aucune demande de livre.') %> <a href="/request-a-book"><%= tr("Can't find a book? Ask us", 'Vous ne trouvez pas un livre ? Demandez-nous') %></a></p>
  <% } else { %>
    <ul class="plain">
      <% bookRequests.forEach(r => { %>
        <li>
          <div class="order-row">
            <strong><%= r.title %></strong><% if (r.author) { %> <span class="muted small">&middot; <%= r.author %></span><% } %>
            <%- include('partials/request_status', { status: r.status }) %>
          </div>
          <form method="post" action="/account/book-requests/<%= r.id %>/cancel">
            <%- include('partials/csrf_field') %>
            <button class="btn btn-outline btn-small" type="submit"><%= tr('Cancel this request', 'Annuler cette demande') %></button>
          </form>
        </li>
      <% }) %>
    </ul>
    <p class="muted small"><a href="/request-a-book"><%= tr('Ask for another book', 'Demander un autre livre') %></a></p>
  <% } %>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { noindex: true, title: tr('My Account', 'Mon compte') }) %>

<%
  const statusLabels = { pending: tr('Pending', 'En attente'), paid: tr('Paid', 'Payée'), cancelled: tr('Cancelled', 'Annulée'), expired: tr('Expired', 'Expirée') };
  const statusLabel = (st) => statusLabels[st] || (st.charAt(0).toUpperCase() + st.slice(1));
  const money = (n) => (lang === 'fr' ? Number(n).toFixed(2).replace('.', ',') + '\u00a0€' : '€' + Number(n).toFixed(2));
%>
<h1><%= tr('My Account', 'Mon compte') %></h1>
<p class="small"><a href="/account/2fa"><%= tr('Two-step verification', 'Vérification en deux étapes') %></a></p>
<p class="small"><a href="/account/privacy"><%= tr('Privacy: download or delete my data', 'Confidentialité : télécharger ou supprimer mes données') %></a></p>
<p class="muted small"><%= tr('Orders and session sign-ups matched to {email}.', 'Commandes et inscriptions aux séances associées à {email}.', { email: email }) %></p>

<div class="card">
  <div class="section-title"><%= tr('Orders', 'Commandes') %></div>
  <% if (!emailVerified) { %>
    <div role="status" class="notice-box"><%= tr('Confirm your email address to see your orders here — we sent a confirmation link to {email} when you signed up. Check your inbox (and spam folder). Your orders are never lost; they’ll appear as soon as the address is confirmed.', 'Confirmez votre adresse e-mail pour voir vos commandes ici : nous avons envoyé un lien de confirmation à {email} lors de votre inscription. Vérifiez votre boîte de réception (et vos courriers indésirables). Vos commandes ne sont jamais perdues : elles apparaîtront dès que l’adresse sera confirmée.', { email: email }) %></div>
  <% } else if (!orders.length) { %>
    <p class="muted"><%= tr('No orders yet —', 'Aucune commande pour le moment :') %> <a href="/books.html"><%= tr('browse books', 'parcourir les livres') %></a> <%= tr('or', 'ou') %> <a href="/sessions"><%= tr('book a drop-in session', 'réserver une séance') %></a>.</p>
  <% } else { %>
    <ul class="plain">
      <% orders.forEach(o => { %>
        <li>
          <div class="order-row">
            <strong><%= formatDate(o.created_at) %></strong>
            <span class="status-pill <%= o.status %>"><%= statusLabel(o.status) %></span>
          </div>
          <ul class="plain nested">
            <% (o.items || []).forEach(i => { %>
              <li><%= i.title %> <span class="muted small">&middot; <%= money(i.price) %></span></li>
            <% }) %>
          </ul>
          <div class="muted small"><%= tr('Total:', 'Total :') %> <%= money(o.total_amount) %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>

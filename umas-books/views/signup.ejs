<%- include('partials/header', { noindex: true, title: tr('Join', 'Inscription') }) %>

<h1><%= tr('Create your account', 'Créer votre compte') %></h1>
<% if (error) { %><div role="alert" class="error-box"><%= error %></div><% } %>
<% if (notice) { %><div role="status" class="notice-box"><%= notice %></div><% } %>
<%- include('partials/return_note') %>
<form class="stack" method="post" action="/signup">
  <%- include('partials/csrf_field') %>
  <% if (locals.returnTo) { %><input type="hidden" name="returnTo" value="<%= locals.returnTo %>"><% } %>
  <label for="displayName"><%= tr('Name', 'Nom') %></label>
  <input id="displayName" name="displayName" type="text" autocomplete="name" required>
  <label for="email"><%= tr('Email', 'E-mail') %></label>
  <input id="email" name="email" type="email" autocomplete="email" required>
  <p class="muted small"><%= tr('We will email you a link to confirm your address and choose your password.', 'Nous vous enverrons par e-mail un lien pour confirmer votre adresse et choisir votre mot de passe.') %></p>
  <button class="btn" type="submit"><%= tr('Create account', 'Créer mon compte') %></button>
  <%- include('partials/privacy_note', { en: 'We use your details only to create and manage your account. See our', fr: 'Vos données servent uniquement à créer et gérer votre compte. Consultez notre' }) %>
</form>
<p class="muted small"><%= tr('Already a member?', 'Déjà membre ?') %> <a href="/login<%= locals.returnTo ? '?returnTo=' + encodeURIComponent(locals.returnTo) : '' %>"><%= tr('Log in', 'Se connecter') %></a></p>

<%- include('partials/footer') %>

<%- include('partials/header', { title: tr('Forum', 'Forum') }) %>

<h1><%= tr('Community Forum', 'Forum de la communauté') %></h1>
<p><a class="btn" href="/forum/new"><%= tr('Start a thread', 'Lancer une discussion') %></a></p>
<p class="muted small"><%= tr('See something that should not be here? Use the “Report” link on any thread or reply. Reports go to the association’s administrators, who review them promptly.', 'Vous voyez quelque chose qui n’a pas sa place ici ? Utilisez le lien « Signaler » sur n’importe quelle discussion ou réponse. Les signalements sont transmis aux administrateurs de l’association, qui les examinent rapidement.') %></p>

<% if (!threads.length) { %>
  <p class="muted"><%= tr('No threads yet.', 'Aucune discussion pour le moment.') %></p>
<% } else { %>
  <ul class="plain">
    <% threads.forEach(t => { %>
      <li>
        <% if (t.hidden && !(user && user.isAdmin)) { %>
          <em class="muted"><%= tr('This post was removed by the moderators.', 'Ce message a été retiré par les modérateurs.') %></em>
        <% } else { %>
          <a href="/forum/<%= t.id %>"><%= t.title %></a><% if (t.hidden) { %> <span class="muted small">(Hidden)</span><% } %>
        <% } %>
        <div class="thread-meta"><%= t.author_name || tr('Member', 'Membre') %> &middot; <%= formatDate(t.created_at) %> &middot; <%= t.reply_count == 1 ? tr('1 reply', '1 réponse') : tr('{n} replies', '{n} réponses', { n: t.reply_count }) %></div>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>

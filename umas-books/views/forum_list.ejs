<%- include('partials/header', { title: 'Forum' }) %>

<h1>Community Forum</h1>
<p><a class="btn" href="/forum/new">Start a thread</a></p>
<p class="muted small">See something that should not be here? Use the &ldquo;Report&rdquo; link on any thread or reply. Reports go to the association&rsquo;s administrators, who review them promptly.</p>

<% if (!threads.length) { %>
  <p class="muted">No threads yet.</p>
<% } else { %>
  <ul class="plain">
    <% threads.forEach(t => { %>
      <li>
        <a href="/forum/<%= t.id %>"><%= t.title %></a>
        <div class="thread-meta"><%= t.author_name || 'Member' %> &middot; <%= formatDate(t.created_at) %> &middot; <%= t.reply_count %> repl<%= t.reply_count == 1 ? 'y' : 'ies' %></div>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>

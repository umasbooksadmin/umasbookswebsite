<%- include('partials/header', { title: tr('Two-step verification', 'Vérification en deux étapes') }) %>

<h1><%= tr('Two-step verification', 'Vérification en deux étapes') %></h1>
<% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
<p><%= tr('Two-step verification is', 'La vérification en deux étapes est') %> <strong><%= tr('on', 'activée') %></strong> <%= tr('for your account.', 'pour votre compte.') %><% if (recoveryLeft != null) { %> <%= recoveryLeft === 1 ? tr('You have {n} unused recovery code.', 'Il vous reste {n} code de récupération inutilisé.', { n: recoveryLeft }) : tr('You have {n} unused recovery codes.', 'Il vous reste {n} codes de récupération inutilisés.', { n: recoveryLeft }) %><% } %></p>

<h2><%= tr('Get new recovery codes', 'Obtenir de nouveaux codes de récupération') %></h2>
<p class="muted small"><%= tr('This invalidates your old codes. Enter a current code from your app to confirm.', 'Vos anciens codes seront invalidés. Saisissez un code actuel de votre application pour confirmer.') %></p>
<form class="stack" method="post" action="/account/2fa/recovery-codes">
  <%- include('partials/csrf_field') %>
  <label for="code1"><%= tr('Code', 'Code') %></label>
  <input id="code1" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" autocapitalize="off" autocorrect="off" spellcheck="false" required>
  <button class="btn btn-outline" type="submit"><%= tr('New recovery codes', 'Nouveaux codes de récupération') %></button>
</form>

<% if (!isAdmin) { %>
<h2><%= tr('Turn off', 'Désactiver') %></h2>
<form class="stack" method="post" action="/account/2fa/disable">
  <%- include('partials/csrf_field') %>
  <label for="code2"><%= tr('Code', 'Code') %></label>
  <input id="code2" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" autocapitalize="off" autocorrect="off" spellcheck="false" required>
  <button class="btn btn-outline" type="submit"><%= tr('Turn off two-step verification', 'Désactiver la vérification en deux étapes') %></button>
</form>
<% } else { %>
<p class="muted small"><%= tr('Admin accounts can\'t turn this off. If you lose your phone and recovery codes, another admin can reset it for you (Admin → Members).', 'Les comptes administrateurs ne peuvent pas la désactiver. Si vous perdez votre téléphone et vos codes de récupération, un autre administrateur pourra la réinitialiser pour vous (Admin → Members).') %></p>
<% } %>

<%- include('partials/footer') %>

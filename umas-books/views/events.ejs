<%- include('partials/header', { title: 'Events', extraCss: ['/floral-calendar.css'], mainClass: view === 'week' ? 'wrap-wide' : 'wrap' }) %>

<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>
<% const monWeeks = view === 'week' ? weeks : mondayFirstWeeks(weeks); %>

<section class="fcal-hero">
  <img class="art art-left" src="/assets/img/hero-left.png" alt="">
  <img class="art art-right" src="/assets/img/hero-right.png" alt="">
  <div class="fcal-hero-copy">
    <div class="fcal-kicker">Uma’s Books &amp; Adventures<div class="rule"></div></div>
    <h1 class="fcal-title">Upcoming Events</h1>
    <p class="fcal-sub">Everyone’s welcome — browse what’s coming up and sign up below, no account needed.</p>
    <div class="fcal-nav">
      <a href="/events?<%= prevHref %>" aria-label="Previous">&lsaquo;</a>
      <span class="fcal-month"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a href="/events?<%= nextHref %>" aria-label="Next">&rsaquo;</a>
    </div>
    <div class="fcal-view-toggle">
      <a href="/events" class="<%= view === 'month' ? 'is-active' : '' %>">Month</a>
      <a href="/events?view=week" class="<%= view === 'week' ? 'is-active' : '' %>">Week</a>
    </div>
  </div>
</section>

<div class="fcal-wrap<%= view === 'week' ? ' is-week' : '' %>">
  <%- include('partials/calendar_grid', { monWeeks, qs, itemPartial: 'calendar_item_event' }) %>
</div>

<%- include('partials/footer') %>

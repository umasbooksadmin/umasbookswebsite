<%- include('partials/header', { title: tr('Events', 'Événements'), description: tr("Upcoming events at Uma's Books & Adventures in Albi, France: browse the calendar by month or week and sign up online, no account needed.", 'Les prochains événements d’Uma’s Books & Adventures à Albi : parcourez le calendrier par mois ou par semaine et inscrivez-vous en ligne, sans compte.'), extraCss: ['/floral-calendar.css'], mainClass: view === 'week' ? 'wrap-wide' : 'wrap' }) %>

<% const qs = view === 'week' ? `view=week&week=${currentWeek}` : `month=${currentMonth}`; %>
<% const prevHref = view === 'week' ? `view=week&week=${prevWeek}` : `month=${prevMonth}`; %>
<% const nextHref = view === 'week' ? `view=week&week=${nextWeek}` : `month=${nextMonth}`; %>
<% const monWeeks = view === 'week' ? weeks : mondayFirstWeeks(weeks); %>

<section class="fcal-hero fcal-hero-events">
  <%- include('partials/picture', { src: '/assets/img/hero-left.png', alt: '', w: 322, h: 512, cls: 'art art-left', lazy: true }) %>
  <%- include('partials/picture', { src: '/assets/img/hero-right.png', alt: '', w: 286, h: 512, cls: 'art art-right', lazy: true }) %>
  <div class="fcal-hero-copy">
    <div class="fcal-kicker">Uma’s Books &amp; Adventures<div class="rule"></div></div>
    <h1 class="fcal-title"><%= tr('Upcoming Events', 'Prochains événements') %></h1>
    <p class="fcal-sub"><%= tr('Everyone’s welcome — browse what’s coming up and sign up below, no account needed.', 'Tout le monde est le bienvenu — parcourez les événements à venir et inscrivez-vous ci-dessous, sans besoin de créer de compte.') %></p>
    <div class="fcal-nav">
      <a href="/events?<%= prevHref %>" aria-label="<%= tr('Previous', 'Précédent') %>">‹</a>
      <span class="fcal-month"><%= view === 'week' ? weekLabel : monthLabel %></span>
      <a href="/events?<%= nextHref %>" aria-label="<%= tr('Next', 'Suivant') %>">›</a>
    </div>
    <div class="fcal-view-toggle">
      <a href="/events" class="<%= view === 'month' ? 'is-active' : '' %>"><%= tr('Month', 'Mois') %></a>
      <a href="/events?view=week" class="<%= view === 'week' ? 'is-active' : '' %>"><%= tr('Week', 'Semaine') %></a>
    </div>
  </div>
</section>

<div class="fcal-wrap<%= view === 'week' ? ' is-week' : '' %>">
  <%- include('partials/calendar_grid', { monWeeks, qs, itemPartial: 'calendar_item_event', emptyKind: 'events', nextUrl: '/events?' + nextHref }) %>
</div>

<%- include('partials/footer') %>

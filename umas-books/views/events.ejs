<%- include('partials/header', { title: 'Events' }) %>

<h1>Events</h1>
<p class="muted">Everyone's welcome &mdash; browse what's coming up and sign up below, no account needed.</p>

<div class="card">
  <div class="calendar-nav">
    <a class="btn btn-outline btn-small" href="/events?month=<%= prevMonth %>">&larr; Prev</a>
    <span class="month-label"><%= monthLabel %></span>
    <a class="btn btn-outline btn-small" href="/events?month=<%= nextMonth %>">Next &rarr;</a>
  </div>
  <div class="calendar-grid">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="calendar-weekday"><%= d %></div><% }) %>
    <% weeks.forEach(week => { %>
      <% week.forEach(day => { %>
        <% if (!day) { %>
          <div class="calendar-day is-empty"></div>
        <% } else { %>
          <div class="calendar-day<%= day.isToday ? ' is-today' : '' %>">
            <div class="calendar-day-number"><%= day.day %></div>
            <% day.items.forEach(e => { %>
              <% const full = e.capacity != null && e.signup_count >= e.capacity; %>
              <details class="calendar-pill<%= full ? ' is-full' : '' %>">
                <summary><%= e.title %> &middot; <%= new Date(e.starts_at).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %></summary>
                <div class="calendar-pill-body">
                  <div class="muted small">
                    <%= new Date(e.starts_at).toLocaleString() %><%= e.location ? ' · ' + e.location : '' %>
                    <%= e.capacity != null ? ' · ' + e.signup_count + '/' + e.capacity + ' spots taken' : ' · ' + e.signup_count + ' going' %>
                  </div>
                  <% if (e.description) { %><div class="muted small" style="margin-top:6px;"><%= e.description %></div><% } %>

                  <form class="stack" method="post" action="/events/<%= e.id %>/signup?month=<%= currentMonth %>" style="margin-top:10px; gap:8px;">
                    <%- include('partials/csrf_field') %>
                    <label for="name-<%= e.id %>">Name</label>
                    <input id="name-<%= e.id %>" name="name" type="text" required<%= full ? ' disabled' : '' %>>
                    <label for="email-<%= e.id %>">Email</label>
                    <input id="email-<%= e.id %>" name="email" type="email" required<%= full ? ' disabled' : '' %>>
                    <div><button class="btn btn-small" type="submit"<%= full ? ' disabled' : '' %>><%= full ? 'Full' : 'Sign up' %></button></div>
                  </form>
                </div>
              </details>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>

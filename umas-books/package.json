{
  "name": "umas-books",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Uma's Books and Adventures: member accounts, forum, charity vote, volunteer/meeting scheduling, and inventory management",
  "main": "src/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "backfill-french-content": "node src/backfillFrenchContent.js",
    "clear-test-data": "node scripts/clear-test-data.js",
    "demo:load": "node scripts/demo-data.js load",
    "demo:remove": "node scripts/demo-data.js remove",
    "lint": "eslint . ../assets",
    "test": "node --test",
    "e2e": "node e2e/run.js",
    "e2e:local": "node e2e/local.js",
    "e2e:ci": "node e2e/ci.js",
    "docs:env": "node scripts/gen-env-docs.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "isbn3": "^2.0.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "puppeteer": "^25.15.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "puppeteer@25.13.0": true
  }
}
